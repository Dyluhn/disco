    "steps": [
      {
        "title": "Write status_server.py",
        "detail": "A Python 3 stdlib HTTP server on port 3000 that responds to GET /status.json with {\"service\": \"status\", \"ok\": true}, Content-Type: application/json, and Access-Control-Allow-Origin: *."
      },
      {
        "title": "Write index.html",
        "detail": "A static page with <h1>BP10 multi-port</h1>, a <pre id=\"status\">, and a script that fetches http://localhost:3000/status.json and displays the result (or \"status: unavailable\" on failure)."
