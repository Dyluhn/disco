   "arguments": {
    "path": "server.py",
    "content": "import csv\nimport json\nfrom http.server import HTTPServer, BaseHTTPRequestHandler\n\n# Read CSV once at startup\nreadings = []\nwith open(\"uploads/sensor_readings.csv\", newline=\"\") as f:\n    reader = csv.DictReader(f)\n    for row in reader:\n        row[\"temperature_c\"] = float(row[\"temperature_c\"])\n        readings.append(row)\n\nclass Handler(BaseHTTPRequestHandler):\n    def do_GET(self):\n        if self.path == \"/api/readings\":\n            self.send_response(200)\n            self.send_header(\"Content-Type\", \"application/json\")\n            self.send_header(\"Access-Control-Allow-Origin\", \"*\")\n            self.end_headers()\n            self.wfile.write(json.dumps(readings).encode())\n        else:\n            self.send_response(404)\n            self.end_headers()\n\n    def log_message(self, format, *args):\n        print(f\"[API] {args[0]}\")\n\nif __name__ == \"__main__\":\n    port = 3000\n    server = HTTPServer((\"0.0.0.0\", port), Handler)\n    print(f\"API server running on port {port} ({len(readings)} readings loaded)\")\n    server.serve_forever()\n"
   },
