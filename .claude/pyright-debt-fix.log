   309	# CURRENT WORKSPACE message rendered by view_render.workspace_snapshot_message). Shared
   310	# here (the lowest common module both the loop renderer and the provider import) so the
   311	# provider can locate the block to place an Anthropic cache breakpoint after it, and so
   312	# recovery/pointer prose can reference it by a LOCATION-INDEPENDENT name ("the CURRENT
   313	# WORKSPACE block in this prompt" — never "below"/"above": the block moved to the
   314	# cacheable prefix, so directional words are wrong).
   315	WORKSPACE_SNAPSHOT_SENTINEL = "# CURRENT WORKSPACE"
