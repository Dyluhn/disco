   898	# ---- the discriminated union the store/serde use ----------------------------
   899	
   900	Event = Annotated[
   901	    MessageEvent
   902	    | ActionEvent
   903	    | ObservationEvent
   904	    | AgentErrorEvent
   905	    | CondensationEvent
   906	    | StatusEvent
   907	    | PlanEvent
   908	    | ReportEvent
   909	    | AlternativesEvent
   910	    | KnowledgeEvent
   911	    | DatasourceEvent
   912	    | DeliverableEvent
   913	    | ErrorEvent
   914	    | ScheduleEvent
   915	    | ScheduleRunEvent
   916	    | ClarifyEvent
   917	    | ContextResolvedEvent
   918	    | ContextSummaryEvent,
   919	    Field(discriminator="kind"),
   920	]
   921	
   922	# Single shared validator/serializer for the union. Consumers parse arbitrary
   923	# event dicts (post-migration) through this; the `kind` field selects the
   924	# concrete type. (§4 serialization contract.)
   925	EventAdapter: TypeAdapter[Event] = TypeAdapter(Event)
   926	
   927	
   928	def event_to_json_dict(event: Event) -> dict[str, Any]:
   929	    """Serialize one event to a JSON-safe dict (§4 rule 1): ISO datetimes,
   930	    enums by value. The inverse is `event_from_json_dict`."""
   931	    return event.model_dump(mode="json")
   932	
   933	
   934	def event_from_json_dict(raw: dict[str, Any]) -> Event:
   935	    """Deserialize a (already-migrated) JSON dict back into the concrete event
   936	    type via the discriminated union. Callers should run `migrate_event` first
   937	    (see migration.py) so old persisted events stay readable forever."""
   938	    return EventAdapter.validate_python(raw)

