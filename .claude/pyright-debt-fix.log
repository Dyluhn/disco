   189	    await loop.approve_plan()
   190	    await loop.run()
   191	
   192	    events = await store.get_events(CID)
   193	    # The run landed FINISHED (the single step was marked done; finish was
   194	    # accepted because the plan is complete).
   195	    final_status = next(
