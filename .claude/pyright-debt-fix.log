   404	def retarget_elided_arg_markers(messages: list[LLMMessage]) -> list[LLMMessage]:
   405	    """CW P1-a (round-2) — assist-OFF render pass: rewrite each elided tool-call
   406	    ARGUMENT marker to the NEUTRAL, non-dangling marker.
   407	
   408	    `_snip_args` emits the directional `_arg_snip_marker_below` unconditionally (it runs
   409	    inside `View.of`, which has no tier context). For assist-OFF the CURRENT WORKSPACE
   410	    block moved to the cacheable PREFIX, where the directional "below" is wrong AND a
   411	    "the content is in the block" pointer is UNSAFE: an elided arg is a write/edit body
   412	    (an attempted or NEW value), NOT the file's current content, so the block does not
   413	    carry it even when the call's target path is pinned in full. So this pass rewrites
   414	    EVERY elided arg to `_arg_snip_marker_neutral` — which claims only the always-true
   415	    re-issue / file_read recovery — with NO per-arg pinned-vs-omitted guessing.
   416	
   417	    assist-ON never calls this (the directional marker is correct + pre-CW-3 byte-
   418	    identical for the tail-placed block). Pure: returns a new list; input unchanged.
   419	    """
   420	    out: list[LLMMessage] = []
   421	    for msg in messages:
   422	        if msg.role != "assistant" or not msg.tool_calls:
   423	            out.append(msg)
   424	            continue
   425	        new_tcs: list[dict[str, Any]] = []
   426	        mutated = False
   427	        for tc in msg.tool_calls:
   428	            if not isinstance(tc, dict):
   429	                new_tcs.append(tc)
   430	                continue
   431	            args = tc.get("arguments")
   432	            if not isinstance(args, dict):
   433	                new_tcs.append(tc)
   434	                continue
   435	            new_args: dict[str, Any] | None = None
   436	            for k, v in args.items():
   437	                if not isinstance(v, str):
   438	                    continue
   439	                count = _ELISION_COUNT_RE.match(v)
   440	                if count is None or _ELISION_MARKER_RE.search(v) is None:
   441	                    continue  # not one of our markers — leave the model's arg alone
   442	                n = int(count.group(1).replace(",", ""))
   443	                replacement = _arg_snip_marker_neutral(n)
   444	                if replacement == v:
   445	                    continue
   446	                if new_args is None:
   447	                    new_args = dict(args)
   448	                new_args[k] = replacement
   449	            if new_args is not None:
   450	                new_tc = dict(tc)
   451	                new_tc["arguments"] = new_args
   452	                new_tcs.append(new_tc)
   453	                mutated = True
   454	            else:
   455	                new_tcs.append(tc)
   456	        out.append(msg.model_copy(update={"tool_calls": new_tcs}) if mutated else msg)
   457	    return out
