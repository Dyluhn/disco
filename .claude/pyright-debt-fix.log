   392	def _snip_args(arguments: dict[str, Any]) -> dict[str, Any]:
   393	    out: dict[str, Any] = {}
   394	    for k, v in arguments.items():
   395	        if isinstance(v, str) and len(v) > _ARG_SNIP_CHARS:
   396	            # Always the assist-ON / pre-CW-3 directional marker. assist-OFF retargets
   397	            # it (per pinned-in-full path) in ViewBuilder; assist-ON keeps it as-is.
   398	            out[k] = _arg_snip_marker_below(len(v))
   399	        else:
   400	            out[k] = v
   401	    return out
