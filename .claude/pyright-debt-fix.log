   292	        return content
   293	    dropped = len(content) - head - tail
   294	    return (
   295	        f"{content[:head]}\n"
   296	        f"… [snipped {dropped:,} chars — re-run the tool or use file_read for the full output] …\n"
   297	        f"{content[-tail:]}"
   298	    )
