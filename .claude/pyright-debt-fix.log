    60	# plan_step completes and the post-execute C18 hook runs).
    61	# ---------------------------------------------------------------------------
    62	
    63	
    64	class _FakeSandbox:
    65	    """Minimal sandbox surface the C18 evaluator needs: `workspace_path` for
    66	    `file_exists` path resolution. The list of files in the workspace is
    67	    what the test plants up front, so the predicate's outcome is
    68	    deterministic."""
    69	
    70	    def __init__(self, workspace_path: str, files: dict[str, bytes] | None = None) -> None:
    71	        self.workspace_path = workspace_path
    72	        self._files: dict[str, bytes] = dict(files or {})
    73	
    74	    async def read_file(self, path: str) -> bytes:
    75	        if path not in self._files:
    76	            raise FileNotFoundError(path)
    77	        return self._files[path]
    78	
    79	    async def write_file(self, path: str, data: bytes) -> None:
    80	        self._files[path] = bytes(data)
    81	
    82	    async def file_exists(self, path: str) -> bool:
    83	        """B4 — mirrors the real process/session backend: resolve against the
    84	        host-side `workspace_path` (this fake plants real files there) and check
    85	        the FS. The C18 check now calls THIS instead of a literal host path."""
    86	        from pathlib import Path
    87	
    88	        return (Path(self.workspace_path) / path).exists()
    89	
    90	
    91	class _SandboxExecutor:
    92	    """ToolExecutor stub: any `execute()` returns success (so plan_step's
    93	    in-process tool completes), and a `sandbox` attribute is exposed so the
    94	    C18 evaluator can resolve `file_exists` paths against the workspace.
    95	
    96	    `available_tools()` offers `shell` so the Rung-7 unknown-tool requery
    97	    doesn't trip on tool names the agent uses between `submit_plan` and
    98	    `plan_step`."""
    99	
   100	    def __init__(self, sandbox: _FakeSandbox) -> None:
   101	        self.sandbox = sandbox
   102	        self.execute_calls: list[ToolCall] = []
   103	
   104	    def available_tools(self):
   105	        from disco.core.llm import ToolSpec
   106	        return [
   107	            ToolSpec(name="shell", description="run a shell command", parameters_schema={}),
   108	            ToolSpec(name="plan_step", description="mark plan step progress", parameters_schema={}),
   109	            ToolSpec(
   110	                name="update_plan_progress",
   111	                description="declarative full-state plan progress",
   112	                parameters_schema={},
   113	            ),
   114	        ]
   115	
   116	    async def execute(self, call: ToolCall) -> ToolResult:
   117	        self.execute_calls.append(call)
   118	        return ToolResult(
   119	            call_id=call.call_id, tool_name=call.tool_name, success=True, content="ok"
   120	        )
   121	
   122	
   123	def _advisory_notes(events: list) -> list[MessageEvent]:
   124	    """Pull the C18 advisory notes out of the event log. They are
   125	    `MessageEvent(source=ENVIRONMENT, meta={"advisory": "plan_step_done_condition", ...})`
   126	    — NOT wrapped in <system-reminder> (so they are visible but
   127	    non-nudging)."""
   128	    return [
   129	        e for e in events
   130	        if isinstance(e, MessageEvent)
   131	        and e.source == EventSource.ENVIRONMENT
   132	        and isinstance(e.meta, dict)
   133	        and e.meta.get("advisory") == "plan_step_done_condition"
   134	    ]
   135	
   136	
   137	def _has_no_advisory_note(events: list) -> bool:
   138	    """Back-compat assertion helper: the trace contains zero C18 notes."""
   139	    return _advisory_notes(events) == []
   140	
   141	
   142	# ---------------------------------------------------------------------------
   143	# Test 1 — step with a SATISFIED predicate → clean done + visible "met" note
   144	# ---------------------------------------------------------------------------
   145	
   146	
   147	@pytest.mark.asyncio
   148	async def test_c18_satisfied_predicate_emits_met_note(tmp_path):
   149	    """A plan step whose `done_condition` (file_exists) is satisfied at the
   150	    moment the agent marks it done → the C18 advisory note says `met`. The
   151	    run completes cleanly; the note is visible in the trace."""
   152	    # Plant a file the predicate will look for.
   153	    workspace = tmp_path / "ws"
   154	    workspace.mkdir()
   155	    (workspace / "artifact.txt").write_text("ok")
   156	    sbx = _FakeSandbox(str(workspace))
   157	
   158	    agent = ScriptedAgent(
   159	        [
   160	            # submit_plan: one step with a satisfied file_exists predicate
   161	            action_step(
   162	                "submit_plan",
   163	                {
   164	                    "summary": "p",
   165	                    "steps": [
   166	                        {
   167	                            "title": "write artifact",
   168	                            "done_condition": {
   169	                                "kind": "file_exists",
   170	                                "path": "artifact.txt",
   171	                            },
   172	                        }
   173	                    ],
   174	                },
   175	            ),
   176	            # A real productive action so the run executes the plan (else the
   177	            # approve→no-execution gate terminalizes STUCK before finish).
   178	            action_step("shell", {"command": "echo done"}),
   179	            # plan_step(1, 'done') — the C18 hook evaluates the predicate
   180	            action_step("plan_step", {"index": 1, "state": "done"}),
   181	            finish_step(),
   182	        ]
   183	    )
   184	    loop, store = build_loop(agent, executor=_SandboxExecutor(sbx), conversation_id=CID)
   185	    loop.mode = OperatingMode.PLANNING
   186	    loop._planning_tools = frozenset(["file_read"])
   187	    await loop.send_message("go")
