  1996	                MessageEvent(
  1997	                    source=EventSource.ENVIRONMENT,
  1998	                    message=LLMMessage(role="user", content=_EXECUTION_NUDGE),
  1999	                )
  2000	            )
  2001	            # The execution-nudge cap (_EXECUTION_NUDGE_CAP) is the
  2002	            # backstop for this path: after N nudges the gate emits
  2003	            # FINISHED and halts above. The old noop valve call has
  2004	            # been removed — it fired at _ACTIONLESS_BREAK_CAP (3),
  2005	            # same count as the cap, and would PAUSED the run before
  2006	            # the cap's FINISHED release could land (W5 fix).
  2007	            return Disp.CONTINUE
  2008	        # Productive action found — reset the nudge streak so a fresh
  2009	        # plan-approval cycle gets a full _EXECUTION_NUDGE_CAP budget.
  2010	        self._loop._execution_nudges = 0
  2011	        return Disp.FALLTHROUGH
