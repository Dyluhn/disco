  1869	    def kick(self, conversation_id: str) -> None:
  1870	        """Schedule the loop to run (idempotent: a no-op if already running). The
  1871	        loop itself decides if there's unprocessed work and streams events.
  1872	
  1873	        Wraps `loop.run()` in a task that — for Build conversations with a valid
  1874	        ProjectStore configured — first REHYDRATES the persisted workspace on
  1875	        the very first kick, and SNAPSHOTS it after every run that ends in
  1876	        FINISHED. Failures are reported as ambient system-reminder events on
  1877	        the conversation log (the user + model both see them), never as
  1878	        exceptions that crash the task."""
  1879	        # Auto-title from the first user message (idempotent, detached, no-op once
  1880	        # titled). Placed here because kick() is the single chokepoint every user
  1881	        # message flows through — covers WS + REST send_message + first-kick alike.
  1882	        self._title_service.schedule(conversation_id)
  1883	        existing = self._tasks.get(conversation_id)
  1884	        if existing is not None and not existing.done():
  1885	            return  # already running; the new message is picked up at the next step
  1886	        # W-48(c): if Settings switched the sandbox backend since this conversation
  1887	        # last composed, evict its stale-backend session here so _loop_for composes a
  1888	        # fresh sandbox on the new backend (best-effort destroy of the old box).
  1889	        self._evict_stale_backend(conversation_id)
  1890	        loop = self._loop_for(conversation_id)
  1891	        # finding #3: this is a NEW run task → bump the conversation's run-generation
  1892	        # and bind it into the done-callback, so the finalizer for THIS run can tell
  1893	        # whether a newer run has since reused the pin (and must not clear it).
  1894	        generation = self._run_generation.get(conversation_id, 0) + 1
  1895	        self._run_generation[conversation_id] = generation

