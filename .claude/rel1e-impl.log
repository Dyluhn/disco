   760	class DeliverableEvent(BaseEvent, LLMConvertible):
   761	    """The agent's explicit 'here is the finished thing' handoff (Build). It names
   762	    WHAT was produced and WHERE, so the UI can present a real handoff (open the
   763	    live app / download the files) instead of leaving the user to guess what the
   764	    run made. Distinct from the live preview (which shows work-in-progress): a
   765	    DeliverableEvent is the agent affirming a result is ready.
   766	
   767	    `kind`:
   768	      • "app"   — a runnable result the user opens in the live preview (a built
   769	                  site / running dev server rooted at `path`).
   770	      • "files" — one or more workspace artifacts to download/inspect (`path` is
   771	                  the file or directory).
   772	
   773	    LLMConvertible so the agent's own context reflects what it has already handed
   774	    off (it shouldn't re-deliver the same thing); the body stays terse."""
   775	
   776	    kind: Literal[EventKind.DELIVERABLE] = EventKind.DELIVERABLE
   777	    source: EventSource = EventSource.AGENT
   778	    title: str  # short human label, e.g. "Landing page" / "Sales report"
   779	    path: str  # workspace-relative path (dir for an app root, file/dir for files)
   780	    artifact_kind: Literal["app", "files"] = "app"
   781	    # Optional canonical URL the deliverable is reachable at (a deploy target, a
   782	    # tunnel, or the live preview). When the agent serves to a known address it
   783	    # passes it on `serve(url=…)`; the UI surfaces an "Open deployed app" link.
   784	    deployment_url: str = ""
   785	
   786	    def to_llm_message(self) -> LLMMessage:
   787	        return LLMMessage(
   788	            role="user",
   789	            content=(
   790	                f"<deliverable kind=\"{self.artifact_kind}\" path=\"{self.path}\">\n"
   791	                f"{self.title}\n</deliverable>"
   792	            ),
   793	        )

