  1661	                source=EventSource.ENVIRONMENT,
  1662	                message=LLMMessage(
  1663	                    role="user",
  1664	                    content=(
  1665	                        "<system-reminder>\n"
  1666	                        "You called finish, but the external Definition-of-Done "
  1667	                        f"evaluator found {len(verdict.unmet)} unmet acceptance "
