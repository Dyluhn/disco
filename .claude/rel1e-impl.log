  1808	                    MessageEvent(
  1809	                        source=EventSource.ENVIRONMENT,
  1810	                        message=LLMMessage(
  1811	                            role="user",
  1812	                            content=(
  1813	                                "<system-reminder>\n"
  1814	                                f"Your verify command `{verify_cmd}` is not runnable "
  1815	                                "(syntax error / command-not-found) — that is a broken "
  1816	                                "CHECK, not a failed task, so it is "
  1817	                                "being ignored and the "
  1818	                                "run is finishing. Next time pass a "
  1819	                                "valid shell command "
  1820	                                "if you want real verification.\n"
  1821	                                "</system-reminder>"
  1822	                            ),
  1823	                        ),
  1824	                    )
  1825	                )
