  1789	    async def normalize_finish_step(
  1790	        self, step: AgentStep, events: list[Event]
  1791	    ) -> tuple[AgentStep, Disp]:
  1792	        # VERIFY-ON-FINISH (post-condition gate). If the agent attached
  1793	        # a `verify` check to finish, RUN it first and refuse the finish
  1794	        # if it doesn't pass — the "run the tests before you claim done"
  1795	        # forcing function. The check is visible in the trace; on
  1796	        # failure the agent sees exactly what broke and adapts, instead
  1797	        # of declaring a broken build complete.
