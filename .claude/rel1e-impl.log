+            finish_step(),
+            finish_step(),
+            finish_step(),
+        ]
+    )
+    loop, store = _loop(agent, execu, host_verifier=host)
+
+    await loop.send_message("build a page")
+    state = await loop.run()
+
+    assert state.execution_status == ConversationStatus.FINISHED
+    assert execu.verify_calls == 0
