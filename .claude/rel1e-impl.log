  1831	                    MessageEvent(
  1832	                        source=EventSource.ENVIRONMENT,
  1833	                        message=LLMMessage(
  1834	                            role="user",
  1835	                            content=(
  1836	                                "<system-reminder>\n"
  1837	                                f"You called finish, but the verify "
  1838	                                f"command `{verify_cmd}` "
  1839	                                "did not pass (see the result above). The task is NOT "
  1840	                                "complete. Fix what it surfaced, then "
  1841	                                "finish again — or "
  1842	                                "finish without a verify command if "
  1843	                                "the check itself is "
  1844	                                "wrong.\n"
  1845	                                "</system-reminder>"
  1846	                            ),
  1847	                        ),
  1848	                    )
  1849	                )
