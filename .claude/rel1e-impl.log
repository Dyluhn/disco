  1936	            and not signals.productive_action_since_approval(events)
  1937	        ):
  1938	            # W5 cap: after _EXECUTION_NUDGE_CAP nudges without productive
  1939	            # action, TERMINALIZE the run as a FAILURE — NOT a false FINISHED.
  1940	            # Spec §11.2: after approval, execution must produce ≥1 action OR
  1941	            # a terminal explicit failure. A plan that is approved but never
  1942	            # executed is the latter, so land STUCK (bounded no-progress /
  1943	            # model-stall — same family as the other no-progress terminals;
  1944	            # ERROR is reserved for thrown exceptions). The cap is the
  1945	            # terminal exit for this path: HALT so the engine exits the loop
  1946	            # and `get_state()` surfaces STUCK/approve_plan_no_execution.
  1947	            if self._loop._execution_nudges >= _EXECUTION_NUDGE_CAP:
  1948	                _LOG.warning(
  1949	                    "execution-nudge cap (%d) reached for %s — plan approved but "
  1950	                    "never executed; terminalizing STUCK (approve_plan_no_execution).",
  1951	                    _EXECUTION_NUDGE_CAP,
  1952	                    self._loop.conversation_id,
  1953	                )
  1954	                await self._loop._emit(
  1955	                    MessageEvent(
  1956	                        source=EventSource.ENVIRONMENT,
  1957	                        message=LLMMessage(
  1958	                            role="user",
  1959	                            content=(
  1960	                                "<system-reminder>\n"
  1961	                                "Plan approved but no execution action was taken after "
  1962	                                f"{self._loop._execution_nudges} execution reminders. "
  1963	                                "The plan was not executed.\n"
  1964	                                "</system-reminder>"
  1965	                            ),
  1966	                        ),
  1967	                    )
  1968	                )
  1969	                await self._loop._emit(
  1970	                    StatusEvent(
  1971	                        status=ConversationStatus.STUCK,
  1972	                        detail="approve_plan_no_execution",
  1973	                    )
  1974	                )
