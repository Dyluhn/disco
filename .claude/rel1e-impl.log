+"""REL-1e host verifier authoritative gate."""
+
+from __future__ import annotations
+
+import pytest
+
+from disco.core import (
+    ActionEvent,
+    ConversationStatus,
+    DeliverableEvent,
+    MessageEvent,
+    NoOpCondenser,
+    ObservationEvent,
+    SqliteEventStore,
+    StatusEvent,
