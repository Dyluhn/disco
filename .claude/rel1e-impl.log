  1925	    async def gate_execution_nudge(self, step: AgentStep, events: list[Event]) -> Disp:
  1926	        # PLAN-MODE EXECUTION GATE — a forcing function, NOT a prompt. If
  1927	        # the loop is in execution mode (planning_tools configured) and the
  1928	        # agent declares "done" without any productive action since plan
  1929	        # approval, refuse the finish: append an IMPLICIT system-reminder
  1930	        # and re-enter the loop. W5: capped at _EXECUTION_NUDGE_CAP (3) for
  1931	        # parity with the other finish-path gates — after cap the gate
  1932	        # RELEASES with a visible warning rather than running forever.
  1933	        if (
  1934	            self._loop._planning_tools  # plan-first lifecycle is configured
