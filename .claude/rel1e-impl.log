  2013	    async def _gate_verify_web_app(self, events: list[Event]) -> Disp:
  2014	        """W-45 — the verdict-consuming finish gate (the loop-killer).
  2015	
  2016	        Replaces `_browser_verified()` as the PRIMARY completion check for web
  2017	        builds with "the latest `verify_web_app` verdict since the last productive
  2018	        edit". If none exists when the agent calls finish, the gate DRIVES
  2019	        `verify_web_app` itself (ONE call). pass → finish; fail → emit the verdict's
  2020	        summary + first concrete error + screenshot + next_action and CONTINUE.
  2021	
  2022	        LOOP BREAKER: the verdict is cached by `_last_productive_seq` — a browser/
  2023	        navigate/verify probe is NOT a productive edit, so re-verifying without an
  2024	        edit reads the SAME cached verdict (no real re-run). When the SAME
  2025	        `failure_fingerprint` recurs without a productive edit that changes the
  2026	        served output, the gate marks the run STUCK/no_progress (W-31 detail
  2027	        naming) instead of reloading 25-40×. The 3-refusal release no longer
  2028	        silently converts repeated failed verification into 'done' — it finishes
  2029	        ONLY with an explicit blocked/incomplete summary."""
  2030	        since_seq = _last_productive_seq(events)
  2031	        # P1-1: bind the accepted verdict to the CURRENT preview target. Detect the
  2032	        # live preview (same _PREVIEW_PORTS detection the tool uses) and accept only
  2033	        # a verdict whose url matches it; a stale / foreign-port (or url-less) PASS
  2034	        # must NOT satisfy the gate — it drives a fresh verify against the real
  2035	        # preview instead. target_url=None (preview undetectable) disables binding.
