  1976	
  1977	            self._loop._execution_nudges += 1  # telemetry + cap counter
  1978	            # Surface the model's reasoning before nudging (don't
  1979	            # discard it) — mirror the plan-nudge sibling.
  1980	            if step.thought.strip():
  1981	                await self._loop._emit(
  1982	                    MessageEvent(
  1983	                        source=EventSource.AGENT,
  1984	                        message=LLMMessage(
  1985	                            role="assistant", content=step.thought
  1986	                        ),
  1987	                    )
  1988	                )
  1989	            else:
  1990	                # An empty finish-step persists nothing, so it's
  1991	                # invisible to every event-derived detector; the
  1992	                # instance counter has to carry it (the (g) no-op
  1993	                # path does the same).
  1994	                self._loop._invisible_steps += 1
