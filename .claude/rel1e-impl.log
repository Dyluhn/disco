  1611	                    MessageEvent(
  1612	                        source=EventSource.ENVIRONMENT,
  1613	                        message=LLMMessage(
  1614	                            role="user",
  1615	                            content=(
  1616	                                f"<note>\nFinished, but {len(failed)} acceptance check(s) "
  1617	                                "could NOT be verified (the check could not run — e.g. a "
  1618	                                "denied command or a server that was not serving). These are "
  1619	                                "NOT failures, but they were NOT confirmed either:\n\n"
  1620	                                f"{unverified}\n</note>"
