  1853	                # model can't satisfy (mirrors the browser-verify valve). The
  1854	                # failure stays visible (status detail + reminder + summary).
  1855	                await self._loop._emit(
  1856	                    StatusEvent(
  1857	                        status=ConversationStatus.RUNNING,
  1858	                        detail="finish_verify_release",
  1859	                    )
  1860	                )
  1861	                await self._loop._emit(
  1862	                    MessageEvent(
  1863	                        source=EventSource.ENVIRONMENT,
  1864	                        message=LLMMessage(
  1865	                            role="user",
  1866	                            content=(
  1867	                                "<system-reminder>\n"
  1868	                                f"The verify command `{verify_cmd}` has failed "
  1869	                                f"{self._loop._finish_verify_refusals} times. "
  1870	                                "Finishing anyway "
  1871	                                "so the run does not loop forever — "
  1872	                                "but the deliverable "
  1873	                                "may be incomplete. Note this clearly "
  1874	                                "in your summary.\n"
  1875	                                "</system-reminder>"
  1876	                            ),
  1877	                        ),
  1878	                    )
  1879	                )
  1880	                # ⚠ human-facing: surfaces in the UI as a warning chip so the
  1881	                # user knows the run finished with a failing check.
  1882	                await self._loop._emit(
  1883	                    MessageEvent(
  1884	                        source=EventSource.ENVIRONMENT,
  1885	                        message=LLMMessage(
  1886	                            role="user",
  1887	                            content=(
  1888	                                "⚠ Finished despite the verification check failing "
  1889	                                f"{self._loop._finish_verify_refusals}× — "
  1890	                                "the deliverable may "
  1891	                                "be incomplete; review it."
  1892	                            ),
  1893	                        ),
