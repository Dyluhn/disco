  1681	    async def build_dod_evaluator(self) -> DoDEvaluator:
  1682	        """Construct the DoDEvaluator. Two paths:
  1683	
  1684	          * `_dod_evaluator_factory` is set (test seam): call it, ignore args.
  1685	          * Otherwise: derive the workspace_root from the executor's sandbox
  1686	            (the in-cluster `workspace_path`); if absent, raise
  1687	            `_DoDWorkspaceUnavailable` and the gate degrades to "skip".
  1688	
  1689	        The factory is the dependency-injection point — tests close over
  1690	        a tmp_path + fake command_runner / http_probe and return a fully
  1691	        configured `DoDEvaluator`. Production callers leave the factory
  1692	        None and the engine does the workspace resolution here.
  1693	        """
  1694	        if self._loop._dod_evaluator_factory is not None:
  1695	            # The factory is an async-callable in the common case (tests
  1696	            # want to close over a `tmp_path` + fakes without performing
  1697	            # any I/O at construction time), but a sync callable is also
  1698	            # accepted — production callers may want to keep the
  1699	            # construction cheap. Awaiting a non-awaitable raises
  1700	            # TypeError, which the gate's `_DoDWorkspaceUnavailable`-
  1701	            # style `try/except` doesn't catch; the explicit
  1702	            # `inspect.iscoroutine` check keeps both shapes working.
  1703	            import inspect
  1704	
  1705	            result = self._loop._dod_evaluator_factory()
  1706	            if inspect.iscoroutine(result):
  1707	                result = await result
  1708	            # inspect.iscoroutine is a TypeGuard (narrows only the positive
  1709	            # branch), so the awaited-away Coroutine lingers in the static type;
  1710	            # at runtime `result` is always the resolved DoDEvaluator here.
  1711	            return cast(DoDEvaluator, result)
  1712	        sbx = getattr(self._loop.executor, "sandbox", None)
  1713	        workspace = getattr(sbx, "workspace_path", None) if sbx is not None else None
  1714	        if not workspace:
  1715	            raise _DoDWorkspaceUnavailable(
  1716	                f"no sandbox.workspace_path on executor {type(self._loop.executor).__name__}"
  1717	            )
  1718	        from pathlib import Path
  1719	
  1720	        # An `http_ok` serve-check must probe from INSIDE the sandbox: a build's dev
  1721	        # server binds the SANDBOX's localhost, not the host's. The default host-side
  1722	        # urlopen would hit the agent-server (404 on `/`), false-failing every sandboxed
  1723	        # serve and spinning the model into re-serve/re-verify loops. Route the probe
  1724	        # through `exec_shell` + curl when the backend supports it; otherwise fall back
  1725	        # to the default host probe (e.g. the process backend shares the host network).
  1726	        http_probe = None
  1727	        if sbx is not None and hasattr(sbx, "exec_shell"):
  1728	            import shlex
  1729	
  1730	            async def _in_sandbox_http_probe(
  1731	                url: str, expected_status: int
  1732	            ) -> HttpProbeResult:
  1733	                cmd = (
  1734	                    "curl -s -o /dev/null -w '%{http_code}' --max-time 10 "
  1735	                    + shlex.quote(url)
  1736	                )
  1737	                try:
  1738	                    res = await sbx.exec_shell(cmd, timeout_s=15)
  1739	                except Exception as exc:  # noqa: BLE001 — a probe failure is "not probed", never a crash
  1740	                    return HttpProbeResult(
  1741	                        status_code=None,
  1742	                        error_message=f"sandbox http probe failed: {exc}",
  1743	                    )
  1744	                out = (res.stdout or "").strip()
  1745	                if not out.isdigit() or out == "000":
  1746	                    return HttpProbeResult(
  1747	                        status_code=None,
  1748	                        error_message=(
  1749	                            f"sandbox curl produced no HTTP status "
  1750	                            f"(got {out!r}, exit {res.exit_code})"
  1751	                        ),
  1752	                    )
  1753	                return HttpProbeResult(status_code=int(out))
  1754	
  1755	            http_probe = _in_sandbox_http_probe
  1756	
  1757	        return DoDEvaluator(Path(workspace), http_probe=http_probe)
  1758	
  1759	    async def resolve_verify_command(self, args: dict) -> str:
  1760	        verify_cmd = str(args.get("verify") or "").strip()
  1761	        # E4: a `static` directive verifies a static page WITHOUT a server
  1762	        # (files present + HTML parses) — the honest check for a page build.
  1763	        if verify_cmd == _STATIC_VERIFY_PREFIX or verify_cmd.startswith(
  1764	            _STATIC_VERIFY_PREFIX + ":"
  1765	        ):
  1766	            _, _, _path = verify_cmd.partition(":")
  1767	            verify_cmd = _static_verify_command(_path)
  1768	        # app / app:<url> — verify the RUNNING deliverable actually serves
  1769	        # (HTTP 200 + non-trivial body), not just that a file exists.
  1770	        elif verify_cmd == _APP_VERIFY_PREFIX or verify_cmd.startswith(
  1771	            _APP_VERIFY_PREFIX + ":"
  1772	        ):
  1773	            _, _, _url = verify_cmd.partition(":")
  1774	            _url = _url.strip()
  1775	            if not _url:
  1776	                # Bare `verify="app"` (no explicit URL). The platform assigns the preview
  1777	                # port — there is NO fixed :8000 inside the sandbox (a curl there 404s),
  1778	                # so resolve the URL the live deliverable ACTUALLY serves on (the same
  1779	                # backend-aware detection the verify_web_app gate uses). If no live preview
  1780	                # can be located, degrade to the server-free static check rather than
  1781	                # asserting :8000 — a 404 on a guessed port is a FALSE failure that would
  1782	                # spin the model into re-serve/re-verify loops.
  1783	                _url = await self._detect_preview_url() or ""
  1784	                if not _url:
  1785	                    return _static_verify_command("index.html")
  1786	            verify_cmd = _app_verify_command(_url)
  1787	        return verify_cmd
