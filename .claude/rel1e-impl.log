  2059	        if verdict.get("passed"):
  2060	            self._loop._browser_verify_refusals = 0  # clean pass → reset the streak
  2061	            if _vision_mode():
  2062	                shot = str(verdict.get("screenshot_path") or "")
  2063	                if shot:
  2064	                    await self._loop._emit(
  2065	                        StatusEvent(
  2066	                            status=ConversationStatus.RUNNING,
  2067	                            detail=f"vision_artifact:{shot}",
