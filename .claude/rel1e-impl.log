+        }
+
+    @staticmethod
+    def _verdict_first_failure(verdict: dict) -> str:
+        errs = verdict.get("console_errors") or []
+        nets = verdict.get("network_failures") or []
+        if errs:
+            e0 = errs[0]
+            if isinstance(e0, dict):
+                where = f" @ {e0.get('source')}" if e0.get("source") else ""
