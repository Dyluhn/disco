    monkeypatch.delenv("PMX_ARTIFACT_MANIFEST_SHADOW", raising=False)
    assert manifest_shadow_enabled() is False
    monkeypatch.setenv("DISCO_ARTIFACT_MANIFEST_SHADOW", "1")
    assert manifest_shadow_enabled() is True
