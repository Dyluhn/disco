     1	"""Evidence lock (guidelines §5, §6).
     2	
     3	Every run writes an immutable `manifest.json` carrying run metadata + SHA256 hashes
     4	of the durable evidence files. After classification the run folder is FROZEN: if any
     5	hashed evidence changes, the run becomes INVALID_RUN (the repair loop may copy a
     6	frozen folder but never mutate it).
     7	
     8	This module is pure plumbing — hashing, manifest build/load, and a tamper check —
     9	with no product dependency.
    10	"""
    11	
    12	from __future__ import annotations
    13	
    14	import hashlib
    15	import json
    16	from dataclasses import dataclass, field
    17	from pathlib import Path
    18	from typing import Any
    19	
    20	MANIFEST_NAME = "manifest.json"
    21	
    22	
    23	def sha256_bytes(data: bytes) -> str:
    24	    return "sha256:" + hashlib.sha256(data).hexdigest()
    25	
    26	
    27	def sha256_text(text: str) -> str:
    28	    return sha256_bytes(text.encode("utf-8"))
    29	
    30	
    31	def sha256_file(path: str | Path) -> str:
    32	    p = Path(path)
    33	    h = hashlib.sha256()
    34	    with p.open("rb") as fh:
    35	        for chunk in iter(lambda: fh.read(65536), b""):
    36	            h.update(chunk)
    37	    return "sha256:" + h.hexdigest()
    38	
    39	
