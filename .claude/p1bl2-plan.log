# Build Soak — bare-Build scenario matrix (guidelines §14, §15).
#
# Machine-readable §14 specs. Each scenario carries:
#   * runner directives  — how the runner drives the live API (prompt, model,
#     autonomous, followups + their trigger points).
#   * assertions         — the predicates the deterministic oracle consumes
#     (event_chain / planning / revisions / workspace / preview / terminal).
#
# The runner ACTS AS THE USER: it approves the plan for interactive scenarios and
# sends each follow-up at its trigger point; an autonomous scenario sets
# autonomous: true and never approves.
#
# Optional `clarification_answer` (string, Bug 17): if a build asks a clarifying
# question mid-build (status AWAITING_USER_QUESTION), the runner ANSWERS it as the user
# so the build proceeds instead of false-stalling into NO_PLAN. A scenario MAY supply
# this exact answer; when omitted the runner sends a generic safe default that instructs
# the model to use sensible defaults and not ask further questions. Bounded by
# _MAX_CLARIFY so an endlessly-asking model is eventually let go to a real terminal.
#
# NOTE on §11.7 (WRITE_TOOL_ALLOWED_IN_PLANNING — a disallowed tool that stays
# *callable* even when hidden): proving it needs the per-turn offered/allowed tool
# scope, which the durable event log does NOT carry. Capturing it is a future
# loop-instrumentation slice, so these scenarios do NOT assert `tool_scope`
# (which would fail-closed to INVALID_RUN without that evidence). The
# event-adjudicable plan-discipline invariant — WRITE_TOOL_ATTEMPTED_IN_PLANNING
# (a mutating action before approval) — is still enforced from the event log.

scenarios:
  # ---- §15.1 Smoke ---------------------------------------------------------
  - id: static_html_minimal
    mode: api
    prompt: "Create an index.html with the heading 'Build Smoke OK', serve it, and finish."
    assertions:
      event_chain:
        require_user_event: true
        require_plan_before_execution: true
        require_action_observation_pairs: true
      workspace:
        files:
          - path: "index.html"
            must_contain: ["Build Smoke OK"]
      preview:
        required: true
        must_contain: ["Build Smoke OK"]
      terminal_status_in: ["FINISHED", "VERIFIED"]

  # ---- §15.2 Plan discipline ----------------------------------------------
  - id: must_plan_before_tool
    mode: api
    prompt: "Create a simple landing page for a local bakery."
    assertions:
      event_chain:
        require_user_event: true
        require_plan_before_execution: true
        require_action_observation_pairs: true
      # Documentary (no oracle gates on it): the first meaningful agent tool must be
      # a planning-safe one and no write may precede plan approval. The latter is
      # enforced from events by ToolScopeOracle (WRITE_TOOL_ATTEMPTED_IN_PLANNING).
      planning:
        first_agent_tool_in:
          ["submit_plan", "ask_user", "clarify", "think", "file_read", "file_list", "search", "extract"]
        forbid_write_before_plan_approval: true
      workspace:
        files:
          - path: "index.html"
            must_contain: ["bakery"]
      terminal_status_in: ["FINISHED", "VERIFIED"]

  # ---- §15.3 Revision (2 follow-ups, each requires a new plan revision) -----
  - id: revise_after_finish
    mode: api
    prompt: "Create an index.html with a blue hero and the heading 'Launch Day'."
    followups:
      - text: "Revise the hero heading to 'Grand Opening' and add a pricing section."
        requires_plan_revision: true
        trigger: after_terminal
      - text: "Now change the pricing section to three tiers and update the CTA to 'Book a Visit'."
        requires_plan_revision: true
        trigger: after_terminal
    assertions:
      event_chain:
        require_user_event: true
        require_plan_before_execution: true
        require_action_observation_pairs: true
      revisions:
        initial_plan_revision: 1
        expected_final_plan_revision: 3
        forbid_write_before_revision_approval: true
      workspace:
        files:
          - path: "index.html"
            must_contain: ["Grand Opening", "Book a Visit"]
      terminal_status_in: ["FINISHED", "VERIFIED"]

  # ---- §15.4 Mid-run steering (follow-up injected after the first file write) -
  - id: steer_while_running_requires_plan_update_or_clear_execution_note
    mode: api
    prompt: "Create a two-page static site with Home and About pages."
    followups:
      - text: "Also add a Contact page and update nav links."
        requires_plan_revision: true
        trigger: after_first_file_write
    assertions:
      event_chain:
        require_user_event: true
        require_plan_before_execution: true
        require_action_observation_pairs: true
      revisions:
        initial_plan_revision: 1
        expected_final_plan_revision: 2
        require_acknowledged_followup: true
        forbid_write_before_revision_approval: true
      workspace:
        files:
          - path: "index.html"
            must_contain: ["Contact"]
      terminal_status_in: ["FINISHED", "VERIFIED"]

  # ---- §3/§28 diversity: multi-file static delivery ------------------------
  # Exercises multi-file delivery: three files that must ALL be present with their own
  # unique marker plus a SHARED css class linking them — a richer output-truth check than
  # the single-file smoke. Every marker is dictated verbatim by the prompt so a competent
  # model satisfies it and the deterministic OutputTruthOracle can verify it.
  - id: multifile_static_site
    mode: api
    prompt: >-
      Create a small multi-page static website with three files: index.html (the Home
      page), about.html (the About page), and a shared style.css. Give index.html an
      <h1> heading exactly 'Welcome Home' and about.html an <h1> heading exactly
      'About Us'. Both pages must include a navigation bar using the CSS class
      'site-nav' (defined in style.css) with links between the pages — the Home page
      links to about.html and the About page links back to index.html. Serve the site
      and finish.
    assertions:
      event_chain:
        require_user_event: true
        require_plan_before_execution: true
        require_action_observation_pairs: true
      workspace:
        files:
          - path: "index.html"
            must_contain: ["Welcome Home", "site-nav", "about.html"]
          - path: "about.html"
            must_contain: ["About Us", "site-nav", "index.html"]
          - path: "style.css"
            must_contain: [".site-nav"]
      preview:
        required: true
        must_contain: ["Welcome Home"]
      terminal_status_in: ["FINISHED", "VERIFIED"]

  # ---- §3 complex revisions (2 sequential change follow-ups) ----------------
  # A stepping stone toward §3's "complex revisions >= 3 follow-ups": this is TWO
  # sequential change follow-ups, each requiring a FRESH revised plan (rev increments
  # 1 -> 2 -> 3) before any write (the §11.4 chain, enforced by RevisionOracle). The
  # final workspace must carry the CUMULATIVE result of both revisions. A 3-followup
  # variant can extend this later.
  - id: revise_twice_complex
    mode: api
    prompt: "Create an index.html landing page for a SaaS product with a hero section and the heading 'Acme Cloud'."
    followups:
      - text: "Add a pricing section with three tiers labeled 'Starter', 'Pro', and 'Enterprise'."
        requires_plan_revision: true
        trigger: after_terminal
      - text: "Now change every call-to-action button to say 'Get Started'."
        requires_plan_revision: true
        trigger: after_terminal
    assertions:
      event_chain:
        require_user_event: true
        require_plan_before_execution: true
        require_action_observation_pairs: true
      revisions:
        initial_plan_revision: 1
        expected_final_plan_revision: 3
        forbid_write_before_revision_approval: true
      workspace:
        files:
          - path: "index.html"
            must_contain: ["Acme Cloud", "Starter", "Pro", "Enterprise", "Get Started"]
      terminal_status_in: ["FINISHED", "VERIFIED"]

  # ---- §28 richer build->verify->finish (achievable, single-pass) -----------
  # Exercises the build -> serve -> verify -> finish loop on a RICHER deliverable (a form
  # with multiple required elements) than the smoke. Kept ACHIEVABLE on purpose: a clean
  # single pass with deterministic markers, NOT a forced failure. Markers are quote-style
  # agnostic (substrings the model will emit regardless of single/double quotes) so it is
  # not flaky.
  #
  # NOTE: a TRUE broken-then-fixed fault-injection scenario (force a verify failure, then
  # assert the loop repairs + re-verifies before finishing) needs RUNNER SUPPORT to inject
  # a verify failure into the live build — there is no such hook yet. That variant is
  # DEFERRED; this scenario proves the honest verify->finish path on a non-trivial page.
  - id: verify_catches_broken_then_fixed
    mode: api
    prompt: >-
      Create an index.html contact page with an <h1> heading exactly 'Contact Us' and an
      HTML <form> containing a text input for the visitor's name, an email input, and a
      submit button labeled 'Send'. Serve the page and verify it loads in a browser before
      finishing.
    assertions:
      event_chain:
        require_user_event: true
        require_plan_before_execution: true
        require_action_observation_pairs: true
      workspace:
        files:
          - path: "index.html"
            must_contain: ["Contact Us", "<form", "name", "email", "Send"]
      preview:
        required: true
        must_contain: ["Contact Us"]
      terminal_status_in: ["FINISHED", "VERIFIED"]

  # ---- DIAGNOSTIC: predict-before-acting tool-clarity probe -----------------
  # Antipattern-mining scenario. The agent narrates a PREDICT line before every tool
  # call and an OBSERVED match/mismatch line after — surfacing exactly where OUR tool
  # surface violates a competent agent's expectations (the "what are we doing wrong /
  # what's hard for agents" signal). The build task itself is the trivial smoke so the
  # tool surface (file_write / preview_start / verify / shell) is exercised cleanly; the
  # VALUE is the captured PREDICT/OBSERVED trace, judged offline by a frontier model.
  - id: diag_predict_reflect_smoke
    mode: api
    prompt: >-
      DIAGNOSTIC PROTOCOL — you MUST follow this for EVERY tool call, in addition to doing
      the task. For each tool call:
      (1) BEFORE calling the tool, output ONE short line starting with "PREDICT:" stating
      the concrete result you expect that specific tool call to return or do.
      (2) AFTER you see the tool's result, output ONE short line starting with "OBSERVED:"
      — write "OBSERVED: match" if the result matched your prediction, or
      "OBSERVED: mismatch — <one phrase on what about THE TOOL'S behavior was different from
      what you expected>". Focus on the tool's behavior (ports, URLs, output shape, errors,
      state), NOT on your own mistakes. Keep each line to one sentence. Do this start to finish.

      TASK: Create an index.html whose <h1> heading is exactly 'Build Smoke OK', serve it so
      it is viewable in a live preview, then finish.
    assertions:
      event_chain:
        require_user_event: true
        require_plan_before_execution: true
        require_action_observation_pairs: true
      workspace:
        files:
          - path: "index.html"
            must_contain: ["Build Smoke OK"]
      terminal_status_in: ["FINISHED", "VERIFIED"]

  # ---- DIAGNOSTIC BATCH (exhaustive antipattern mining) ---------------------
  # Diverse tasks, each stressing a DIFFERENT part of the tool surface, all carrying the
  # predict-before-acting protocol. Distinct task text => distinct transcript files even
  # when run concurrently. The frontier judge mines all transcripts for tool antipatterns.
  #
  # diag B: multi-file site — file_write x3 + shared asset + preview.
  - id: diag_multifile
    mode: api
    prompt: >-
      DIAGNOSTIC PROTOCOL — for EVERY tool call, FIRST output one line "PREDICT: <what you
      expect this tool call to return/do>", and AFTER the result one line "OBSERVED: match"
      or "OBSERVED: mismatch — <what about THE TOOL'S behavior surprised you>" (focus on the
      tool: ports, URLs, output shape, errors, state — not your own mistakes). One sentence each.

