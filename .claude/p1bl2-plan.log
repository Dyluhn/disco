    "assertions": {
        "provider": {"require_host_substr": "minimax", "model": "MiniMax-M3"},
    },
}


def _run(ledger, scenario=_PROV):
    return ProviderLedgerOracle().check([], scenario=scenario, provider_ledger=ledger)


