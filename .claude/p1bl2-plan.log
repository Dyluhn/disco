   110	def compute_evidence_hashes(folder: str | Path, files: dict[str, str]) -> dict[str, str]:
   111	    """Hash each named evidence file (relative to `folder`). `files` maps a label
   112	    (e.g. "events.jsonl") to a folder-relative path. A missing file hashes to the
   113	    sentinel "MISSING" so the manifest still records its absence (which the tamper
   114	    check and harness-validity oracle both treat as evidence-incomplete)."""
   115	    base = Path(folder)
   116	    out: dict[str, str] = {}
   117	    for label, rel in files.items():
   118	        p = base / rel
   119	        out[label] = sha256_file(p) if p.is_file() else "MISSING"
   120	    return out
   121	
   122	
   123	def write_manifest(folder: str | Path, manifest: EvidenceManifest) -> Path:
   124	    base = Path(folder)
   125	    base.mkdir(parents=True, exist_ok=True)
   126	    path = base / MANIFEST_NAME
   127	    path.write_text(json.dumps(manifest.to_dict(), indent=2, sort_keys=True), encoding="utf-8")
   128	    return path
   129	
   130	
   131	def load_manifest(folder: str | Path) -> EvidenceManifest:
   132	    base = Path(folder)
   133	    raw = json.loads((base / MANIFEST_NAME).read_text(encoding="utf-8"))
   134	    return EvidenceManifest.from_dict(raw)
