diff --git a/packages/core/src/disco/core/loop/boundaries.py b/packages/core/src/disco/core/loop/boundaries.py
index 802cb96b24d9a5d20ba0535df84a11a134c9f0d6..a22fbe2000b5cece332ab822cdb6c492fc60ec0f
