+            "verdict": "unavailable",
+            "url": deliverable.deployment_url,
+            "http_status": 0,
+            "summary": detail,
+            "next_action": "",
+            "console_errors": [],
+            "network_failures": [],
+            "failure_fingerprint": "host_verifier_unavailable",
