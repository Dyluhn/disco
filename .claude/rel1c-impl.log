            target_url_port,
        )

        from ..sandbox.port_owner import port_owners

        port = target_url_port(url)
        if port is None:
            return False  # no explicit port → cannot confirm it is a served preview
        ports = sorted(set(_PREVIEW_PORTS) | {port})
        try:

