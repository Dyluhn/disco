+@pytest.mark.asyncio
+async def test_host_verify_canary_on_default_build_updates_phase_and_manifest(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    monkeypatch.setenv("DISCO_HOST_VERIFY_CANARY", "1")
