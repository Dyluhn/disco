    70	    @model_validator(mode="after")
    71	    def _unique_section_ids(self) -> AppSpec:
    72	        ids = [s.id for s in self.sections]
    73	        if len(ids) != len(set(ids)):
    74	            dupes = sorted({i for i in ids if ids.count(i) > 1})
