   194	_PUNCT_RUN = re.compile(r"[^a-z0-9]+")
   195	
   196	
   197	def normalize_screen_label(label: str) -> str:
   198	    """Deterministic, idempotent slug: casefold, collapse any run of non-alphanumerics
   199	    to a single '-', trim. ``normalize(normalize(x)) == normalize(x)``."""
   200	    return _PUNCT_RUN.sub("-", label.casefold()).strip("-")
