    22	def _safe_rel(path: str) -> str:
    23	    """A starter writes only NORMALIZED, workspace-relative paths — never absolute and
    24	    never escaping the workspace (no ``..``). Rejects traversal at scaffold time."""
    25	    p = PurePosixPath(path)
    26	    if p.is_absolute() or ".." in p.parts or not p.parts:
    27	        raise ValueError(f"unsafe starter path: {path!r}")
    28	    return str(p)
