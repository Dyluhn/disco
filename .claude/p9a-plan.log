   203	# ---------------------------------------------------------------- ordinal parsing
   204	
   205	_ORDINAL_WORDS: dict[str, int] = {
   206	    w: i + 1
   207	    for i, w in enumerate(
   208	        ["first", "second", "third", "fourth", "fifth", "sixth", "seventh", "eighth", "ninth", "tenth"]
   209	    )
   210	}
   211	_DIGIT_ORDINAL = re.compile(r"\b(\d+)(?:st|nd|rd|th)?\b")
   212	# a zero ordinal on the normalized string ("0", "0th"); a NEGATIVE on the RAW string (a
   213	# minus at start/after-space before a digit — NOT a normalization hyphen-separator).
   214	_ZERO_ORDINAL = re.compile(r"\b0+(?:st|nd|rd|th)?\b")
   215	# a NEGATIVE = a minus directly before a digit whose left neighbour is NOT alphanumeric —
   216	# i.e. start, whitespace, or punctuation (catches "-1", " -1", "slide:-1"). A minus between
   217	# two word chars ("slide-5", a normalization separator) is NOT a negative.
   218	_NEG_ORDINAL = re.compile(r"(?:^|[^a-z0-9])-\s*\d", re.IGNORECASE)
   219	
   220	
   221	class _Ordinal(BaseModel):
   222	    """The outcome of looking for a human ordinal in a phrase."""
   223	
   224	    model_config = ConfigDict(frozen=True)
   225	    value: int | None = None  # 1-based ordinal found, or None if none present
   226	    invalid: bool = False  # an explicit but invalid ordinal (0th / negative)
   227	
   228	
   229	def parse_human_ordinal(phrase: str) -> _Ordinal:
   230	    """Find a 1-based human ordinal in ``phrase``. Ordinal WORDS (first..tenth) and DIGITS
   231	    (5 / 5th) both count. An explicit 0 / 0th / zeroth / negative is INVALID (not absent)."""
   232	    if _NEG_ORDINAL.search(phrase):
   233	        return _Ordinal(invalid=True)
   234	    norm = normalize_screen_label(phrase)
   235	    if _ZERO_ORDINAL.search(norm) or "zeroth" in norm:
   236	        return _Ordinal(invalid=True)
   237	    for word, n in _ORDINAL_WORDS.items():
   238	        if re.search(rf"\b{word}\b", norm):
   239	            return _Ordinal(value=n)
   240	    m = _DIGIT_ORDINAL.search(norm)
   241	    if m:
   242	        n = int(m.group(1))
   243	        return _Ordinal(value=n) if n >= 1 else _Ordinal(invalid=True)
   244	    return _Ordinal()
   245	
   246	
   247	def human_ordinal_to_index(ordinal: int) -> int:
   248	    """1-based human ordinal → 0-based array index. Rejects < 1."""
   249	    if ordinal < 1:
   250	        raise ValueError(f"ordinal must be >= 1, got {ordinal}")
   251	    return ordinal - 1
   252	
   253	
   254	# ---------------------------------------------------------------- the resolver
   255	
   256	
   257	def _tokens(norm: str) -> set[str]:
   258	    return set(norm.split("-")) - {""}
