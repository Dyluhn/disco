    24	
    25	class SemanticTargetKind(str, Enum):
    26	    FIELD = "field"  # a field of a section (hero.headline)
    27	    SECTION = "section"  # a whole section
    28	    INDEXED = "indexed"  # the Nth item of a collection (services.cards[1])
    29	    SLIDE = "slide"  # the Nth slide of a deck
    30	    COMMENT_ANCHOR = "comment_anchor"  # a stable comment anchor
    31	
    32	
    33	class ResolutionReason(str, Enum):
    34	    RESOLVED = "resolved"
    35	    AMBIGUOUS = "ambiguous"  # >1 candidate — surfaced, never guessed
    36	    NO_MATCH = "no_match"
    37	    INVALID_ORDINAL = "invalid_ordinal"  # "0th" / negative / non-ordinal
    38	    OUT_OF_RANGE = "out_of_range"  # ordinal beyond the collection/deck length
