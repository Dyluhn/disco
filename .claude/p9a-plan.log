   155	
   156	class ReferenceResolution(BaseModel):
   157	    model_config = ConfigDict(frozen=True)
   158	    resolved: SemanticTarget | None = None
   159	    ambiguous: bool = False
   160	    reason: ResolutionReason = ResolutionReason.NO_MATCH
   161	    candidates: tuple[str, ...] = ()
   162	
   163	    @model_validator(mode="after")
   164	    def _invariants(self) -> ReferenceResolution:
   165	        # Full biconditional, one branch per reason — no slack states.
   166	        if self.reason is ResolutionReason.RESOLVED:
   167	            if self.resolved is None or self.ambiguous or self.candidates:
   168	                raise ValueError("RESOLVED: exactly one target, not ambiguous, no candidates")
   169	        elif self.reason is ResolutionReason.AMBIGUOUS:
   170	            if self.resolved is not None or not self.ambiguous or not self.candidates:
   171	                raise ValueError("AMBIGUOUS: no target, ambiguous=True, non-empty candidates")
   172	        else:  # NO_MATCH / INVALID_ORDINAL / OUT_OF_RANGE
   173	            if self.resolved is not None or self.ambiguous or self.candidates:
   174	                raise ValueError(f"{self.reason.value}: no target, not ambiguous, no candidates")
   175	        return self
