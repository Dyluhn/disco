+            call_id="call-write",
+            tool_name="file_write",
+            success=True,
+            content="wrote 12 bytes",
+            structured={
+                "path": path,
+                "sha256": "f" * 64,
+            },
+        ),
+        action_id="action-write",
+    )
+
+
+def test_artifact_projection_picks_up_file_write_structured_path() -> None:
+    assert artifact_paths_from_events([_file_write_obs("./site/index.html")]) == {
