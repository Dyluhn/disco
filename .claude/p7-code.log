     1	"""Contract scope ENFORCEMENT at the tool-dispatch boundary (CONTRACT-ENFORCE).
     2	
     3	CONTRACT-3 compiled a contract into per-phase hard allowlists; this is the piece that
     4	DENIES an out-of-scope tool call before it executes. The executor (the universal tool
     5	chokepoint) holds an optional ``ContractScopeGuard``; when a build run is governed by a
     6	contract, the guard rejects a call whose tool is not permitted in the current phase —
     7	so e.g. an ``appkit.leadgen`` run cannot ``file_write`` during the EDIT phase (it must
     8	use the semantic app_* tools); raw rewrite is reachable only in REPAIR.
     9	
    10	Governed surface: a tool is enforced if the contract scopes it to SOME phase (a build
    11	tool the contract knows) OR it is a known escape-hatch mutator (file_write/shell/…).
    12	Everything else — think, preview_*, read-only utilities, the finalizer — is ungoverned
    13	and always passes, so enforcement constrains the BUILD surface without breaking the
    14	universal tools. Pure decision logic + a thin guard; no runtime imports.
    15	"""
    16	
    17	from __future__ import annotations
    18	
    19	from collections.abc import Callable
    20	
    21	from pydantic import BaseModel, ConfigDict
    22	
    23	from .models import BuildContract
    24	from .scopes import ContractToolScopes, Phase, compile_tool_scopes
    25	
    26	# Fallback escape-hatch mutators, used ONLY when a caller can't supply tool metadata
    27	# (pure unit tests). The real dispatch path passes ``is_mutating`` derived from the
    28	# tool's read_only flag, so enforcement does NOT depend on this list staying in sync
    29	# with the registry (no bypass via an unlisted writer/exec like file_append/shell_exec).
    30	DANGEROUS_TOOLS: frozenset[str] = frozenset(
    31	    {"file_write", "file_edit", "file_replace_lines", "file_delete", "file_append",
    32	     "file_str_replace", "shell", "shell_exec", "code_exec", "bash", "exec"}
    33	)
    34	
    35	
    36	class ScopeDecision(BaseModel):
    37	    """The allow/deny outcome for one tool call under a contract + phase."""
    38	
    39	    model_config = ConfigDict(frozen=True)
    40	
    41	    allowed: bool
    42	    reason: str = ""
    43	
    44	
    45	def _governed(tool: str, scopes: ContractToolScopes, is_mutating: bool | None) -> bool:
    46	    """Is this tool subject to contract enforcement at all?
    47	
    48	    Governed = a MUTATING tool (derived from the registry's read_only flag at the
    49	    dispatch boundary — so a writer/exec is gated whatever its name), OR a build tool
    50	    the contract scopes to bootstrap/edit/repair/export. When ``is_mutating`` is None
    51	    (a caller with no tool metadata, e.g. a pure unit test) it falls back to the
    52	    best-effort DANGEROUS_TOOLS name list. The verify finalizer is deliberately
    53	    EXCLUDED: it is a control signal ('I think this is ready') that requests the phase
    54	    transition, so it must remain callable from any phase — blocking it strands the run.
    55	    """
    56	    mutating = is_mutating if is_mutating is not None else (tool in DANGEROUS_TOOLS)
    57	    if mutating:
    58	        return True
    59	    return tool in (scopes.bootstrap | scopes.edit | scopes.repair | scopes.export)
    60	
    61	
    62	def decide_tool_in_scope(
    63	    scopes: ContractToolScopes, phase: Phase, tool: str, *, is_mutating: bool | None = None
    64	) -> ScopeDecision:
    65	    """Allow/deny ``tool`` in ``phase`` under compiled ``scopes`` (HARD allowlist).
    66	
    67	    - permitted in this phase → allow
    68	    - governed (a mutating tool, or one scoped to another phase) but NOT in this phase → DENY
    69	    - ungoverned read-only utility (think / preview / read / finalizer) → allow
    70	
    71	    ``is_mutating`` should be passed by the dispatch boundary (``not read_only``) so
    72	    enforcement is metadata-driven, not dependent on a hand-maintained name list.
    73	    """
    74	    if scopes.allowed(phase, tool):
    75	        return ScopeDecision(allowed=True)
    76	    if _governed(tool, scopes, is_mutating):
    77	        permitted = ", ".join(sorted(scopes.for_phase(phase))) or "(none)"
    78	        mutating = is_mutating if is_mutating is not None else (tool in DANGEROUS_TOOLS)
    79	        hint = (
    80	            "Use the contract's semantic edit tools — raw file rewrite is reachable "
    81	            "only in the repair phase."
    82	            if mutating
    83	            else "This tool belongs to a different build phase."
    84	        )
    85	        return ScopeDecision(
    86	            allowed=False,
    87	            reason=(
    88	                f"out of contract scope: tool {tool!r} is not permitted in the "
    89	                f"{phase.value} phase of this contract; permitted here: {permitted}. " + hint
    90	            ),
    91	        )
    92	    return ScopeDecision(allowed=True)
    93	
    94	
    95	class ContractScopeGuard:
    96	    """The executor-side guard: holds the compiled scopes + a live phase provider, and
    97	    checks a tool name against the current phase. Constructed by whoever runs a build
    98	    under a contract; when absent, the executor enforces nothing (a plain agent run)."""
    99	
   100	    def __init__(self, scopes: ContractToolScopes, phase_provider: Callable[[], Phase]) -> None:
   101	        self._scopes = scopes
   102	        self._phase = phase_provider
   103	
   104	    @classmethod
   105	    def for_contract(
   106	        cls, contract: BuildContract, phase_provider: Callable[[], Phase]
   107	    ) -> ContractScopeGuard:
   108	        return cls(compile_tool_scopes(contract), phase_provider)
   109	
   110	    def check(self, tool_name: str, *, is_mutating: bool | None = None) -> ScopeDecision:
   111	        return decide_tool_in_scope(
   112	            self._scopes, self._phase(), tool_name, is_mutating=is_mutating
   113	        )

