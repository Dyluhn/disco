   157	def _nested_shape_hint(field_name: str, model: type[BaseModel], is_list: bool) -> str:
   158	    """A concise, copyable hint: the expected nested shape + ONE concrete example —
   159	    so a model that mis-formats an array-of-objects (e.g. `steps: ["", "", ""]`)
   160	    can see exactly what to send instead. Never the full JSON schema (kept small)."""
   161	    shape = _model_shape(model)
   162	    if is_list:
   163	        example = json.dumps([_model_example_item(model, 0), _model_example_item(model, 1)])
   164	        return (
   165	            f"The {field_name!r} argument must be a list of objects, each shaped "
   166	            f"{shape}. Example: {field_name}={example}."
   167	        )
   168	    example = json.dumps(_model_example_item(model, 0))
   169	    return (
   170	        f"The {field_name!r} argument must be an object shaped {shape}. "
   171	        f"Example: {field_name}={example}."
   172	    )
