    70	</main>
    71	</body>
    72	</html>
    73	"""
    74	
    75	
    76	def _app_shell(title: str) -> dict[str, str]:
    77	    return {"index.html": _APP_SHELL_HTML.format(title=html.escape(title, quote=True))}
    78	
    79	
    80	def _lead_form(title: str) -> dict[str, str]:
    81	    return _appspec_files(lead_form_appspec(title))
    82	
    83	
    84	class StarterKit:
    85	    """A named host-owned scaffold: ``scaffold(title)`` → {rel_path: text} (path-safe)."""
    86	
    87	    def __init__(self, kit_id: str, builder: Callable[[str], dict[str, str]]) -> None:
    88	        self.id = kit_id
    89	        self._builder = builder
    90	
    91	    def scaffold(self, title: str) -> dict[str, str]:
    92	        return {_safe_rel(k): v for k, v in self._builder(title).items()}
    93	
    94	
    95	class StarterKitRegistry:
    96	    """Resolves a contract's ``starter_kit`` name to a host-owned StarterKit."""
    97	
