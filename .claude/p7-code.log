   175	def describe_validation_failure(
   176	    tool_name: str,
   177	    args_model: type[BaseModel],
   178	    arguments: dict[str, Any],
   179	    errors: list[dict[str, Any]],
   180	) -> str:
   181	    """Build a SELF-CORRECTING, model-facing validation error.
   182	
   183	    The model only sees a failed ToolResult's `error`/`content` string (the
   184	    structured `validation_errors`/`expected_schema` are not surfaced into the
   185	    agent's message stream), so the actionable detail MUST live in this string.
   186	    It names the unexpected key(s) the caller invented (e.g. `cmd`) AND the
   187	    expected/required field(s) it should have used (e.g. `command`), pulled
   188	    generically from the pydantic model — so EVERY tool benefits, not just shell.
   189	
   190	    Deterministic for identical arguments (so byte-identical repeated bad calls
   191	    still trip the loop's stuck detector as before).
   192	    """
   193	    valid_keys = _valid_arg_keys(args_model)
   194	    unknown = sorted(k for k in arguments if k not in valid_keys)
   195	
   196	    reasons: list[str] = []
   197	    if unknown:
   198	        reasons.append(
   199	            f"unexpected argument(s) {unknown} — not accepted by this tool"
   200	        )
   201	    for err in errors:
   202	        loc = ".".join(str(p) for p in err.get("loc", ())) or "(root)"
   203	        etype = err.get("type", "")
   204	        if etype == "missing":
   205	            reasons.append(f"missing required argument {loc!r}")
   206	        elif etype in {"extra_forbidden", "unexpected_keyword_argument"}:
   207	            # already covered by `unknown` above; skip to avoid duplication
   208	            continue
   209	        else:
   210	            reasons.append(f"argument {loc!r}: {err.get('msg', etype)}")
   211	    if not reasons:
   212	        reasons.append("arguments did not match the tool's schema")
   213	
   214	    msg = (
   215	        f"arguments for {tool_name!r} failed validation: "
   216	        + "; ".join(reasons)
   217	        + f". Expected arguments: {_arg_surface(args_model)}."
   218	    )
   219	    if unknown:
   220	        # spell out the likely fix so a weaker model can self-correct next turn
   221	        required_names = [
   222	            n for n, fi in args_model.model_fields.items() if fi.is_required()
   223	        ]
   224	        if required_names:
   225	            msg += (
   226	                f" Re-call {tool_name!r} using the correct key(s) "
   227	                f"{required_names} instead of {unknown}."
   228	            )
   229	    # Nested-shape hints (GENERIC, all tools): when an error points at a field
   230	    # whose value is a model — or a list of models — but the model sent the wrong
   231	    # shape (e.g. `steps: ["", "", ""]` where each item must be an object), append
   232	    # the EXPECTED nested shape + one concrete example so the call is recoverable.
   233	    # Skip "missing"/unknown-key errors (already explained above) and dedupe by
   234	    # field so three bad list items don't repeat the same hint thrice. Deterministic.
   235	    seen_fields: set[str] = set()
   236	    for err in errors:
   237	        loc = err.get("loc", ())
   238	        if not loc:
   239	            continue
   240	        top = loc[0]
   241	        etype = err.get("type", "")
   242	        if (
   243	            not isinstance(top, str)
   244	            or top in seen_fields
   245	            or etype in {"missing", "extra_forbidden", "unexpected_keyword_argument"}
   246	        ):
   247	            continue
   248	        finfo = args_model.model_fields.get(top)
   249	        if finfo is None:
   250	            continue
   251	        nested = _nested_model(finfo.annotation)
   252	        if nested is None:
   253	            continue
   254	        seen_fields.add(top)
   255	        model, is_list = nested
   256	        msg += " " + _nested_shape_hint(top, model, is_list)
   257	    if arguments:
   258	        msg += f" You provided: {sorted(arguments)}."
   259	    return msg
