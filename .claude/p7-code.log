     1	"""Build-phase state machine (CONTRACT-ACTIVATE).
     2	
     3	CONTRACT-ENFORCE gates tools per phase but needs a live phase signal. This tracker is
     4	that signal: a small, deterministic state machine advanced by OBSERVABLE build events
     5	(a bootstrap tool succeeded, the finalizer was called, a verifier passed/failed). The
     6	executor's ContractScopeGuard reads ``current()`` to decide each call.
     7	
     8	Transitions (conservative — it never wrongly broadens; the worst case keeps the raw
     9	escape-hatch tools denied, never grants them early):
    10	
    11	    BOOTSTRAP --(a bootstrap-scoped tool succeeds)--> EDIT
    12	    *         --(the verify finalizer is called)----> VERIFY
    13	    VERIFY    --(verifier passed)-------------------> EXPORT
    14	    VERIFY    --(verifier failed)-------------------> REPAIR
    15	    REPAIR    --(a repair/edit tool succeeds)-------> REPAIR   (stays until re-finalized)
    16	
    17	Pure; no runtime imports.
    18	"""
    19	
    20	from __future__ import annotations
    21	
    22	from .models import BuildContract
    23	from .scopes import Phase
    24	
    25	
    26	class BuildPhaseTracker:
    27	    """Tracks the current build phase for one run, advanced by observable signals."""
    28	
    29	    def __init__(self, contract: BuildContract) -> None:
    30	        self._bootstrap_tools = frozenset(contract.bootstrap.tools)
    31	        self._finalizer = contract.verify.finalizer
    32	        self._phase = Phase.BOOTSTRAP
    33	
    34	    def current(self) -> Phase:
    35	        return self._phase
    36	
    37	    def note_tool_success(self, tool_name: str) -> None:
    38	        """A tool ran successfully — advance the phase if this is a transition signal."""
    39	        if tool_name == self._finalizer:
    40	            self._phase = Phase.VERIFY
    41	            return
    42	        if self._phase is Phase.BOOTSTRAP and tool_name in self._bootstrap_tools:
    43	            self._phase = Phase.EDIT
    44	
    45	    def note_finalizer_called(self) -> None:
    46	        """The model requested verification (the finalizer fired)."""
    47	        self._phase = Phase.VERIFY
    48	
    49	    def note_verifier_result(self, *, passed: bool) -> None:
    50	        """The host verifier adjudicated: pass → EXPORT, fail → REPAIR (so the model can
    51	        use the repair tools to fix it; without this a failed verify would strand)."""
    52	        self._phase = Phase.EXPORT if passed else Phase.REPAIR

