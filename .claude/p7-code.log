   270	    def __init__(
   271	        self,
   272	        registry: ToolRegistry,
   273	        scope: ToolScope,
   274	        *,
   275	        sandbox: SandboxInstance | None = None,
   276	        broker: CapabilityBroker | None = None,
   277	        owner_id: str = "local",
   278	        conversation_id: str | None = None,
   279	        default_timeout_s: int = 300,
   280	        model_policy: ModelExecutionPolicy = _STANDARD_POLICY,
   281	        driver_llm: tuple[str, str, str | None] | None = None,
   282	        read_char_budget: int | None = None,
   283	        scope_guard: ContractScopeGuard | None = None,
   284	        on_tool_success: Callable[[str], None] | None = None,
   285	        starter_kit: str | None = None,
   286	    ) -> None:
   287	        self._registry = registry
   288	        self._scope = scope
   289	        self._sandbox = sandbox
   290	        # CONTRACT-ENFORCE: optional per-phase contract scope guard. When a Build run
   291	        # is governed by a BuildContract, this denies a tool call that is out of the
   292	        # current phase's allowlist (e.g. file_write during an appkit EDIT phase).
   293	        # None ⇒ a plain agent run ⇒ no contract enforcement (unchanged behavior).
   294	        self._scope_guard = scope_guard
   295	        # CONTRACT-ACTIVATE: notified with the tool name after each SUCCESSFUL call so a
   296	        # build-phase tracker can advance (bootstrap-tool success → edit; finalizer →
   297	        # verify). None ⇒ no tracking. Best-effort: a callback error never fails the call.
   298	        self._on_tool_success = on_tool_success
