     1	"""Tool registry & scoping — tool-sandbox-contract.md §8.
     2	
     3	The available toolset is a registry; surfaces (Research vs Agent) expose
     4	different *scopes* of it (BoD §8). `available_tools()` returns only in-scope
     5	tools, so the model is never shown — and the executor never runs (§4) — a tool
     6	outside the active surface's scope. Scope is the first-line capability boundary;
     7	the sandbox/egress/secrets rules are the hard backstops.
     8	"""
     9	
    10	from __future__ import annotations
    11	
    12	from disco.core.llm import ModelExecutionPolicy
    13	from pydantic import BaseModel, ConfigDict
    14	
    15	from .anatomy import Tool
    16	
    17	
    18	class ToolScope(BaseModel):
    19	    """[CONTRACT] The set of tools a SURFACE exposes (BoD §8).
    20	
    21	    `allowed_tools` is the SECURITY allowlist — the executor only calls tools
    22	    in this set. `advertised_tools` (RP-05c) is the VISIBILITY set — what
    23	    available_tools() returns to the LLM. None means "advertise all allowed"
    24	    (today's behavior). A tool that is allowed but not advertised is still
    25	    callable by qualified name; the planner-safety readonly_tool_names backstop
    26	    always keys off allowed_tools, never the advertised subset.
    27	    """
    28	
    29	    model_config = ConfigDict(frozen=True)
    30	    allowed_tools: frozenset[str]
    31	    advertised_tools: frozenset[str] | None = None  # None = advertise all allowed
    32	    preset: str | None = None  # "research" | "agent" | custom
    33	
    34	
    35	class ToolRegistry:
    36	    """[CONTRACT] The catalogue of all tools. The executor asks it for in-scope
    37	    tools and to resolve a name within a scope. `get()` returns None if the name
    38	    is absent OR out-of-scope — the executor turns that into `unknown_tool`."""
    39	
    40	    def __init__(self) -> None:
    41	        self._tools: dict[str, Tool] = {}
    42	
    43	    def register(self, tool: Tool) -> None:
    44	        self._tools[tool.definition.name] = tool
    45	
    46	    def get(self, name: str, *, scope: ToolScope) -> Tool | None:
    47	        if name not in scope.allowed_tools:
    48	            return None  # out of scope is indistinguishable from absent (§4)
    49	        return self._tools.get(name)
    50	
    51	    def in_scope(self, scope: ToolScope) -> list[Tool]:
    52	        return [t for n, t in self._tools.items() if n in scope.allowed_tools]
    53	
    54	    def names(self) -> frozenset[str]:
    55	        return frozenset(self._tools)
    56	
    57	
    58	# Surface presets (BoD §8). Research excludes world-affecting tools; Agent gets
