   488	
   489	    assets: dict[int, bytes] = {}
   490	    # W-50: image generation is OPTIONAL for a deck. When no real image backend is
   491	    # configured (select_image_backend() raised → caller passed None), DEGRADE to
   492	    # text-only slides — omit images rather than crash. Configure ComfyUI/OpenAI/
   493	    # OpenRouter in Settings → Image generation to include real images.
   494	    if backend is None:
   495	        _LOG.info("no image backend configured — generating image-less (text-only) slides")
   496	        return assets
   497	    for i, slide in enumerate(authored.slides):
   498	        if not slide.image_prompt:
   499	            continue
   500	        img_name = f"{filename_base}_img_{i}.png"
   501	        h = hashlib.sha256(slide.image_prompt.encode("utf-8")).digest()
   502	        seed = int.from_bytes(h[:4], "big", signed=False)
   503	
   504	        try:
