   219	# --- app_snapshot_version -----------------------------------------------------
   220	class AppSnapshotArgs(BaseModel):
   221	    label: str = Field(default="", description="optional version label; defaults to a sequence number")
   222	
   223	
   224	class AppSnapshotVersionTool:
   225	    definition = _def(
   226	        "app_snapshot_version",
   227	        "Snapshot the current AppSpec to .disco/versions/<label>.json for iteration history.",
   228	        AppSnapshotArgs,
   229	    )
   230	
   231	    async def run(self, args: AppSnapshotArgs, ctx: ToolContext) -> ToolOutcome:
   232	        assert ctx.sandbox is not None
   233	        store = AppSpecStore(ctx.sandbox)
   234	        try:
   235	            spec = await store.read()
   236	        except Exception:
   237	            return ToolOutcome(success=False, error="corrupt_appspec", content=f"{_SPEC_PATH} is unreadable")
   238	        if spec is None:
   239	            return ToolOutcome(success=False, error="no_app", content="no app yet — call app_create first")
   240	        # deterministic, content-addressed label (NOT builtin hash() — that is
   241	        # per-process randomized, so it would produce unstable/colliding names).
   242	        digest = hashlib.sha256(spec.model_dump_json().encode("utf-8")).hexdigest()[:12]
   243	        label = args.label.strip() or f"v-{digest}"
   244	        safe = "".join(c if c.isalnum() or c in "-_" else "_" for c in label)
   245	        path = f".disco/versions/{safe}.json"
   246	        await ctx.sandbox.write_file(path, (spec.model_dump_json(indent=2) + "\n").encode("utf-8"))
   247	        return ToolOutcome(success=True, content=f"snapshotted app → {path}", structured={"rel_path": path})
