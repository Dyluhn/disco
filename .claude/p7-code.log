     4	model to "scaffold from the <name> starter". This tool makes that real: it writes the
     5	ACTIVE contract's starter files (from ctx.starter_kit, threaded by the runtime — so it's
     6	active-contract-bound, not a free-for-all) into the workspace, so the model edits a real
     7	frame instead of hand-drawing common chrome. Never clobbers existing work (skips files
     8	that already exist).
     9	"""
    10	
    11	from __future__ import annotations
    12	
    13	from disco.core import SecurityRisk
    14	from disco.core.kits import StarterKitRegistry
    15	from pydantic import BaseModel
    16	
    17	from ..anatomy import Capability, ToolContext, ToolDef, ToolOutcome
    18	
    19	
    20	class ScaffoldStarterArgs(BaseModel):
    21	    title: str
    22	
    23	
    24	class ScaffoldStarterTool:
    25	    definition = ToolDef(
    26	        name="scaffold_starter",
    27	        description=(
    28	            "Scaffold this build's host-owned starter frame into the workspace (the "
    29	            "contract's starter_kit), so you edit a real frame instead of hand-drawing "
    30	            "common chrome. Writes ONLY files that don't already exist — it never "
    31	            "clobbers your work. Pass the artifact title."
    32	        ),
    33	        args_model=ScaffoldStarterArgs,
    34	        needs=frozenset({Capability.FILESYSTEM}),
    35	        base_risk=SecurityRisk.LOW,
    36	        runs_in="sandbox",
    37	        read_only=False,
    38	    )
    39	
    40	    async def run(self, args: ScaffoldStarterArgs, ctx: ToolContext) -> ToolOutcome:
    41	        assert ctx.sandbox is not None
    42	        starter_id = getattr(ctx, "starter_kit", None)
    43	        if not starter_id:
    44	            return ToolOutcome(
    45	                success=False, error="no_starter",
    46	                content="this build has no starter kit (its contract declares no starter_kit) — author the artifact directly.",
    47	            )
    48	        kit = StarterKitRegistry.default().get(starter_id)
    49	        if kit is None:
    50	            return ToolOutcome(success=False, error="unknown_starter", content=f"no starter kit {starter_id!r}")
    51	        try:
    52	            files = kit.scaffold(args.title)
    53	        except ValueError as exc:  # path-safety / build error
    54	            return ToolOutcome(success=False, error="invalid_starter", content=str(exc))
    55	
    56	        written: list[str] = []
    57	        skipped: list[str] = []
    58	        for path, text in files.items():
    59	            if await self._exists(ctx, path):
    60	                skipped.append(path)  # never clobber existing work
    61	                continue
    62	            await ctx.sandbox.write_file(path, text.encode("utf-8"))
    63	            written.append(path)
    64	        msg = f"scaffolded '{starter_id}' starter — wrote {written or '(nothing new)'}"
    65	        if skipped:
    66	            msg += f"; left existing {skipped} untouched"
    67	        return ToolOutcome(
    68	            success=True, content=msg,
    69	            structured={"starter": starter_id, "written": written, "skipped": skipped},
    70	        )
    71	
    72	    @staticmethod
    73	    async def _exists(ctx: ToolContext, path: str) -> bool:
    74	        assert ctx.sandbox is not None
    75	        try:
    76	            await ctx.sandbox.read_file(path)
    77	            return True
    78	        except Exception:
    79	            return False

