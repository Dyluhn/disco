   373	        use_c2 = bool(args.goal) and args.mode != "markdown"
   374	        if use_c2:
   375	            outcome = await self._run_c2_pipeline(args, ctx, fmt)
   376	        else:
   377	            # ---- Marp / markdown path (fallback or explicit mode="markdown") ----
   378	            outcome = await self._run_marp_path(args, ctx, fmt)
   379	
   380	        # ROOT-4 (slides spiral): completion recognition. A generated deck is a
   381	        # finished BINARY deliverable — once it is written + delivered the agent must
   382	        # finish, not "verify"/rewrite it. Append the REAL on-disk path(s) (so it does
   383	        # not hunt for /workspace) plus an explicit done/delivered/call-finish signal.
   384	        if outcome.success and outcome.artifacts:
   385	            outcome = outcome.model_copy(
   386	                update={"content": outcome.content + self._delivery_note(ctx, outcome.artifacts)}
   387	            )
   388	        return outcome
