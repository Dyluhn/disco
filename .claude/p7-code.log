   312	        # tracker never silently shares a bucket with another executor (the old "conv"
   313	        # default would have all unkeyed executors share one bucket).
   314	        self._conversation_id = (
   315	            conversation_id if conversation_id is not None else f"conv_{uuid4().hex}"
   316	        )
   317	        self._default_timeout_s = default_timeout_s
   318	        self._model_policy = model_policy  # replaces bare assist: bool; standard = no-op
   319	        self._killed = False
   320	
   321	    @property
   322	    def sandbox(self) -> SandboxInstance | None:
   323	        """The live sandbox instance, or None for a sandbox-less executor.
   324	
   325	        The agent loop reaches the sandbox through this duck-typed accessor
   326	        (getattr(executor, "sandbox", None)) — both for mid-session-recreation
