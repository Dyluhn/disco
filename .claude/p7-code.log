   160	def render_html(spec: AppSpec) -> str:
   161	    """Deterministically render an AppSpec to a self-contained index.html (inline CSS
   162	    so it paints reliably — no separate stylesheet that streams late)."""
   163	    d = {k: _css_safe(v) for k, v in spec.resolved_design().items()}
   164	    css = (
   165	        f":root{{--primary:{d['primary']};--accent:{d['accent']};--bg:{d['bg']};--fg:{d['fg']}}}"
   166	        f"body{{margin:0;font-family:{d['font']};background:var(--bg);color:var(--fg)}}"
   167	        "section{padding:3rem 1.5rem;max-width:900px;margin:0 auto}"
   168	        ".hero{text-align:center}.hero h1{font-size:2.5rem;margin:0 0 .5rem}"
   169	        ".cta,button{display:inline-block;background:var(--primary);color:#fff;border:0;"
   170	        "padding:.75rem 1.25rem;border-radius:.5rem;text-decoration:none;cursor:pointer}"
   171	        ".lead form{display:flex;flex-direction:column;gap:.5rem;max-width:360px}"
   172	        ".lead input{padding:.6rem;border:1px solid #ccc;border-radius:.4rem}"
   173	    )
   174	    body = "\n".join(_render_section(s) for s in spec.sections)
   175	    return (
   176	        "<!doctype html>\n<html lang=\"en\">\n<head>\n"
   177	        '<meta charset="utf-8">\n<meta name="viewport" content="width=device-width,initial-scale=1">\n'
   178	        f"<title>{_esc(spec.title)}</title>\n<style>{css}</style>\n</head>\n"
   179	        f"<body>\n{body}\n</body>\n</html>\n"
   180	    )

