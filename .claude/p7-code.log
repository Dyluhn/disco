   352	            tools = [t for t in tools if t.definition.name not in withheld]
   353	        return [t.definition.to_spec() for t in tools]
   354	
   355	    def callable_tool_names(self) -> frozenset[str]:
   356	        """Names of every tool the executor will actually run (registry ∩
   357	        allowed_tools), IGNORING advertised_tools. The advertise/callable split
   358	        (RP-05c) hides over-cap MCP tools from available_tools(), but they remain
   359	        callable by qualified name — callers that need to know 'can this name be
   360	        executed?' (e.g. the engine's unknown-tool requery gate) must use THIS,
   361	        not available_tools(), or they will bounce withheld-but-callable tools."""
   362	        return frozenset(t.definition.name for t in self._registry.in_scope(self._scope))
   363	
   364	    def readonly_tool_names(self) -> frozenset[str]:
   365	        """Names of in-scope tools that only OBSERVE (ToolDef.read_only). The loop
   366	        consults this to scope the PLANNING agent to read-only tools — a
   367	        capability-level backstop to any name allowlist, so a misconfigured
   368	        allowlist can't leak a write/exec tool to the planner (planner safety)."""
   369	        return frozenset(
   370	            t.definition.name
   371	            for t in self._registry.in_scope(self._scope)
   372	            if t.definition.read_only
   373	        )
