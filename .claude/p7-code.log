   338	            if tool.definition.name == tool_name:
   339	                return tool.definition.runs_in
   340	        return "unknown"
   341	
   342	    def available_tools(self) -> list[ToolSpec]:
   343	        tools = self._registry.in_scope(self._scope)  # registry ∩ allowed_tools
   344	        if self._scope.advertised_tools is not None:
   345	            tools = [t for t in tools if t.definition.name in self._scope.advertised_tools]
   346	        # Contract #3: additionally drop any tool the model policy withholds, regardless
   347	        # of what the scope advertises.  For the standard tier withheld_tools is empty
   348	        # (frozenset()) so this branch is a no-op.  For the weak tier and !anchored_edit
   349	        # this is the executor-level enforcement backstop on top of the registry's scope.
   350	        withheld = self._model_policy.withheld_tools
