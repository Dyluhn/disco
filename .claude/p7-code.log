   303	        # stamped onto every ToolContext for LLM-using tools (slides_generate).
   304	        self._driver_llm = driver_llm
   305	        # CW-6: the capability-derived file_read page budget, stamped onto every
   306	        # ToolContext so files.py can read a file that fits the snapshot pin in one
   307	        # shot. None ⇒ files.py uses its static default (assist-ON parity).
   308	        self._read_char_budget = read_char_budget
   309	        self._broker = broker or CapabilityBroker()
   310	        self._owner_id = owner_id
