    16	from collections.abc import Callable
    17	from pathlib import PurePosixPath
    18	
    19	from ..appkit import AppSection, AppSpec, render_html
    20	
    21	
    22	def _safe_rel(path: str) -> str:
    23	    """A starter writes only NORMALIZED, workspace-relative paths — never absolute and
    24	    never escaping the workspace (no ``..``). Rejects traversal at scaffold time."""
    25	    p = PurePosixPath(path)
    26	    if p.is_absolute() or ".." in p.parts or not p.parts:
    27	        raise ValueError(f"unsafe starter path: {path!r}")
    28	    return str(p)
    29	
    30	
    31	def lead_form_appspec(title: str) -> AppSpec:
    32	    """The default AppKit lead-gen app (a hero + a lead form). The SINGLE source for both
    33	    the lead_form starter AND app_create's default — so they can't drift."""
    34	    return AppSpec(
    35	        title=title,
    36	        sections=(
    37	            AppSection(id="hero", kind="hero", fields={"headline": title, "subhead": "", "cta_text": "Get started"}),
    38	            AppSection(id="lead", kind="lead_form", fields={"title": "Contact us", "submit_text": "Send"}),
    39	        ),
    40	    )
    41	
    42	
    43	def _appspec_files(spec: AppSpec) -> dict[str, str]:
    44	    # byte-identical to AppSpecStore.write (.disco/appspec.json + rendered index.html).
    45	    return {
    46	        ".disco/appspec.json": spec.model_dump_json(indent=2) + "\n",
    47	        "index.html": render_html(spec),
    48	    }
    49	
    50	
    51	_APP_SHELL_HTML = """<!doctype html>
    52	<html lang="en">
    53	<head>
    54	<meta charset="utf-8">
    55	<meta name="viewport" content="width=device-width,initial-scale=1">
    56	<title>{title}</title>
