     5	so a copy/color/section change touches exactly one thing (the targeted-edit law). A raw
     6	file rewrite is NOT in this set; it lives only in the repair/custom contract scopes.
     7	
     8	Tools: app_create / app_update_content / app_add_section / app_remove_section /
     9	app_reorder_section / app_set_design / app_set_tweak / app_snapshot_version.
    10	"""
    11	
    12	from __future__ import annotations
    13	
    14	import hashlib
    15	from typing import Any, Callable
    16	
    17	from disco.core import SecurityRisk
    18	from disco.core.appkit import AppSection, AppSpec, render_html
    19	from disco.core.kits import lead_form_appspec
    20	from pydantic import BaseModel, Field
    21	
    22	from ..anatomy import Capability, ToolContext, ToolDef, ToolOutcome
    23	
    24	_SPEC_PATH = ".disco/appspec.json"
    25	_HTML_PATH = "index.html"
    26	
    27	
    28	def _coerce_scalar(value: str) -> Any:
    29	    """Coerce a string tweak value to a stable scalar: bools (case-insensitive
    30	    true/false), ints, else the trimmed string — so the spec's tweak shape is
    31	    predictable rather than 'true' the string sometimes and True other times."""
    32	    low = value.strip().lower()
    33	    if low in ("true", "false"):
    34	        return low == "true"
    35	    body = value.strip()
    36	    if body.lstrip("-").isdigit():
    37	        return int(body)
    38	    return value
    39	
    40	
    41	class AppSpecStore:
    42	    """Reads/writes the durable AppSpec + the rendered index.html over a sandbox FS."""
    43	
    44	    def __init__(self, fs: Any) -> None:
    45	        self._fs = fs
    46	
    47	    async def read(self) -> AppSpec | None:
    48	        try:
    49	            data = await self._fs.read_file(_SPEC_PATH)
    50	        except Exception:
    51	            return None
    52	        return AppSpec.model_validate_json(data)  # raises on corrupt → caller maps to error
    53	
    54	    async def write(self, spec: AppSpec) -> None:
    55	        await self._fs.write_file(_SPEC_PATH, (spec.model_dump_json(indent=2) + "\n").encode("utf-8"))
    56	        await self._fs.write_file(_HTML_PATH, render_html(spec).encode("utf-8"))
    57	
    58	
    59	async def _apply(ctx: ToolContext, mutate: Callable[[AppSpec], AppSpec]) -> ToolOutcome:
    60	    """Load the spec, apply a pure mutation, persist spec + re-rendered HTML."""
    61	    assert ctx.sandbox is not None
    62	    store = AppSpecStore(ctx.sandbox)
    63	    try:
    64	        spec = await store.read()
    65	    except Exception:
    66	        return ToolOutcome(success=False, error="corrupt_appspec", content=f"{_SPEC_PATH} is unreadable")
    67	    if spec is None:
    68	        return ToolOutcome(success=False, error="no_app", content="no app yet — call app_create first")
    69	    try:
    70	        new_spec = mutate(spec)
    71	    except ValueError as exc:
    72	        return ToolOutcome(success=False, error="invalid_app_edit", content=str(exc))
    73	    await store.write(new_spec)
    74	    return ToolOutcome(
    75	        success=True,
    76	        content=f"updated app + re-rendered {_HTML_PATH}",
    77	        structured={"sections": [s.id for s in new_spec.sections]},
    78	    )
    79	
    80	
    81	def _def(name: str, desc: str, args_model: type[BaseModel]) -> ToolDef:
    82	    return ToolDef(
    83	        name=name,
    84	        description=desc,
    85	        args_model=args_model,
    86	        needs=frozenset({Capability.FILESYSTEM}),
    87	        base_risk=SecurityRisk.LOW,
    88	        runs_in="sandbox",
    89	        read_only=False,
    90	    )
