     4	resolve_theme), the same tokens that drive report/deck exports. AppKit uses a SMALLER
     5	token vocabulary ({primary, accent, bg, fg, font}); this projects a brand theme into
     6	those keys so a build's brand stays consistent with the rest of Disco — instead of a
     7	parallel, drifting token catalog. Pure; reuses disco.core.brand.
     8	"""
     9	
    10	from __future__ import annotations
    11	
    12	from ..brand import THEMES, resolve_theme
    13	
    14	# The brand names available to project (the registry keys of disco.core.brand.THEMES).
    15	BRAND_NAMES: frozenset[str] = frozenset(name for name, _mode in THEMES)
    16	
    17	
    18	def brand_to_appkit_tokens(theme: object) -> dict[str, str]:
    19	    """Project a disco.core.brand Theme into AppKit design tokens. The brand's accent is
    20	    the primary action color; bg/text become the canvas/ink; the UI font stack drives
    21	    type. Keys match appkit.DEFAULT_DESIGN exactly so app_set_design can apply them."""
    22	    return {
    23	        "primary": getattr(theme, "accent"),
    24	        "accent": getattr(theme, "accent"),
    25	        "bg": getattr(theme, "bg"),
    26	        "fg": getattr(theme, "text"),
    27	        "font": getattr(theme, "font_ui"),
    28	    }
    29	
    30	
    31	def appkit_brand(name: str, mode: str = "light") -> dict[str, str]:
    32	    """The AppKit design tokens for a named brand (e.g. 'disco', 'neutral', 'ink').
    33	    Raises ValueError on an unknown brand (reuses resolve_theme's validation)."""
    34	    return brand_to_appkit_tokens(resolve_theme(name, mode))

