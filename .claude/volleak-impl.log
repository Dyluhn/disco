        cli_url=svc._cli_url, container_name=name, cli_runner=cli,
        preview_host=svc._cfg.preview_host or _preview_host(svc._cli_url),
        reload_timeout_s=svc._cfg.reload_timeout_s, workspace_volume=workspace_volume,
    )
    print('constructed', inst.id, flush=True)

asyncio.run(main())
