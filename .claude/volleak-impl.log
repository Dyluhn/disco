   365	    other_net = _ReconNet("disco-egr-other", {_LABEL: "different-conv"})
   366	    client = _ReconClient([sbx, sidecar], [egr_net, other_net])
   367	    svc = PodmanSandboxService(default_podman_config(), client=client)
