+class FakeVolume:
+    def __init__(self, name: str, labels: dict[str, str]) -> None:
+        self.name = name
+        self.id = "vol-" + name
+        self.labels = labels
+        self.removed = False
+        self.remove_kwargs: dict | None = None
+
+    def remove(self, force=False):
+        self.removed = True
+        self.remove_kwargs = {"force": force}
