import asyncio, faulthandler, sys
sys.path.insert(0, 'packages/tools/tests')
from test_podman import _svc
from disco.tools.sandbox import SandboxSpec
from disco.tools.sandbox.podman import PodmanSandboxInstance, _preview_host

faulthandler.dump_traceback_later(5, exit=True)

async def main():
    svc, client, cli = _svc()
