   565	        SSH) and confirm the selected runtime (`runsc` for gVisor, `runc` for the
   566	        local tier) is registered on that host. Raises a typed
   567	        ``SandboxUnavailableError`` NAMING the endpoint + reason on failure
   568	        (`_client()` → "Docker unreachable at <endpoint>: …"; `_require_runtime` →
   569	        "the '<runtime>' runtime is not configured on the Docker host"); returns None
   570	        on success. The blocking docker-py calls run in a thread and are bounded by
   571	        `client_timeout_s`, so an unreachable host fails fast instead of hanging."""
   572	        def _probe() -> None:
   573	            client = self._client()  # typed: "Docker unreachable at <endpoint>: …"
   574	            self._require_runtime(client)  # typed: "<runtime> not configured …"
   575	
   576	        await asyncio.to_thread(_probe)
   577	
   578	    async def list_live_instances(self) -> list[str]:
   579	        """Return conversation_ids of all live pmx-sbx-* containers on this backend.
   580	
   581	        Side effect (documented, deliberate): a pmx-sbx-* container WITHOUT a
   582	        pmx.conversation_id label predates the label scheme — it cannot be
   583	        correlated to any conversation, so it is unreachable garbage by
   584	        construction (session handles are in-memory; recreation always builds a
   585	        fresh instance). These legacy orphans are reaped on sight — they are
   586	        exactly the population that OOM-wedged VM-201 (34 unlabeled containers,
   587	        2026-06-10); a label-only sweep would skip every one of them."""
   588	        def _list() -> list[str]:
   589	            try:
   590	                client = self._client()
   591	                # Dual-read: sweep BOTH the current `disco-sbx-` and legacy
   592	                # `pmx-sbx-` name prefixes so a rename never strands a container
   593	                # started under the old scheme. Dedup by container id (a name
   594	                # filter is a substring match, so the two queries can't overlap
   595	                # here, but the dedup keeps this robust to filter semantics).
   596	                seen_ids: set[str] = set()
   597	                containers = []
   598	                for prefix in SBX_NAME_PREFIXES:
   599	                    for c in client.containers.list(filters={"name": prefix}):
   600	                        if c.id not in seen_ids:
   601	                            seen_ids.add(c.id)
   602	                            containers.append(c)
   603	                result = []
   604	                for c in containers:
   605	                    cid = conv_id_from_labels(c.labels)
   606	                    if cid:
   607	                        result.append(cid)
   608	                        continue
   609	                    try:  # legacy/unlabeled: reap on sight (see docstring)
   610	                        _LOG.info("reaping unlabeled legacy sandbox container %s", c.name)
   611	                        c.stop(timeout=2)
   612	                        c.remove(force=True)
