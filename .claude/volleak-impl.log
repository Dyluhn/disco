   644	                        except Exception:  # noqa: BLE001 — already gone is fine
   645	                            pass
   646	                # Clean up the egress internal network(s) by LABEL — networks are
   647	                # named disco-egr-{instance_id}, which has NO relation to the
   648	                # conversation_id, so a name match can never work. Labels are set
   649	                # at create time (same conversation label as the containers);
   650	                # containers were removed above, so the network is detachable.
   651	                seen_nets: set[str] = set()
   652	                for key in LABEL_CONV_KEYS:
