+
+def _remove_volume(volume: Any, *, force: bool = True) -> None:
+    """Best-effort named-volume remove across docker-py/podman-py and fakes."""
+    if volume is None:
+        return
+    try:
+        volume.remove(force=force)
+        return
+    except TypeError:
+        pass
+    volume.remove()
