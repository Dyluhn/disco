   625	                # Dual-read: match BOTH the current `disco.conversation_id` and
   626	                # legacy `pmx.conversation_id` label keys (union, dedup by id) so
   627	                # a container/network started under the old label scheme is still
   628	                # torn down after the rename.
   629	                seen_ids: set[str] = set()
   630	                for key in LABEL_CONV_KEYS:
   631	                    for c in client.containers.list(
   632	                        all=True,
   633	                        filters={"label": f"{key}={conversation_id}"},
   634	                    ):
   635	                        if c.id in seen_ids:
