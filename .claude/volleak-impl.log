+        return
+    try:
+        container.remove(force=force, v=volumes)
+        return
+    except TypeError:
+        pass
+    try:
+        container.remove(force=force, volumes=volumes)
+        return
+    except TypeError:
+        pass
+    container.remove(force=force)
