   138	                except Exception:  # noqa: BLE001 — best-effort
   139	                    pass
   140	            raise SandboxUnavailableError(f"container failed to start: {exc}") from exc
   141	        # [FIX6 podman-parity] The parent gVisor `_start_container` launches the inbound
   142	        # preview forwarder on the sidecar after the sandbox starts; this override has
   143	        # to do the same or a FILTERED box's published preview port forwards to nothing
   144	        # (the sidecar publishes the port, but nothing listens on it → connection
   145	        # refused → preview 502). Live-proven on the workstation's rootless podman: with
   146	        # this call the host reaches the filtered box's preview via the sidecar; without
   147	        # it, 502. Best-effort (never raises), same as the parent.
   148	        if mode == "filtered" and egress_sidecar is not None:
