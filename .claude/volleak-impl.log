    91	            ports: dict[str, str | None] | None = None  # inbound preview on internal net
    92	        elif mode == "open":
    93	            net_kwargs = {"network_mode": "bridge"}
    94	            ports = {f"{p}/tcp": None for p in sorted(PUBLISHED_PORTS)}
    95	        else:  # sealed
    96	            net_kwargs = {"network_mode": "none"}
