+def _podman_volume_names(args: list[str]) -> list[str] | None:
+    try:
+        out = subprocess.run(
+            args,
+            capture_output=True, text=True, timeout=15, check=False,
+        )
+    except Exception:
+        return None
+    if out.returncode != 0:
+        return None
+    names: list[str] = []
