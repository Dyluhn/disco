   126	        except SandboxUnavailableError:
   127	            raise
   128	        except Exception as exc:  # noqa: BLE001 — start failure, real cause preserved
   129	            # Don't leak the egress aux if the sandbox itself failed to start (E8).
   130	            if egress_sidecar is not None:
   131	                try:
   132	                    egress_sidecar.remove(force=True)
   133	                except Exception:  # noqa: BLE001 — best-effort
   134	                    pass
   135	            if egress_network is not None:
   136	                try:
