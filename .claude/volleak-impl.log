    85	        return out
    86	
    87	    @classmethod
    88	    def from_dict(cls, raw: dict[str, Any]) -> OracleResult:
    89	        if not isinstance(raw, dict):
    90	            raise TypeError("OracleResult.from_dict expects a dict")
    91	        missing = {"oracle", "status"} - set(raw)
