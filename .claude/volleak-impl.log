     1	"""The structured fact every oracle emits (guidelines §10).
     2	
     3	Each oracle returns `OracleResult` objects — structured facts, never prose. The
     4	classifier reads these; a human reads them; nothing interprets free text. The
     5	result round-trips losslessly to/from a JSON-safe dict so it lands verbatim in the
     6	frozen `classification.json` (§13) and the evidence dossier.
     7	
     8	Plain dataclasses (no pydantic, no disco import) keep the schema standalone and the
     9	serialization byte-stable.
    10	"""
    11	
    12	from __future__ import annotations
    13	
    14	from dataclasses import dataclass, field
    15	from typing import Any
    16	
    17	# Oracle result status. Distinct from the run OUTCOME (PASS/FAIL/INVALID_RUN/
    18	# INFRA_FAILURE): an oracle PASSES, FAILS, or is SKIPPED (not applicable to this
    19	# scenario, or needs evidence this slice doesn't capture — e.g. the live tool
    20	# scope). A SKIP is never silently a pass; the classifier records it.
    21	OK = "PASS"
    22	FAILED = "FAIL"
    23	SKIPPED = "SKIP"
    24	
    25	_STATUSES = frozenset({OK, FAILED, SKIPPED})
    26	
    27	
    28	@dataclass(frozen=True)
    29	class OracleResult:
    30	    """One oracle's verdict on one predicate.
    31	
    32	    Fields:
    33	      oracle: the emitting oracle class name (e.g. "RevisionOracle").
    34	      status: PASS | FAIL | SKIP.
    35	      code:   a failure_codes constant when status==FAIL; for PASS/SKIP it may be
    36	              None or a short reason token.
    37	      facts:  structured, machine-readable evidence (never prose narrative).
    38	      first_broken_link: the "A -> B" link this result breaks (FAIL only), used by
    39	              the classifier's first-broken-link wins ordering (§16).
