   104	                # keepalive
   105	                command=_keepalive_command(),
   106	                runtime=self._cfg.runtime,  # runc (a value, not a branch)
   107	                # Publish the curated port set (declared at create — Docker can't
   108	                # add mappings later). Only on `open`; the filtered and sealed
   109	                # paths have no inbound preview (an internal net, or no net at all).
   110	                ports=ports,
   111	                # The limit goes through the LOCAL socket/daemon → it actually bites.
   112	                mem_limit=f"{mem_mb}m",
   113	                nano_cpus=int(cpu * 1_000_000_000),
   114	                pids_limit=pids,  # EPIC H: cgroup pids.max — fork-bomb / host-PID guard
   115	                volumes={vol_name: {"bind": self._cfg.container_workspace, "mode": "rw"}},
