+            capture_output=True, text=True, timeout=15, check=False,
+        )
+    except Exception:
+        return None
+    if out.returncode != 0:
+        return None
+    names: list[str] = []
+    for line in out.stdout.splitlines():
+        clean = line.strip()
+        if clean:
+            names.append(clean)
+    return names
+
+
+def _disco_volume_names() -> list[str] | None:
