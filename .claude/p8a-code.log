def resolve_human_reference(phrase: str, *, context: SemanticReferenceContext) -> ReferenceResolution:
    """Resolve a human reference phrase to a typed target, or reject (ambiguous / no_match /
    invalid_ordinal / out_of_range). Deterministic; never guesses past one clear candidate."""
    norm = normalize_screen_label(phrase)
    if not norm:
        return _reject(ResolutionReason.NO_MATCH)
    ordinal = parse_human_ordinal(phrase)
    if ordinal.invalid:
        return _reject(ResolutionReason.INVALID_ORDINAL)

    # 1) SLIDE — "slide N" / "Nth slide" (most specific when the word 'slide' is present).
    if "slide" in _tokens(norm) and ordinal.value is not None:
        idx = human_ordinal_to_index(ordinal.value)
        if idx < len(context.slides):
            return _resolved(SlideLocator(slide_id=context.slides[idx].id))
        return _reject(ResolutionReason.OUT_OF_RANGE)

    # 2) SECTION by ordinal — "section N".
    if "section" in _tokens(norm) and ordinal.value is not None:
        idx = human_ordinal_to_index(ordinal.value)
        by_ord = sorted(context.sections, key=lambda s: s.ordinal)
        if idx < len(by_ord):
            return _resolved(SectionLocator(section_id=by_ord[idx].id))
        return _reject(ResolutionReason.OUT_OF_RANGE)

    # Collect all plausible candidates, then decide (1 → resolve, >1 → ambiguous, 0 → no_match).
    # A FIELD (section+field, 2 labels) is the most specific tier; collection item next; then
    # bare section / anchor. We resolve within the most specific non-empty tier.
    field_hits: list[SemanticTarget] = []
    for f in context.fields:
        sec = next((s for s in context.sections if s.id == f.section_id), None)
        sec_labels = (sec.label, *sec.aliases) if sec is not None else ()
        if _labels_match(norm, sec_labels) and _labels_match(norm, f.labels or (f.field_id,)):
            field_hits.append(FieldLocator(section_id=f.section_id, field_id=f.field_id))
    if field_hits:
        uniq = _dedupe(field_hits)
        return _resolved(uniq[0]) if len(uniq) == 1 else _ambiguous([target_id(t) for t in uniq])

    item_hits: list[SemanticTarget] = []
    if ordinal.value is not None:
        for col in context.collections:
            names = (*col.labels, col.item_kind)
            if _labels_match(norm, names):
                idx = human_ordinal_to_index(ordinal.value)
                if idx >= col.length:
                    return _reject(ResolutionReason.OUT_OF_RANGE)
                item_hits.append(IndexedLocator(collection_id=col.id, index=idx))
    if item_hits:
        uniq = _dedupe(item_hits)
        return _resolved(uniq[0]) if len(uniq) == 1 else _ambiguous([target_id(t) for t in uniq])

    bare_hits: list[SemanticTarget] = []
    for s in context.sections:
        if _labels_match(norm, (s.label, *s.aliases)):
            bare_hits.append(SectionLocator(section_id=s.id))
    for a in context.comment_anchors:
        if _labels_match(norm, (a.label, a.id)):
            bare_hits.append(CommentAnchorLocator(anchor_id=a.id))
    uniq = _dedupe(bare_hits)
    if len(uniq) == 1:
        return _resolved(uniq[0])
    if len(uniq) > 1:
        return _ambiguous([target_id(t) for t in uniq])
    return _reject(ResolutionReason.NO_MATCH)


def _dedupe(targets: list[SemanticTarget]) -> list[SemanticTarget]:
    seen: set[str] = set()
    out: list[SemanticTarget] = []
    for t in targets:
        tid = target_id(t)
        if tid not in seen:
            seen.add(tid)
            out.append(t)
    return out

