   632	                if seen_active and self._terminal_is_new(conversation_id, min_terminal_seq):
   633	                    return last
   634	                # pre-kick / settling (or a stale pre-follow-up terminal) — keep waiting.
   635	            else:
   636	                seen_active = True  # RUNNING or any active transitional status
   637	
   638	            now = time.monotonic()
   639	            # Progress = new events appeared OR the status transitioned since last poll.
   640	            cur_marker = self._progress_marker(conversation_id)
   641	            if cur_marker != marker or last != last_status:
   642	                marker = cur_marker
   643	                last_status = last
   644	                last_progress = now
   645	
   646	            inactive_for = now - last_progress
   647	            if now - start >= hard_cap_s:
   648	                # Safety ceiling. Was it still progressing recently? Then this is an
   649	                # inconclusive model-speed cutoff, NOT a wedge → PROGRESSING_TIMEOUT.
   650	                return (
   651	                    PROGRESSING_TIMEOUT if inactive_for < inactivity_s else INACTIVE_TIMEOUT
   652	                )
   653	            if inactive_for >= inactivity_s:
   654	                return INACTIVE_TIMEOUT
   655	            await asyncio.sleep(self._poll)
   656	
   657	    async def poll_until_terminal_or_gate(
   658	        self,
   659	        conversation_id: str,
   660	        *,
   661	        inactivity_s: float,
   662	        hard_cap_s: float,
   663	        min_terminal_seq: int | None = None,
   664	    ) -> str:
   665	        """Progress-aware wait that ALSO stops on a GATE the runner must act on (e.g.
   666	        AWAITING_PLAN_APPROVAL). Returns the terminal/gate/pause status, or a Bug-15
   667	        timeout sentinel (INACTIVE_TIMEOUT / PROGRESSING_TIMEOUT). `min_terminal_seq`
   668	        (H1/V2): when set, a terminal whose durable event seq <= it is the STALE
   669	        pre-follow-up terminal and does NOT end the wait — only the follow-up's OWN new
   670	        terminal (seq > min_terminal_seq) does."""
   671	        return await self._poll_progress_aware(
   672	            conversation_id,
   673	            stop_on_gate=True,
   674	            inactivity_s=inactivity_s,
   675	            hard_cap_s=hard_cap_s,
   676	            min_terminal_seq=min_terminal_seq,
   677	        )
   678	
   679	    async def poll_until_terminal(
   680	        self,
   681	        conversation_id: str,
   682	        *,
   683	        inactivity_s: float,
   684	        hard_cap_s: float,
   685	        min_terminal_seq: int | None = None,
   686	    ) -> str:
   687	        """Progress-aware wait to a strictly TERMINAL state (no gate stop). Used after a
   688	        plan is approved / for autonomous runs with no interactive gate. `min_terminal_seq`
   689	        (H1/V2): only a terminal whose durable event seq > it ends the wait (the follow-up's
   690	        OWN new terminal), never the stale pre-follow-up one."""
   691	        return await self._poll_progress_aware(
   692	            conversation_id,
   693	            stop_on_gate=False,
   694	            inactivity_s=inactivity_s,
   695	            hard_cap_s=hard_cap_s,
   696	            min_terminal_seq=min_terminal_seq,
   697	        )
   698	
   699	    async def wait_until_status_leaves(
   700	        self, conversation_id: str, status: str, *, timeout_s: float
   701	    ) -> str:
   702	        """After acting on a gate (e.g. approving a plan), wait for the status to move
   703	        OFF that gate before driving again — so a not-yet-processed approval isn't
   704	        re-read as the same gate and double-approved. Returns the new status (or the
   705	        unchanged one on timeout)."""
   706	        deadline = time.monotonic() + timeout_s
   707	        last = status
   708	        while time.monotonic() < deadline:
   709	            last = self._status_of(await self.get_state(conversation_id))
   710	            if last != status:
   711	                return last
   712	            await asyncio.sleep(self._poll)
   713	        return last
   714	
   715	    def _latest_plan_revision(self, conversation_id: str) -> int:
   716	        """Highest plan-event revision in the durable log (0 when no plan exists yet).
   717	        Mirrors events.latest_plan_revision but reads the DB directly so the adapter
   718	        stays oracle-import-free. A re-plan appends a NEW PlanEvent whose `revision`
   719	        increments, so a bump here is hard evidence a follow-up was PICKED UP + re-planned."""
   720	        best = 0
   721	        for e in self._read_events(conversation_id):
   722	            if e.get("kind") != "plan":
   723	                continue
   724	            rev = _payload(e).get("revision", 1)
   725	            try:
   726	                best = max(best, int(rev))
   727	            except (TypeError, ValueError):
   728	                continue
   729	        return best
   730	
   731	    def _planning_reentry_since(self, conversation_id: str, after_seq: int) -> bool:
   732	        """True when a RE-PLAN re-entry status (detail == `planning`) appears at seq >
   733	        after_seq. enter_planning stamps this on a re-plan but NOT on the first build turn
   734	        (a plain RUNNING with no detail) — so it is a genuine pickup-of-follow-up signal,
   735	        not the initial plan. `after_seq` is the baseline max seq captured BEFORE the send."""
   736	        for e in self._read_events(conversation_id):
   737	            if e.get("kind") != "status" or int(e.get("seq", -1)) <= after_seq:
   738	                continue
   739	            if (_payload(e).get("detail") or None) == _PLANNING_DETAIL:
   740	                return True
   741	        return False
   742	
   743	    def _progress_event_since(self, conversation_id: str, after_seq: int) -> bool:
   744	        """True when the FIRST genuine NON-USER PROGRESS event appears at seq > after_seq —
   745	        the EVENT-SEQUENCED pickup signal (V2). The engine actually processing the follow-up
   746	        produces a new durable event: an action, an observation, a plan, an agent_error, an
   747	        AGENT/assistant message, or a RUNNING / gate / `planning` status. Detectable EVEN WHEN
   748	        the conversation STATUS stays at the prior terminal (FINISHED) — a follow-up appended
   749	        during run finalization causes NO status change, the exact dead-window V1 missed.
   750	
   751	        A bare USER-MESSAGE append (kind=message, source=user) is explicitly NOT progress: the
   752	        append itself bumps the event seq but is not processing — that is precisely the
   753	        stale-terminal red herring this guards against, so it is skipped, never a pickup."""
   754	        for e in self._read_events(conversation_id):
   755	            if int(e.get("seq", -1)) <= after_seq:
   756	                continue
   757	            kind = e.get("kind")
   758	            if kind == "message":
   759	                if (e.get("source") or "") == "user":
   760	                    continue  # the user-message APPEND itself is NOT pickup (the red herring)
   761	                return True  # an agent/assistant message = the engine produced output
   762	            if kind in ("action", "observation", "plan", "agent_error"):
   763	                return True
   764	            if kind == "status":
   765	                p = _payload(e)
   766	                st = p.get("status")
   767	                if (
   768	                    st == "RUNNING"
   769	                    or st in GATE_STATES
   770	                    or (p.get("detail") or None) == _PLANNING_DETAIL
   771	                ):
   772	                    return True
   773	        return False
   774	
   775	    def _latest_terminal_seq(self, conversation_id: str) -> int:
   776	        """The seq of the MOST RECENT terminal status event in the durable log (-1 when none).
   777	        Used to require a follow-up's OWN NEW terminal (a terminal EVENT with seq > the
   778	        baseline) before the drive returns — so the STALE pre-follow-up terminal can never be
   779	        mistaken for the follow-up's completion (the piece V1 missed)."""
   780	        best = -1
   781	        for e in self._read_events(conversation_id):
   782	            if e.get("kind") != "status":
   783	                continue
   784	            if _payload(e).get("status") in TERMINAL_STATES:
   785	                best = max(best, int(e.get("seq", -1)))
   786	        return best
   787	
   788	    def _terminal_is_new(self, conversation_id: str, min_terminal_seq: int | None) -> bool:
   789	        """Whether a terminal status reached NOW is the follow-up's OWN new terminal — its
   790	        durable terminal event has seq > `min_terminal_seq` — rather than the STALE
   791	        pre-follow-up terminal. None ⇒ no baseline guard (any terminal counts, the default)."""
   792	        if min_terminal_seq is None:
   793	            return True
   794	        return self._latest_terminal_seq(conversation_id) > min_terminal_seq
   795	
   796	    async def capture_followup_baseline(self, conversation_id: str) -> dict[str, Any]:
   797	        """Snapshot the state needed to detect REAL pickup of the NEXT follow-up (H1),
   798	        captured BEFORE send_followup. `max_seq` is the PRIMARY anchor (V2): pickup and the
   799	        follow-up's own new terminal are both measured as events at seq > max_seq.
   800	          * `max_seq` — the latest durable event seq; the baseline for BOTH the event-sequenced
   801	            pickup detector (a non-user progress event past it) AND the min_terminal_seq drive
   802	            guard (the follow-up's OWN new terminal must have seq > it, not the stale one);
   803	          * `plan_revision` — the latest plan revision so a re-plan bump is detectable;
   804	          * `status` — the build's current (prior-terminal) status, e.g. FINISHED (a
   805	            belt-and-suspenders signal only; a follow-up appended during finalization leaves
   806	            the status UNCHANGED, so the seq — not the status — is what V2 keys on).
   807	        Deliberately does NOT use a bare event-count bump as pickup — the user-message append
   808	        alone bumps the seq, and the append is NOT processing (that red herring is the bug)."""
   809	        status = self._status_of(await self.get_state(conversation_id))
   810	        return {
   811	            "status": status,
   812	            "plan_revision": self._latest_plan_revision(conversation_id),
   813	            "max_seq": self._progress_marker(conversation_id)[1],
   814	        }
   815	
   816	    async def wait_for_followup_pickup(
   817	        self,
   818	        conversation_id: str,
   819	        baseline: dict[str, Any],
   820	        *,
   821	        timeout_s: float | None = None,
   822	    ) -> str:
   823	        """SERIALIZE after-terminal follow-ups (H1): after send_followup, BLOCK until the
   824	        engine actually PICKS UP this follow-up — measured against `baseline` (captured
   825	        BEFORE the send) — so the NEXT follow-up is not piled on top of an unprocessed one
   826	        and collapsed into a single plan revision.
   827	
   828	        EVENT-SEQUENCED (V2 — V1 was status-only and timed out): pickup is detected from the
   829	        durable EVENT LOG relative to `baseline.max_seq`, NOT from a status change. A follow-up
   830	        appended while the prior run is FINALIZING causes NO status change (status stays
   831	        FINISHED) — V1 watched the status, saw nothing, timed out, and PROCEEDED, letting
   832	        follow-up 2 collapse into follow-up 1. V2 returns as soon as there is REAL pickup
   833	        evidence relative to the baseline:
   834	          * FOLLOWUP_REPLANNED — a re-plan: the latest plan revision bumped above baseline, OR
   835	            a `planning` re-entry status appeared past the baseline seq; OR
   836	          * FOLLOWUP_PICKED_UP — the FIRST non-user PROGRESS event (action / observation / plan
   837	            / agent message / RUNNING-or-gate status) appeared at seq > the baseline seq — the
   838	            engine began processing, EVEN IF the status is still FINISHED. (Belt-and-suspenders:
   839	            a genuine status change off the prior terminal also counts.)
   840	
   841	        A new event seq caused MERELY by the user-message append is NOT treated as pickup —
   842	        the append itself is not processing (that is precisely the stale-terminal red herring
   843	        this guards against), so the raw event marker is never a pickup signal.
   844	
   845	        BOUNDED by `timeout_s` (default = the policy-driven `_followup_pickup_timeout_s()`):
   846	        on timeout it RETURNS FOLLOWUP_PICKUP_TIMEOUT (never hangs). The CALLER must treat that
   847	        as a SEQUENCING FAILURE — HARD-FAIL the run (do NOT re-send, do NOT drive on the stale
   848	        terminal): re-sending duplicates the user turn (no legal kick-without-append on a
   849	        FINISHED run) and driving on the stale terminal collapses the next follow-up (V1's bug)."""
   850	        if timeout_s is None:
   851	            timeout_s = _followup_pickup_timeout_s()
   852	        base_status = str(baseline.get("status") or "")
   853	        base_rev = int(baseline.get("plan_revision") or 0)
   854	        base_seq = int(baseline.get("max_seq", -1))
   855	        deadline = time.monotonic() + timeout_s
   856	        while time.monotonic() < deadline:
   857	            status = self._status_of(await self.get_state(conversation_id))
   858	            # (1) a re-plan signal: a revision bump OR a `planning` re-entry past the baseline.
   859	            if self._latest_plan_revision(conversation_id) > base_rev:
   860	                return FOLLOWUP_REPLANNED
   861	            if self._planning_reentry_since(conversation_id, base_seq):
   862	                return FOLLOWUP_REPLANNED
   863	            # (2) EVENT-SEQUENCED pickup: a non-user progress event past the baseline seq means
   864	            #     the engine started processing — detectable even when the status stays FINISHED.
   865	            if self._progress_event_since(conversation_id, base_seq):
   866	                return FOLLOWUP_PICKED_UP
   867	            # (3) belt-and-suspenders: the build left its prior terminal/resting status.
   868	            if base_status and status and status != base_status:
   869	                return FOLLOWUP_PICKED_UP
   870	            await asyncio.sleep(self._poll)
   871	        return FOLLOWUP_PICKUP_TIMEOUT
   872	
   873	    async def wait_for_first_file_write(
   874	        self, conversation_id: str, *, timeout_s: float
   875	    ) -> int | None:
   876	        """Poll the DB for the first MUTATING action (the §15.4 steer trigger).
   877	        Returns its seq, or None on timeout / terminal-without-write."""
   878	        deadline = time.monotonic() + timeout_s
   879	        while time.monotonic() < deadline:
   880	            events = self._read_events(conversation_id)
   881	            for e in events:
   882	                if e.get("kind") != "action":
   883	                    continue
   884	                tc = _payload(e).get("tool_call") or {}
   885	                name = tc.get("tool_name")
   886	                if name and name not in _NON_MUTATING_TOOLS:
   887	                    return int(e.get("seq", -1))
   888	            # bail early if the run already finished without a write
   889	            if events and _last_terminal(events) is not None:
   890	                return None
   891	            await asyncio.sleep(self._poll)
   892	        return None
   893	
   894	    def latest_user_message_seq(self, conversation_id: str) -> int:
   895	        """The highest seq of a USER message in the durable log, or -1 when none yet. Used to
   896	        snapshot the user-turn watermark BEFORE the harness sends a turn (declared follow-up or
   897	        injected auto-answer) so the NEW user-message seq it produces can be attributed to the
   898	        harness (revision-anchor metadata)."""
   899	        best = -1
   900	        try:
   901	            for e in self._read_events(conversation_id):
   902	                if e.get("kind") == "message" and e.get("source") == "user":
   903	                    best = max(best, int(e.get("seq", -1)))
   904	        except sqlite3.Error:
   905	            return -1
   906	        return best
   907	
   908	    async def wait_for_new_user_message_seq(
   909	        self, conversation_id: str, *, after_seq: int, timeout_s: float
   910	    ) -> int | None:
   911	        """After the harness sends a user turn, poll the durable log until a USER message with
   912	        seq > `after_seq` appears; return ITS seq (the turn the harness just sent), or None on
   913	        timeout / no new user message (e.g. a `confirm` or `pick_alternative` control frame
   914	        appends NO user message — nothing to attribute). Bounded — never hangs."""
   915	        deadline = time.monotonic() + timeout_s
   916	        while True:
   917	            seq = self.latest_user_message_seq(conversation_id)
   918	            if seq > after_seq:
   919	                return seq
   920	            if time.monotonic() >= deadline:
   921	                return None
   922	            await asyncio.sleep(self._poll)
   923	
   924	    # -- collection (post-terminal, race-free) --------------------------------
   925	
   926	    def collect_events(self, conversation_id: str) -> list[dict[str, Any]]:
   927	        """Read the FULL event log from disco.db AFTER the run reached terminal —
   928	        the durable, race-free source (the trace_conversation.py pattern). Returns
   929	        DB-row dicts {seq,kind,source,id,created_at,payload(JSON string)} which the
   930	        classifier's normalizer flattens identically to events.jsonl."""
   931	        return self._read_events(conversation_id)
   932	
   933	    async def collect_state(self, conversation_id: str) -> dict[str, Any]:
   934	        return await self.get_state(conversation_id)
   935	
   936	    async def collect_workspace(
   937	        self, conversation_id: str, file_paths: list[str]
   938	    ) -> dict[str, Any]:
   939	        """Collect the conversation's workspace files AUTHORITATIVELY (Bug 9 fix).
   940	
   941	        ROOT CAUSE this replaces: the old path fetched each declared file via the
   942	        single-origin preview proxy (``GET …/preview-app/<path>``). That proxies the
   943	        agent's DEV SERVER, so it returns the file ONLY when the served preview is up,
   944	        registered, and serving that exact route — fragile. A build that genuinely
   945	        SUCCEEDED (index.html written, served, FINISHED) produced an EMPTY manifest
   946	        because the proxy 404'd → the OutputTruthOracle false-FAILed it
   947	        (FALSE_FINISH_NO_OUTPUT). Verified live: ``…/preview-app/index.html``,
   948	        ``…/workspace/index.html`` (image-only allowlist), and ``…/artifacts/index.html``
   949	        (declared-"files" only; an app deliverable is artifact_kind="app") ALL 404 for a
   950	        finished static build — there is no HTTP route that serves arbitrary workspace
   951	        source. The durable, dev-server-independent truth is the host ProjectStore
   952	        SNAPSHOT (``<projects_root>/<cid>/workspace/…``), the SAME source the product's
   953	        own preview-edit / artifact-download routes fall back to once a run is terminal.
   954	
   955	        Returns a manifest keyed by workspace-relative path:
   956	            {path: {"present": True, "size": int, "sha256": hex, "content": str}}
   957	        for EVERY file in the snapshot (a faithful workspace reflection, not just the
   958	        declared paths), plus each declared path under its EXACT scenario-declared key
   959	        so the OutputTruthOracle's ``path in files`` presence check matches. A declared
   960	        file that is genuinely absent is OMITTED (never a present:false key — that would
   961	        mask FALSE_FINISH_NO_OUTPUT into ARTIFACT_TRUTH_MISMATCH), so a real
   962	        missing-deliverable build STILL FAILs correctly. ``content`` is the decoded UTF-8
   963	        text (so must_contain substring checks run on the real file); a binary / oversized
   964	        file keeps present+size+sha256 with empty content.
   965	
   966	        Fallback: ONLY when there is NO snapshot at all (no projects_root configured, or
   967	        the conversation's snapshot workspace dir never materialized), each declared path
   968	        is fetched via the preview proxy — so a no-storage deployment is never WORSE than
   969	        before. When the snapshot IS authoritative (its workspace dir exists), the proxy
   970	        is NEVER consulted: a declared file absent from the snapshot is genuinely missing
   971	        and is OMITTED, so the proxy can't mask a missing required deliverable with a
   972	        served/stale copy (anti-false-PASS hole #1).
   973	        """
   974	        declared = list(file_paths)
   975	        manifest: dict[str, Any] = {}
   976	        snapshot_dir: Path | None = None
   977	
   978	        if self._projects_root is not None:
   979	            manifest, snapshot_dir = await self._await_ready_snapshot(conversation_id, declared)
   980	
   981	        # The snapshot is AUTHORITATIVE: return it as-is. A declared file absent from the
   982	        # snapshot stays OMITTED — never proxy-substituted (hole #1).
   983	        if snapshot_dir is not None:
   984	            return manifest
   985	
   986	        # No snapshot at all → legacy preview-proxy fallback (no-storage deployments only).
   987	        for path in declared:
   988	            if path in manifest:
   989	                continue
   990	            rel = path.lstrip("/")
   991	            status, text, _hdrs = await self._t.get_text(
   992	                f"/conversations/{conversation_id}/preview-app/{rel}"
   993	            )
   994	            if status < 400:
   995	                entry = _file_entry(text.encode("utf-8"))
   996	                entry["source"] = "preview_proxy"
   997	                manifest[path] = entry
   998	        return manifest
   999	
  1000	    async def _await_ready_snapshot(
  1001	        self, conversation_id: str, declared: list[str]
  1002	    ) -> tuple[dict[str, Any], Path | None]:
  1003	        """Poll the host ProjectStore snapshot until it has SETTLED on the build's
  1004	        AGENT-FINAL state, then return ``(manifest, snapshot_dir)``.
  1005	
  1006	        WHY (stale-read race): ``_maybe_snapshot`` mirrors the sandbox workspace to the
  1007	        ProjectStore AFTER the build appends a terminal event. A multi-revision build
  1008	        reaches a terminal per revision, so revision-1's files are already on disk
  1009	        (presence-complete) BEFORE revision-2's bytes flush — the old presence-only gate
  1010	        settled on STALE revision-1 content → a false ARTIFACT_TRUTH_MISMATCH. A timing
  1011	        window can't deterministically close that gap, so we gate on a DETERMINISTIC
  1012	        readiness signal derived from the build's own durable event log (NOT the scenario's
  1013	        expected assertion — gating on the assertion target would mask real failures).
  1014	
  1015	        Per declared file the agent's FINAL state (from ``_agent_declared_expected``) is one of:
  1016	          * sha — last op is ``file_write`` (full bytes in the payload): on-disk sha256 MATCH.
  1017	          * rendered — a partial edit was the last mutation but a FULL ``file_read`` readback
  1018	            after it carries the true post-edit bytes: the on-disk file RENDERED by file_read's
  1019	            own numberer must equal the readback (closes the partial-edit-last stale gap).
  1020	          * absent — the agent ``rm``'d it via shell: accept only when NOT on disk.
  1021	          * present_unproven — a partial edit with no provable post-state: extended stability.
  1022	          * unknown — no event-log signal at all: extended stability (present or absent).
  1023	
  1024	        Timeout = FAIL-FAST only for a CONTENT-PRECISE signal (sha / rendered / absent) still
  1025	        unsatisfied at the ``snapshot_wait_s`` deadline → raise ``SnapshotNotReadyError`` (→
  1026	        INVALID_RUN WORKSPACE_SNAPSHOT_NOT_READY). present_unproven / unknown files NEVER
  1027	        fail-fast (no content proof exists, and a legit edit-without-readback build must not
  1028	        become INVALID_RUN) — they settle on EXTENDED content-stability (+a logged warning) and
  1029	        are accepted best-effort at the deadline, preserving the genuinely-missing → OMITTED →
  1030	        FALSE_FINISH path. Already-consistent snapshots are accepted PROMPTLY, no needless wait."""
  1031	        try:
  1032	            events = self.collect_events(conversation_id)
  1033	        except sqlite3.Error:
  1034	            # No durable event log available (e.g. deterministic tests that don't seed the
  1035	            # DB) → no event signals; every declared file settles on content-stability.
  1036	            events = []
  1037	        expected = _agent_declared_expected(events, declared)
  1038	
  1039	        deadline = time.monotonic() + self._snapshot_wait_s
  1040	        prev_ident: dict[str, Any] = {}
  1041	        stable_n: dict[str, int] = {}
  1042	        manifest: dict[str, Any] = {}
  1043	        snapshot_dir: Path | None = None
  1044	        while True:
  1045	            snapshot_dir = self._snapshot_workspace_dir(conversation_id)
  1046	            manifest = (
  1047	                self._read_snapshot_manifest(conversation_id, declared, snapshot_dir)
  1048	                if snapshot_dir is not None
  1049	                else {}
  1050	            )
  1051	            # Content-stability bookkeeping: count consecutive identical (present+size+sha)
  1052	            # reads per declared file. A change resets the counter to this fresh observation.
  1053	            for p in declared:
  1054	                ident = _manifest_ident(manifest, p)
  1055	                if p in prev_ident and prev_ident[p] == ident:
  1056	                    stable_n[p] = stable_n.get(p, 1) + 1
  1057	                else:
