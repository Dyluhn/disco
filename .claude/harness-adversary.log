    63	class EventChainOracle:
    64	    def check(
    65	        self, events: list[dict[str, Any]], *, scenario: dict[str, Any] | None = None
    66	    ) -> list[OracleResult]:
    67	        # 1. submit -> user event
    68	        if not has_user_message(events):
    69	            return [
    70	                failing(
    71	                    _ORACLE,
    72	                    fc.NO_USER_EVENT_AFTER_SUBMIT,
    73	                    first_broken_link="submit -> user_event",
    74	                    facts={"user_event_present": False},
    75	                )
    76	            ]
    77	
    78	        # 2. user event -> plan event (only when the scenario requires the gate)
    79	        if _wants_plan_gate(scenario) and not has_plan(events):
    80	            return [
    81	                failing(
    82	                    _ORACLE,
    83	                    fc.NO_PLAN_AFTER_USER_TURN,
    84	                    first_broken_link="user_event -> plan_event",
    85	                    facts={"plan_event_present": False},
    86	                )
    87	            ]
    88	
    89	        # 3/4. The FULL ordered approval chain (§16). For a plan-gated run that
    90	        # reached a FINISHED terminal the durable facts must show, IN SEQ ORDER:
    91	        #
    92	        #   PlanEvent (A) < AWAITING_PLAN_APPROVAL (B) < RUNNING/plan_approved (C)
    93	        #                 < execution action (D)
    94	        #
    95	        # FAIL-CLOSED + non-circular: the chain is NOT gated on `plan_approved`
    96	        # already existing (a plan that finished WITHOUT approval would slip past),
    97	        # and the human-approval gate (B) must PRECEDE the approval (C) — a
    98	        # `plan_approved` with no preceding AWAITING is a forged/skipped gate.
    99	        #
   100	        # AUTONOMOUS EXCEPTION: an autonomous build auto-approves INLINE (engine.py
   101	        # ~L855) emitting RUNNING/plan_approved with NO awaiting status — that is a
   102	        # LEGITIMATE chain, so the B link is required only for interactive runs.
   103	        #
   104	        # STUCK is judged too (codex #1): the loop's approve-but-never-execute exit
