  1287	    def _snapshot_served_index(self, conversation_id: str) -> Path | None:
  1288	        """The durable served-root ``index.html`` Path for a STATIC build: at the snapshot
  1289	        workspace root (preferred), else the shallowest ``index.html`` in the tree —
  1290	        MIRRORING the product's ``lifecycle._find_snapshot_index`` skip set
  1291	        (``.pmx`` / ``.disco`` / ``node_modules``) so an internal ``index.html`` is never
  1292	        picked as the served root. Symlink-jailed (resolved path must stay inside the
  1293	        workspace). None ⇒ no static served-root (so the caller does NOT claim a preview)."""
  1294	        ws = self._snapshot_workspace_dir(conversation_id)
  1295	        if ws is None:
  1296	            return None
  1297	        candidates: list[Path] = []
  1298	        root_index = ws / "index.html"
  1299	        if root_index.is_file():
  1300	            candidates = [root_index]
  1301	        else:
  1302	            try:
  1303	                candidates = sorted(
  1304	                    (
  1305	                        p
  1306	                        for p in ws.rglob("index.html")
  1307	                        if p.is_file() and not (_SERVE_SKIP_DIRS & set(p.relative_to(ws).parts))
  1308	                    ),
  1309	                    key=lambda p: (len(p.relative_to(ws).parts), str(p)),
  1310	                )
  1311	            except OSError:
  1312	                return None
  1313	        for cand in candidates:
  1314	            try:
  1315	                resolved = cand.resolve()
  1316	                if resolved.is_relative_to(ws) and resolved.is_file():
  1317	                    return resolved
  1318	            except OSError:
  1319	                continue
  1320	        return None
  1321	
  1322	    def _snapshot_served_root(self, conversation_id: str) -> str | None:
  1323	        """The served-root ``index.html`` CONTENT (decoded) — thin wrapper over
  1324	        :meth:`_snapshot_served_index` (which handles root-preference, the
  1325	        ``.pmx``/``.disco``/``node_modules`` skip set, and the symlink jail). None ⇒ no
  1326	        static served-root."""
  1327	        p = self._snapshot_served_index(conversation_id)
  1328	        if p is None:
  1329	            return None
  1330	        try:
  1331	            return p.read_bytes().decode("utf-8")
  1332	        except (OSError, UnicodeDecodeError):
  1333	            return None
  1334	
  1335	    def _in_run_verify_failed(self, conversation_id: str) -> bool:
  1336	        """True iff the build's LAST in-run ``verify_web_app`` FAILED — where FAILED means
  1337	        ANY of: ``structured.passed`` is False; the tool FAILED TO EXECUTE
  1338	        (``tool_result.success`` is False, which produces NO verdict — hole #2); or it ran
  1339	        but the verdict/error signals failure. Only a verify that genuinely PASSED (ran
  1340	        successfully AND ``passed`` truthy) leaves this False, so the durable-preview
  1341	        substitution never fires off a verify that errored or failed. No verify at all ⇒
  1342	        False (a static deliverable that finished with no serve-check is not a PROVEN
  1343	        failure; the served-root presence + content truth still gate the substitution)."""
  1344	        last: dict[str, Any] | None = None
  1345	        for e in self._read_events(conversation_id):
  1346	            if e.get("kind") != "observation":
  1347	                continue
  1348	            tr = _payload(e).get("tool_result") or {}
  1349	            if tr.get("tool_name") == "verify_web_app":
  1350	                last = tr
  1351	        if last is None:
  1352	            return False
  1353	        if not last.get("success", True):
  1354	            return True  # verifier EXECUTION failure — no verdict produced (hole #2)
  1355	        raw_structured = last.get("structured")
  1356	        structured: dict[str, Any] = raw_structured if isinstance(raw_structured, dict) else {}
  1357	        if structured.get("passed") is False:
  1358	            return True
  1359	        if str(structured.get("verdict", "")).lower() in {"fail", "failed", "error", "broken"}:
  1360	            return True
  1361	        return bool(structured.get("error"))
  1362	
  1363	    # -- internal: race-free DB read ------------------------------------------
  1364	
  1365	    def _read_events(self, conversation_id: str) -> list[dict[str, Any]]:
  1366	        uri = f"file:{self._db_path}?mode=ro"
  1367	        conn = sqlite3.connect(uri, uri=True)
  1368	        try:
  1369	            conn.row_factory = sqlite3.Row
  1370	            rows = conn.execute(
  1371	                "SELECT seq, kind, source, id, created_at, payload "
  1372	                "FROM events WHERE conversation_id = ? ORDER BY seq",
  1373	                (conversation_id,),
  1374	            ).fetchall()
  1375	        finally:
  1376	            conn.close()
  1377	        return [
  1378	            {
  1379	                "seq": r["seq"],
  1380	                "kind": r["kind"],
  1381	                "source": r["source"],
  1382	                "id": r["id"],
  1383	                "created_at": r["created_at"],
  1384	                "payload": r["payload"],  # JSON string — normalizer parses it
  1385	            }
  1386	            for r in rows
  1387	        ]
