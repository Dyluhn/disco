  1221	    # instance id(s). Parallel lanes may have live sandboxes after our release; those are not this
  1222	    # run's orphans. Volumes are RUNNING-independent: a leaked `disco-ws-{sandbox_id}` still counts
  1223	    # after the container is gone. If the server version cannot expose ids, keep the old global
  1224	    # baseline delta as the serial/fail-closed fallback; for unnamed image VOLUME leaks, use the
  1225	    # newly-dangling volume delta from the run window.
  1226	    sandbox_ids = _extract_sandbox_instance_ids(getattr(run, "state_final", {}) or {}, release_resp)
  1227	    if sandbox_ids and after_container_names is not None:
  1228	        container_orphans = _scoped_disco_container_count(after_container_names, sandbox_ids)
  1229	        named_volume_orphans = (
  1230	            _scoped_disco_volume_count(after_volume_names, sandbox_ids)
  1231	            if after_volume_names is not None
  1232	            else None
  1233	        )
  1234	        unnamed_volume_orphans = _new_dangling_volume_count(
  1235	            baseline_dangling_volumes, after_dangling_volumes, exclude_disco_named=True
  1236	        )
  1237	        volume_parts = [
  1238	            count for count in (named_volume_orphans, unnamed_volume_orphans) if count is not None
  1239	        ]
  1240	        volume_orphans = sum(volume_parts) if volume_parts else None
  1241	        total_orphans = (
  1242	            container_orphans + volume_orphans
  1243	            if volume_orphans is not None
  1244	            else container_orphans
  1245	        )
  1246	        ev["cleanup"] = {
  1247	            "orphans": total_orphans,
  1248	            "workspace_released": released_ok and volume_orphans is not None and total_orphans == 0,
  1249	            "scope": "conversation",
  1250	            "container_orphans": container_orphans,
  1251	            "volume_orphans": volume_orphans,
  1252	            "volume_scope": "conversation",
  1253	        }
  1254	    elif baseline_containers is not None and after_container_names is not None:
  1255	        after_containers = len(after_container_names)
  1256	        container_orphans = max(0, after_containers - baseline_containers)
  1257	        volume_orphans = _new_dangling_volume_count(
  1258	            baseline_dangling_volumes, after_dangling_volumes, exclude_disco_named=False
  1259	        )
  1260	        total_orphans = (
  1261	            container_orphans + volume_orphans
  1262	            if volume_orphans is not None
  1263	            else container_orphans
  1264	        )
  1265	        ev["cleanup"] = {
  1266	            "orphans": total_orphans,
  1267	            "workspace_released": released_ok and volume_orphans is not None and total_orphans == 0,
  1268	            "scope": "global",
  1269	            "container_orphans": container_orphans,
  1270	            "volume_orphans": volume_orphans,
  1271	            "volume_scope": "global_dangling",
  1272	        }
  1273	
  1274	    with contextlib.suppress(Exception):
  1275	        run.product_evidence = ev  # CollectedRun is a plain dataclass — attach the populated slices
