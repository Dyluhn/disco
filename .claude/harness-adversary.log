   229	
   230	# Every product failure code, for validation.
   231	PRODUCT_FAILURE_CODES = frozenset(SEVERITY_BY_CODE)
   232	
   233	# The "intermittent" prefix (§17): a run that failed once then passed on exact
   234	# replay is recorded as FAIL with code INTERMITTENT_<original_code>, same severity.
   235	INTERMITTENT_PREFIX = "INTERMITTENT_"
   236	
   237	
   238	def severity_for(code: str) -> str:
   239	    """Severity for a (possibly INTERMITTENT_-prefixed) failure code. Unknown
   240	    codes are treated as P0 (§13: an unclassified failure is a release blocker)."""
   241	    base = code[len(INTERMITTENT_PREFIX):] if code.startswith(INTERMITTENT_PREFIX) else code
   242	    return SEVERITY_BY_CODE.get(base, P0)
   243	
   244	
   245	def is_known_code(code: str) -> bool:
   246	    base = code[len(INTERMITTENT_PREFIX):] if code.startswith(INTERMITTENT_PREFIX) else code
   247	    return base in PRODUCT_FAILURE_CODES or base in HARNESS_VALIDITY_CODES

