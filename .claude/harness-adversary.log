   961	def _podman_volume_names(args: list[str]) -> list[str] | None:
   962	    try:
   963	        out = subprocess.run(
   964	            args,
   965	            capture_output=True, text=True, timeout=15, check=False,
   966	        )
   967	    except Exception:
   968	        return None
   969	    if out.returncode != 0:
   970	        return None
   971	    names: list[str] = []
   972	    for line in out.stdout.splitlines():
   973	        clean = line.strip()
   974	        if clean:
   975	            names.append(clean)
   976	    return names
