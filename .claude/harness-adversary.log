  1366	                out_root, run_id, scenario, f"{type(exc).__name__}: {exc}"
  1367	            )
  1368	
  1369	        # [REL-5] Measure terminal cleanup + release BEFORE freezing the dossier, so the
  1370	        # lifecycle / sidecar / cleanup oracles ADJUDICATE (instead of SKIP "no evidence
  1371	        # (headless run)"). The build's §6 evidence is already frozen into `run` by
  1372	        # drive_scenario, so releasing here never races it. Populates run.product_evidence.
  1373	        try:
  1374	            ev = await _collect_terminal_cleanup_evidence(
  1375	                client, run.conversation_id, run,
  1376	                baseline_containers=baseline_containers,
  1377	                relay_log=_relay_log_path(),
  1378	                timeline=getattr(run, "timeline", []),
  1379	                baseline_dangling_volumes=baseline_dangling_volumes,
  1380	            )
  1381	        except Exception as exc:  # noqa: BLE001
