   358	        # so it mirrors the agent-server's OWN default root resolution (same env), and
   359	        # the snapshot unit test injects a tmp root.
   360	        self._projects_root = projects_root
   361	        # How long to wait for the snapshot to flush after the run reaches a terminal
   362	        # state — the build appends FINISHED INSIDE loop.run(), then `_maybe_snapshot`
   363	        # writes the workspace to the ProjectStore; a fast collect can read between the
   364	        # two. Re-read the snapshot until every declared file is present (or this budget
   365	        # elapses) so a genuinely-present file is never reported missing.
   366	        self._snapshot_wait_s = snapshot_wait_s
   367	        # The conversation_id this client most recently CREATED (set in
   368	        # create_build_conversation). Lets the runner reach the cid for teardown even when
   369	        # drive_scenario raised before returning a CollectedRun (so an abandoned RUNNING
   370	        # build can still be killed from run_once's finally). None until a create succeeds.
   371	        self.last_conversation_id: str | None = None
   372	
   373	    # -- pre-create infra probe (§9; the ONLY infra source) -------------------
   374	
   375	    async def pre_create_probe(self, model: str | None) -> None:
   376	        """Probe the agent-server (and, transitively, the model provider) BEFORE
   377	        creating a conversation. Raise InfraProbeError on a matched signature; the
   378	        caller maps that to INFRA_FAILURE with bounded retry (per infra_signatures).
   379	
   380	        We probe the server health endpoint — a connection error / 5xx here is a
   381	        pre-create, runner-side infra condition. (A provider 429/5xx that only shows
   382	        up mid-loop is POST-create and is therefore a PRODUCT outcome, never infra.)
   383	        """
   384	        try:
   385	            status, _body = await self._t.health()
   386	        except _PRECREATE_INFRA_ERRORS as exc:
   387	            raise InfraProbeError(
   388	                "agent_server_unreachable_before_conversation",
   389	                {
   390	                    "component": "agent_server",
   391	                    "error_kind": _classify_conn_error(exc),
   392	                    "error": str(exc),
   393	                },
   394	            ) from exc
   395	        if status in (500, 502, 503, 504):
   396	            raise InfraProbeError(
   397	                "provider_5xx_before_conversation",
   398	                {"component": "agent_server", "http_status": status},
   399	            )
   400	        if status == 429:
   401	            raise InfraProbeError(
   402	                "provider_429_before_conversation",
   403	                {"component": "agent_server", "http_status": status},
   404	            )
   405	        # model is advisory here — the agent-server's own /health is the gate; a
   406	        # bad model surfaces post-create as StatusEvent(ERROR) (a product outcome).
   407	
   408	    # -- create + drive -------------------------------------------------------
   409	
   410	    async def create_build_conversation(
   411	        self, prompt: str, *, model: str | None = None, autonomous: bool = False
   412	    ) -> str:
   413	        """POST /conversations (surface=build) then POST the user message (which the
   414	        route appends AND kicks). Returns the conversation_id."""
   415	        body: dict[str, Any] = {"surface": "build", "autonomous": autonomous}
   416	        if model:
   417	            body["model_override"] = model
   418	        status, data = await self._t.post_json("/conversations", body)
   419	        if status >= 400 or "conversation_id" not in data:
   420	            raise RuntimeError(f"create_conversation failed: HTTP {status} {data}")
   421	        cid = str(data["conversation_id"])
   422	        # Record the created cid IMMEDIATELY (before the kick) so the runner can tear it
   423	        # down even if the subsequent message POST / drive raises — a created-but-abandoned
   424	        # conversation must never leak as a RUNNING build on the shared server.
   425	        self.last_conversation_id = cid
   426	        # POST the user task — appends the USER message AND kicks the loop.
   427	        mstatus, _ = await self._t.post_json(
   428	            f"/conversations/{cid}/messages", {"content": prompt}
   429	        )
   430	        if mstatus >= 400:
   431	            raise RuntimeError(f"post_message failed: HTTP {mstatus}")
   432	        return cid
   433	
   434	    async def approve_plan(self, conversation_id: str) -> None:
   435	        """Approve the pending plan via the REAL WS plan gate (routes/ws.py:95)."""
   436	        await self._t.ws_control(conversation_id, {"type": "approve_plan"})
   437	
   438	    async def confirm(self, conversation_id: str) -> None:
   439	        """Confirm a pending RISKY ACTION via the REAL WS confirmation gate
   440	        (routes/ws.py:89 -> runtime.confirm -> ControlOps.confirm -> loop.confirm() + kick).
   441	        This is the confirmation ANALOGUE of approve_plan, NOT a free-text message: a plain
   442	        user `send_message` does NOT clear a WAITING_FOR_CONFIRMATION gate — only the dedicated
   443	        `confirm` control frame executes the pending action and resumes the loop past the gate."""
   444	        await self._t.ws_control(conversation_id, {"type": "confirm"})
   445	
   446	    async def resolve_decision(
   447	        self, conversation_id: str, *, preferred_option_id: str | None = None
   448	    ) -> dict[str, Any] | None:
   449	        """Auto-resolve an AWAITING_USER_DECISION gate by picking one of the agent's proposed
   450	        alternatives — the runner ACTS AS THE USER for a non-interactive soak. Routed through
   451	        the REAL decision mechanism: the WS `pick_alternative` frame (routes/ws.py:108 →
   452	        runtime.pick_alternative), NOT approve_plan (a plan gate) — the loop synthesizes the
   453	        picked option's ToolCall as the next action and resumes.
   454	
   455	        STATE-BIND before selecting (never auto-resolve the wrong / a stale branch): re-read
   456	        the CURRENT conversation state and require it is STILL AWAITING_USER_DECISION with a
   457	        LIVE `pending_alternatives_id` (the state machine recomputes this from the full event
   458	        log every read, so it is always the live pending gate). Bind the options to THAT id by
   459	        reading the matching AlternativesEvent from the durable log; require a non-empty option
   460	        list with valid ids. Selection: the caller's `preferred_option_id` (scenario override)
   461	        if it names a valid option, else a recommended option (recommendation flag), else the
   462	        first valid option.
   463	
   464	        Returns {alternatives_id, option_id} on a successful pick, or None when the gate is no
   465	        longer live / the payload is invalid (no pending id, no valid options) — the caller
   466	        treats None as a HARD signal (never a clean pass)."""
   467	        state = await self.get_state(conversation_id)
   468	        if self._status_of(state) != AWAITING_USER_DECISION:
   469	            return None
   470	        alt_id = state.get("pending_alternatives_id")
   471	        if not alt_id:
   472	            return None
   473	        options = self._alternatives_options(conversation_id, str(alt_id))
   474	        chosen = _choose_alternative(options, preferred_option_id)
   475	        if chosen is None:
   476	            return None
   477	        await self._t.ws_control(
   478	            conversation_id, {"type": "pick_alternative", "option_id": chosen}
   479	        )
   480	        return {"alternatives_id": str(alt_id), "option_id": chosen}
   481	
   482	    def _alternatives_options(
   483	        self, conversation_id: str, alternatives_id: str
   484	    ) -> list[dict[str, Any]]:
   485	        """The option list of the AlternativesEvent whose id == `alternatives_id` (the live
   486	        pending gate), read from the durable event log. Empty when absent / malformed."""
   487	        try:
   488	            events = self._read_events(conversation_id)
   489	        except sqlite3.Error:
   490	            return []
   491	        for e in events:
   492	            if e.get("kind") != "alternatives":
   493	                continue
   494	            p = _payload(e)
   495	            if str(e.get("id") or p.get("id") or "") != str(alternatives_id):
   496	                continue
   497	            opts = p.get("options")
   498	            if isinstance(opts, list):
   499	                return [o for o in opts if isinstance(o, dict)]
   500	        return []
   501	
   502	    async def resume(self, conversation_id: str) -> dict[str, Any]:
   503	        """Resume a PAUSED (cooperative / actionless) run — the runner ACTS AS THE
   504	        USER who hits Resume. POST /conversations/{cid}/resume (conversations.py:284,
   505	        the same mode-agnostic path the WS `resume` frame uses). A 409 (not resumable)
   506	        is returned as-is so the caller can stop retrying.
   507	
   508	        The HTTP code is returned under `http_status` (NOT `status`): the resume body
   509	        itself carries a ``status`` field (e.g. ``{"ok": true, "status": "RUNNING"}``), so
   510	        merging it under the same key would clobber the HTTP int with the body's STATE
   511	        STRING — the caller's ``int(resp["status"])`` then crashed the whole drive with
   512	        ``ValueError: invalid literal for int() ... 'RUNNING'`` the moment a build paused."""
   513	        status, data = await self._t.post_json(
   514	            f"/conversations/{conversation_id}/resume", {}
   515	        )
   516	        return {"http_status": status, **(data if isinstance(data, dict) else {})}
   517	
   518	    async def kill(self, conversation_id: str) -> dict[str, Any]:
   519	        """KILL (force-terminate) a conversation the runner is DONE with — the hygiene
   520	        teardown so an abandoned RUNNING / PAUSED / AWAITING build the runner stopped
   521	        watching (inconclusive cutoff, error path, or post-evidence release) does not
   522	        leak and load the shared server. POST /conversations/{cid}/kill
   523	        (conversations.py:275 — halts the agent, tears down its sandbox, revokes its
   524	        capabilities). IDEMPOTENT: a kill on an already-terminal conversation is harmless.
   525	
   526	        The HTTP code is returned under `http_status` (mirrors :meth:`resume`); the route
   527	        body is ``{"killed": true, "state": {...}}``. Returns ``{"http_status": int, ...}``."""
   528	        status, data = await self._t.post_json(
   529	            f"/conversations/{conversation_id}/kill", {}
   530	        )
   531	        return {"http_status": status, **(data if isinstance(data, dict) else {})}
   532	
   533	    async def send_followup(
   534	        self, conversation_id: str, text: str, *, kind: str = "message"
   535	    ) -> None:
   536	        """Send a follow-up over the REAL WS path. `kind`:
   537	          * "message"      -> {"type":"send_message"}  (after-terminal user follow-up:
   538	                              appended + kick; the PRODUCT decides to re-plan)
   539	          * "steer"        -> {"type":"steer"}         (mid-run redirect of a RUNNING
   540	                              agent — the §15.4 after-first-file-write injection)
   541	          * "request_plan" -> {"type":"request_plan"}  (explicit re-plan gate)
   542	        """
   543	        if kind == "steer":
   544	            frame = {"type": "steer", "steer_text": text}
   545	        elif kind == "request_plan":
   546	            frame = {"type": "request_plan", "content": text}
   547	        else:
   548	            frame = {"type": "send_message", "content": text}
   549	        await self._t.ws_control(conversation_id, frame)
   550	
   551	    # -- polling --------------------------------------------------------------
   552	
   553	    async def get_state(self, conversation_id: str) -> dict[str, Any]:
   554	        status, data = await self._t.get_json(f"/conversations/{conversation_id}/state")
   555	        if status >= 400:
   556	            raise RuntimeError(f"get_state failed: HTTP {status}")
   557	        return data
   558	
   559	    @staticmethod
   560	    def _status_of(state: dict[str, Any]) -> str:
   561	        return str(state.get("execution_status") or state.get("status") or "")
   562	
   563	    def _progress_marker(self, conversation_id: str) -> tuple[int, int]:
   564	        """A cheap PROGRESS fingerprint for the conversation: (event_count, max_seq) from
   565	        the durable event log. Either advancing means the build is STILL PRODUCING new
   566	        events — the signal the progress-aware wait resets its inactivity timer on (Bug 15).
   567	        A missing/locked DB reads as no-progress (-1) rather than crashing the poll."""
   568	        uri = f"file:{self._db_path}?mode=ro"
   569	        try:
   570	            conn = sqlite3.connect(uri, uri=True)
   571	        except sqlite3.Error:
   572	            return (0, -1)
   573	        try:
   574	            row = conn.execute(
   575	                "SELECT COUNT(*), COALESCE(MAX(seq), -1) FROM events WHERE conversation_id = ?",
   576	                (conversation_id,),
   577	            ).fetchone()
   578	        except sqlite3.Error:
   579	            return (0, -1)
   580	        finally:
   581	            conn.close()
   582	        return (int(row[0]), int(row[1])) if row else (0, -1)
   583	
   584	    async def _poll_progress_aware(
   585	        self,
   586	        conversation_id: str,
   587	        *,
   588	        stop_on_gate: bool,
   589	        inactivity_s: float,
   590	        hard_cap_s: float,
   591	        min_terminal_seq: int | None = None,
   592	    ) -> str:
   593	        """The shared PROGRESS-AWARE terminal wait (Bug 15). Poll GET /state until EITHER:
   594	          (a) a genuine terminal / gate / pause status is reached → return it; OR
   595	          (b) the build goes GENUINELY INACTIVE — no NEW events and no status change for
   596	              `inactivity_s` → return INACTIVE_TIMEOUT (a real wedge: classify normally); OR
   597	          (c) the generous `hard_cap_s` ceiling is hit. If the build was STILL progressing
   598	              within the last inactivity window when the cap hit → PROGRESSING_TIMEOUT
   599	              (inconclusive, NOT a product fail); otherwise → INACTIVE_TIMEOUT.
   600	
   601	        A still-actively-progressing build is NEVER cut off by a mere wall-clock elapsing:
   602	        the inactivity timer RESETS whenever the event count / max seq advances OR the status
   603	        transitions. Only genuine silence or the safety ceiling ends the wait.
   604	
   605	        IDLE RACE (live-surfaced): POST /messages KICKS the loop ASYNCHRONOUSLY, so a freshly
   606	        -created conversation reads IDLE for a beat before the kick stamps RUNNING. IDLE is
   607	        terminal for adjudication but ambiguous as a DRIVE-STOP — pre-kick "not started yet"
   608	        vs parked "nothing left". We only stop on IDLE once the run has gone active at least
   609	        once (`seen_active`); a pre-kick IDLE is ignored so we don't bail before it plans."""
   610	        start = time.monotonic()
   611	        last_progress = start
   612	        marker = self._progress_marker(conversation_id)
   613	        last_status: str | None = None
   614	        seen_active = False
   615	        while True:
   616	            last = self._status_of(await self.get_state(conversation_id))
   617	            if stop_on_gate and last in GATE_STATES:
   618	                return last
   619	            # A WORK terminal only ENDS the wait when it is the follow-up's OWN new terminal
   620	            # (`min_terminal_seq` guard): with a baseline set, a terminal whose durable event
   621	            # seq <= the baseline is the STALE pre-follow-up terminal — do NOT return on it,
   622	            # keep waiting for the follow-up's own new terminal (seq > baseline). min=None
   623	            # (the default, non-follow-up drive) ⇒ any terminal counts, unchanged behavior.
   624	            if last in _WORK_TERMINALS and self._terminal_is_new(
   625	                conversation_id, min_terminal_seq
   626	            ):
   627	                return last
   628	            if last == PAUSED_STATE:
   629	                # a cooperative / actionless PAUSE — the driver decides (resume or stop).
   630	                return last
   631	            if last == "IDLE":
   632	                if seen_active and self._terminal_is_new(conversation_id, min_terminal_seq):
   633	                    return last
   634	                # pre-kick / settling (or a stale pre-follow-up terminal) — keep waiting.
   635	            else:
   636	                seen_active = True  # RUNNING or any active transitional status
   637	
   638	            now = time.monotonic()
   639	            # Progress = new events appeared OR the status transitioned since last poll.
   640	            cur_marker = self._progress_marker(conversation_id)
   641	            if cur_marker != marker or last != last_status:
   642	                marker = cur_marker
   643	                last_status = last
   644	                last_progress = now
   645	
   646	            inactive_for = now - last_progress
   647	            if now - start >= hard_cap_s:
   648	                # Safety ceiling. Was it still progressing recently? Then this is an
   649	                # inconclusive model-speed cutoff, NOT a wedge → PROGRESSING_TIMEOUT.
   650	                return (
   651	                    PROGRESSING_TIMEOUT if inactive_for < inactivity_s else INACTIVE_TIMEOUT
   652	                )
   653	            if inactive_for >= inactivity_s:
   654	                return INACTIVE_TIMEOUT
   655	            await asyncio.sleep(self._poll)
   656	
   657	    async def poll_until_terminal_or_gate(
   658	        self,
   659	        conversation_id: str,
   660	        *,
   661	        inactivity_s: float,
   662	        hard_cap_s: float,
   663	        min_terminal_seq: int | None = None,
   664	    ) -> str:
   665	        """Progress-aware wait that ALSO stops on a GATE the runner must act on (e.g.
   666	        AWAITING_PLAN_APPROVAL). Returns the terminal/gate/pause status, or a Bug-15
   667	        timeout sentinel (INACTIVE_TIMEOUT / PROGRESSING_TIMEOUT). `min_terminal_seq`
   668	        (H1/V2): when set, a terminal whose durable event seq <= it is the STALE
   669	        pre-follow-up terminal and does NOT end the wait — only the follow-up's OWN new
   670	        terminal (seq > min_terminal_seq) does."""
   671	        return await self._poll_progress_aware(
   672	            conversation_id,
   673	            stop_on_gate=True,
   674	            inactivity_s=inactivity_s,
   675	            hard_cap_s=hard_cap_s,
   676	            min_terminal_seq=min_terminal_seq,
   677	        )
   678	
   679	    async def poll_until_terminal(
   680	        self,
   681	        conversation_id: str,
   682	        *,
   683	        inactivity_s: float,
   684	        hard_cap_s: float,
   685	        min_terminal_seq: int | None = None,
   686	    ) -> str:
   687	        """Progress-aware wait to a strictly TERMINAL state (no gate stop). Used after a
   688	        plan is approved / for autonomous runs with no interactive gate. `min_terminal_seq`
   689	        (H1/V2): only a terminal whose durable event seq > it ends the wait (the follow-up's
   690	        OWN new terminal), never the stale pre-follow-up one."""
   691	        return await self._poll_progress_aware(
   692	            conversation_id,
   693	            stop_on_gate=False,
   694	            inactivity_s=inactivity_s,
   695	            hard_cap_s=hard_cap_s,
   696	            min_terminal_seq=min_terminal_seq,
   697	        )
   698	
   699	    async def wait_until_status_leaves(
   700	        self, conversation_id: str, status: str, *, timeout_s: float
   701	    ) -> str:
   702	        """After acting on a gate (e.g. approving a plan), wait for the status to move
   703	        OFF that gate before driving again — so a not-yet-processed approval isn't
   704	        re-read as the same gate and double-approved. Returns the new status (or the
   705	        unchanged one on timeout)."""
   706	        deadline = time.monotonic() + timeout_s
   707	        last = status
   708	        while time.monotonic() < deadline:
   709	            last = self._status_of(await self.get_state(conversation_id))
   710	            if last != status:
   711	                return last
   712	            await asyncio.sleep(self._poll)
   713	        return last
   714	
   715	    def _latest_plan_revision(self, conversation_id: str) -> int:
   716	        """Highest plan-event revision in the durable log (0 when no plan exists yet).
   717	        Mirrors events.latest_plan_revision but reads the DB directly so the adapter
   718	        stays oracle-import-free. A re-plan appends a NEW PlanEvent whose `revision`
   719	        increments, so a bump here is hard evidence a follow-up was PICKED UP + re-planned."""
   720	        best = 0
   721	        for e in self._read_events(conversation_id):
   722	            if e.get("kind") != "plan":
   723	                continue
   724	            rev = _payload(e).get("revision", 1)
   725	            try:
   726	                best = max(best, int(rev))
   727	            except (TypeError, ValueError):
   728	                continue
   729	        return best
   730	
   731	    def _planning_reentry_since(self, conversation_id: str, after_seq: int) -> bool:
   732	        """True when a RE-PLAN re-entry status (detail == `planning`) appears at seq >
   733	        after_seq. enter_planning stamps this on a re-plan but NOT on the first build turn
   734	        (a plain RUNNING with no detail) — so it is a genuine pickup-of-follow-up signal,
   735	        not the initial plan. `after_seq` is the baseline max seq captured BEFORE the send."""
   736	        for e in self._read_events(conversation_id):
   737	            if e.get("kind") != "status" or int(e.get("seq", -1)) <= after_seq:
   738	                continue
   739	            if (_payload(e).get("detail") or None) == _PLANNING_DETAIL:
   740	                return True
   741	        return False
   742	
   743	    def _progress_event_since(self, conversation_id: str, after_seq: int) -> bool:
   744	        """True when the FIRST genuine NON-USER PROGRESS event appears at seq > after_seq —
   745	        the EVENT-SEQUENCED pickup signal (V2). The engine actually processing the follow-up
   746	        produces a new durable event: an action, an observation, a plan, an agent_error, an
   747	        AGENT/assistant message, or a RUNNING / gate / `planning` status. Detectable EVEN WHEN
   748	        the conversation STATUS stays at the prior terminal (FINISHED) — a follow-up appended
   749	        during run finalization causes NO status change, the exact dead-window V1 missed.
   750	
   751	        A bare USER-MESSAGE append (kind=message, source=user) is explicitly NOT progress: the
   752	        append itself bumps the event seq but is not processing — that is precisely the
   753	        stale-terminal red herring this guards against, so it is skipped, never a pickup."""
   754	        for e in self._read_events(conversation_id):
   755	            if int(e.get("seq", -1)) <= after_seq:
   756	                continue
   757	            kind = e.get("kind")
   758	            if kind == "message":
   759	                if (e.get("source") or "") == "user":
   760	                    continue  # the user-message APPEND itself is NOT pickup (the red herring)
   761	                return True  # an agent/assistant message = the engine produced output
   762	            if kind in ("action", "observation", "plan", "agent_error"):
   763	                return True
   764	            if kind == "status":
   765	                p = _payload(e)
   766	                st = p.get("status")
   767	                if (
   768	                    st == "RUNNING"
   769	                    or st in GATE_STATES
   770	                    or (p.get("detail") or None) == _PLANNING_DETAIL
   771	                ):
   772	                    return True
   773	        return False
   774	
   775	    def _latest_terminal_seq(self, conversation_id: str) -> int:
   776	        """The seq of the MOST RECENT terminal status event in the durable log (-1 when none).
   777	        Used to require a follow-up's OWN NEW terminal (a terminal EVENT with seq > the
   778	        baseline) before the drive returns — so the STALE pre-follow-up terminal can never be
   779	        mistaken for the follow-up's completion (the piece V1 missed)."""
   780	        best = -1
   781	        for e in self._read_events(conversation_id):
   782	            if e.get("kind") != "status":
   783	                continue
   784	            if _payload(e).get("status") in TERMINAL_STATES:
   785	                best = max(best, int(e.get("seq", -1)))
   786	        return best
   787	
   788	    def _terminal_is_new(self, conversation_id: str, min_terminal_seq: int | None) -> bool:
   789	        """Whether a terminal status reached NOW is the follow-up's OWN new terminal — its
   790	        durable terminal event has seq > `min_terminal_seq` — rather than the STALE
   791	        pre-follow-up terminal. None ⇒ no baseline guard (any terminal counts, the default)."""
   792	        if min_terminal_seq is None:
   793	            return True
   794	        return self._latest_terminal_seq(conversation_id) > min_terminal_seq
   795	
   796	    async def capture_followup_baseline(self, conversation_id: str) -> dict[str, Any]:
   797	        """Snapshot the state needed to detect REAL pickup of the NEXT follow-up (H1),
   798	        captured BEFORE send_followup. `max_seq` is the PRIMARY anchor (V2): pickup and the
   799	        follow-up's own new terminal are both measured as events at seq > max_seq.
   800	          * `max_seq` — the latest durable event seq; the baseline for BOTH the event-sequenced
   801	            pickup detector (a non-user progress event past it) AND the min_terminal_seq drive
   802	            guard (the follow-up's OWN new terminal must have seq > it, not the stale one);
   803	          * `plan_revision` — the latest plan revision so a re-plan bump is detectable;
   804	          * `status` — the build's current (prior-terminal) status, e.g. FINISHED (a
   805	            belt-and-suspenders signal only; a follow-up appended during finalization leaves
   806	            the status UNCHANGED, so the seq — not the status — is what V2 keys on).
   807	        Deliberately does NOT use a bare event-count bump as pickup — the user-message append
   808	        alone bumps the seq, and the append is NOT processing (that red herring is the bug)."""
   809	        status = self._status_of(await self.get_state(conversation_id))
   810	        return {
   811	            "status": status,
   812	            "plan_revision": self._latest_plan_revision(conversation_id),
   813	            "max_seq": self._progress_marker(conversation_id)[1],
   814	        }
   815	
   816	    async def wait_for_followup_pickup(
   817	        self,
   818	        conversation_id: str,
   819	        baseline: dict[str, Any],
   820	        *,
   821	        timeout_s: float | None = None,
   822	    ) -> str:
   823	        """SERIALIZE after-terminal follow-ups (H1): after send_followup, BLOCK until the
   824	        engine actually PICKS UP this follow-up — measured against `baseline` (captured
   825	        BEFORE the send) — so the NEXT follow-up is not piled on top of an unprocessed one
   826	        and collapsed into a single plan revision.
   827	
   828	        EVENT-SEQUENCED (V2 — V1 was status-only and timed out): pickup is detected from the
   829	        durable EVENT LOG relative to `baseline.max_seq`, NOT from a status change. A follow-up
   830	        appended while the prior run is FINALIZING causes NO status change (status stays
   831	        FINISHED) — V1 watched the status, saw nothing, timed out, and PROCEEDED, letting
   832	        follow-up 2 collapse into follow-up 1. V2 returns as soon as there is REAL pickup
   833	        evidence relative to the baseline:
   834	          * FOLLOWUP_REPLANNED — a re-plan: the latest plan revision bumped above baseline, OR
   835	            a `planning` re-entry status appeared past the baseline seq; OR
   836	          * FOLLOWUP_PICKED_UP — the FIRST non-user PROGRESS event (action / observation / plan
   837	            / agent message / RUNNING-or-gate status) appeared at seq > the baseline seq — the
   838	            engine began processing, EVEN IF the status is still FINISHED. (Belt-and-suspenders:
   839	            a genuine status change off the prior terminal also counts.)
   840	
   841	        A new event seq caused MERELY by the user-message append is NOT treated as pickup —
   842	        the append itself is not processing (that is precisely the stale-terminal red herring
   843	        this guards against), so the raw event marker is never a pickup signal.
   844	
   845	        BOUNDED by `timeout_s` (default = the policy-driven `_followup_pickup_timeout_s()`):
   846	        on timeout it RETURNS FOLLOWUP_PICKUP_TIMEOUT (never hangs). The CALLER must treat that
   847	        as a SEQUENCING FAILURE — HARD-FAIL the run (do NOT re-send, do NOT drive on the stale
   848	        terminal): re-sending duplicates the user turn (no legal kick-without-append on a
   849	        FINISHED run) and driving on the stale terminal collapses the next follow-up (V1's bug)."""
   850	        if timeout_s is None:
   851	            timeout_s = _followup_pickup_timeout_s()
   852	        base_status = str(baseline.get("status") or "")
   853	        base_rev = int(baseline.get("plan_revision") or 0)
   854	        base_seq = int(baseline.get("max_seq", -1))
   855	        deadline = time.monotonic() + timeout_s
   856	        while time.monotonic() < deadline:
   857	            status = self._status_of(await self.get_state(conversation_id))
   858	            # (1) a re-plan signal: a revision bump OR a `planning` re-entry past the baseline.
   859	            if self._latest_plan_revision(conversation_id) > base_rev:
   860	                return FOLLOWUP_REPLANNED
   861	            if self._planning_reentry_since(conversation_id, base_seq):
   862	                return FOLLOWUP_REPLANNED
   863	            # (2) EVENT-SEQUENCED pickup: a non-user progress event past the baseline seq means
   864	            #     the engine started processing — detectable even when the status stays FINISHED.
   865	            if self._progress_event_since(conversation_id, base_seq):
   866	                return FOLLOWUP_PICKED_UP
   867	            # (3) belt-and-suspenders: the build left its prior terminal/resting status.
   868	            if base_status and status and status != base_status:
   869	                return FOLLOWUP_PICKED_UP
   870	            await asyncio.sleep(self._poll)
   871	        return FOLLOWUP_PICKUP_TIMEOUT
   872	
   873	    async def wait_for_first_file_write(
   874	        self, conversation_id: str, *, timeout_s: float
   875	    ) -> int | None:
   876	        """Poll the DB for the first MUTATING action (the §15.4 steer trigger).
   877	        Returns its seq, or None on timeout / terminal-without-write."""
   878	        deadline = time.monotonic() + timeout_s
   879	        while time.monotonic() < deadline:
   880	            events = self._read_events(conversation_id)
   881	            for e in events:
   882	                if e.get("kind") != "action":
   883	                    continue
   884	                tc = _payload(e).get("tool_call") or {}
   885	                name = tc.get("tool_name")
   886	                if name and name not in _NON_MUTATING_TOOLS:
   887	                    return int(e.get("seq", -1))
   888	            # bail early if the run already finished without a write
   889	            if events and _last_terminal(events) is not None:
   890	                return None
   891	            await asyncio.sleep(self._poll)
   892	        return None
   893	
   894	    def latest_user_message_seq(self, conversation_id: str) -> int:
   895	        """The highest seq of a USER message in the durable log, or -1 when none yet. Used to
   896	        snapshot the user-turn watermark BEFORE the harness sends a turn (declared follow-up or
   897	        injected auto-answer) so the NEW user-message seq it produces can be attributed to the
   898	        harness (revision-anchor metadata)."""
   899	        best = -1
   900	        try:
   901	            for e in self._read_events(conversation_id):
   902	                if e.get("kind") == "message" and e.get("source") == "user":
   903	                    best = max(best, int(e.get("seq", -1)))
   904	        except sqlite3.Error:
   905	            return -1
   906	        return best
   907	
   908	    async def wait_for_new_user_message_seq(
   909	        self, conversation_id: str, *, after_seq: int, timeout_s: float
   910	    ) -> int | None:
   911	        """After the harness sends a user turn, poll the durable log until a USER message with
   912	        seq > `after_seq` appears; return ITS seq (the turn the harness just sent), or None on
   913	        timeout / no new user message (e.g. a `confirm` or `pick_alternative` control frame
   914	        appends NO user message — nothing to attribute). Bounded — never hangs."""
   915	        deadline = time.monotonic() + timeout_s
   916	        while True:
   917	            seq = self.latest_user_message_seq(conversation_id)
   918	            if seq > after_seq:
   919	                return seq
   920	            if time.monotonic() >= deadline:
   921	                return None
   922	            await asyncio.sleep(self._poll)
