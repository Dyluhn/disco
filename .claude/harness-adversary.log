  1713	def _evaluate_snapshot_readiness(
  1714	    declared: list[str],
  1715	    expected: dict[str, tuple[Any, ...]],
  1716	    manifest: dict[str, Any],
  1717	    stable_n: dict[str, int],
  1718	) -> tuple[bool, list[str], list[str]]:
  1719	    """Decide whether the snapshot has settled on the agent's final state.
  1720	
  1721	    Returns ``(ready, blocking, unproven_ready)``:
  1722	      * ``ready`` — EVERY declared file's expected state is met.
  1723	      * ``blocking`` — UNSATISFIED files carrying a DEFINITE, content-precise signal
  1724	        (``sha`` / ``rendered`` / ``absent``). On the wait-budget deadline a non-empty
  1725	        ``blocking`` is the FAIL-FAST trigger (the snapshot is provably behind the agent).
  1726	      * ``unproven_ready`` — files accepted ONLY via extended content-stability
  1727	        (``present_unproven`` / ``unknown``), i.e. with no content proof; the caller logs a
  1728	        warning. These NEVER fail-fast (a legit edit-without-readback build must not become
  1729	        INVALID_RUN); an unsatisfied unproven file simply keeps `ready` False and is accepted
  1730	        best-effort at the deadline.
  1731	
  1732	    Content-precise gates:
  1733	      * ``sha`` — on-disk raw sha256 == the written bytes' sha.
  1734	      * ``rendered`` — the on-disk file RENDERED by file_read's own numberer == the readback.
  1735	      * ``absent`` — the file is NOT on disk.
  1736	    Stability gates (count of consecutive identical reads in ``stable_n``):
  1737	      * ``present_unproven`` — present AND ``>= _SNAPSHOT_UNPROVEN_STABLE_POLLS`` (+warn).
  1738	      * ``unknown`` — present-or-absent stable ``>= _SNAPSHOT_UNPROVEN_STABLE_POLLS`` (+warn)."""
  1739	    ready = True
  1740	    blocking: list[str] = []
  1741	    unproven_ready: list[str] = []
  1742	    for p in declared:
  1743	        kind = expected.get(p, ("unknown",))[0]
  1744	        present = _manifest_present(manifest, p)
  1745	        n = stable_n.get(p, 0)
  1746	        definite = False
  1747	        if kind == "sha":
  1748	            ok = present and _manifest_sha(manifest, p) == expected[p][1]
  1749	            definite = True
  1750	        elif kind == "rendered":
  1751	            on_disk_rendered = _render_numbered(_manifest_content(manifest, p) or "")
  1752	            ok = present and on_disk_rendered == expected[p][1]
  1753	            definite = True
  1754	        elif kind == "absent":
  1755	            ok = not present
  1756	            definite = True
  1757	        elif kind == "present_unproven":
  1758	            ok = present and n >= _SNAPSHOT_UNPROVEN_STABLE_POLLS
  1759	            if ok:
  1760	                unproven_ready.append(p)
  1761	        else:  # unknown — require PRESENT + extended stability (NOT stable-absent).
  1762	            # Settling on a STABLE-ABSENT declared file accepted a PARTIAL snapshot (only the
  1763	            # .pmx/ live-browser scaffolding had flushed) as final, before the real output
  1764	            # (e.g. index.html) appeared → a FALSE_FINISH_NO_OUTPUT false-negative on a build
  1765	            # that actually succeeded. Requiring `present` makes a not-yet-flushed file keep
  1766	            # the snapshot un-ready; a file that is GENUINELY never created waits the full
  1767	            # window and the run's own timeout flags it (correct), instead of premature ready.
  1768	            ok = present and n >= _SNAPSHOT_UNPROVEN_STABLE_POLLS
  1769	            if ok:
  1770	                unproven_ready.append(p)
  1771	        if not ok:
  1772	            ready = False
  1773	            if definite:
  1774	                blocking.append(p)
  1775	    return ready, blocking, unproven_ready
