   151	class RevisionOracle:
   152	    def check(
   153	        self,
   154	        events: list[dict[str, Any]],
   155	        *,
   156	        scenario: dict[str, Any] | None = None,
   157	        meta: dict[str, Any] | None = None,
   158	    ) -> list[OracleResult]:
