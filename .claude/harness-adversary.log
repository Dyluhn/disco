  1581	def _agent_declared_expected(
  1582	    events: list[dict[str, Any]], declared: list[str]
  1583	) -> dict[str, tuple[Any, ...]]:
  1584	    """Reconstruct each DECLARED file's AGENT-FINAL state from the durable event log, keyed by
  1585	    the original declared-path string. A mutation / read counts only when its action has a
  1586	    SUCCESSFUL observation and no agent_error (a failed/aborted op is NOT the final state).
  1587	
  1588	    Priority per path (seq-ordered — the LAST mutation, plus any FULL readback after it):
  1589	      a. last mutation is ``file_write`` (full, non-elided content) → ``("sha", <hexdigest>)``
  1590	         over the RAW written bytes (strongest signal).
  1591	      b. else a partial mutator (edit/append/replace/insert/str_replace, or an elided
  1592	         file_write) is the last mutation AND a FULL, genuinely-rendered ``file_read``
  1593	         readback exists with seq AFTER it → ``("rendered", <readback body>)`` (compared in
  1594	         file_read's rendered space — closes the partial-edit-last stale-snapshot gap).
  1595	      c. else last op is a shell ``rm`` of the path → ``("absent",)``.
  1596	      d. else a partial mutator with NO qualifying post-mutation readback →
  1597	         ``("present_unproven",)`` (content can't be proven; extended-stability + warn).
  1598	      e. else no signal → omitted (caller treats as ``unknown``)."""
  1599	    want = {_norm_rel(p): p for p in declared}
  1600	    if not want:
  1601	        return {}
  1602	
  1603	    obs_success: dict[str, bool] = {}
  1604	    obs_content: dict[str, Any] = {}
  1605	    err_call_ids: set[str] = set()
  1606	    for e in events:
  1607	        kind = e.get("kind")
  1608	        if kind == "observation":
  1609	            tr = _payload(e).get("tool_result") or {}
  1610	            cid = tr.get("call_id")
  1611	            if cid is not None:
  1612	                obs_success[str(cid)] = bool(tr.get("success", True))
  1613	                obs_content[str(cid)] = tr.get("content")
  1614	        elif kind == "agent_error":
  1615	            tcid = _payload(e).get("tool_call_id")
  1616	            if tcid is not None:
  1617	                err_call_ids.add(str(tcid))
  1618	
  1619	    # Per path: the LAST mutation (seq, kind, sha?) and the LAST qualifying full readback
  1620	    # (seq, rendered body). Combined after the walk so ordering decides which wins.
  1621	    last_mut: dict[str, tuple[int, str, str | None]] = {}  # np -> (seq, kind, write_sha)
  1622	    last_read: dict[str, tuple[int, str]] = {}  # np -> (seq, body)
  1623	    for e in events:  # seq order (the DB read is ORDER BY seq)
  1624	        if e.get("kind") != "action":
  1625	            continue
  1626	        seq = int(e.get("seq", -1))
  1627	        tc = _payload(e).get("tool_call") or {}
  1628	        call_id = tc.get("call_id")
  1629	        name = tc.get("tool_name")
  1630	        args = tc.get("arguments") or {}
  1631	        if call_id is None:
  1632	            continue
  1633	        cid = str(call_id)
  1634	        if cid in err_call_ids or not obs_success.get(cid, False):
  1635	            continue  # only a SUCCESSFUL, un-errored op is the agent's real state
  1636	        if name in _FILE_WRITE_FULL_TOOLS:
  1637	            np = _norm_rel(str(args.get("path", "")))
  1638	            if np not in want:
  1639	                continue
  1640	            content = args.get("content")
  1641	            if isinstance(content, str) and not _ELISION_MARKER_RE.search(content):
  1642	                sha = hashlib.sha256(content.encode("utf-8")).hexdigest()
  1643	                last_mut[np] = (seq, "sha", sha)
  1644	            else:  # elided/unknown bytes → a content-unprovable mutation
  1645	                last_mut[np] = (seq, "present", None)
  1646	        elif name in _FILE_WRITE_PARTIAL_TOOLS:
  1647	            np = _norm_rel(str(args.get("path", "")))
  1648	            if np not in want:
  1649	                continue
  1650	            last_mut[np] = (seq, "present", None)
  1651	        elif name in _FILE_READ_TOOLS:
  1652	            np = _norm_rel(str(args.get("path", "")))
  1653	            if np not in want:
