   164	    }
   165	)
   166	
   167	
   168	# The severity of every product failure code. (Harness-validity codes are not in
   169	# here — they resolve to INVALID_RUN, which has its own outcome, not a severity.)
   170	SEVERITY_BY_CODE: dict[str, str] = {
   171	    # P0
   172	    NO_USER_EVENT_AFTER_SUBMIT: P0,
   173	    NO_PLAN_AFTER_USER_TURN: P0,
