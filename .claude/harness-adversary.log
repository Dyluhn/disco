  1538	# OPAQUE mutation tools. A shell command (either shell tool name) or a project-script can rewrite a
  1539	# declared path in a way we cannot reconstruct from the action alone, so after one of these the path
  1540	# degrades to content-unprovable (present_unproven) rather than leaving an earlier modeled write's
  1541	# sha standing as the "final" expected — which false-INVALIDs a snapshot that correctly holds the
  1542	# post-mutation bytes. Fail-safe by design: only ever relaxes a sha to present, never a false INVALID.
  1543	_SHELL_TOOLS = frozenset({"shell", "shell_exec"})
  1544	_SCRIPT_MUTATE_TOOLS = frozenset({"run_project_script"})
