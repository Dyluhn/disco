   220	
   221	def has_plan(
   222	    events: list[dict[str, Any]], *, revision: int | None = None, after_seq: int = 0
   223	) -> bool:
   224	    """True when a PlanEvent exists with seq > after_seq (and matching `revision`
   225	    when given)."""
   226	    for e in events:
   227	        if kind_of(e) != KIND_PLAN or seq_of(e) <= after_seq:
   228	            continue
   229	        if revision is not None and int(e.get("revision", 1)) != revision:
   230	            continue
   231	        return True
   232	    return False
   233	
   234	
   235	def has_status(
   236	    events: list[dict[str, Any]],
   237	    *,
   238	    detail: str | None = None,
   239	    status: str | None = None,
   240	    after_seq: int = 0,
   241	) -> bool:
   242	    """True when a StatusEvent exists matching the given `status` and/or `detail`,
   243	    with seq > after_seq."""
   244	    for e in events:
   245	        if kind_of(e) != KIND_STATUS or seq_of(e) <= after_seq:
   246	            continue
   247	        if status is not None and str(e.get("status")) != status:
   248	            continue
   249	        if detail is not None and (e.get("detail") or None) != detail:
   250	            continue
   251	        return True
   252	    return False
