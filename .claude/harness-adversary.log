    95	        try:
    96	            obj = json.loads(line)
    97	        except (json.JSONDecodeError, ValueError):
    98	            obj = None
    99	        if isinstance(obj, dict):
   100	            host = str(obj.get("host") or "")
   101	            if not host:
   102	                url = str(obj.get("url") or "")
   103	                m = _URL_HOST_RE.search(url)
   104	                host = m.group(1) if m else ""
   105	            if host:
   106	                out.append(
   107	                    _record(
   108	                        host,
   109	                        model=str(obj.get("model") or ""),
   110	                        ts=obj.get("ts") or obj.get("timestamp"),
   111	                        after_terminal=bool(obj.get("after_terminal", False)),
   112	                        has_tools=bool(obj.get("has_tools", True)),  # [REL-5b] default True=fail-closed
   113	                        conversation_id=obj.get("conversation_id"),
   114	                    )
   115	                )
   116	            continue
   117	        # 2) loose log line — extract host + model by regex
   118	        mh = _URL_HOST_RE.search(line)
   119	        if not mh:
   120	            continue
   121	        mm = _MODEL_RE.search(line)
   122	        out.append(_record(mh.group(1), model=mm.group(1) if mm else ""))
   123	    return out
   124	
   125	
   126	def parse_relay_log(text: str) -> list[dict[str, Any]]:
   127	    """Convenience: parse a whole relay-log blob into ledger records."""
   128	    return parse_relay_log_lines(text.splitlines())

