   274	                        failing(
   275	                            _ORACLE,
   276	                            fc.STALE_PLAN_USED_AFTER_FOLLOWUP,
   277	                            first_broken_link="revised_plan_event -> revised_plan_approval",
   278	                            facts={
   279	                                "followup_user_event_seq": fseq,
   280	                                "revised_plan_seq": p_seq,
   281	                                "revised_plan_approval_seq": None,
   282	                                "terminal_status": term,
   283	                            },
   284	                        )
   285	                    ]
   286	                continue  # incomplete — not a failure
   287	
   288	            # LINK P -> AWAITING -> C: interactive runs require an AWAITING gate
   289	            # BETWEEN the revised plan and its approval (autonomous auto-approves
   290	            # inline with no gate — legitimate).
   291	            if not autonomous and not any(p_seq < s < revised_approval for s in awaiting):
   292	                return [
   293	                    failing(
   294	                        _ORACLE,
   295	                        fc.PLAN_APPROVED_STATUS_MISSING,
   296	                        first_broken_link="revised_plan_event -> awaiting_plan_approval",
   297	                        facts={
   298	                            "followup_user_event_seq": fseq,
   299	                            "revised_plan_seq": p_seq,
   300	                            "revised_plan_approval_seq": revised_approval,
   301	                            "awaiting_seqs": awaiting,
   302	                            "reason": "no AWAITING gate between the revised plan and its approval",
   303	                        },
   304	                    )
   305	                ]
   306	
   307	            # LINK C -> D: a FINISHED revised build must show an execution action
   308	            # after the revised approval.
   309	            if term == "FINISHED" and not has_action(events, after_seq=revised_approval):
   310	                return [
   311	                    failing(
   312	                        _ORACLE,
   313	                        fc.APPROVE_PLAN_NO_EXECUTION,
   314	                        first_broken_link="revised_plan_approval -> execution_action",
   315	                        facts={
   316	                            "followup_user_event_seq": fseq,
   317	                            "revised_plan_approval_seq": revised_approval,
   318	                            "action_after_revised_approval": False,
   319	                            "terminal_status": term,
