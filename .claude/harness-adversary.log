     1	"""EventChainOracle (guidelines §11.1–11.3, §16).
     2	
     3	Walks the canonical chain that the bare Build loop must satisfy, IN ORDER, and
     4	stops at the first broken link (§16 "the first broken link wins"):
     5	
     6	    submit -> user event
     7	    user event -> plan event          (when the scenario requires the plan gate)
     8	    plan event -> approval status
     9	    approval status -> execution action
    10	    execution action -> observation
    11	
    12	Caveat (codex #5): a tool REJECTION is recorded as an AgentErrorEvent (or an
    13	ObservationEvent with success=False). That IS visible feedback to the model — a
    14	VALID pairing for the action — distinct from a genuinely-missing observation. So
    15	`has_observation_for_action` treats an AgentErrorEvent as a valid pairing, and this
    16	oracle only raises ACTION_NO_OBSERVATION when NEITHER an observation nor an error
    17	references the action.
    18	"""
    19	
    20	from __future__ import annotations
    21	
    22	from typing import Any
    23	
    24	from .. import failure_codes as fc
    25	from ..events import (
    26	    EXECUTION_EXPECTED_TERMINALS,
    27	    KIND_ACTION,
    28	    KIND_AGENT_ERROR,
    29	    KIND_OBSERVATION,
    30	    KIND_PLAN,
    31	    awaiting_approval_seqs,
    32	    has_action,
    33	    has_plan,
    34	    has_user_message,
    35	    is_autonomous,
    36	    kind_of,
    37	    plan_approved_seqs,
    38	    seq_of,
    39	    terminal_status,
    40	    tool_name_of,
    41	)
    42	from .schema import OracleResult, failing, passing
    43	
    44	_ORACLE = "EventChainOracle"
    45	
    46	
    47	def _wants_plan_gate(scenario: dict[str, Any] | None) -> bool:
    48	    if not scenario:
    49	        return False
    50	    ec = (scenario.get("assertions") or {}).get("event_chain") or {}
    51	    return bool(ec.get("require_plan_before_execution"))
    52	
    53	
    54	def _wants_observation_pairs(scenario: dict[str, Any] | None) -> bool:
    55	    # Default ON: a Build run should always pair actions with observations. A
    56	    # scenario may opt out explicitly with require_action_observation_pairs: false.
    57	    if not scenario:
    58	        return True
    59	    ec = (scenario.get("assertions") or {}).get("event_chain") or {}
    60	    return ec.get("require_action_observation_pairs", True) is not False
    61	
