  1134	async def _collect_terminal_cleanup_evidence(
  1135	    client: DiscoApiClient,
  1136	    cid: str,
  1137	    run: Any,
  1138	    *,
  1139	    baseline_containers: int | None,
  1140	    relay_log: str | None,
  1141	    timeline: list[str],
  1142	    baseline_dangling_volumes: set[str] | None = None,
  1143	    grace_s: float = 8.0,
  1144	) -> dict[str, Any]:
  1145	    """[REL-5] Make terminal cleanup ADJUDICATED instead of SKIPPED on the headless soak. The
  1146	    build has reached terminal and its §6 evidence is already frozen into `run`; here we measure
  1147	    the post-terminal provider calls (grace window on the relay ledger), RELEASE the conversation
  1148	    (destroy the sandbox + egress-sidecar containers), and verify zero orphans — populating the
  1149	    lifecycle / sidecar / cleanup product_evidence slices from REAL signals so the reliability
  1150	    oracles RUN. Every signal is measured truthfully: an unmeasurable signal is OMITTED (its oracle
  1151	    skips), never stubbed to a passing value."""
  1152	    ev: dict[str, Any] = dict(getattr(run, "product_evidence", None) or {})
  1153	
  1154	    # lifecycle — the terminal + status path (from the frozen final state + the drive timeline).
  1155	    terminal = ""
  1156	    with contextlib.suppress(Exception):
  1157	        terminal = DiscoApiClient._status_of(getattr(run, "state_final", {}) or {})
  1158	    if terminal:
  1159	        ev["lifecycle"] = {"terminal": terminal, "statuses": list(getattr(run, "timeline", []) or [])}
