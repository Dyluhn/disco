   143	def _first_plan_after(events: list[dict[str, Any]], after_seq: int) -> tuple[int, int] | None:
   144	    """(seq, revision) of the FIRST PlanEvent strictly after `after_seq`, else None."""
   145	    for e in events:
   146	        if kind_of(e) == KIND_PLAN and seq_of(e) > after_seq:
   147	            return seq_of(e), int(e.get("revision", 1))
   148	    return None
