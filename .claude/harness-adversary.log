  1282	async def run_once(
  1283	    client: DiscoApiClient,
  1284	    scenario: dict[str, Any],
  1285	    *,
  1286	    run_id: str,
  1287	    out_root: str | Path,
  1288	    model: str | None,
  1289	    autonomous: bool,
  1290	    commit: str,
  1291	    kernel: str = "disco",
  1292	    timeout_s: float,
  1293	    hard_cap_s: float = _DEFAULT_HARD_CAP_S,
  1294	) -> dict[str, Any]:
  1295	    # §9 pre-create infra gate (the ONLY infra source). No conversation exists yet, so a
  1296	    # failure here needs no teardown (returns before the try/finally below).
  1297	    try:
  1298	        await client.pre_create_probe(model)
  1299	    except InfraProbeError as exc:
  1300	        return _infra_failure_record(out_root, run_id, scenario, exc)
  1301	
  1302	    # This run has not created a conversation yet — reset the tracked cid so the finally
  1303	    # only ever kills the conversation THIS run created (the client is reused across a
  1304	    # batch of iterations).
  1305	    client.last_conversation_id = None
  1306	    # [REL-5] pre-run orphan baseline. The scoped sandbox-id path does not need this, but older
  1307	    # servers that cannot expose ids still fall back to the serial-era global delta.
  1308	    baseline_containers = _live_disco_container_count()
  1309	    baseline_dangling_volumes = _dangling_volume_names()
  1310	    try:
  1311	        # A mid-run transport loss (the shared server crashed / network dropped AFTER
  1312	        # create) is not adjudicable — degrade to INVALID_RUN instead of a raw traceback,
  1313	        # so a batch keeps going and the outcome is recorded honestly.
  1314	        try:
  1315	            run = await drive_scenario(
  1316	                client,
  1317	                scenario,
  1318	                model=model,
  1319	                autonomous=autonomous,
  1320	                timeout_s=timeout_s,
  1321	                hard_cap_s=hard_cap_s,
  1322	            )
  1323	        except InconclusiveRunError as exc:
  1324	            # Bug 15: the build was STILL PROGRESSING when the hard cap hit — the runner could
  1325	            # not obtain a terminal verdict. INVALID_RUN (inconclusive), NEVER a product fail.
  1326	            return _invalid_run_record(
  1327	                out_root,
  1328	                run_id,
  1329	                scenario,
  1330	                exc.reason,
  1331	                code=fc.RUN_TIMEOUT_WHILE_PROGRESSING,
  1332	                first_broken_link="terminal_wait -> no_terminal_before_hard_cap",
  1333	                facts=exc.facts,
  1334	            )
  1335	        except FollowupPickupError as exc:
