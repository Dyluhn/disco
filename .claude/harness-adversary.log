  1570	def _render_numbered(text: str) -> str:
  1571	    """Render `text` EXACTLY as ``file_read`` renders a full read — 1-based, right-aligned
  1572	    line numbers + a tab, no trailing newline — by importing the PRODUCT's own pure helper
  1573	    (``disco.tools.builtin.files._number_lines``) so the format can never drift from the
  1574	    readback we compare against. Imported lazily to keep the deterministic test path free of
  1575	    the live tool deps until a readback signal actually needs rendering."""
  1576	    from disco.tools.builtin.files import _number_lines
  1577	
  1578	    return _number_lines(text, 1)
