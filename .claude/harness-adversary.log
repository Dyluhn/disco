  1393	def _file_entry(data: bytes) -> dict[str, Any]:
  1394	    """A single workspace-manifest entry: existence + identity (size, sha256) plus the
  1395	    decoded text content. The OutputTruthOracle reads ``content`` for must_contain
  1396	    substring checks; a binary / oversized file keeps present+size+sha256 with empty
  1397	    content (binary deliverables carry no text assertions)."""
  1398	    entry: dict[str, Any] = {
  1399	        "present": True,
  1400	        "size": len(data),
  1401	        "sha256": hashlib.sha256(data).hexdigest(),
  1402	    }
  1403	    if len(data) <= _WS_MANIFEST_MAX_BYTES:
  1404	        try:
  1405	            entry["content"] = data.decode("utf-8")
  1406	        except UnicodeDecodeError:
  1407	            entry["content"] = ""
  1408	            entry["binary"] = True
  1409	    else:
  1410	        entry["content"] = ""
  1411	        entry["truncated"] = True
  1412	    return entry
