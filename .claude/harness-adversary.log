  1101	    for e in events:
  1102	        if e.get("kind") != "status":
  1103	            continue
  1104	        # run.events are raw DB rows {seq,kind,created_at,payload(JSON string)} — the status lives
  1105	        # INSIDE `payload`, not as a top-level field. Accept both shapes (flattened + DB-row).
  1106	        status = e.get("status")
  1107	        if status is None:
  1108	            pl = e.get("payload")
  1109	            if isinstance(pl, str):
  1110	                try:
  1111	                    status = (json.loads(pl) or {}).get("status")
  1112	                except Exception:
  1113	                    status = None
  1114	            elif isinstance(pl, dict):
  1115	                status = pl.get("status")
  1116	        if str(status or "").upper() not in _BUILD_TERMINAL_STATUSES:
