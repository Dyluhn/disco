   812	def _infra_failure_record(
   813	    out_root: str | Path,
   814	    run_id: str,
   815	    scenario: dict[str, Any],
   816	    exc: InfraProbeError,
   817	) -> dict[str, Any]:
   818	    """Write a §9-compliant INFRA_FAILURE record (the run never created a
   819	    conversation). This is the ONLY non-product outcome the runner emits."""
   820	    base = Path(out_root) / run_id
   821	    base.mkdir(parents=True, exist_ok=True)
   822	    record = {
   823	        "status": fc.INFRA_FAILURE,
   824	        "severity": fc.NONE,
   825	        "code": exc.signature_id,
   826	        "first_broken_link": "pre_create_probe -> agent_server/provider",
   827	        "scenario_id": scenario.get("id"),
   828	        "run_id": run_id,
   829	        "conversation_id": None,
   830	        "facts": exc.detail,
   831	        "accepted_by": "oracle",
   832	        "agent_comments_ignored_for_adjudication": True,
   833	        "stage": "before_conversation_creation",
   834	    }
   835	    (base / CLASSIFICATION_NAME).write_text(
   836	        json.dumps(record, indent=2, sort_keys=True), encoding="utf-8"
   837	    )
   838	    (base / "timeline.md").write_text(
   839	        f"# INFRA_FAILURE (pre-create)\n\nsignature: {exc.signature_id}\ndetail: {exc.detail}\n",
   840	        encoding="utf-8",
   841	    )
   842	    return record
