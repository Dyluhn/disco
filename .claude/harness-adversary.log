   886	# ---- runner hygiene: kill an abandoned conversation -------------------------
   887	
   888	
   889	async def _release_conversation(
   890	    client: DiscoApiClient, cid: str | None, timeline: list[str] | None = None
   891	) -> None:
   892	    """Tear down the conversation the runner is DONE with — INCLUDING its sandbox + egress
   893	    sidecar CONTAINERS — so nothing leaks between runs. Called from run_once's `finally` AFTER
   894	    evidence has been collected + frozen (the §6 read of the terminal events already happened in
   895	    drive_scenario), so the release never races the dossier.
   896	
   897	    [REL-4] We release the conversation even when it is already TERMINAL. MEASURED on the
   898	    production podman backend: a single FINISHED build leaves TWO live containers — the sandbox
   899	    `disco-sbx-sbx_<id>` and the egress sidecar `disco-egr-sbx_<id>` — both still "Up" after the
   900	    terminal event (the sandbox is not destroyed at terminal; it lingers to the idle-TTL). Across
   901	    a 95-run soak that is ~190 orphan containers and FAILS the 0-orphans acceptance. `POST /kill`
   902	    on the terminal conversation tears down BOTH containers (measured: 2 → 0), revokes the provider
   903	    token, and stops the preview, and is IDEMPOTENT + BEST-EFFORT (any error — server gone, already
   904	    torn down — is swallowed so teardown never turns a real verdict into a crash). The FINISHED
   905	    workspace snapshot is already taken (kick post-run) and evidence is frozen, so releasing here
   906	    is safe."""
   907	    if not cid:
   908	        return
   909	    status = ""
   910	    with contextlib.suppress(Exception):
   911	        status = DiscoApiClient._status_of(await client.get_state(cid))
   912	    # Release regardless of terminal status — the orphan-container teardown. kill is idempotent +
   913	    # suppressed, so a non-terminal abandon and a terminal release share the one proven path.
   914	    with contextlib.suppress(Exception):
   915	        resp = await client.kill(cid)
   916	        if timeline is not None:
   917	            verb = "released terminal" if status in TERMINAL_STATES else "killed abandoned"
   918	            timeline.append(
   919	                f"{verb} conversation {cid} — sandbox + sidecar containers destroyed "
   920	                f"(was {status or 'unknown'}, http {resp.get('http_status')})"
   921	            )
   922	
   923	
   924	_DISCO_CONTAINER_PREFIXES = ("disco-sbx-", "disco-egr-")
   925	_DISCO_VOLUME_PREFIXES = ("disco-ws-", "pmx-ws-")
   926	
   927	
   928	def _live_disco_container_names() -> list[str] | None:
   929	    """RUNNING disco sandbox + egress-sidecar container names, or None if unmeasurable."""
   930	    try:
   931	        out = subprocess.run(
   932	            ["podman", "ps", "--format", "{{.Names}}"],  # RUNNING only (no -a)
   933	            capture_output=True, text=True, timeout=15, check=False,
   934	        )
   935	    except Exception:
   936	        return None
   937	    if out.returncode != 0:
   938	        return None
   939	    names: list[str] = []
   940	    for line in out.stdout.splitlines():
   941	        for name in line.split(","):
   942	            clean = name.strip()
   943	            if clean.startswith(_DISCO_CONTAINER_PREFIXES):
   944	                names.append(clean)
   945	    return names
   946	
   947	
   948	def _live_disco_container_count() -> int | None:
   949	    """[REL-5 / Lane A A-B5/M3] Count RUNNING disco sandbox + egress-sidecar containers via the
   950	    podman CLI — the host-side orphan signal for the CleanupOracle on the LOCAL PODMAN iteration
   951	    backend. Uses `podman ps` (RUNNING only) NOT `podman ps -a`: `-a` includes exited-but-not-yet-
   952	    pruned containers, so a correctly-torn-down box still matched the prefix and inflated the count
   953	    on either side of the baseline→after delta (a real leak could net to 0, or a prune could push
   954	    after<baseline). Counting only RUNNING containers measures actual liveness. Returns None if
   955	    podman is unavailable (count UNKNOWN, never faked 0). The gVisor FINAL REL-6 run needs the
   956	    gVisor-equivalent probe (tracked)."""
   957	    names = _live_disco_container_names()
   958	    return None if names is None else len(names)
   959	
