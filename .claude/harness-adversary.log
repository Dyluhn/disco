  1386	        # could NOT adjudicate for cleanup must NOT pass via oracle SKIP (the gate forbids
  1387	        # SKIP-as-PASS). The three terminal-cleanup slices are MANDATORY whenever the cleanup-
  1388	        # measurement infra is configured (MINIMAX_RELAY_LOG set = a real soak run) — if a signal
  1389	        # is then unmeasurable (empty ledger / no container probe / unparseable terminal), that is
  1390	        # an INVALID_RUN, which the REL-6 gate ("0 INVALID_RUN in positive scenarios") forces the
  1391	        # operator to fix. The REL-6 preflight REQUIRES the relay ledger for positive scenarios, so
  1392	        # this always applies in the real gate. Deterministic unit tests (no live infra, no relay
  1393	        # env) exercise the CLASSIFIER and are not subject to the live-cleanup requirement.
  1394	        _live_measure = bool(_relay_log_path())
  1395	        _required = ("lifecycle", "sidecar", "cleanup")
  1396	        _missing = [k for k in _required if k not in ev]
  1397	        if _live_measure and _missing:
  1398	            return _invalid_run_record(
  1399	                out_root, run_id, scenario,
  1400	                f"terminal cleanup not adjudicable — missing evidence slice(s): {', '.join(_missing)} "
  1401	                "(set MINIMAX_RELAY_LOG and ensure the container probe is available so the "
  1402	                "sidecar/cleanup oracles cannot silently SKIP into a green pass)",
  1403	                code=fc.RUN_INTERRUPTED,
  1404	                first_broken_link="terminal -> cleanup_evidence_unmeasurable",
  1405	                facts={"missing_slices": _missing},
  1406	            )
  1407	
  1408	        base = assemble_dossier(
  1409	            out_root, run_id, scenario, run,
  1410	            model=model, autonomous=autonomous, commit=commit, kernel=kernel,
  1411	        )
  1412	        return classify_dossier(base, scenario, run, autonomous=autonomous, commit=commit)
  1413	    finally:
  1414	        # RUNNER HYGIENE: kill the conversation this run created if it's still non-terminal,
  1415	        # so an abandoned RUNNING / PAUSED / AWAITING build (inconclusive cutoff, error path,
  1416	        # or simply released after evidence collection) doesn't leak and load the shared
  1417	        # server. AFTER assemble_dossier on the happy path → the §6 evidence is already frozen
  1418	        # (the terminal events were read in drive_scenario); a kill of the remote conversation
  1419	        # never touches the local frozen dossier. Best-effort + idempotent.
  1420	        await _release_conversation(client, client.last_conversation_id)
