   194	                            "followup_user_event_seq": fseq,
   195	                            "latest_plan_revision_before_followup": rev_before,
   196	                            "latest_plan_revision_after_followup": _rev_after(events, fseq),
   197	                            "replanning_status_present": replanned,
   198	                            "first_write_tool_after_followup_seq": mutated_seq,
   199	                            "write_before_revised_plan_approval": mutated_seq is not None,
   200	                        },
   201	                    )
   202	                ]
