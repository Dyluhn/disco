  1525	    if "rm" not in toks:
  1526	        return False
  1527	    # Compound/composite commands (&&, ;, |, redirects) or other program tokens before/after
  1528	    # rm mean the rm may target a copy or may not even run — not a deterministic delete.
  1529	    shell_meta = {"&&", "||", ";", "|", ">", ">>", "<"}
  1530	    if any(t in shell_meta or any(m in t for m in ("&&", "||", ";", "|")) for t in toks):
