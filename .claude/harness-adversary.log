   231	                    failing(
   232	                        _ORACLE,
   233	                        fc.STALE_PLAN_USED_AFTER_FOLLOWUP,
   234	                        first_broken_link="followup_user_event -> revised_plan_approval",
   235	                        facts={
   236	                            "followup_user_event_seq": fseq,
   237	                            "revised_plan_seq": p_seq,
