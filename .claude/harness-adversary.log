  1337	            # finalization dead-window) even after a re-kick. This is a HARNESS SEQUENCING
  1338	            # failure, not a product verdict — INVALID_RUN so §17 re-runs it. We must NOT drive
  1339	            # on the stale terminal (V1's silent-proceed is what collapsed the follow-ups).
  1340	            return _invalid_run_record(
  1341	                out_root,
  1342	                run_id,
  1343	                scenario,
  1344	                exc.reason,
  1345	                code=fc.RUN_INTERRUPTED,
  1346	                first_broken_link="followup_send -> no_pickup_before_bound",
  1347	                facts=exc.facts,
  1348	            )
  1349	        except SnapshotNotReadyError as exc:
  1350	            # The host workspace snapshot never settled on the build's AGENT-FINAL state
  1351	            # within the snapshot-wait budget (a slow/failed flush, or a multi-revision build
  1352	            # whose later bytes hadn't flushed). FAIL-FAST → INVALID_RUN rather than launder a
  1353	            # stale capture into a false ARTIFACT_TRUTH_MISMATCH or a silent stale PASS; §17
  1354	            # re-runs it. Bounded — never hangs.
  1355	            return _invalid_run_record(
  1356	                out_root,
  1357	                run_id,
  1358	                scenario,
  1359	                exc.reason,
  1360	                code=fc.WORKSPACE_SNAPSHOT_NOT_READY,
  1361	                first_broken_link="snapshot_flush -> snapshot_behind_agent_final_state",
  1362	                facts=exc.facts,
  1363	            )
