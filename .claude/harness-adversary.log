  1061	def _relay_log_path() -> str | None:
  1062	    """[codex] ONE canonical resolver for the MiniMax relay-ledger path — the SINGLE source for
  1063	    BOTH reading the ledger AND the `_live_measure` fail-closed gate, so the rule can never key on
  1064	    a different env var than the one that actually carries the ledger. The relay WRITES
  1065	    MINIMAX_RELAY_LOG (minimax_relay.py); we also accept the legacy PMX_RELAY_LOG (Playwright live
  1066	    specs) and DISCO_RELAY_LOG so no driver path can drift into a silent SKIP-as-PASS."""
  1067	    for name in ("MINIMAX_RELAY_LOG", "PMX_RELAY_LOG", "DISCO_RELAY_LOG"):
  1068	        v = os.environ.get(name)
  1069	        if v:
  1070	            return v
  1071	    return None
  1072	
  1073	
  1074	def _event_epoch(e: dict[str, Any]) -> float | None:
  1075	    """Epoch of one event from its ISO-8601 UTC timestamp ('2026-06-30T16:59:28.755769Z')."""
  1076	    from datetime import datetime
  1077	
  1078	    ts = e.get("timestamp") or e.get("created_at")
  1079	    if not isinstance(ts, str):
  1080	        return None
  1081	    try:
  1082	        return datetime.fromisoformat(ts.replace("Z", "+00:00")).timestamp()
  1083	    except Exception:
  1084	        return None
  1085	
  1086	
  1087	# [Lane A A-M2] The BUILD-terminal set for anchoring provider-after-terminal. EXCLUDES IDLE: IDLE is
  1088	# both the pre-kick resting state AND the post-kill state, so anchoring on a (later) IDLE would push
  1089	# the boundary PAST real post-FINISHED calls and hide them. Includes VERIFIED (a clean terminal the
  1090	# LifecycleOracle accepts but TERMINAL_STATES omits) so a VERIFIED run is adjudicable, not INVALID.
  1091	_BUILD_TERMINAL_STATUSES = frozenset({"FINISHED", "VERIFIED", "ERROR", "STUCK"})
  1092	
  1093	
  1094	def _terminal_status_epoch(events: list[dict[str, Any]]) -> float | None:
  1095	    """[codex/Lane A] Epoch of the LAST `status` event whose status is a BUILD terminal
  1096	    (_BUILD_TERMINAL_STATUSES — NOT IDLE) — the true instant the build went terminal. NOT the max
  1097	    timestamp across ALL events (a durable event appended AFTER the terminal status would push the
  1098	    anchor past a real post-terminal provider call), and NOT anchored on IDLE (the rest/kill state).
  1099	    None if no build-terminal status event is present."""
  1100	    best: float | None = None
  1101	    for e in events:
  1102	        if e.get("kind") != "status":
  1103	            continue
  1104	        # run.events are raw DB rows {seq,kind,created_at,payload(JSON string)} — the status lives
  1105	        # INSIDE `payload`, not as a top-level field. Accept both shapes (flattened + DB-row).
  1106	        status = e.get("status")
  1107	        if status is None:
  1108	            pl = e.get("payload")
  1109	            if isinstance(pl, str):
  1110	                try:
  1111	                    status = (json.loads(pl) or {}).get("status")
  1112	                except Exception:
  1113	                    status = None
