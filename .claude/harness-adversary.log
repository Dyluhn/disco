   196	                },
   197	            )
   198	        ]
   199	
   200	    def _check_pairing(self, events: list[dict[str, Any]]) -> OracleResult | None:
   201	        # ORDER-AWARE pairing: a response must come AFTER the action it answers.
   202	        # action_id -> the action's seq.
   203	        action_seqs: dict[str, int] = {}
   204	        for e in events:
   205	            if kind_of(e) == KIND_ACTION:
   206	                action_seqs[str(e.get("id"))] = seq_of(e)
   207	
   208	        # Every ActionEvent must be answered by an Observation OR an AgentError that
   209	        # appears LATER in the log (a response at/ before the action is not a valid
   210	        # pairing — it is forged/out-of-order).
   211	        for e in events:
   212	            if kind_of(e) != KIND_ACTION:
   213	                continue
   214	            action_id = str(e.get("id"))
   215	            aseq = seq_of(e)
   216	            if not self._has_later_response(events, action_id, aseq):
   217	                return failing(
   218	                    _ORACLE,
   219	                    fc.ACTION_NO_OBSERVATION,
   220	                    first_broken_link="execution_action -> observation",
   221	                    facts={
   222	                        "action_id": action_id,
   223	                        "action_seq": aseq,
   224	                        "tool_name": tool_name_of(e),
   225	                    },
   226	                )
   227	
   228	        # Every Observation must reference an Action that EXISTS and PRECEDES it.
   229	        for e in events:
   230	            if kind_of(e) != KIND_OBSERVATION:
   231	                continue
   232	            ref = str(e.get("action_id"))
   233	            origin = action_seqs.get(ref)
   234	            if origin is None or origin >= seq_of(e):
   235	                return failing(
   236	                    _ORACLE,
   237	                    fc.OBSERVATION_WITHOUT_ACTION,
   238	                    first_broken_link="observation -> originating_action",
   239	                    facts={
   240	                        "observation_seq": seq_of(e),
   241	                        "dangling_action_id": ref,
   242	                        "originating_action_seq": origin,
   243	                    },
   244	                )
   245	        return None
   246	
   247	    @staticmethod
   248	    def _has_later_response(events: list[dict[str, Any]], action_id: str, action_seq: int) -> bool:
   249	        """True iff an ObservationEvent OR AgentErrorEvent references `action_id`
   250	        with seq > `action_seq` (a rejection/error IS a valid pairing, codex #5)."""
   251	        for e in events:
   252	            k = kind_of(e)
   253	            if seq_of(e) <= action_seq:
   254	                continue
   255	            if k == KIND_OBSERVATION and str(e.get("action_id")) == action_id:
   256	                return True
   257	            if k == KIND_AGENT_ERROR and e.get("action_id") is not None and (
   258	                str(e.get("action_id")) == action_id
   259	            ):
   260	                return True
   261	        return False

