   979	def _disco_volume_names() -> list[str] | None:
   980	    """All disco workspace volumes, independent of whether their container is running."""
   981	    names = _podman_volume_names(["podman", "volume", "ls", "--format", "{{.Name}}"])
   982	    if names is None:
   983	        return None
   984	    return [name for name in names if name.startswith(_DISCO_VOLUME_PREFIXES)]
