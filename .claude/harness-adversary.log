   106	        # plan and emitted no action, so the C->D link below breaks and it classifies
   107	        # as APPROVE_PLAN_NO_EXECUTION — the FAIL it is, NOT a false PASS (which is
   108	        # what happened while STUCK read as non-terminal/incomplete).
   109	        approvals = plan_approved_seqs(events)
   110	        awaiting = awaiting_approval_seqs(events)
   111	        plan_seqs = [seq_of(e) for e in events if kind_of(e) == KIND_PLAN]
