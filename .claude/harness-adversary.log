   352	def _rev_upto(events: list[dict[str, Any]], seq: int) -> int:
   353	    """Latest plan revision among plans at or before `seq`."""
   354	    best = 0
   355	    for e in events:
   356	        if kind_of(e) == "plan" and seq_of(e) <= seq:
   357	            best = max(best, int(e.get("revision", 1)))
   358	    return best
   359	
   360	
   361	def _rev_after(events: list[dict[str, Any]], seq: int) -> int:
   362	    return latest_plan_revision(events, after_seq=seq)

