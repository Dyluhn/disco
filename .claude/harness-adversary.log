   936	    async def collect_workspace(
   937	        self, conversation_id: str, file_paths: list[str]
   938	    ) -> dict[str, Any]:
   939	        """Collect the conversation's workspace files AUTHORITATIVELY (Bug 9 fix).
   940	
   941	        ROOT CAUSE this replaces: the old path fetched each declared file via the
   942	        single-origin preview proxy (``GET …/preview-app/<path>``). That proxies the
   943	        agent's DEV SERVER, so it returns the file ONLY when the served preview is up,
   944	        registered, and serving that exact route — fragile. A build that genuinely
   945	        SUCCEEDED (index.html written, served, FINISHED) produced an EMPTY manifest
   946	        because the proxy 404'd → the OutputTruthOracle false-FAILed it
   947	        (FALSE_FINISH_NO_OUTPUT). Verified live: ``…/preview-app/index.html``,
   948	        ``…/workspace/index.html`` (image-only allowlist), and ``…/artifacts/index.html``
   949	        (declared-"files" only; an app deliverable is artifact_kind="app") ALL 404 for a
   950	        finished static build — there is no HTTP route that serves arbitrary workspace
   951	        source. The durable, dev-server-independent truth is the host ProjectStore
   952	        SNAPSHOT (``<projects_root>/<cid>/workspace/…``), the SAME source the product's
   953	        own preview-edit / artifact-download routes fall back to once a run is terminal.
   954	
   955	        Returns a manifest keyed by workspace-relative path:
   956	            {path: {"present": True, "size": int, "sha256": hex, "content": str}}
   957	        for EVERY file in the snapshot (a faithful workspace reflection, not just the
   958	        declared paths), plus each declared path under its EXACT scenario-declared key
   959	        so the OutputTruthOracle's ``path in files`` presence check matches. A declared
   960	        file that is genuinely absent is OMITTED (never a present:false key — that would
   961	        mask FALSE_FINISH_NO_OUTPUT into ARTIFACT_TRUTH_MISMATCH), so a real
   962	        missing-deliverable build STILL FAILs correctly. ``content`` is the decoded UTF-8
   963	        text (so must_contain substring checks run on the real file); a binary / oversized
   964	        file keeps present+size+sha256 with empty content.
   965	
   966	        Fallback: ONLY when there is NO snapshot at all (no projects_root configured, or
   967	        the conversation's snapshot workspace dir never materialized), each declared path
   968	        is fetched via the preview proxy — so a no-storage deployment is never WORSE than
   969	        before. When the snapshot IS authoritative (its workspace dir exists), the proxy
   970	        is NEVER consulted: a declared file absent from the snapshot is genuinely missing
   971	        and is OMITTED, so the proxy can't mask a missing required deliverable with a
   972	        served/stale copy (anti-false-PASS hole #1).
   973	        """
   974	        declared = list(file_paths)
   975	        manifest: dict[str, Any] = {}
   976	        snapshot_dir: Path | None = None
   977	
   978	        if self._projects_root is not None:
   979	            manifest, snapshot_dir = await self._await_ready_snapshot(conversation_id, declared)
   980	
   981	        # The snapshot is AUTHORITATIVE: return it as-is. A declared file absent from the
   982	        # snapshot stays OMITTED — never proxy-substituted (hole #1).
   983	        if snapshot_dir is not None:
   984	            return manifest
   985	
   986	        # No snapshot at all → legacy preview-proxy fallback (no-storage deployments only).
   987	        for path in declared:
   988	            if path in manifest:
   989	                continue
   990	            rel = path.lstrip("/")
   991	            status, text, _hdrs = await self._t.get_text(
   992	                f"/conversations/{conversation_id}/preview-app/{rel}"
   993	            )
   994	            if status < 400:
   995	                entry = _file_entry(text.encode("utf-8"))
   996	                entry["source"] = "preview_proxy"
   997	                manifest[path] = entry
   998	        return manifest
   999	
  1000	    async def _await_ready_snapshot(
  1001	        self, conversation_id: str, declared: list[str]
  1002	    ) -> tuple[dict[str, Any], Path | None]:
  1003	        """Poll the host ProjectStore snapshot until it has SETTLED on the build's
  1004	        AGENT-FINAL state, then return ``(manifest, snapshot_dir)``.
  1005	
  1006	        WHY (stale-read race): ``_maybe_snapshot`` mirrors the sandbox workspace to the
  1007	        ProjectStore AFTER the build appends a terminal event. A multi-revision build
  1008	        reaches a terminal per revision, so revision-1's files are already on disk
  1009	        (presence-complete) BEFORE revision-2's bytes flush — the old presence-only gate
  1010	        settled on STALE revision-1 content → a false ARTIFACT_TRUTH_MISMATCH. A timing
  1011	        window can't deterministically close that gap, so we gate on a DETERMINISTIC
  1012	        readiness signal derived from the build's own durable event log (NOT the scenario's
  1013	        expected assertion — gating on the assertion target would mask real failures).
  1014	
  1015	        Per declared file the agent's FINAL state (from ``_agent_declared_expected``) is one of:
  1016	          * sha — last op is ``file_write`` (full bytes in the payload): on-disk sha256 MATCH.
  1017	          * rendered — a partial edit was the last mutation but a FULL ``file_read`` readback
  1018	            after it carries the true post-edit bytes: the on-disk file RENDERED by file_read's
  1019	            own numberer must equal the readback (closes the partial-edit-last stale gap).
  1020	          * absent — the agent ``rm``'d it via shell: accept only when NOT on disk.
  1021	          * present_unproven — a partial edit with no provable post-state: extended stability.
  1022	          * unknown — no event-log signal at all: extended stability (present or absent).
  1023	
  1024	        Timeout = FAIL-FAST only for a CONTENT-PRECISE signal (sha / rendered / absent) still
  1025	        unsatisfied at the ``snapshot_wait_s`` deadline → raise ``SnapshotNotReadyError`` (→
  1026	        INVALID_RUN WORKSPACE_SNAPSHOT_NOT_READY). present_unproven / unknown files NEVER
  1027	        fail-fast (no content proof exists, and a legit edit-without-readback build must not
  1028	        become INVALID_RUN) — they settle on EXTENDED content-stability (+a logged warning) and
  1029	        are accepted best-effort at the deadline, preserving the genuinely-missing → OMITTED →
  1030	        FALSE_FINISH path. Already-consistent snapshots are accepted PROMPTLY, no needless wait."""
  1031	        try:
  1032	            events = self.collect_events(conversation_id)
  1033	        except sqlite3.Error:
  1034	            # No durable event log available (e.g. deterministic tests that don't seed the
  1035	            # DB) → no event signals; every declared file settles on content-stability.
  1036	            events = []
  1037	        expected = _agent_declared_expected(events, declared)
  1038	
  1039	        deadline = time.monotonic() + self._snapshot_wait_s
  1040	        prev_ident: dict[str, Any] = {}
  1041	        stable_n: dict[str, int] = {}
  1042	        manifest: dict[str, Any] = {}
  1043	        snapshot_dir: Path | None = None
  1044	        while True:
  1045	            snapshot_dir = self._snapshot_workspace_dir(conversation_id)
  1046	            manifest = (
  1047	                self._read_snapshot_manifest(conversation_id, declared, snapshot_dir)
  1048	                if snapshot_dir is not None
  1049	                else {}
  1050	            )
  1051	            # Content-stability bookkeeping: count consecutive identical (present+size+sha)
  1052	            # reads per declared file. A change resets the counter to this fresh observation.
  1053	            for p in declared:
  1054	                ident = _manifest_ident(manifest, p)
  1055	                if p in prev_ident and prev_ident[p] == ident:
  1056	                    stable_n[p] = stable_n.get(p, 1) + 1
  1057	                else:
  1058	                    stable_n[p] = 1
  1059	                prev_ident[p] = ident
  1060	            ready, blocking, unproven_ready = _evaluate_snapshot_readiness(
  1061	                declared, expected, manifest, stable_n
  1062	            )
  1063	            # PROVEN-ready entries (raw_sha / rendered_readback / absent) are safe to accept
  1064	            # the instant they're ready. But an entry accepted PURELY on content-stability
  1065	            # (unproven_ready) can still be STALE: a multi-revision build's FINAL edit (e.g.
  1066	            # the late "Get Started" CTA change in revise_twice_complex) can flush AFTER the
  1067	            # brief stability window, so short-circuiting here captured the pre-edit bytes and
  1068	            # mislabeled a DELIVERED build WORKSPACE_SNAPSHOT_UNVERIFIED (the authoritative
  1069	            # ProjectStore had the change). So when readiness rests on unproven stability, do
  1070	            # NOT break early — keep polling to the full snapshot_wait_s deadline so a late
  1071	            # flush re-resets stability and is captured. Proven captures stay fast (no wait).
  1072	            if ready and (not unproven_ready or time.monotonic() >= deadline):
  1073	                for p in unproven_ready:
  1074	                    _LOG.warning(
  1075	                        "snapshot %s: declared file %r accepted on EXTENDED content-stability "
  1076	                        "(%s) — no sha/readback proof of the agent's final bytes (expected=%s)",
  1077	                        conversation_id, p, expected.get(p, ("unknown",))[0],
  1078	                        list(expected.get(p, ("unknown",))),
  1079	                    )
  1080	                break
  1081	            if time.monotonic() >= deadline:
  1082	                if blocking:
  1083	                    raise SnapshotNotReadyError(
  1084	                        "workspace snapshot never reached the agent's final state within "
  1085	                        f"{self._snapshot_wait_s:g}s",
  1086	                        {
  1087	                            "conversation_id": conversation_id,
  1088	                            "snapshot_wait_s": self._snapshot_wait_s,
  1089	                            "snapshot_dir": str(snapshot_dir) if snapshot_dir else None,
  1090	                            "unsatisfied": [
  1091	                                {
  1092	                                    "path": p,
  1093	                                    "expected": list(expected.get(p, ("unknown",))),
  1094	                                    "on_disk_sha256": _manifest_sha(manifest, p),
  1095	                                    "present": _manifest_present(manifest, p),
  1096	                                }
  1097	                                for p in blocking
  1098	                            ],
  1099	                        },
  1100	                    )
  1101	                # No DEFINITE event signal still pending → no evidence the snapshot is behind
  1102	                # the agent. Accept the current read best-effort (genuinely-missing files stay
  1103	                # OMITTED → FALSE_FINISH preserved); never FAIL-FAST on an unknown file.
  1104	                break
  1105	            await asyncio.sleep(_SNAPSHOT_POLL_S)
  1106	        # Stamp each PRESENT declared file's acceptance PROOF LEVEL onto its manifest entry so
  1107	        # the OutputTruthOracle can proof-gate a content mismatch (Part A): a mismatch on a
  1108	        # non-authoritative capture (unproven_extended_stability / unknown) is unreliable and
  1109	        # must not be a definitive product failure unless the bytes reached the same stability
  1110	        # threshold the readiness gate uses; a proven one (raw_sha / rendered_readback) stays
  1111	        # hard. Absent declared files carry no entry (existence is judged separately).
  1112	        for p in declared:
  1113	            entry = _manifest_lookup(manifest, p)
  1114	            if entry is not None:
  1115	                entry["proof"] = _proof_level(expected.get(p))
  1116	                entry["content_stable"] = (
  1117	                    stable_n.get(p, 0) >= _SNAPSHOT_UNPROVEN_STABLE_POLLS
  1118	                )
  1119	        return manifest, snapshot_dir
  1120	
  1121	    def _read_snapshot_manifest(
  1122	        self, conversation_id: str, declared: list[str], ws: Path | None = None
  1123	    ) -> dict[str, Any]:
  1124	        """Walk the host ProjectStore snapshot workspace for `conversation_id` and
  1125	        build the per-file manifest. Symlink-jailed (resolve + is_relative_to) so a
  1126	        planted ``leak.html -> /etc/passwd`` can never escape the workspace. Empty dict
  1127	        when no snapshot exists yet (caller retries / falls back to the preview proxy)."""
  1128	        if ws is None:
  1129	            ws = self._snapshot_workspace_dir(conversation_id)
  1130	        if ws is None:
  1131	            return {}
  1132	        manifest: dict[str, Any] = {}
  1133	        count = 0
  1134	        for root, _dirs, names in os.walk(ws):  # followlinks=False → no dir-symlink escape
  1135	            for name in sorted(names):
  1136	                fp = Path(root) / name
  1137	                try:
  1138	                    resolved = fp.resolve()
  1139	                    if not resolved.is_relative_to(ws) or not resolved.is_file():
  1140	                        continue
  1141	                    rel = resolved.relative_to(ws).as_posix()
  1142	                    data = resolved.read_bytes()
  1143	                except OSError:
  1144	                    continue
  1145	                manifest[rel] = _file_entry(data)
  1146	                count += 1
  1147	                if count >= _WS_MANIFEST_MAX_FILES:
  1148	                    break
  1149	            if count >= _WS_MANIFEST_MAX_FILES:
  1150	                break
  1151	        # Guarantee each DECLARED path is keyed by its EXACT scenario string (the oracle
  1152	        # checks `spec["path"] in files`); the walk keys by the leading-slash-free relpath.
  1153	        for path in declared:
  1154	            rel = path.lstrip("/")
  1155	            if path not in manifest and rel in manifest:
  1156	                manifest[path] = manifest[rel]
  1157	        return manifest
  1158	
  1159	    def _snapshot_workspace_dir(self, conversation_id: str) -> Path | None:
  1160	        """The host ProjectStore ``workspace/`` directory for this conversation, or None
  1161	        when no projects_root is configured/valid or the snapshot isn't on disk yet.
  1162	        Uses the product's OWN ProjectStore so the runner resolves the SAME root the
  1163	        agent-server does (DISCO_DATA_DIR / XDG_DATA_HOME / ~/.local/share/disco/projects)."""
  1164	        if self._projects_root is None:
  1165	            return None
  1166	        try:
  1167	            from disco.tools.projects.store import ProjectStore, StorageStatus
  1168	
  1169	            store = ProjectStore(self._projects_root)
  1170	            if store.status() != StorageStatus.OK:
  1171	                return None
  1172	            ws = store.path_for(conversation_id).resolve()
  1173	        except Exception:  # noqa: BLE001 — any resolution failure ⇒ no snapshot available
  1174	            return None
  1175	        return ws if ws.is_dir() else None
  1176	
  1177	    async def collect_preview(self, conversation_id: str) -> dict[str, Any]:
  1178	        """Capture preview truth: availability + the served ROOT html + its HTTP
  1179	        health status. Shape consumed by OutputTruthOracle:
  1180	        {"health": {"status": <code>}, "content": <html>, "available": <bool>}.
  1181	
  1182	        Bug 10 (same ephemeral-proxy fragility as Bug 9): post-FINISH the live preview
  1183	        proxy 404s because the model's served preview (a backgrounded ``python -m
  1184	        http.server``) is torn down when the run ends — false `FALSE_FINISH_PREVIEW_BROKEN`.
  1185	
  1186	        TRUTH HIERARCHY (no forged 200 — every preview-OK carries GENUINE POSITIVE evidence
  1187	        the deliverable actually serves the required content):
  1188	          1. The LIVE proxy serves (status < 400 AND non-empty) → that IS the truth, used as-is.
  1189	          2. Proxy down + a STATIC served-root (``index.html``) is durable in the snapshot →
  1190	             the runner SERVES that snapshot dir itself on an OS-assigned FREE high port (never
  1191	             a reserved control port) and HTTP-PROBES it, then tears the server down. The REAL
  1192	             probe (status + body) is the evidence — independent of whether the agent ran an
  1193	             in-run verify. A non-serving / unreadable / wrong-content snapshot → the probe
  1194	             genuinely fails / lacks the needle → the preview FAILs (NOT masked). Absence of an
  1195	             in-run verify is NOT treated as a pass; the serve+probe supplies the positive proof.
  1196	          3. The build's OWN in-run web-app verification ENDED in failure (`_in_run_verify_failed`)
  1197	             → believe the agent's broken-verdict; do NOT claim OK even if the static shell serves.
  1198	          4. No static served-root (dynamic-only app, or no deliverable) → honest 404
  1199	             (FALSE_FINISH_PREVIEW_BROKEN). Live dynamic-app preview verification is the
  1200	             documented follow-up — never a forged pass.
  1201	        """
  1202	        avail_status, avail = await self._t.get_json(
  1203	            f"/conversations/{conversation_id}/preview"
  1204	        )
  1205	        status, text, _hdrs = await self._t.get_text(
  1206	            f"/conversations/{conversation_id}/preview-app/"
  1207	        )
  1208	        live = {
  1209	            "health": {"status": status},
  1210	            "content": text,
  1211	            "available": bool(avail.get("available")) if avail_status < 400 else False,
  1212	        }
  1213	        # (1) The live preview proxy actually served → that IS the truth.
  1214	        if status < 400 and text:
  1215	            return live
  1216	        # (3) The agent's own in-run verify ended in failure → believe it; no durable claim.
  1217	        if self._projects_root is None or self._in_run_verify_failed(conversation_id):
  1218	            return live
  1219	        # (4) No static served-root → honest 404 (dynamic-only / no deliverable).
  1220	        served_index = self._snapshot_served_index(conversation_id)
  1221	        if served_index is None:
  1222	            return live
  1223	        # (2) Serve the snapshot static content ourselves + PROBE it for GENUINE evidence.
  1224	        probe = await asyncio.to_thread(self._serve_probe_snapshot, served_index.parent)
