   121	            # Link A->B: PlanEvent -> AWAITING_PLAN_APPROVAL (interactive only).
   122	            if not autonomous and not any(s > first_plan for s in awaiting):
   123	                return [
   124	                    failing(
   125	                        _ORACLE,
   126	                        fc.PLAN_APPROVED_STATUS_MISSING,
   127	                        first_broken_link="plan_event -> awaiting_plan_approval",
   128	                        facts={
   129	                            "first_plan_seq": first_plan,
   130	                            "awaiting_plan_approval_present": False,
   131	                            "terminal_status": term,
   132	                        },
   133	                    )
   134	                ]
   135	
   136	            # Link B->C: AWAITING -> RUNNING/plan_approved.
   137	            if not approvals:
   138	                return [
   139	                    failing(
   140	                        _ORACLE,
   141	                        fc.PLAN_APPROVED_STATUS_MISSING,
   142	                        first_broken_link="awaiting_plan_approval -> plan_approved",
   143	                        facts={
   144	                            "plan_approved_present": False,
   145	                            "terminal_status": term,
   146	                        },
   147	                    )
   148	                ]
   149	            first_approval = approvals[0]
   150	
   151	            # Ordering A < B < C: the awaiting gate must fall BETWEEN the plan and
   152	            # its approval (interactive only). Catches an out-of-order forged chain.
   153	            if not autonomous and not any(first_plan < s < first_approval for s in awaiting):
   154	                return [
   155	                    failing(
   156	                        _ORACLE,
   157	                        fc.PLAN_APPROVED_STATUS_MISSING,
   158	                        first_broken_link="plan_event -> awaiting_plan_approval",
   159	                        facts={
   160	                            "first_plan_seq": first_plan,
   161	                            "awaiting_seqs": awaiting,
   162	                            "first_plan_approved_seq": first_approval,
   163	                            "reason": "no AWAITING_PLAN_APPROVAL between the plan and its approval",
   164	                        },
   165	                    )
   166	                ]
   167	
   168	            # Link C->D: RUNNING/plan_approved -> execution action.
   169	            last_approval = approvals[-1]
