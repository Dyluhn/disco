   845	def _invalid_run_record(
   846	    out_root: str | Path,
   847	    run_id: str,
   848	    scenario: dict[str, Any],
   849	    reason: str,
   850	    *,
   851	    code: str = "RUN_INTERRUPTED",
   852	    first_broken_link: str = "drive -> evidence_collection",
   853	    facts: dict[str, Any] | None = None,
   854	) -> dict[str, Any]:
   855	    """Write an INVALID_RUN record (§8) when the harness could not collect complete
   856	    evidence / obtain a verdict to adjudicate — e.g. the agent-server became UNREACHABLE
   857	    mid-run (RUN_INTERRUPTED), or the terminal wait was cut off by the hard cap while the
   858	    build was STILL PROGRESSING (RUN_TIMEOUT_WHILE_PROGRESSING, Bug 15). This is NOT a
   859	    product FAIL (we can't prove a product outcome) and NOT INFRA_FAILURE (pre-create only,
   860	    §9); it blocks promotion AND signals §17 to re-run rather than recording a false fail."""
   861	    base = Path(out_root) / run_id
   862	    base.mkdir(parents=True, exist_ok=True)
   863	    record_facts: dict[str, Any] = {"reason": reason, **(facts or {})}
   864	    record = {
   865	        "status": fc.INVALID_RUN,
   866	        "severity": fc.NONE,
   867	        "code": code,
   868	        "first_broken_link": first_broken_link,
   869	        "scenario_id": scenario.get("id"),
   870	        "run_id": run_id,
   871	        "conversation_id": None,
   872	        "facts": record_facts,
   873	        "required_evidence_present": False,
   874	        "accepted_by": "oracle",
   875	        "agent_comments_ignored_for_adjudication": True,
   876	    }
   877	    (base / CLASSIFICATION_NAME).write_text(
   878	        json.dumps(record, indent=2, sort_keys=True), encoding="utf-8"
   879	    )
   880	    (base / "timeline.md").write_text(
   881	        f"# INVALID_RUN ({code})\n\nreason: {reason}\n", encoding="utf-8"
   882	    )
   883	    return record
