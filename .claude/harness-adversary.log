   254	                        _ORACLE,
   255	                        fc.WRITE_BEFORE_REVISION_APPROVAL,
   256	                        first_broken_link="followup_write -> revised_plan_approval",
   257	                        facts={
   258	                            "followup_user_event_seq": fseq,
   259	                            "revised_plan_seq": p_seq,
   260	                            "first_write_tool_after_followup_seq": mutated_seq,
