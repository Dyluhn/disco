   255	def has_action(
   256	    events: list[dict[str, Any]], *, tool_name: str | None = None, after_seq: int = 0
   257	) -> bool:
   258	    """True when an ActionEvent exists (optionally for `tool_name`) with seq >
   259	    after_seq."""
   260	    for e in events:
   261	        if kind_of(e) != KIND_ACTION or seq_of(e) <= after_seq:
   262	            continue
   263	        if tool_name is not None and tool_name_of(e) != tool_name:
   264	            continue
   265	        return True
   266	    return False
   267	
   268	
   269	def action_id_of(ev: dict[str, Any]) -> str | None:
   270	    """The durable id an ObservationEvent / AgentErrorEvent's `action_id` points
   271	    back to — i.e. the ActionEvent's own `id`. None for non-action events.
   272	
   273	    Correlation key for pairing an action with its result: the real loop stamps the
   274	    observation/error with `action_id == <the action event's id>` (verified on
   275	    frozen evidence: action `id` evt_X ↔ observation/agent_error `action_id` evt_X).
   276	    """
   277	    if kind_of(ev) != KIND_ACTION:
   278	        return None
   279	    aid = ev.get("id")
   280	    return str(aid) if aid is not None else None
   281	
   282	
   283	# Stable message signatures the PRE-EXECUTION gates/guards emit when they refuse a
   284	# tool BEFORE the executor runs — the ONLY provably-non-mutating rejections. These
   285	# are fixed module-constant strings in the product (only the tool name is
   286	# interpolated into the wrapper), so a substring match on the invariant portion is
   287	# stable. Verified against the product source:
   288	#   * disco.core.loop.engine `_gate_planning_mode`     (write/exec tool in PLANNING)
   289	#   * disco.core.loop.engine `_MIDSTEP_STEER_REFUSAL`  (mutating tool at the apply
   290	#     boundary after a mid-step change steer — the Bug-13 seq-60 case)
   291	#   * disco.core.loop.observe K1 elision-marker execution guard (arg carries an
   292	#     elision placeholder; rejected before execution)
   293	# FRAGILITY: this couples the harness to the product's refusal WORDING. The robust
   294	# fix would be a structured marker on the AgentErrorEvent the gates emit (e.g.
   295	# `error_type="gate_rejected"` / a rejection code) — a tiny, gate-only product change
   296	# the oracle could key on instead of strings. The AgentErrorEvent today carries only
   297	# a free-text `error` (no structured field, `meta` is empty), so we match the stable
   298	# strings and DEFER the product marker (flagged in build-soak-surfaced-bugs.md). If a
   299	# gate's message text changes, update this allowlist.
   300	_GATE_REJECTION_MARKERS: tuple[str, ...] = (
   301	    "is not available in PLANNING mode. No workspace mutation",
   302	    "was not applied. A change request arrived while you were mid-step",
   303	    "contain an internal elision placeholder",
   304	)
   305	
   306	
   307	def _is_recognized_gate_rejection(error_text: str) -> bool:
   308	    """True iff `error_text` is a RECOGNIZED pre-execution gate/guard rejection (a
   309	    refusal that provably ran BEFORE the executor → nothing mutated). A generic
   310	    AgentErrorEvent is NOT enough: the product emits AgentErrorEvent for many cases —
   311	    tool failed, action invalid, EXECUTION RAISED (the tool may have started, mutated
   312	    disk, then raised → AgentError, no observation, but it DID mutate), or the human
   313	    declined. Only the closed allowlist above is provably non-mutating."""
   314	    return any(marker in error_text for marker in _GATE_REJECTION_MARKERS)
   315	
   316	
   317	def action_executed(events: list[dict[str, Any]], action_id: str) -> bool:
   318	    """True iff the action identified by `action_id` MAY HAVE MUTATED the workspace —
   319	    i.e. it is counted as a write. The discriminator is a RECOGNIZED PRE-EXECUTION
   320	    GATE REJECTION, NOT the success flag and NOT the mere presence of an AgentError
   321	    (the two codex anti-false-PASS corrections):
   322	
   323	      * Paired with an ObservationEvent (a `tool_result` exists) -> the call reached
   324	        the executor and RAN. COUNTS regardless of `tool_result.success` True/False: a
   325	        write can mutate disk and THEN report success=False (a partial /
   326	        failed-after-mutation write), so excluding `success=False` would hide a real
   327	        mutation -> false-PASS. Any observation => counts.
   328	
   329	      * Paired ONLY with an AgentErrorEvent whose text matches a RECOGNIZED gate/guard
   330	        rejection (`_is_recognized_gate_rejection` — `_gate_planning_mode` /
   331	        `_gate_midstep_steer_replan` / the K1 elision guard) and NO observation -> the
   332	        tool was refused BEFORE the executor ran, so NOTHING mutated. The §11.3
   333	        tool-rejection-recovery contract WORKING, not a §11.4/§11.7 violation. Does NOT
   334	        count. This is the Bug-13 case (the rejected pre-approval write at seq 59 /
   335	        agent_error at seq 60, which carries the `_MIDSTEP_STEER_REFUSAL` text).
   336	
   337	      * Any OTHER AgentErrorEvent (tool raised after possibly mutating, invalid
   338	        action, human declined) with no observation -> POSSIBLY MUTATED -> COUNTS
   339	        (anti-false-PASS). A bare AgentError is NOT proof of non-mutation.
   340	
   341	      * Paired with NEITHER (dangling, no response) -> COUNTS conservatively (an
   342	        unpaired action must not mask a real violation; a genuinely missing
   343	        observation is also caught as ACTION_NO_OBSERVATION by the EventChainOracle).
   344	    """
   345	    has_observation = False
   346	    gate_rejected = False
   347	    for e in events:
   348	        k = kind_of(e)
   349	        if k == KIND_OBSERVATION and str(e.get("action_id")) == action_id:
   350	            has_observation = True
   351	        elif (
   352	            k == KIND_AGENT_ERROR
   353	            and e.get("action_id") is not None
   354	            and str(e.get("action_id")) == action_id
   355	            and _is_recognized_gate_rejection(str(e.get("error") or ""))
   356	        ):
   357	            gate_rejected = True
   358	    if has_observation:
   359	        return True  # reached the executor (ran; may have mutated) -> counts
   360	    if gate_rejected:
   361	        return False  # recognized pre-execution gate/guard rejection -> nothing mutated
   362	    return True  # other AgentError (may have mutated) / dangling -> count (anti-false-PASS)
   363	
   364	
   365	def has_observation_for_action(events: list[dict[str, Any]], action_id: str) -> bool:
   366	    """True when an OBSERVATION or AGENT_ERROR event references `action_id`.
   367	
   368	    Per the EventChain caveat: a tool rejection / error is recorded as an
   369	    AgentErrorEvent (`action_id == X`) and that IS visible feedback to the model —
   370	    a VALID pairing for the action, distinct from a genuinely-missing observation.
   371	    """
   372	    for e in events:
   373	        k = kind_of(e)
   374	        if k == KIND_OBSERVATION and str(e.get("action_id")) == action_id:
   375	            return True
   376	        if k == KIND_AGENT_ERROR and e.get("action_id") is not None and (
   377	            str(e.get("action_id")) == action_id
   378	        ):
   379	            return True
   380	    return False
   381	
   382	
   383	def has_tool_rejection(events: list[dict[str, Any]]) -> bool:
   384	    """True when any tool call was rejected — an AgentErrorEvent, or an
   385	    ObservationEvent whose tool_result.success is False."""
   386	    for e in events:
   387	        k = kind_of(e)
   388	        if k == KIND_AGENT_ERROR:
   389	            return True
   390	        if k == KIND_OBSERVATION:
   391	            tr = e.get("tool_result") or {}
   392	            if tr.get("success") is False:
   393	                return True
   394	    return False
   395	
   396	
   397	def terminal_status(events: list[dict[str, Any]]) -> str | None:
   398	    """The last terminal status the run reached (FINISHED/ERROR/IDLE/STUCK), else
   399	    None (the run never reached a terminal state — STUCK_RUNNING territory). A
   400	    later RUNNING re-opens the run (follow-up/replan) and clears the marker."""
   401	    result: str | None = None
   402	    for e in events:
   403	        if kind_of(e) != KIND_STATUS:
   404	            continue
   405	        st = str(e.get("status"))
   406	        if st in TERMINAL_STATUSES:
   407	            result = st
   408	        elif st == "RUNNING":
   409	            # Re-entering RUNNING after a terminal means the run reopened
   410	            # (a follow-up / replan) — clear the terminal marker.
   411	            result = None
   412	    return result
   413	
   414	
   415	def latest_plan_revision(events: list[dict[str, Any]], *, after_seq: int = 0) -> int:
   416	    """The highest plan revision seen with seq > after_seq, or 0 when no plan
   417	    exists. Mirrors plans.py's semantics: the loop assigns
   418	    `revision = 1 + (count of prior PlanEvents)`, so the latest PlanEvent's stored
   419	    `revision` is also the count of plans so far — both views agree."""
   420	    best = 0
   421	    for e in events:
   422	        if kind_of(e) != KIND_PLAN or seq_of(e) <= after_seq:
   423	            continue
   424	        best = max(best, int(e.get("revision", 1)))
   425	    return best
   426	
   427	
   428	def plan_event_count(events: list[dict[str, Any]], *, after_seq: int = 0) -> int:
   429	    return sum(
