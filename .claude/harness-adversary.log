  1029	def _extract_sandbox_instance_ids(*payloads: Any) -> list[str]:
  1030	    """Harvest sandbox ids from state/kill response shapes without depending on one version."""
  1031	    ids: list[str] = []
  1032	
  1033	    def add(raw: Any) -> None:
  1034	        if isinstance(raw, str):
  1035	            sid = raw.strip()
  1036	            if sid and not sid.startswith("session-") and sid not in ids:
  1037	                ids.append(sid)
  1038	            return
  1039	        if isinstance(raw, (list, tuple, set)):
  1040	            for item in raw:
  1041	                add(item)
  1042	
  1043	    def scan(value: Any, *, sandbox_context: bool = False) -> None:
  1044	        if not isinstance(value, dict):
  1045	            return
  1046	        add(value.get("sandbox_instance_id"))
  1047	        add(value.get("sandbox_instance_ids"))
  1048	        if sandbox_context:
  1049	            add(value.get("instance_id"))
  1050	            add(value.get("instance_ids"))
  1051	            add(value.get("id"))
  1052	        scan(value.get("state"))
  1053	        scan(value.get("extras"))
  1054	        scan(value.get("sandbox"), sandbox_context=True)
  1055	
  1056	    for payload in payloads:
  1057	        scan(payload)
  1058	    return ids
