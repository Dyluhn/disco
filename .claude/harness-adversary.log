    84	class NormalizationError(ValueError):
    85	    """A raw event could not be coerced into the canonical full-event shape."""
    86	
    87	
    88	# The DB row columns SqliteEventStore writes alongside the JSON `payload` (the
    89	# full event). These are duplicated INSIDE the payload too, so on a row the
    90	# payload is authoritative for content; the columns only fill a gap.
    91	_ROW_COLUMNS = ("seq", "kind", "source", "id", "created_at")
    92	
    93	
    94	def normalize_event(raw: Any) -> dict[str, Any]:
    95	    """Coerce one raw event into the canonical FULL-event dict.
    96	
    97	    Two input shapes, ONE canonical output (same fields regardless of input):
    98	
    99	      * the full persisted event dict — `event.model_dump(mode="json")`: a flat
   100	        dict with `kind` and ALL content fields (`tool_call`, `tool_result`,
   101	        `detail`, `revision`, ...) inlined, and NO `payload` member. Returned as a
   102	        shallow copy.
   103	
   104	      * a real SQLite row `{seq, kind, source, [id, created_at,] payload}` where
   105	        `payload` is the FULL event — either an already-decoded dict OR (the real
   106	        on-disk shape) a JSON STRING of one. The canonical event is the PARSED
   107	        PAYLOAD (it carries every content field); the top-level row columns only
   108	        FILL a field the payload happens to lack (older dumps). This is the fix
   109	        for the P0 false-negative where a row with top-level `kind` had its payload
   110	        dropped, hiding `detail`/`tool_call`/`revision` from every predicate.
   111	
   112	    Raises NormalizationError on anything else (a non-dict, a payload that won't
   113	    parse, or a dict with no discernible kind) so a corrupt log surfaces as
   114	    INVALID_RUN, never a silent mis-parse.
   115	    """
   116	    if not isinstance(raw, dict):
   117	        raise NormalizationError(f"event is not a dict: {type(raw).__name__}")
   118	
   119	    # Decode a `payload` member (string -> JSON, or an already-decoded dict).
   120	    parsed_payload: Any = None
   121	    if "payload" in raw:
   122	        payload = raw["payload"]
   123	        if isinstance(payload, str):
   124	            try:
   125	                parsed_payload = json.loads(payload)
   126	            except (ValueError, TypeError) as exc:
   127	                raise NormalizationError(f"row payload is not JSON: {exc}") from exc
   128	        elif isinstance(payload, dict):
   129	            parsed_payload = payload
   130	        else:
   131	            raise NormalizationError(
   132	                f"row payload is neither a JSON string nor a dict: {type(payload).__name__}"
   133	            )
   134	
   135	    # Row shape: the payload IS the full event. MERGE — payload content wins, the
   136	    # row's columns only fill a missing field.
   137	    if isinstance(parsed_payload, dict) and "kind" in parsed_payload:
   138	        event = dict(parsed_payload)
   139	        for col in _ROW_COLUMNS:
   140	            if event.get(col) is None and raw.get(col) is not None:
   141	                event[col] = raw[col]
   142	        return event
   143	
   144	    # Full event dict (no payload member, kind inlined).
   145	    if "kind" in raw and "payload" not in raw:
   146	        return dict(raw)
   147	
   148	    raise NormalizationError(
   149	        f"event has no discernible kind (and no usable payload): keys={sorted(raw)}"
   150	    )
   151	
