  1235	    def _serve_probe_snapshot(self, served_dir: Path) -> tuple[int, str] | None:
  1236	        """Serve `served_dir` on an OS-assigned FREE loopback port (NEVER a reserved control
  1237	        port — port 0 lets the OS pick an ephemeral high port, guarded defensively) and
  1238	        HTTP-probe ``GET /`` for GENUINE evidence the static deliverable serves + with what
  1239	        content. Returns (status, body) or None if it could not be served/probed. The server
  1240	        is ALWAYS torn down (finally). Loopback-only bind (127.0.0.1)."""
  1241	        import functools
  1242	        import http.server
  1243	        import threading
  1244	        import urllib.error
  1245	        import urllib.request
  1246	
  1247	        class _QuietHandler(http.server.SimpleHTTPRequestHandler):
  1248	            # silence per-request stderr noise; signature matches BaseHTTPRequestHandler
  1249	            def log_message(self, format: str, *args: Any) -> None:  # noqa: A002
  1250	                return
  1251	
  1252	        handler = functools.partial(_QuietHandler, directory=str(served_dir))
  1253	        try:
  1254	            httpd = http.server.ThreadingHTTPServer(("127.0.0.1", 0), handler)
  1255	        except OSError:
  1256	            return None
  1257	        # From here `httpd` owns a bound socket — it must be closed on EVERY path, including
  1258	        # a failure to create/start the serving thread (else the socket/server leaks).
  1259	        thread: threading.Thread | None = None
  1260	        try:
  1261	            port = httpd.server_address[1]
  1262	            if port in _RESERVED_CONTROL_PORTS:  # defensive — port 0 won't pick these
  1263	                return None
  1264	            thread = threading.Thread(target=httpd.serve_forever, daemon=True)
  1265	            thread.start()
  1266	            try:
  1267	                with urllib.request.urlopen(f"http://127.0.0.1:{port}/", timeout=5) as resp:
  1268	                    body = resp.read().decode("utf-8", "replace")
  1269	                    return int(resp.status), body
  1270	            except urllib.error.HTTPError as exc:  # a real HTTP error status IS evidence
  1271	                try:
  1272	                    body = exc.read().decode("utf-8", "replace")
  1273	                except Exception:  # noqa: BLE001
  1274	                    body = ""
  1275	                return int(exc.code), body
  1276	            except (urllib.error.URLError, OSError, ValueError):
  1277	                return None
  1278	        finally:
  1279	            # shutdown() only makes sense once serve_forever is actually running; server_close()
  1280	            # is ALWAYS safe and is what frees the socket if the thread never started.
  1281	            if thread is not None and thread.is_alive():
  1282	                httpd.shutdown()
  1283	            httpd.server_close()
  1284	            if thread is not None:
  1285	                thread.join(timeout=2)
