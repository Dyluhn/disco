   460	
   461	def is_autonomous(scenario: dict[str, Any] | None) -> bool:
   462	    """An autonomous build auto-approves its plan INLINE (engine.py ~L855) — it
   463	    emits RUNNING/plan_approved with NO human AWAITING_PLAN_APPROVAL gate. That is a
   464	    LEGITIMATE chain, so the awaiting link is required only for interactive runs.
   465	    Declared by the scenario (mirrors the §6 manifest `autonomous` flag); defaults
   466	    to False (interactive — the §15 bare-Build scenarios are all `mode: api`,
   467	    human-approved). Shared by BOTH the initial chain (EventChainOracle) and the
   468	    revised chain (RevisionOracle) so they use one fail-closed default."""
   469	    if not scenario:
   470	        return False
   471	    return bool(scenario.get("autonomous", False))

