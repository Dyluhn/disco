  1472	async def _amain(args: argparse.Namespace) -> int:
  1473	    from .adapters.disco_api import HttpTransport  # live deps only on the CLI path
  1474	
  1475	    scenarios = load_scenarios(args.scenarios)
  1476	    if args.scenario not in scenarios:
  1477	        print(f"unknown scenario {args.scenario!r}; known: {sorted(scenarios)}", file=sys.stderr)
  1478	        return 2
  1479	    scenario = scenarios[args.scenario]
  1480	    # [Lane A A-B1] FAIL-CLOSED infra preflight: a reliability soak must be able to adjudicate
  1481	    # terminal cleanup + provider-after-terminal, which REQUIRES the relay ledger. Refuse to START a
  1482	    # positive scenario without it — else run_once's _live_measure is False, the sidecar/cleanup
  1483	    # slices are omitted, the oracles SKIP, and the run classifies SKIP-as-PASS. A scenario opts out
  1484	    # only by explicitly declaring `requires_relay_ledger: false` (a pure classifier/negative case).
  1485	    if scenario.get("requires_relay_ledger", True) and not _relay_log_path():
  1486	        print(
  1487	            "[build-soak] INFRA_FAILURE: scenario requires the relay ledger to adjudicate terminal "
  1488	            "cleanup + provider-after-terminal — set MINIMAX_RELAY_LOG (or PMX_/DISCO_RELAY_LOG). "
  1489	            "Refusing to run a soak that could SKIP-as-PASS.",
  1490	            file=sys.stderr,
  1491	        )
  1492	        return 3
  1493	    repo_root = Path(__file__).resolve().parents[2]
  1494	    commit = _git_commit(repo_root)
  1495	    db_path = args.db or os.environ.get("DISCO_DB") or str(repo_root / "disco.db")
  1496	    model = args.model or os.environ.get("DISCO_SOAK_MODEL") or None
  1497	    autonomous = bool(args.autonomous or scenario.get("autonomous"))
  1498	
  1499	    # Bug 9: read the authoritative host ProjectStore SNAPSHOT for workspace collection
  1500	    # (not the fragile dev-server preview proxy). "" mirrors the agent-server's OWN root
  1501	    # resolution from the SAME env (DISCO_DATA_DIR / XDG_DATA_HOME / ~/.local/share). The
  1502	    # snapshot wait absorbs the FINISHED-before-_maybe_snapshot flush window.
  1503	    projects_root = args.projects_root or os.environ.get("DISCO_PROJECTS_ROOT") or ""
  1504	    transport: Transport = HttpTransport(args.base_url)
  1505	    client = DiscoApiClient(
  1506	        transport,
  1507	        db_path=db_path,
  1508	        projects_root=projects_root,
  1509	        snapshot_wait_s=args.snapshot_wait,
  1510	    )
  1511	
  1512	    # EPIC K: pin the Build kernel for this whole run before any iteration. A failure
  1513	    # here is INFRA (the bake-off can't run), not a product verdict.
  1514	    kernel_err = await _select_build_kernel(args.app_base_url, args.kernel)
  1515	    if kernel_err:
  1516	        print(f"[build-soak] kernel-select INFRA failure: {kernel_err}", file=sys.stderr)
  1517	        return 3
  1518	    print(
  1519	        f"[build-soak] kernel={args.kernel} ({_KERNEL_KIND[args.kernel]}) pinned for this run",
  1520	        file=sys.stderr,
  1521	    )
  1522	
  1523	    worst = 0
  1524	    for i in range(args.iterations):
  1525	        ts = datetime.now(UTC).strftime("%Y%m%d_%H%M%S")
  1526	        run_id = f"build_soak_{args.scenario}_{ts}_{i:03d}"
  1527	        classification = await run_once(
  1528	            client,
  1529	            scenario,
  1530	            run_id=run_id,
  1531	            out_root=args.out,
  1532	            model=model,
  1533	            autonomous=autonomous,
  1534	            commit=commit,
  1535	            kernel=args.kernel,
  1536	            timeout_s=args.timeout,
  1537	            hard_cap_s=args.hard_cap,
  1538	        )
  1539	        status = str(classification.get("status"))
  1540	        code = classification.get("code")
  1541	        print(
  1542	            f"[{i + 1}/{args.iterations}] {run_id}: {status}"
