  1009	def _new_dangling_volume_count(
  1010	    baseline: set[str] | None,
  1011	    after: set[str] | None,
  1012	    *,
  1013	    exclude_disco_named: bool,
  1014	) -> int | None:
  1015	    """Count volumes newly dangling since run start.
  1016	
  1017	    Named disco workspace volumes are counted by sandbox id when possible; exclude
  1018	    them there to avoid double-counting the same leaked volume as both named and
  1019	    dangling.
  1020	    """
  1021	    if baseline is None or after is None:
  1022	        return None
  1023	    created = after - baseline
  1024	    if exclude_disco_named:
  1025	        created = {name for name in created if not name.startswith(_DISCO_VOLUME_PREFIXES)}
  1026	    return len(created)
