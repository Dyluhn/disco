   153	def normalize_events(raw_events: Iterable[Any]) -> list[dict[str, Any]]:
   154	    """Normalize a sequence of raw events and return them ordered by `seq`.
   155	
   156	    Events whose `seq` is None sort after numbered ones in their original order
   157	    (a not-yet-persisted event should never appear in durable evidence, but we
   158	    never crash on it — durability is the harness-validity oracle's call)."""
   159	    normalized = [normalize_event(e) for e in raw_events]
   160	
   161	    def _key(item: tuple[int, dict[str, Any]]) -> tuple[int, int]:
   162	        idx, ev = item
   163	        seq = ev.get("seq")
   164	        if isinstance(seq, int):
   165	            return (0, seq)
   166	        return (1, idx)
   167	
   168	    return [ev for _, ev in sorted(enumerate(normalized), key=_key)]
