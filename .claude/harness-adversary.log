  1790	class HttpTransport:
  1791	    """httpx + websockets transport against a running agent-server. Imported lazily
  1792	    so the deterministic test path never needs the live deps loaded."""
  1793	
  1794	    def __init__(self, base_url: str = "http://127.0.0.1:8000", *, timeout_s: float = 120.0) -> None:
  1795	        self.base_url = base_url.rstrip("/")
  1796	        self._timeout = timeout_s
  1797	
  1798	    def _ws_url(self, conversation_id: str) -> str:
  1799	        scheme = "wss" if self.base_url.startswith("https") else "ws"
  1800	        host = self.base_url.split("://", 1)[1]
  1801	        return f"{scheme}://{host}/ws/conversations/{conversation_id}"
  1802	
  1803	    async def post_json(self, path: str, body: dict[str, Any]) -> tuple[int, dict[str, Any]]:
  1804	        import httpx
  1805	
  1806	        async with httpx.AsyncClient(timeout=self._timeout) as client:
  1807	            r = await client.post(f"{self.base_url}{path}", json=body)
  1808	            return r.status_code, _safe_json(r)
  1809	
  1810	    async def get_json(self, path: str) -> tuple[int, dict[str, Any]]:
  1811	        import httpx
  1812	
  1813	        async with httpx.AsyncClient(timeout=self._timeout) as client:
  1814	            r = await client.get(f"{self.base_url}{path}")
  1815	            return r.status_code, _safe_json(r)
  1816	
  1817	    async def get_text(self, path: str) -> tuple[int, str, dict[str, str]]:
  1818	        import httpx
  1819	
  1820	        async with httpx.AsyncClient(timeout=self._timeout, follow_redirects=True) as client:
  1821	            r = await client.get(f"{self.base_url}{path}")
  1822	            return r.status_code, r.text, dict(r.headers)
  1823	
  1824	    async def ws_control(self, conversation_id: str, frame: dict[str, Any]) -> None:
  1825	        import websockets
  1826	
  1827	        url = self._ws_url(conversation_id)
  1828	        async with websockets.connect(url, open_timeout=self._timeout) as ws:
  1829	            # Drain the initial state frame the server sends on connect, then send
  1830	            # the control frame. We do NOT wait for an ack — truth is the event log.
  1831	            try:
  1832	                await asyncio.wait_for(ws.recv(), timeout=self._timeout)
  1833	            except TimeoutError:
  1834	                pass
  1835	            await ws.send(json.dumps(frame))
  1836	            # Give the server a beat to process before the socket closes.
  1837	            await asyncio.sleep(0.2)
  1838	
  1839	    async def health(self) -> tuple[int, dict[str, Any]]:
  1840	        import httpx
  1841	
  1842	        async with httpx.AsyncClient(timeout=self._timeout) as client:
  1843	            r = await client.get(f"{self.base_url}/health")
  1844	            return r.status_code, _safe_json(r)
  1845	
  1846	
  1847	def _safe_json(response: Any) -> dict[str, Any]:
  1848	    try:
  1849	        data = response.json()
  1850	    except Exception:  # noqa: BLE001 — non-JSON body
  1851	        return {}
  1852	    return data if isinstance(data, dict) else {"_": data}

