     1	"""EPIC K bake-off scorecard — group Build-Soak runs by kernel and evaluate the
     2	PiKernel-vs-DiscoKernel promotion gate (campaign §K3) from frozen run evidence.
     3	
     4	Reads every run folder under a runs-root: ``manifest.json`` (``kernel`` +
     5	``scenario_id``, stamped by run.py) + ``classification.json`` (the deterministic
     6	oracle ``status`` ∈ {PASS, FAIL, INVALID_RUN, INFRA_FAILURE} + ``severity``). Pure
     7	analysis over frozen evidence — it NEVER re-adjudicates; it only counts. INVALID_RUN
     8	/ INFRA_FAILURE are inconclusive and excluded from the pass-rate denominator (a soak
     9	infra hiccup is not a product failure — guidelines §3).
    10	
    11	Usage:
    12	    python -m build_soak.bakeoff --runs test-record/build-soak
    13	    python -m build_soak.bakeoff --runs test-record/build-soak --scenario static_html_minimal --json
    14	"""
    15	
    16	from __future__ import annotations
    17	
    18	import argparse
    19	import json
    20	import sys
    21	from dataclasses import dataclass, field
    22	from pathlib import Path
    23	from typing import Any
    24	
    25	# Outcomes that COUNT toward a product pass rate (a build either worked or didn't).
    26	# INVALID_RUN / INFRA_FAILURE are inconclusive — excluded from the denominator.
    27	_CONCLUSIVE = ("PASS", "FAIL")
    28	
    29	
    30	@dataclass
    31	class KernelTally:
    32	    kernel: str
    33	    total: int = 0
    34	    passed: int = 0
    35	    failed: int = 0
    36	    invalid: int = 0
    37	    infra: int = 0
    38	    p0: int = 0
    39	    p1: int = 0
    40	    # scenario -> {"pass": n, "fail": n, "invalid": n, "infra": n}
    41	    by_scenario: dict[str, dict[str, int]] = field(default_factory=dict)
    42	
    43	    @property
    44	    def conclusive(self) -> int:
    45	        return self.passed + self.failed
    46	
    47	    @property
    48	    def pass_rate(self) -> float | None:
    49	        return (self.passed / self.conclusive) if self.conclusive else None
    50	
    51	    def add(self, scenario: str, status: str, severity: str | None) -> None:
    52	        self.total += 1
    53	        bucket = {"PASS": "passed", "FAIL": "failed", "INVALID_RUN": "invalid"}.get(
    54	            status, "infra"
    55	        )
    56	        setattr(self, bucket, getattr(self, bucket) + 1)
    57	        if status == "FAIL" and severity == "P0":
    58	            self.p0 += 1
    59	        if status == "FAIL" and severity == "P1":
    60	            self.p1 += 1
    61	        sc = self.by_scenario.setdefault(
    62	            scenario, {"pass": 0, "fail": 0, "invalid": 0, "infra": 0}
    63	        )
    64	        sc[{"passed": "pass", "failed": "fail", "invalid": "invalid"}.get(bucket, "infra")] += 1
    65	
    66	
    67	def _load_run(run_dir: Path) -> dict[str, Any] | None:
    68	    try:
    69	        man = json.loads((run_dir / "manifest.json").read_text(encoding="utf-8"))
    70	        cls = json.loads((run_dir / "classification.json").read_text(encoding="utf-8"))
    71	    except (OSError, json.JSONDecodeError):
    72	        return None
    73	    return {
    74	        # kernel field added by run.py for EPIC K; pre-K runs default to disco.
    75	        "kernel": str(man.get("kernel") or "disco"),
    76	        "scenario": str(man.get("scenario_id") or "?"),
    77	        "status": str(cls.get("status") or "?"),
    78	        "severity": cls.get("severity"),
    79	        "run_id": str(man.get("run_id") or run_dir.name),
    80	    }
    81	
    82	
    83	def scan_runs(runs_root: Path, scenario: str | None = None) -> list[dict[str, Any]]:
    84	    runs: list[dict[str, Any]] = []
    85	    if not runs_root.is_dir():
    86	        return runs
    87	    for d in sorted(runs_root.iterdir()):
    88	        if not (d.is_dir() and (d / "classification.json").exists()):
    89	            continue
    90	        r = _load_run(d)
    91	        if r is None:
    92	            continue
    93	        if scenario and r["scenario"] != scenario:
    94	            continue
    95	        runs.append(r)
    96	    return runs
    97	
    98	
    99	def tally(runs: list[dict[str, Any]]) -> dict[str, KernelTally]:
   100	    out: dict[str, KernelTally] = {}
   101	    for r in runs:
   102	        t = out.setdefault(r["kernel"], KernelTally(kernel=r["kernel"]))
   103	        t.add(r["scenario"], r["status"], r["severity"])
   104	    return out
   105	
   106	
   107	def evaluate_gate(tallies: dict[str, KernelTally]) -> dict[str, Any]:
   108	    """The §K3 criteria computable from soak evidence. (Security/no-key/no-user-
   109	    packages/process-backend criteria are SEPARATE audits, not soak counts — listed
   110	    as manual.) PiKernel is promotion-ELIGIBLE on these only if it ties-or-beats
   111	    DiscoKernel on pass rate and carries no P0/P1."""
   112	    pi, disco = tallies.get("pi"), tallies.get("disco")
   113	    checks: list[dict[str, Any]] = []
   114	
   115	    def chk(name: str, ok: bool | None, detail: str) -> None:
   116	        checks.append({"check": name, "ok": ok, "detail": detail})
   117	
   118	    if pi is None or disco is None:
   119	        chk(
   120	            "both kernels present",
   121	            False,
   122	            f"need pi AND disco runs; have {sorted(tallies)}",
   123	        )
   124	        return {"eligible": False, "checks": checks}
   125	
   126	    chk("pi: zero P0", pi.p0 == 0, f"{pi.p0} P0 failures")
   127	    chk("pi: zero P1", pi.p1 == 0, f"{pi.p1} P1 failures")
   128	    pr_pi, pr_d = pi.pass_rate, disco.pass_rate
   129	    if pr_pi is None or pr_d is None:
   130	        chk("pass-rate comparable", None, "a kernel has no conclusive runs")
   131	    else:
   132	        chk(
   133	            "pi pass-rate >= disco (bare build)",
   134	            pr_pi >= pr_d,
   135	            f"pi {pr_pi:.1%} vs disco {pr_d:.1%}",
   136	        )
   137	    eligible = all(c["ok"] for c in checks if c["ok"] is not None) and not any(
   138	        c["ok"] is False for c in checks
   139	    )
   140	    return {"eligible": eligible, "checks": checks}
   141	
   142	
   143	def _fmt_rate(t: KernelTally) -> str:
   144	    pr = t.pass_rate
   145	    return f"{pr:.1%}" if pr is not None else "n/a"
   146	
   147	
   148	def render(tallies: dict[str, KernelTally], gate: dict[str, Any]) -> str:
   149	    lines = ["EPIC K — Build-Soak bake-off scorecard", "=" * 42]
   150	    if not tallies:
   151	        lines.append("no runs found.")
   152	        return "\n".join(lines)
   153	    for k in sorted(tallies):
   154	        t = tallies[k]
   155	        lines.append(
   156	            f"\n[{k}]  pass-rate {_fmt_rate(t)}  "
   157	            f"(PASS {t.passed} / FAIL {t.failed} / INVALID {t.invalid} / INFRA {t.infra}"
   158	            f"  · P0 {t.p0} · P1 {t.p1} · n={t.total})"
   159	        )
   160	        for sc in sorted(t.by_scenario):
   161	            c = t.by_scenario[sc]
   162	            lines.append(f"    {sc:30} P{c['pass']} F{c['fail']} I{c['invalid']} X{c['infra']}")
   163	    lines.append("\n— §K3 promotion gate (soak-computable criteria) —")
   164	    for c in gate["checks"]:
   165	        mark = {True: "PASS", False: "FAIL", None: "n/a "}[c["ok"]]
   166	        lines.append(f"  [{mark}] {c['check']}: {c['detail']}")
   167	    lines.append(
   168	        f"\nPiKernel promotion-eligible (soak criteria): "
   169	        f"{'YES' if gate['eligible'] else 'NO'}"
   170	    )
   171	    lines.append(
   172	        "  (manual/separate: no raw provider keys, no user Pi packages, no process-"
   173	        "backend prod runs, AppKit + preview + event-mapping suites)"
   174	    )
   175	    return "\n".join(lines)
   176	
   177	
   178	def main(argv: list[str] | None = None) -> int:
   179	    p = argparse.ArgumentParser(description="EPIC K bake-off scorecard (PiKernel vs DiscoKernel).")
   180	    p.add_argument("--runs", default="test-record/build-soak", help="run-folder root")
   181	    p.add_argument("--scenario", default=None, help="restrict to one scenario id")
   182	    p.add_argument("--json", action="store_true", help="emit machine-readable JSON")
   183	    args = p.parse_args(argv)
   184	
   185	    runs = scan_runs(Path(args.runs), args.scenario)
   186	    tallies = tally(runs)
   187	    gate = evaluate_gate(tallies)
   188	    if args.json:
   189	        payload = {
   190	            "runs": len(runs),
   191	            "kernels": {
   192	                k: {
   193	                    "total": t.total,
   194	                    "pass": t.passed,
   195	                    "fail": t.failed,
   196	                    "invalid": t.invalid,
   197	                    "infra": t.infra,
   198	                    "p0": t.p0,
   199	                    "p1": t.p1,
   200	                    "pass_rate": t.pass_rate,
   201	                    "by_scenario": t.by_scenario,
   202	                }
   203	                for k, t in tallies.items()
   204	            },
   205	            "gate": gate,
   206	        }
   207	        print(json.dumps(payload, indent=2, sort_keys=True))
   208	    else:
   209	        print(render(tallies, gate))
   210	    return 0
   211	
   212	
   213	if __name__ == "__main__":
   214	    sys.exit(main())

