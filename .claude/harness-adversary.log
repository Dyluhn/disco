     1	"""HARN-1b (evidence side) — the validated producer of the product-harness dossier.
     2	
     3	The HARN-2 oracles READ a ``product_evidence`` dict + a provider-call ledger. This
     4	module is the verified WRITER: it validates a captured dossier against the schema the
     5	oracles expect BEFORE writing it, so a harness bug can't emit malformed evidence that
     6	an oracle would silently mis-adjudicate. The live Playwright harness captures the raw
     7	browser data and calls these to serialize ``product-evidence.json`` and
     8	``provider-call-ledger.jsonl`` into the run folder.
     9	
    10	This is pure + unit-tested; it does not drive a browser (that is HARN-1b's live spec).
    11	"""
    12	
    13	from __future__ import annotations
    14	
    15	import json
    16	from pathlib import Path
    17	from typing import Any
    18	
    19	# The expected slices and their field types. Each slice is optional (a run that did
    20	# not export has no "export" slice → the ExportDownload oracle SKIPs), but when a slice
    21	# IS present its fields must be well-typed so the oracle reads it fail-closed-correctly.
    22	_SLICE_FIELDS: dict[str, dict[str, type]] = {
    23	    "browser_ws": {"connections": int},
    24	    "lifecycle": {"terminal": str, "statuses": list},
    25	    "sidecar": {"stopped_at_terminal": bool, "provider_calls_after_terminal": int},
    26	    "preview": {"owner": str, "manual_port": bool},
    27	    "shown": {"artifact_shown": bool, "preview_shown": bool},
    28	    "verification": {"ready_for_verification_called": bool, "passed": bool},
    29	    # download_present/download_bytes ARE adjudicated by ExportDownloadOracle — they must be
    30	    # type-validated here too, else e.g. a bool download_bytes capture bug evades validation.
    31	    "export": {"requested": bool, "download_present": bool, "download_bytes": int},
    32	    "cleanup": {
    33	        "orphans": int,
    34	        "workspace_released": bool,
    35	        "scope": str,
    36	        "container_orphans": int,
    37	        "volume_orphans": int,
    38	        "volume_scope": str,
    39	    },
    40	}
    41	
    42	PRODUCT_EVIDENCE_NAME = "product-evidence.json"
    43	PROVIDER_LEDGER_NAME = "provider-call-ledger.jsonl"
    44	
    45	
    46	def validate_product_evidence(ev: dict[str, Any]) -> list[str]:
    47	    """Return a list of schema problems (empty = valid). Unknown top-level keys are
    48	    allowed (forward-compat); a known slice must be a dict whose declared fields, when
    49	    present, carry the right type. ``bool`` is rejected where ``int`` is required (a
    50	    bool count is a capture bug)."""
    51	    problems: list[str] = []
    52	    if not isinstance(ev, dict):
    53	        return ["product_evidence is not a dict"]
    54	    for slice_name, fields in _SLICE_FIELDS.items():
    55	        if slice_name not in ev:
    56	            continue
    57	        slice_val = ev[slice_name]
    58	        if not isinstance(slice_val, dict):
    59	            problems.append(f"{slice_name}: not a dict")
    60	            continue
    61	        for field, typ in fields.items():
    62	            if field not in slice_val:
    63	                continue
    64	            val = slice_val[field]
    65	            if typ is int and isinstance(val, bool):
    66	                problems.append(f"{slice_name}.{field}: bool where int expected")
    67	            elif not isinstance(val, typ):
    68	                problems.append(f"{slice_name}.{field}: {type(val).__name__} where {typ.__name__} expected")
    69	    return problems
    70	
    71	
    72	def write_product_evidence(folder: str | Path, ev: dict[str, Any], *, strict: bool = True) -> Path:
    73	    """Validate then write ``product-evidence.json`` into ``folder``. With
    74	    ``strict=True`` (default) a schema problem raises ValueError BEFORE writing, so the
    75	    harness never persists evidence the oracles can't trust."""
    76	    problems = validate_product_evidence(ev)
    77	    if problems and strict:
    78	        raise ValueError(f"product_evidence failed schema validation: {problems}")
    79	    out = Path(folder) / PRODUCT_EVIDENCE_NAME
    80	    out.write_text(json.dumps(ev, indent=2, sort_keys=True), encoding="utf-8")
    81	    return out
    82	
    83	
    84	def write_provider_ledger(folder: str | Path, records: list[dict[str, Any]]) -> Path:
    85	    """Write ``provider-call-ledger.jsonl`` (one JSON record per line). Each record
    86	    should carry at least a ``host``; the ProviderLedgerOracle fail-closes on a hostless
    87	    record, so a non-dict / hostless entry here would surface as an evidence gap."""
    88	    out = Path(folder) / PROVIDER_LEDGER_NAME
    89	    lines = [json.dumps(r, sort_keys=True) for r in records]
    90	    out.write_text("\n".join(lines) + ("\n" if lines else ""), encoding="utf-8")
    91	    return out

