  1778	def _classify_conn_error(exc: Exception) -> str:
  1779	    text = f"{type(exc).__name__} {exc}".lower()
  1780	    if "name" in text or "resolve" in text or "dns" in text:
  1781	        return "dns"
  1782	    if "timeout" in text or "timed out" in text:
  1783	        return "timeout"
  1784	    return "connection_error"
