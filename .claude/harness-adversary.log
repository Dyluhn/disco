  1426	def _git_commit(repo_root: Path) -> str:
  1427	    with contextlib.suppress(Exception):
  1428	        return subprocess.check_output(
  1429	            ["git", "-C", str(repo_root), "rev-parse", "HEAD"], text=True
  1430	        ).strip()
  1431	    return ""
  1432	
  1433	
  1434	def _exit_code(status: str) -> int:
  1435	    return {
  1436	        fc.PASS: 0,
  1437	        fc.FAIL: 1,
  1438	        fc.INVALID_RUN: 2,
  1439	        fc.INFRA_FAILURE: 3,
  1440	    }.get(status, 1)
