  1470	# a non-authoritative capture is unreliable and must NOT be a definitive product failure).
  1471	_PROOF_BY_EXPECTED_KIND = {
  1472	    "sha": "raw_sha",
  1473	    "rendered": "rendered_readback",
  1474	    "absent": "absent",
  1475	    "present_unproven": "unproven_extended_stability",
  1476	    "unknown": "unknown",
