    61	def _proof_for(manifest: dict[str, Any] | None, path: str) -> str | None:
    62	    """The recorded acceptance proof level for a declared path, or None when the entry is a
    63	    plain string / carries no `proof` (legacy / proxy capture → treated as authoritative)."""
    64	    files = _nested_files(manifest)
    65	    entry = files.get(path)
    66	    if entry is None:
    67	        entry = files.get(path.lstrip("/"))
    68	    if isinstance(entry, dict):
    69	        proof = entry.get("proof")
    70	        return str(proof) if proof is not None else None
    71	    return None
    72	
    73	
    74	def _content_stable_for(manifest: dict[str, Any] | None, path: str) -> bool:
    75	    """Whether the adapter observed this entry stable for the readiness threshold.
    76	
    77	    Missing field / non-dict legacy entries are treated as not stable; legacy behavior is
    78	    still preserved by the proof fold because a missing proof remains authoritative.
    79	    """
    80	    files = _nested_files(manifest)
    81	    entry = files.get(path)
    82	    if entry is None:
    83	        entry = files.get(path.lstrip("/"))
    84	    return isinstance(entry, dict) and entry.get("content_stable") is True
