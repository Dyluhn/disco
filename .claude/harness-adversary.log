  1443	_KERNEL_KIND = {"disco": "disco", "pi": "pi_experimental"}
  1444	
  1445	
  1446	async def _select_build_kernel(app_base_url: str, kernel: str) -> str | None:
  1447	    """EPIC K: pin the GLOBAL Build kernel before a soak run (PUT the app-server
  1448	    build-kernel config). Returns None on success, else an error string. For the
  1449	    experimental Pi kernel the server gate (DISCO_PI_KERNEL_EXPERIMENTAL) MUST be on,
  1450	    else the server refuses the selection — fail fast rather than silently soak the
  1451	    DiscoKernel under a `--kernel pi` label (which would corrupt the bake-off)."""
  1452	    import httpx
  1453	
  1454	    kind = _KERNEL_KIND[kernel]
  1455	    url = f"{app_base_url.rstrip('/')}/api/build-kernel/config"
  1456	    try:
  1457	        async with httpx.AsyncClient(timeout=15.0) as c:
  1458	            await c.put(url, json={"kind": kind})
  1459	            cfg = (await c.get(url)).json()
  1460	    except Exception as exc:  # noqa: BLE001 — surface as INFRA, never a product verdict
  1461	        return f"could not reach build-kernel config at {url}: {exc}"
  1462	    if cfg.get("kind") != kind:
  1463	        return f"kernel select failed: requested {kind!r}, server reports {cfg.get('kind')!r}"
  1464	    if kernel == "pi" and not cfg.get("experimental_enabled"):
  1465	        return (
  1466	            "pi kernel selected but experimental_enabled=false — set "
  1467	            "DISCO_PI_KERNEL_EXPERIMENTAL=1 on the agent-server AND app-server"
  1468	        )
  1469	    return None
