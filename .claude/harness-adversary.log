   144	    def _check_allowed(self, tool_scope: list[dict[str, Any]]) -> OracleResult | None:
   145	        """`tool_scope` is a list of captured per-turn scopes:
   146	        {mode, allowed_tools: [name,...]}. While mode == "planning" no mutating
