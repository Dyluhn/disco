    66	def _resolve_anchors(
    67	    events: list[dict[str, Any]],
    68	    boundary: int,
    69	    followups_spec: list[dict[str, Any]] | None,
    70	    meta: dict[str, Any] | None,
    71	) -> list[tuple[int, bool]]:
    72	    """The revision-anchor follow-ups as ``(user_seq, declared_requires_revision)`` pairs in
    73	    chronological order.
    74	
    75	    METADATA PATH (the runner supplied harness-anchor metadata — every live run): anchor ONLY
    76	    on the DECLARED scenario follow-ups the runner actually sent, EXCLUDING harness-INJECTED
    77	    auto-answers (clarification answers / decision picks). This fixes the regression where an
    78	    auto-answer (a user message after the boundary) was mis-anchored as a revision follow-up →
    79	    false NO_REPLAN_AFTER_REVISION / WRITE_BEFORE_REVISION_APPROVAL. Each declared seq carries
    80	    its OWN `requires_plan_revision` flag (parallel array, matched by send order — guarded to as
    81	    many entries as were actually sent).
    82	
    83	    FALLBACK PATH (no metadata — legacy fixtures / direct classify): the original behavior —
    84	    ALL user messages after the boundary, with the flag matched by spec index."""
    85	    if meta is not None:
    86	        injected = {int(s) for s in (meta.get("harness_injected_user_seqs") or [])}
    87	        seqs = meta.get("declared_followup_seqs") or []
    88	        flags = meta.get("declared_followup_requires_revision") or []
    89	        pairs: list[tuple[int, bool]] = []
    90	        for i, raw in enumerate(seqs):
    91	            s = int(raw)
    92	            if s <= boundary or s in injected:
    93	                continue
    94	            flag = bool(flags[i]) if i < len(flags) else False
    95	            pairs.append((s, flag))
    96	        pairs.sort(key=lambda p: p[0])
    97	        return pairs
    98	    # Legacy fallback: every user message after the boundary, flag by spec index.
    99	    out: list[tuple[int, bool]] = []
   100	    for i, s in enumerate(_followup_user_seqs(events, boundary)):
   101	        flag = (
   102	            bool(followups_spec[i].get("requires_plan_revision"))
   103	            if followups_spec and i < len(followups_spec)
   104	            else False
   105	        )
   106	        out.append((s, flag))
   107	    return out
