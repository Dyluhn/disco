  1448	def _choose_alternative(
  1449	    options: list[dict[str, Any]], preferred_option_id: str | None
  1450	) -> str | None:
  1451	    """Pick an AlternativeOption id deterministically: the caller's `preferred_option_id`
  1452	    (scenario override) when it names a valid option, else a recommended option (a
  1453	    `recommended`/`recommendation` truthy flag, defensively — the option may not carry one),
  1454	    else the FIRST valid option. None when there is no option with a non-empty id."""
  1455	    valid = [o for o in options if isinstance(o, dict) and o.get("id")]
  1456	    if not valid:
  1457	        return None
  1458	    if preferred_option_id is not None:
  1459	        for o in valid:
  1460	            if str(o["id"]) == str(preferred_option_id):
  1461	                return str(o["id"])
  1462	    for o in valid:
  1463	        if o.get("recommended") or o.get("recommendation"):
  1464	            return str(o["id"])
  1465	    return str(valid[0]["id"])
