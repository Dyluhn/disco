     1	"""Shared evidence-slicing + strict type guards for the P8D edit oracles.
     2	
     3	The contract (gpt-5.5): a slice that is ABSENT → SKIP; a slice that is PRESENT but malformed
     4	(not a dict, or a field of the wrong type) → FAIL EDIT_ORACLE_EVIDENCE_MALFORMED (→ INVALID_RUN).
     5	Never coerce a wrong-typed value into a pass. `bool` is NOT accepted as an int/number.
     6	"""
     7	
     8	from __future__ import annotations
     9	
    10	from typing import Any
    11	
    12	from .. import failure_codes as fc
    13	from .schema import OracleResult, failing
    14	
    15	ABSENT = object()  # the slice key is not present at all → SKIP
    16	MALFORMED = object()  # the slice key is present but is not a dict → FAIL
    17	
    18	
    19	def slice_of(product_evidence: dict[str, Any] | None, key: str) -> Any:
    20	    """ABSENT if the key is missing, MALFORMED if present-but-not-a-dict, else the dict."""
    21	    if not product_evidence or key not in product_evidence:
    22	        return ABSENT
    23	    val = product_evidence.get(key)
    24	    return val if isinstance(val, dict) else MALFORMED
    25	
    26	
    27	def is_str_list(x: Any) -> bool:
    28	    return isinstance(x, list) and all(isinstance(i, str) for i in x)
    29	
    30	
    31	def is_str_dict(x: Any) -> bool:
    32	    return isinstance(x, dict) and all(isinstance(k, str) and isinstance(v, str) for k, v in x.items())
    33	
    34	
    35	def is_int(x: Any) -> bool:
    36	    return isinstance(x, int) and not isinstance(x, bool)
    37	
    38	
    39	def is_num(x: Any) -> bool:
    40	    return isinstance(x, (int, float)) and not isinstance(x, bool)
    41	
    42	
    43	def malformed(oracle: str, why: str, facts: dict[str, Any] | None = None) -> OracleResult:
    44	    return failing(
    45	        oracle,
    46	        fc.EDIT_ORACLE_EVIDENCE_MALFORMED,
    47	        first_broken_link="edit_evidence -> oracle",
    48	        facts={"why": why, **(facts or {})},
    49	    )

