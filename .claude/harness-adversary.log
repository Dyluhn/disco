   208	                    failing(
   209	                        _ORACLE,
   210	                        fc.PLAN_REVISION_NOT_INCREMENTED,
   211	                        first_broken_link="revised_plan_event -> incremented_revision",
   212	                        facts={
   213	                            "followup_user_event_seq": fseq,
   214	                            "revised_plan_seq": p_seq,
   215	                            "latest_plan_revision_before_followup": rev_before,
   216	                            "revised_plan_revision": p_rev,
   217	                            "expected_revision": rev_before + 1,
   218	                        },
   219	                    )
   220	                ]
   221	
   222	            # ORDERING F < (stale approval) < P: a plan_approved BETWEEN the follow-up
   223	            # and the revised plan is a STALE approval — it cannot be approving the
   224	            # revised plan (which does not exist yet). This is the out-of-order
   225	            # revised-approval false-pass.
