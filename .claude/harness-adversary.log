   180	    EXECUTION_NO_ACTION: P0,
   181	    ACTION_NO_OBSERVATION: P0,
   182	    FALSE_FINISH_NO_OUTPUT: P0,
   183	    FALSE_FINISH_PREVIEW_BROKEN: P0,
   184	    DUPLICATE_KICK_ON_RESUME: P0,
   185	    EVENT_LOG_STATE_DIVERGENCE: P0,
   186	    WS_FRAME_DROPPED_NO_ERROR: P0,
   187	    UI_ENABLED_DEAD_CONTROL: P0,
   188	    PROVIDER_FORBIDDEN: P0,
   189	    PROVIDER_WRONG_MODEL: P0,
   190	    PROVIDER_CALL_AFTER_TERMINAL: P0,
   191	    BROWSER_WS_NOT_CONNECTED: P0,
   192	    LIFECYCLE_SEQUENCE_INVALID: P0,
   193	    SIDECAR_NOT_STOPPED: P0,
   194	    PREVIEW_OWNERSHIP_VIOLATION: P0,
   195	    ARTIFACT_NOT_SHOWN_TO_USER: P0,
   196	    VERIFICATION_GATE_BYPASSED: P0,
   197	    EXPORT_DOWNLOAD_MISSING: P0,
   198	    WORKSPACE_NOT_CLEANED: P0,
   199	    # P8D targeted/manual-edit discipline
   200	    TARGETED_EDIT_TOUCHED_UNEXPECTED_FILES: P1,
   201	    SMALL_EDIT_FULL_REWRITE: P1,
   202	    MANUAL_EDIT_CLOBBERED: P1,
   203	    COMMENT_ANCHOR_LOST: P1,
   204	    SCREEN_LABEL_UNSTABLE: P2,
   205	    UNKNOWN_FAILURE: P0,
   206	    # P1
   207	    PLAN_REVISION_NOT_INCREMENTED: P1,
   208	    STALE_PLAN_USED_AFTER_FOLLOWUP: P1,
   209	    PLAN_APPROVED_STATUS_MISSING: P1,
   210	    TOOL_SCOPE_MISMATCH: P1,
   211	    TOOL_REJECTION_NOT_VISIBLE_TO_MODEL: P1,
   212	    MODEL_TOLD_WRONG_MODE: P1,
   213	    STUCK_RUNNING_NO_EVENTS: P1,
   214	    PREVIEW_TRUTH_MISMATCH: P1,
   215	    ARTIFACT_TRUTH_MISMATCH: P1,
   216	    DESTRUCTIVE_ELISION: P1,
   217	    NO_CLEAR_FAILURE_TO_USER: P1,
   218	    OBSERVATION_WITHOUT_ACTION: P1,
   219	    WRITE_BEFORE_REVISION_APPROVAL: P1,
   220	    BUILD_DID_NOT_FINISH: P1,
   221	    # P2
   222	    SLOW_FIRST_PLAN: P2,
   223	    EXCESSIVE_READS_BEFORE_PLAN: P2,
   224	    MISSING_DONE_CONDITIONS: P2,
   225	    LOW_QUALITY_PLAN: P2,
   226	    MISSING_PROGRESS_EVENTS: P2,
   227	    WEAK_FINAL_SUMMARY: P2,
