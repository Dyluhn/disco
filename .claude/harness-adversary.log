   333	                    failing(
   334	                        _ORACLE,
   335	                        fc.PLAN_REVISION_NOT_INCREMENTED,
   336	                        first_broken_link="followups -> expected_final_plan_revision",
   337	                        facts={"expected_final_plan_revision": int(expected), "actual": actual},
   338	                    )
   339	                ]
   340	
   341	        return [
   342	            passing(
   343	                _ORACLE,
   344	                facts={
   345	                    "followup_count": len(anchors),
   346	                    "final_plan_revision": latest_plan_revision(events),
   347	                },
   348	            )
   349	        ]
