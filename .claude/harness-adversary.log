   995	def _scoped_disco_container_count(
   996	    names: list[str], sandbox_instance_ids: list[str]
   997	) -> int:
   998	    """Count live disco containers whose name embeds one of this conversation's sandbox ids."""
   999	    ids = [sid for sid in sandbox_instance_ids if sid]
  1000	    return sum(1 for name in names if any(sid in name for sid in ids))
