  1547	def _full_readback_body(args: dict[str, Any], content: Any) -> str | None:
  1548	    """Return the RENDERED body of a FULL, GENUINELY-RENDERED ``file_read`` observation, or
  1549	    None when the read is paged / truncated / synthetic (and so cannot define the agent's
  1550	    final bytes). The body is the readback MINUS its ``[lines 1-N of N]`` header line — i.e.
  1551	    the ``<line-no>\\t<line>`` block, ready to compare against ``_render_numbered`` of the
  1552	    on-disk file.
  1553	
  1554	    Rejections (→ None): an explicit ``offset``/``limit`` (a targeted, partial read); any
  1555	    header that is not the exact full-read shape (a budget-truncated ``; read more…`` or a
  1556	    pressure ``— HEAD-ONLY…`` read has unequal/extra header text); the F9 dedup pointer or
  1557	    any other synthetic content (no ``[lines 1-N of N]`` header at all)."""
  1558	    if args.get("offset") is not None or args.get("limit") is not None:
  1559	        return None
  1560	    if not isinstance(content, str):
  1561	        return None
  1562	    head, sep, body = content.partition("\n")
  1563	    m = _FILE_READ_FULL_HEADER_RE.match(head)
  1564	    if m is None or m.group(1) != m.group(2):
  1565	        return None  # not a full read (or a synthetic [F9 dedup: …] / non-rendered payload)
  1566	    # `sep` empty ⇒ a header-only (empty-file) read: body is "" (matches _render_numbered("")).
  1567	    return body if sep else ""
