   110	def _first_mutating_action_after(events: list[dict[str, Any]], after_seq: int) -> int | None:
   111	    """Seq of the first mutating action after `after_seq` that REACHED THE EXECUTOR.
   112	
   113	    A mutating action is paired with its result by `action_id`; it counts unless it
   114	    was GATE-REJECTED before execution — an agent_error pairing with NO tool_result
   115	    observation (`action_executed` False). A call that reached the executor (ANY
   116	    observation, success True OR False — a write can mutate then report failure)
   117	    counts. A gate-rejected pre-approval write never wrote the workspace — that is the
   118	    §11.3 tool-rejection-recovery contract WORKING, not a §11.4 write-before-revised-
   119	    approval violation. Counting that rejected ATTEMPT as a write was the Bug-13
   120	    false-FAIL. The anti-false-PASS half is preserved: any write that EXECUTED (incl.
   121	    a mutate-then-fail success=False write) still counts → still drives
   122	    WRITE_BEFORE_REVISION_APPROVAL.
   123	    """
   124	    for e in events:
   125	        if kind_of(e) != KIND_ACTION or seq_of(e) <= after_seq:
   126	            continue
   127	        name = tool_name_of(e)
   128	        if name is None or name in PLANNING_SAFE_TOOLS:
   129	            continue
   130	        aid = action_id_of(e)
   131	        if aid is not None and action_executed(events, aid):
   132	            return seq_of(e)
   133	    return None
   134	
