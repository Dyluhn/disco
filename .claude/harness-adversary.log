   218	def classify_run_folder(
   219	    folder: str | Path, *, scenario: dict[str, Any] | None = None
   220	) -> dict[str, Any]:
   221	    """Classify a frozen run folder: load the manifest, verify evidence integrity
   222	    (a mismatch -> INVALID_RUN), read the event log, classify, and write
   223	    classification.json into the folder. Returns the classification dict."""
   224	    base = Path(folder)
   225	    manifest: EvidenceManifest | None = None
   226	    evidence_intact = True
   227	    try:
   228	        manifest = load_manifest(base)
   229	        integrity = verify_evidence_unchanged(base, manifest)
   230	        evidence_intact = integrity.intact
   231	    except (FileNotFoundError, ValueError, json.JSONDecodeError):
   232	        manifest = None
   233	
   234	    events_raw: list[Any] = []
   235	    events_rel = (manifest.evidence_files.get("events") if manifest else None) or "events.jsonl"
   236	    events_path = base / events_rel
   237	    if not events_path.is_file():
   238	        # try the conventional conversation-scoped path
   239	        for candidate in base.rglob("events.jsonl"):
   240	            events_path = candidate
   241	            break
   242	    if events_path.is_file():
   243	        events_raw = _read_jsonl(events_path)
   244	    folder_conversation_id = ""
   245	    if events_path.name == "events.jsonl" and events_path.parent.parent.name == "conversations":
   246	        folder_conversation_id = events_path.parent.name
   247	
   248	    # HARN-1a: the provider-call ledger (MiniMax-only / no-OpenRouter enforcement).
   249	    # Read it if present anywhere in the run folder; absent → the oracle SKIPs (or
   250	    # fails closed if the scenario requires it). A malformed line is NOT silently
   251	    # dropped (that would under-report a forbidden call) nor crashes classification —
   252	    # it becomes a hostless record the ProviderLedgerOracle fails on as an evidence gap.
   253	    provider_ledger: list[dict[str, Any]] | None = None
   254	    ledger_path = base / "provider-call-ledger.jsonl"
   255	    if not ledger_path.is_file():
   256	        ledger_path = next(iter(base.rglob("provider-call-ledger.jsonl")), ledger_path)
   257	    if ledger_path.is_file():
   258	        provider_ledger = _read_ledger(ledger_path)
   259	
   260	    # HARN-2: the browser product-harness evidence dossier (a single JSON object).
   261	    # Absent → the browser oracles SKIP (headless run unaffected).
   262	    product_evidence: dict[str, Any] | None = None
   263	    pe_path = base / "product-evidence.json"
   264	    if not pe_path.is_file():
   265	        pe_path = next(iter(base.rglob("product-evidence.json")), pe_path)
   266	    if pe_path.is_file():
   267	        try:
   268	            loaded = json.loads(pe_path.read_text(encoding="utf-8"))
   269	            product_evidence = loaded if isinstance(loaded, dict) else None
   270	        except (json.JSONDecodeError, ValueError):
   271	            product_evidence = None
   272	
   273	    classification = classify(
   274	        events_raw,
   275	        scenario=scenario,
   276	        run_id=manifest.run_id if manifest else base.name,
   277	        conversation_id=folder_conversation_id,
   278	        commit=manifest.repo_commit if manifest else "",
   279	        seed=manifest.seed if manifest else None,
   280	        evidence_intact=evidence_intact,
   281	        autonomous=manifest.autonomous if manifest else None,
   282	        provider_ledger=provider_ledger,
   283	        product_evidence=product_evidence,
   284	    )
   285	    (base / CLASSIFICATION_NAME).write_text(
   286	        json.dumps(classification, indent=2, sort_keys=True), encoding="utf-8"
   287	    )
   288	    return classification
   289	
   290	
   291	def _read_jsonl(path: str | Path) -> list[Any]:
   292	    out: list[Any] = []
   293	    for line in Path(path).read_text(encoding="utf-8").splitlines():
   294	        line = line.strip()
   295	        if line:
   296	            out.append(json.loads(line))
   297	    return out
   298	
   299	
   300	def _read_ledger(path: str | Path) -> list[dict[str, Any]]:
   301	    """Tolerant provider-call-ledger reader: never crashes on a malformed line and
   302	    never silently drops one. A non-JSON / non-dict line becomes a hostless
   303	    ``{"__malformed__": ...}`` record so the ProviderLedgerOracle surfaces it as an
   304	    evidence gap (rather than under-reporting a possibly-forbidden call)."""
   305	    out: list[dict[str, Any]] = []
   306	    for line in Path(path).read_text(encoding="utf-8").splitlines():
   307	        line = line.strip()
   308	        if not line:
   309	            continue
   310	        try:
   311	            obj = json.loads(line)
   312	        except (json.JSONDecodeError, ValueError):
   313	            out.append({"__malformed__": line[:160]})
   314	            continue
   315	        out.append(obj if isinstance(obj, dict) else {"__malformed__": str(obj)[:160]})
   316	    return out
   317	
   318	
   319	# ---- §17 no-fluke replay policy (pure function) -----------------------------
   320	
   321	
   322	def intermittent_classification(
   323	    original: dict[str, Any],
   324	    *,
   325	    replay_status: str,
   326	    replay_code: str | None = None,
   327	    replay_run_id: str | None = None,
   328	) -> dict[str, Any]:
   329	    """Apply the no-fluke replay policy (§17) to an originally-FAILED run.
   330	
   331	    A failed run that PASSES on exact replay is NOT a pass — it is an intermittent
   332	    failure: status stays FAIL, code becomes INTERMITTENT_<original_code> with the
   333	    SAME severity. A replay that fails the same way is a deterministic failure
   334	    (unchanged). The word "fluke" never yields PASS.
   335	
   336	    Returns a NEW classification dict; the input is not mutated."""
   337	    if original.get("status") != fc.FAIL:
   338	        raise ValueError("no-fluke policy only applies to an originally-FAILED run")
   339	    original_code = str(original.get("code"))
   340	    updated = dict(original)
   341	
   342	    if replay_status == fc.PASS:
   343	        intermittent_code = fc.INTERMITTENT_PREFIX + original_code
   344	        updated["status"] = fc.FAIL
   345	        updated["code"] = intermittent_code
   346	        updated["severity"] = fc.severity_for(intermittent_code)
   347	        updated["replay"] = {
   348	            "attempted": True,
   349	            "result": "passed",
   350	            "run_id": replay_run_id,
   351	        }
   352	        return updated
   353	
   354	    if replay_status == fc.FAIL and replay_code == original_code:
   355	        updated["replay"] = {"attempted": True, "result": "same_failure", "run_id": replay_run_id}
   356	        return updated
   357	
   358	    if replay_status == fc.FAIL:
   359	        updated["replay"] = {
   360	            "attempted": True,
   361	            "result": "different_failure",
   362	            "run_id": replay_run_id,
   363	        }
   364	        return updated
   365	
   366	    # INVALID_RUN / INFRA_FAILURE on replay: cannot prove a pass; keep the failure
   367	    # and record the inconclusive replay.
   368	    updated["replay"] = {"attempted": True, "result": "not_attempted", "run_id": replay_run_id}
   369	    return updated

