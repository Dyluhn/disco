    94	def _fold_content_mismatches(mismatches: list[dict[str, Any]]):
    95	    """DETERMINISTIC PRECEDENCE fold over ALL workspace-content mismatches in the run
    96	    (Part A). A mismatch is AUTHORITATIVE iff its proof is authoritative OR its captured
    97	    bytes reached the adapter's content-stability threshold. If ANY mismatch is authoritative
