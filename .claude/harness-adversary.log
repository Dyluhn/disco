   181	
   182	
   183	def source_of(ev: dict[str, Any]) -> str:
   184	    return str(ev.get("source"))
   185	
   186	
   187	def tool_name_of(ev: dict[str, Any]) -> str | None:
   188	    """The tool name an ACTION event proposes, else None."""
