    27	_URL_HOST_RE = re.compile(r"https?://([^/\s\"']+)", re.IGNORECASE)
    28	# A model id: "model":"X" (JSON), model=X, or model: X.
    29	_MODEL_RE = re.compile(r"""["']?model["']?\s*[:=]\s*["']?([A-Za-z0-9._\-]+)""", re.IGNORECASE)
    30	
    31	
    32	def _record(
    33	    host: str,
    34	    *,
    35	    model: str = "",
    36	    ts: str | None = None,
    37	    after_terminal: bool = False,
    38	    has_tools: bool = True,
    39	    conversation_id: str | None = None,
    40	) -> dict[str, Any]:
    41	    # [REL-5b] has_tools defaults True (fail-closed): an UNMARKED record (older relay, or a loose
    42	    # log line) is treated as a build-driver call so the after-terminal runaway check never silently
    43	    # under-counts. A tool-less SUMMARIZER/title call is excluded only when the relay explicitly
    44	    # marks has_tools=False.
    45	    return {
    46	        "ts": ts,
    47	        "host": host,
    48	        "model": model,
    49	        "after_terminal": bool(after_terminal),
    50	        "has_tools": bool(has_tools),
    51	        "conversation_id": _normalize_conversation_id(conversation_id),
    52	    }
    53	
    54	
    55	def _normalize_conversation_id(value: Any) -> str | None:
    56	    if value is None:
    57	        return None
    58	    text = str(value).strip()
    59	    return text or None
    60	
    61	
    62	def record_applies_to_conversation(rec: Any, conversation_id: str | None) -> bool:
    63	    """Whether ``rec`` should be adjudicated for ``conversation_id``.
    64	
    65	    A record with a non-empty conversation_id is scoped to that conversation only.
    66	    Missing/empty/None conversation ids are legacy records and remain attributed to
    67	    every conversation (fail-closed for old relay logs and serial runs).
    68	    """
    69	    if not isinstance(rec, dict):
    70	        return True
    71	    target = _normalize_conversation_id(conversation_id)
    72	    record_cid = _normalize_conversation_id(rec.get("conversation_id"))
    73	    return target is None or record_cid is None or record_cid == target
    74	
    75	
    76	def records_for_conversation(
    77	    records: list[dict[str, Any]], conversation_id: str | None
    78	) -> list[dict[str, Any]]:
    79	    return [r for r in records if record_applies_to_conversation(r, conversation_id)]
    80	
    81	
    82	def parse_relay_log_lines(lines: list[str]) -> list[dict[str, Any]]:
    83	    """Normalize relay-log lines into ledger records (best-effort, tolerant).
    84	
    85	    Each line that is valid JSON carrying a ``host``/``url`` (and optional ``model``)
    86	    is used directly; otherwise a host is regex-extracted from the first URL on the
    87	    line and a model from a ``model``-like token. Lines with no recoverable host are
    88	    skipped (not every relay line is a provider request)."""
    89	    out: list[dict[str, Any]] = []
