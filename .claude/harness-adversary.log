   206	    client: DiscoApiClient,
   207	    cid: str,
   208	    timeline: list[str],
   209	    *,
   210	    trigger: str,
   211	    timeout_s: float,
   212	    trigger_seq: int | None = None,
   213	) -> None:
   214	    before_status = ""
   215	    with contextlib.suppress(Exception):
   216	        before_status = DiscoApiClient._status_of(await client.get_state(cid))
   217	    resp = await client.kill(cid)
   218	    seq_note = f" (seq={trigger_seq})" if trigger_seq is not None else ""
   219	    timeline.append(
   220	        f"cancel_at fired at {trigger}{seq_note}: POST /conversations/{cid}/kill "
   221	        f"(was {before_status or 'unknown'}, http {resp.get('http_status')})"
   222	    )
   223	    settled = await _wait_for_cancel_idle(
   224	        client,
   225	        cid,
   226	        previous_status=before_status,
   227	        timeout_s=min(timeout_s, 60.0),
   228	    )
   229	    timeline.append(f"cancel_at settled to stable {settled}; continuing scenario")
   230	
   231	
   232	async def _drive_to_terminal(
   233	    client: DiscoApiClient,
   234	    cid: str,
   235	    *,
   236	    autonomous: bool,
   237	    mid_run: list[dict[str, Any]],
   238	    cancel_at: dict[str, Any] | None = None,
   239	    timeline: list[str],
   240	    inactivity_s: float,
   241	    hard_cap_s: float,
   242	    clarification_answer: str | None = None,
   243	    decision_answer: str | None = None,
   244	    decisions: list[dict[str, Any]] | None = None,
   245	    injected_user_seqs: list[int] | None = None,
   246	    declared_followup_seqs: list[int] | None = None,
   247	    declared_followup_requires_revision: list[bool] | None = None,
   248	    min_seq: int | None = None,
   249	) -> str:
   250	    """Drive the run to a terminal state, approving each plan gate (interactive),
   251	    answering any mid-build clarify/confirm gate (Bug 17), and injecting any mid-run
   252	    steer follow-up concurrently. Returns the terminal status.
   253	
   254	    `min_seq` (H1/V2): when driving an after-terminal FOLLOW-UP, the drive must NOT return on
   255	    the STALE pre-follow-up terminal (its event seq <= min_seq) — it keeps polling until the
   256	    follow-up's OWN new terminal (a terminal event with seq > min_seq). This is the piece V1
   257	    missed: V1's drive checked only the status STRING and returned on the stale FINISHED.
   258	
   259	    The wait is PROGRESS-AWARE (Bug 15): a still-actively-progressing build is never cut
   260	    off by a wall-clock — only a genuine terminal, genuine inactivity (INACTIVE_TIMEOUT →
   261	    fall through to normal classification of the wedged run), or the hard cap ends it. A
   262	    hard-cap cutoff WHILE STILL PROGRESSING (PROGRESSING_TIMEOUT) is INCONCLUSIVE, not a
   263	    product failure → raise InconclusiveRunError so the run records INVALID_RUN (§17)."""
   264	    injector: asyncio.Task[None] | None = None
   265	    if mid_run or _is_cancel_after_first_write(cancel_at):
   266	        injector = asyncio.create_task(
   267	            _inject_when_writing(
   268	                client,
   269	                cid,
   270	                mid_run,
   271	                cancel_at,
   272	                timeline,
   273	                hard_cap_s,
   274	                declared_seqs=declared_followup_seqs,
   275	                declared_requires=declared_followup_requires_revision,
   276	            )
   277	        )
   278	    gates = 0
   279	    resumes = 0
   280	    clarifies = 0
   281	    decisions_done = 0
   282	    decision_sink = decisions if decisions is not None else []
   283	    injected_sink = injected_user_seqs if injected_user_seqs is not None else []
   284	
   285	    def _record_injected_user_turn(before_seq: int) -> None:
   286	        # Attribute the NEW user message the harness just injected (clarification answer /
   287	        # decision pick) so the RevisionOracle EXCLUDES it from revision anchors. Called AFTER
   288	        # the gate cleared, so any appended user turn is already durable — a SINGLE check (no
   289	        # wait). A control frame that appends NO user message (confirm / pick_alternative) leaves
   290	        # the watermark unchanged → nothing recorded, no needless wait.
   291	        new = client.latest_user_message_seq(cid)
   292	        if new > before_seq:
   293	            injected_sink.append(new)
   294	
   295	    try:
   296	        while True:
   297	            if autonomous:
   298	                status = await client.poll_until_terminal(
   299	                    cid,
   300	                    inactivity_s=inactivity_s,
   301	                    hard_cap_s=hard_cap_s,
   302	                    min_terminal_seq=min_seq,
   303	                )
   304	            else:
   305	                status = await client.poll_until_terminal_or_gate(
   306	                    cid,
   307	                    inactivity_s=inactivity_s,
   308	                    hard_cap_s=hard_cap_s,
   309	                    min_terminal_seq=min_seq,
   310	                )
   311	            if status == PROGRESSING_TIMEOUT:
   312	                # The hard cap hit while the build was STILL emitting events — the runner
   313	                # could not obtain a terminal verdict. This is a harness/model-speed limit,
   314	                # NOT a product BUILD_DID_NOT_FINISH: surface it as INVALID_RUN so §17 re-runs.
   315	                timeline.append(
   316	                    "hard-cap reached while build was STILL PROGRESSING — "
   317	                    "inconclusive (INVALID_RUN, not a product failure)"
   318	                )
   319	                raise InconclusiveRunError(
   320	                    "terminal status not reached before the hard cap while the build "
   321	                    "was still actively progressing",
   322	                    {"stage": "terminal_wait", "hard_cap_s": hard_cap_s},
   323	                )
   324	            if status == AWAITING_PLAN_APPROVAL and gates < _MAX_GATES:
   325	                gates += 1
   326	                await client.approve_plan(cid)
   327	                timeline.append(f"approved plan (gate {gates})")
   328	                # Wait for the gate to clear so a not-yet-processed approval isn't
   329	                # re-read as the same gate and double-approved (wastes the gate budget).
   330	                await client.wait_until_status_leaves(
   331	                    cid, AWAITING_PLAN_APPROVAL, timeout_s=min(inactivity_s, 60.0)
   332	                )
   333	                continue
   334	            if (
   335	                status in (AWAITING_USER_QUESTION, WAITING_FOR_CONFIRMATION)
   336	                and clarifies < _MAX_CLARIFY
   337	            ):
   338	                # The runner ACTS AS THE USER: a build that asks a clarifying question (or
   339	                # pauses for a go-ahead) mid-build is ANSWERED so it proceeds, instead of
   340	                # false-stalling into NO_PLAN (Bug 17). Each gate is answered via its REAL
   341	                # mechanism — a clarifying QUESTION over the send_message path a real user
   342	                # follow-up uses; a CONFIRMATION via the dedicated `confirm` control frame
   343	                # (the confirm analogue of approve_plan — a plain message does NOT clear it).
   344	                # BOUNDED (≤ _MAX_CLARIFY): a model that keeps asking past the cap is let go
   345	                # to a real terminal/inactivity and classified HONESTLY — never an infinite
   346	                # answer-loop, never a masked failure.
   347	                clarifies += 1
   348	                before_user_seq = client.latest_user_message_seq(cid)
   349	                if status == WAITING_FOR_CONFIRMATION:
   350	                    await client.confirm(cid)
   351	                    timeline.append(
   352	                        f"confirmed pending action (clarify {clarifies}/{_MAX_CLARIFY})"
   353	                    )
   354	                else:
   355	                    answer = clarification_answer or _GENERIC_CLARIFY_ANSWER
   356	                    await client.send_followup(cid, answer, kind="message")
   357	                    timeline.append(
   358	                        "answered clarifying question "
   359	                        f"(clarify {clarifies}/{_MAX_CLARIFY}): {answer!r}"
   360	                    )
   361	                # Wait for the gate to clear so the same unprocessed gate isn't re-read +
   362	                # re-answered (wastes the clarify budget), mirroring the approval gate.
   363	                await client.wait_until_status_leaves(
   364	                    cid, status, timeout_s=min(inactivity_s, 60.0)
   365	                )
   366	                # An ANSWER (send_message) appends a user turn the oracle must NOT mis-anchor as
   367	                # a revision follow-up; a CONFIRM appends none → nothing recorded.
   368	                _record_injected_user_turn(before_user_seq)
   369	                continue
   370	            if status == AWAITING_USER_DECISION:
   371	                # The model proposed structured alternatives (a user-choice gate) after repeated
   372	                # tool failure. A non-interactive soak ACTS AS THE USER and auto-resolves it via
   373	                # the REAL pick_alternative mechanism (NOT approve_plan), so a build that merely
   374	                # asked for a choice can FINISH instead of false-stalling into BUILD_DID_NOT_FINISH.
   375	                # BOUNDED (≤ _MAX_DECISION) + TRACEABLE (every resolution recorded). On cap-hit OR
   376	                # an invalid/stale payload (resolve_decision returns None — state no longer
   377	                # AWAITING_USER_DECISION, or no valid option) we do NOT continue: fall through to
   378	                # the terminal/stop return so the run is judged HONESTLY (never a clean pass).
   379	                if decisions_done >= _MAX_DECISION:
   380	                    timeline.append(
   381	                        f"AWAITING_USER_DECISION cap (_MAX_DECISION={_MAX_DECISION}) hit — "
   382	                        "releasing to honest classification (NOT auto-finishing)"
   383	                    )
   384	                    return status
   385	                before_user_seq = client.latest_user_message_seq(cid)
   386	                resolved = await client.resolve_decision(
   387	                    cid, preferred_option_id=decision_answer
   388	                )
   389	                if resolved is None:
   390	                    timeline.append(
   391	                        "AWAITING_USER_DECISION could NOT be auto-resolved (stale/invalid "
   392	                        "payload: gate no longer live or no valid option) — releasing to honest "
   393	                        "classification (NOT auto-finishing)"
   394	                    )
   395	                    return status
   396	                decisions_done += 1
   397	                record = {**resolved, "attempt": decisions_done}
   398	                decision_sink.append(record)
   399	                timeline.append(
   400	                    f"auto-resolved user decision (decision {decisions_done}/{_MAX_DECISION}): "
   401	                    f"picked option {resolved['option_id']!r} for alternatives "
   402	                    f"{resolved['alternatives_id']!r}"
   403	                )
   404	                # Wait for the gate to clear so the same unprocessed decision isn't re-read +
   405	                # re-resolved, mirroring the approval/clarify gates.
   406	                await client.wait_until_status_leaves(
   407	                    cid, AWAITING_USER_DECISION, timeout_s=min(inactivity_s, 60.0)
   408	                )
   409	                # pick_alternative synthesizes an ACTION (not a user message) → normally nothing
   410	                # to record; the watermark check captures any injected user turn defensively.
   411	                _record_injected_user_turn(before_user_seq)
   412	                continue
   413	            if status == PAUSED_STATE and resumes < _MAX_RESUMES:
   414	                # A cooperative / actionless PAUSE is RESUMABLE — the runner acts as the
   415	                # user who hits Resume. BOUNDED (≤ _MAX_RESUMES) so a build that just keeps
   416	                # actionless-pausing can't spin forever; after the budget it falls through
   417	                # to the terminal/stop return and the oracle classifies the non-finished
   418	                # run (BUILD_DID_NOT_FINISH), never a silent pass.
   419	                resumes += 1
   420	                resp = await client.resume(cid)
   421	                http_status = int(resp.get("http_status", 0))
   422	                timeline.append(f"resumed PAUSED run (resume {resumes}, http {http_status})")
   423	                if http_status >= 400:
   424	                    # not resumable (409) — stop retrying; let the oracle judge.
   425	                    timeline.append("resume rejected (not resumable) — stopping")
   426	                    return status
   427	                await client.wait_until_status_leaves(
   428	                    cid, PAUSED_STATE, timeout_s=min(inactivity_s, 60.0)
   429	                )
   430	                continue
   431	            if (
   432	                injector is not None
   433	                and _is_cancel_after_first_write(cancel_at)
   434	                and not injector.done()
   435	            ):
   436	                with contextlib.suppress(asyncio.TimeoutError):
   437	                    await asyncio.wait_for(
   438	                        asyncio.shield(injector), timeout=min(inactivity_s, 60.0)
   439	                    )
   440	            timeline.append(f"reached terminal/stop status: {status}")
   441	            return status
   442	    finally:
   443	        if injector is not None and not injector.done():
   444	            injector.cancel()
   445	            with contextlib.suppress(asyncio.CancelledError):
   446	                await injector
   447	
   448	
   449	async def drive_scenario(
   450	    client: DiscoApiClient,
   451	    scenario: dict[str, Any],
   452	    *,
   453	    model: str | None,
   454	    autonomous: bool,
   455	    timeout_s: float = _DEFAULT_INACTIVITY_S,
   456	    hard_cap_s: float = _DEFAULT_HARD_CAP_S,
   457	) -> CollectedRun:
   458	    """Create + drive one scenario end-to-end, then COLLECT all evidence
   459	    (events from the DB race-free, state, workspace, preview).
   460	
   461	    `timeout_s` is the PROGRESS-AWARE INACTIVITY window (no-new-events budget), NOT a
   462	    blind wall-clock; `hard_cap_s` is the generous safety ceiling (Bug 15)."""
   463	    timeline: list[str] = []
   464	    prompt = str(scenario["prompt"])
   465	    cid = await client.create_build_conversation(prompt, model=model, autonomous=autonomous)
   466	    timeline.append(f"created build conversation {cid} (autonomous={autonomous})")
   467	    state_initial = await client.get_state(cid)
   468	
   469	    # Optional scenario-provided answer to a mid-build clarifying question (Bug 17). When
   470	    # absent, the runner sends a generic safe default that instructs the model not to ask
   471	    # further questions. Either way the build proceeds + is adjudicated on its real outcome.
   472	    clarification_answer = scenario.get("clarification_answer")
   473	    clarification_answer = str(clarification_answer) if clarification_answer is not None else None
   474	
   475	    # Optional scenario-provided preferred option for an AWAITING_USER_DECISION gate (Part B).
   476	    # Absent → resolve_decision picks the recommended/first valid option. Each auto-resolution
   477	    # is accumulated here so the run record can flag a PASS that REQUIRED one.
   478	    decision_answer = scenario.get("decision_answer")
   479	    decision_answer = str(decision_answer) if decision_answer is not None else None
   480	    decisions: list[dict[str, Any]] = []
   481	
   482	    # Revision-anchor metadata (harness-only): the DECLARED follow-ups the runner sends (seq +
   483	    # requires_plan_revision flag, parallel arrays in send order) vs the HARNESS-INJECTED
   484	    # auto-answers (clarification answers / decision picks). The RevisionOracle anchors revision
   485	    # checks on the declared follow-ups and EXCLUDES the injected turns — so an auto-answer is
   486	    # never mis-anchored as a revision follow-up (the false NO_REPLAN / WRITE_BEFORE regression).
   487	    declared_followup_seqs: list[int] = []
   488	    declared_followup_requires_revision: list[bool] = []
   489	    harness_injected_user_seqs: list[int] = []
   490	
   491	    followups = scenario.get("followups") or []
   492	    cancel_at = scenario.get("cancel_at") if isinstance(scenario.get("cancel_at"), dict) else None
   493	    mid_run = [f for f in followups if f.get("trigger") == _TRIGGER_AFTER_FIRST_FILE_WRITE]
   494	    after_terminal = [f for f in followups if f.get("trigger") != _TRIGGER_AFTER_FIRST_FILE_WRITE]
   495	
   496	    # Phase 1: the initial build (+ any mid-run steer) to terminal.
   497	    await _drive_to_terminal(
   498	        client,
   499	        cid,
   500	        autonomous=autonomous,
   501	        mid_run=mid_run,
   502	        cancel_at=cancel_at,
   503	        timeline=timeline,
   504	        inactivity_s=timeout_s,
   505	        hard_cap_s=hard_cap_s,
   506	        clarification_answer=clarification_answer,
   507	        decision_answer=decision_answer,
   508	        decisions=decisions,
   509	        injected_user_seqs=harness_injected_user_seqs,
   510	        declared_followup_seqs=declared_followup_seqs,
   511	        declared_followup_requires_revision=declared_followup_requires_revision,
   512	    )
   513	
   514	    if cancel_at and cancel_at.get("trigger") == _TRIGGER_AFTER_TERMINAL:
   515	        await _cancel_at_trigger(
   516	            client,
   517	            cid,
   518	            timeline,
   519	            trigger=_TRIGGER_AFTER_TERMINAL,
   520	            timeout_s=hard_cap_s,
   521	        )
   522	
   523	    # Phase 2: after-terminal follow-ups — each is its own re-plan→approve→terminal
   524	    # cycle (the user types a follow-up; the PRODUCT decides to re-plan).
   525	    #
   526	    # SERIALIZED (H1/V2): these follow-ups must be sent ONE AT A TIME, each fully picked up
   527	    # AND driven to its OWN new terminal before the next is sent. The naive loop sent them
   528	    # back-to-back because the terminal wait returned IMMEDIATELY on the STALE prior FINISHED
   529	    # status — so follow-up 2 landed before the engine started processing follow-up 1, and the
   530	    # engine (processing only the latest unprocessed user turn) COLLAPSED the pile into a
   531	    # SINGLE plan revision (a false PLAN_REVISION_NOT_INCREMENTED).
   532	    #
   533	    # V2 REVISED (single send + hard-fail; the re-send was a live bug — on a FINISHED run
   534	    # send_followup APPENDS the user turn again, DUPLICATING the follow-up, since there is no
   535	    # legal kick-without-append for FINISHED, resume being illegal there). For EACH follow-up:
   536	    #   1. snapshot a SEQ baseline BEFORE the send;
   537	    #   2. send EXACTLY ONCE, then BLOCK on the EVENT-SEQUENCED wait_for_followup_pickup (a
   538	    #      non-user progress event past the baseline seq — detectable even when the status stays
   539	    #      FINISHED) for the policy-driven bound (default ~75s, the real ~37s pickup + margin);
   540	    #   3. EXPLICIT decision: pickup observed → drive (success path). Pickup NOT observed within
   541	    #      the bound → HARD-FAIL (FollowupPickupError → INVALID_RUN); do NOT re-send (avoids the
   542	    #      duplicate turn) and do NOT send any later follow-up (preserves no-pile-up). Proceeding
   543	    #      on the stale terminal is precisely what let follow-up 2 collapse into follow-up 1;
   544	    #   4. on pickup, drive to terminal with min_seq=baseline.max_seq so the drive returns on the
   545	    #      follow-up's OWN new terminal (seq > baseline), never the stale one.
   546	    for f in after_terminal:
   547	        baseline = await client.capture_followup_baseline(cid)
   548	        baseline_seq = int(baseline.get("max_seq", -1))
   549	        before_user_seq = client.latest_user_message_seq(cid)
   550	        await client.send_followup(cid, str(f["text"]), kind="message")
   551	        timeline.append(f"sent after-terminal follow-up: {f['text']!r}")
   552	        pickup = await client.wait_for_followup_pickup(cid, baseline)
   553	        if pickup == FOLLOWUP_PICKUP_TIMEOUT:
   554	            # HARD-FAIL: the engine never picked the follow-up up within the bound. Do NOT
   555	            # re-send (a second send_followup DUPLICATES the user turn on a FINISHED run) and
   556	            # do NOT drive on the stale pre-follow-up terminal (that collapses the next follow-up
   557	            # into this one). Record a SEQUENCING failure (INVALID_RUN), never a silent proceed.
   558	            timeline.append(
   559	                "follow-up NOT picked up within the bound — SEQUENCING FAILURE (INVALID_RUN); "
   560	                "not re-sending (would duplicate the turn) and not driving on the stale terminal "
   561	                f"(baseline status={baseline.get('status')!r}, "
   562	                f"plan_revision={baseline.get('plan_revision')}, seq={baseline_seq})"
   563	            )
   564	            raise FollowupPickupError(
   565	                "after-terminal follow-up was not picked up by the engine within the bound "
   566	                "— cannot serialize the follow-ups",
   567	                {
   568	                    "stage": "followup_pickup",
   569	                    "baseline_status": baseline.get("status"),
   570	                    "baseline_seq": baseline_seq,
   571	                    "baseline_plan_revision": baseline.get("plan_revision"),
   572	                    "followup_text": str(f["text"]),
   573	                },
   574	            )
   575	        timeline.append(f"follow-up picked up by the engine ({pickup}) — now serialized")
   576	        # Record this DECLARED follow-up's user-message seq + its requires_plan_revision flag
   577	        # (parallel arrays) so the RevisionOracle anchors on it (and ONLY the declared turns).
   578	        # AFTER pickup the user turn is durable → a SINGLE check (no wait); a fake transport that
   579	        # never appended it leaves the watermark unchanged → nothing recorded.
   580	        new_user_seq = client.latest_user_message_seq(cid)
   581	        if new_user_seq > before_user_seq:
   582	            declared_followup_seqs.append(new_user_seq)
   583	            declared_followup_requires_revision.append(bool(f.get("requires_plan_revision")))
   584	        await _drive_to_terminal(
   585	            client,
   586	            cid,
   587	            autonomous=autonomous,
   588	            mid_run=[],
   589	            timeline=timeline,
   590	            inactivity_s=timeout_s,
   591	            hard_cap_s=hard_cap_s,
   592	            clarification_answer=clarification_answer,
   593	            decision_answer=decision_answer,
   594	            decisions=decisions,
   595	            injected_user_seqs=harness_injected_user_seqs,
   596	            min_seq=baseline_seq,
   597	        )
   598	
   599	    # Collect (post-terminal, race-free DB read for events).
   600	    events = client.collect_events(cid)
   601	    state_final = await client.get_state(cid)
   602	    workspace = await client.collect_workspace(cid, _declared_workspace_paths(scenario))
   603	    preview = await client.collect_preview(cid) if _preview_required(scenario) else None
   604	    timeline.append(f"collected {len(events)} events; workspace files={list(workspace)}")
   605	    return CollectedRun(
   606	        conversation_id=cid,
   607	        events=events,
   608	        state_initial=state_initial,
   609	        state_final=state_final,
   610	        workspace_manifest=workspace,
   611	        preview=preview,
   612	        timeline=timeline,
   613	        decision_resolutions=decisions,
   614	        declared_followup_seqs=declared_followup_seqs,
   615	        declared_followup_requires_revision=declared_followup_requires_revision,
   616	        harness_injected_user_seqs=harness_injected_user_seqs,
   617	    )
   618	
   619	
   620	# ---- dossier assembly + evidence lock (§5, §6) ------------------------------
   621	
   622	
   623	def _events_jsonl(events: list[dict[str, Any]]) -> str:
   624	    """One canonical full-event dict per line. The DB rows carry the event in a
   625	    JSON-string `payload`; write the PARSED payload so events.jsonl is the readable
   626	    canonical shape (the classifier normalizer accepts both)."""
   627	    lines: list[str] = []
   628	    for row in events:
   629	        payload = row.get("payload")
   630	        if isinstance(payload, str):
   631	            try:
   632	                payload = json.loads(payload)
   633	            except (ValueError, TypeError):
   634	                payload = row
   635	        elif not isinstance(payload, dict):
   636	            payload = row
   637	        lines.append(json.dumps(payload, sort_keys=True))
   638	    return "\n".join(lines) + ("\n" if lines else "")
   639	
   640	
   641	def _timeline_md(scenario: dict[str, Any], run: CollectedRun) -> str:
   642	    lines = [
   643	        f"# Build Soak timeline — {scenario.get('id')}",
   644	        "",
   645	        f"- conversation: `{run.conversation_id}`",
   646	        f"- prompt: {scenario.get('prompt')!r}",
   647	        "",
   648	        "## Steps",
   649	    ]
   650	    lines += [f"{i + 1}. {step}" for i, step in enumerate(run.timeline)]
   651	    return "\n".join(lines) + "\n"
   652	
   653	
   654	def assemble_dossier(
   655	    out_root: str | Path,
   656	    run_id: str,
   657	    scenario: dict[str, Any],
   658	    run: CollectedRun,
   659	    *,
   660	    model: str | None,
   661	    autonomous: bool,
   662	    commit: str = "",
   663	    seed: int | None = None,
   664	    mode: str = "api",
   665	    kernel: str = "disco",
   666	) -> Path:
   667	    """Write the §5 dossier and freeze it under the §6 evidence lock. Returns the
   668	    run-folder path. classification.json is written separately by classify_dossier."""
   669	    base = Path(out_root) / run_id
   670	    conv = base / "conversations" / run.conversation_id
   671	    conv.mkdir(parents=True, exist_ok=True)
   672	
   673	    (base / "prompt.txt").write_text(str(scenario.get("prompt", "")), encoding="utf-8")
   674	    (base / "followups.json").write_text(
   675	        json.dumps(scenario.get("followups") or [], indent=2), encoding="utf-8"
   676	    )
   677	    (base / "timeline.md").write_text(_timeline_md(scenario, run), encoding="utf-8")
   678	
   679	    (conv / "events.jsonl").write_text(_events_jsonl(run.events), encoding="utf-8")
   680	    (conv / "state.initial.json").write_text(
   681	        json.dumps(run.state_initial, indent=2, sort_keys=True), encoding="utf-8"
   682	    )
   683	    (conv / "state.final.json").write_text(
   684	        json.dumps(run.state_final, indent=2, sort_keys=True), encoding="utf-8"
   685	    )
   686	    (conv / "workspace-manifest.json").write_text(
   687	        json.dumps(run.workspace_manifest, indent=2, sort_keys=True), encoding="utf-8"
   688	    )
   689	    if run.preview is not None:
   690	        preview_dir = conv / "preview"
   691	        preview_dir.mkdir(exist_ok=True)
   692	        (preview_dir / "health.json").write_text(
   693	            json.dumps(run.preview.get("health") or {}, indent=2, sort_keys=True), encoding="utf-8"
   694	        )
   695	        (preview_dir / "served.html").write_text(
   696	            str(run.preview.get("content") or ""), encoding="utf-8"
   697	        )
   698	
   699	    # [Lane A A-B4] PERSIST product_evidence so a folder reclassify/replay ADJUDICATES instead of
   700	    # going green-by-absence (the headless soak's REL-5 cleanup evidence was in-memory only → any
   701	    # classify_run_folder saw product_evidence=None → all browser oracles SKIP → ungated GREEN).
   702	    # Written into the conv dir (classify_run_folder rglobs product-evidence.json) and added to the
   703	    # §6 hash lock so a tamper trips INVALID_RUN. strict=False: persist the truthful evidence as the
   704	    # oracles saw it (their _int coercion already fails-closed on malformed counts).
   705	    _pe = getattr(run, "product_evidence", None)
   706	    if _pe:
   707	        write_product_evidence(conv, _pe, strict=False)
   708	
   709	    # Evidence lock: hash the durable §6 set (relative to the run folder).
   710	    conv_rel = f"conversations/{run.conversation_id}"
   711	    evidence_files = {
   712	        "events.jsonl": f"{conv_rel}/events.jsonl",
   713	        "state.final.json": f"{conv_rel}/state.final.json",
   714	        "workspace-manifest.json": f"{conv_rel}/workspace-manifest.json",
   715	    }
   716	    if _pe:
   717	        evidence_files[PRODUCT_EVIDENCE_NAME] = f"{conv_rel}/{PRODUCT_EVIDENCE_NAME}"
   718	    # P1 (codex): the PREVIEW dossier is preview TRUTH the oracle adjudicates on — it
   719	    # MUST be under the hash lock too, else a preview-health/served-html tamper would
   720	    # not trip the §6 INVALID_RUN. Hash both preview files when a preview was captured.
   721	    if run.preview is not None:
   722	        evidence_files["preview/health.json"] = f"{conv_rel}/preview/health.json"
   723	        evidence_files["preview/served.html"] = f"{conv_rel}/preview/served.html"
   724	    manifest = EvidenceManifest(
   725	        run_id=run_id,
   726	        scenario_id=str(scenario.get("id")),
   727	        seed=seed,
   728	        repo_commit=commit,
   729	        model=model or "",
   730	        autonomous=autonomous,
   731	        surface="build",
   732	        kernel=kernel,
   733	        mode=mode,
   734	        started_at="",
   735	        finished_at=datetime.now(UTC).isoformat(),
   736	        evidence_files={"events": f"{conv_rel}/events.jsonl", **evidence_files},
   737	        evidence_hashes=compute_evidence_hashes(base, evidence_files),
   738	    )
   739	    write_manifest(base, manifest)
   740	    return base
   741	
   742	
   743	def classify_dossier(
   744	    base: Path,
   745	    scenario: dict[str, Any],
   746	    run: CollectedRun,
   747	    *,
   748	    autonomous: bool,
   749	    commit: str = "",
   750	    seed: int | None = None,
   751	) -> dict[str, Any]:
   752	    """Run the deterministic classifier on the collected run, passing workspace +
   753	    preview + autonomy DIRECTLY (codex #2 — so OutputTruth/preview actually run),
   754	    and write classification.json into the dossier."""
   755	    # [Lane A A-M4] Wire the parsed relay ledger so the INDEPENDENT ProviderLedgerOracle runs
   756	    # alongside the sidecar slice (defense-in-depth: two after-terminal checks, not one). Scope to
   757	    # THIS run's window [run_start, ...] and stamp after_terminal on records past the build-terminal
   758	    # epoch; ran AFTER _collect's grace+release so any straggler post-terminal call is already
   759	    # logged. Live-mode only (relay env set) so deterministic unit tests are unaffected.
   760	    provider_ledger: list[dict[str, Any]] | None = None
   761	    _rl = _relay_log_path()
   762	    if _rl and os.path.exists(_rl):
   763	        try:
   764	            with open(_rl, encoding="utf-8") as _f:
   765	                _recs = parse_relay_log(_f.read())
   766	            _t = _terminal_status_epoch(run.events)
   767	            _s = _min_event_epoch(run.events)
   768	            if _t is not None and _s is not None:
   769	                # [REL-5b] after_terminal is the BUILD-runaway signal the ProviderLedgerOracle reads.
   770	                # Stamp it True ONLY for a tool-bearing (build-driver) call past terminal — a tool-
   771	                # less SUMMARIZER/auto-title call is benign and must not read as PROVIDER_CALL_AFTER_
   772	                # TERMINAL. Unmarked records default has_tools=True (fail-closed → still flagged).
   773	                provider_ledger = [
   774	                    {**r, "after_terminal": float(r["ts"]) > _t and bool(r.get("has_tools", True))}
   775	                    for r in _recs
   776	                    if isinstance(r.get("ts"), (int, float)) and float(r["ts"]) >= _s
   777	                ]
   778	        except Exception:
   779	            provider_ledger = None
   780	    classification = classify(
   781	        run.events,
   782	        scenario=scenario,
   783	        run_id=base.name,
   784	        conversation_id=run.conversation_id,
   785	        commit=commit,
   786	        seed=seed,
   787	        workspace_manifest=run.workspace_manifest,
   788	        preview=run.preview,
   789	        autonomous=autonomous,
   790	        provider_ledger=provider_ledger,
   791	        # HARN-2: browser product-harness evidence (None until HARN-1b populates it on
   792	        # CollectedRun; the browser oracles SKIP without it, so headless runs are unaffected).
   793	        product_evidence=getattr(run, "product_evidence", None),
   794	        revision_meta={
   795	            "declared_followup_seqs": list(run.declared_followup_seqs),
   796	            "declared_followup_requires_revision": list(run.declared_followup_requires_revision),
   797	            "harness_injected_user_seqs": list(run.harness_injected_user_seqs),
   798	        },
   799	    )
   800	    # Part B traceability: a PASS that REQUIRED auto-resolving an AWAITING_USER_DECISION gate
   801	    # must be DISTINGUISHABLE from a clean PASS — surface the count + the picked options so
   802	    # monitoring can detect "the model asked for choices unexpectedly".
   803	    classification["auto_resolved_decisions"] = len(run.decision_resolutions)
   804	    if run.decision_resolutions:
   805	        classification["decision_resolutions"] = list(run.decision_resolutions)
   806	    (base / CLASSIFICATION_NAME).write_text(
   807	        json.dumps(classification, indent=2, sort_keys=True), encoding="utf-8"
   808	    )
   809	    return classification
   810	
