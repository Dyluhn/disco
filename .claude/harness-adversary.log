  1438	def _norm_rel(path: str) -> str:
  1439	    """Canonical workspace-relative key: drop a leading ``./`` then any leading ``/`` so a
  1440	    scenario-declared ``/index.html`` / ``./index.html`` and an event-log ``index.html``
  1441	    compare equal."""
  1442	    s = str(path)
  1443	    if s.startswith("./"):
  1444	        s = s[2:]
  1445	    return s.lstrip("/")
