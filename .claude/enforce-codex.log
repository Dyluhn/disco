    async def execute_pi_tool(
        self, conversation_id: str, tool_call: ToolCall
    ) -> ToolResult:
        """[D2] Execute ONE externally-driven (Pi sidecar) tool call against this
        conversation's executor, MIRRORING ``observe.execute_and_observe``'s
