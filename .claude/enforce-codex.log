"""Contract scope ENFORCEMENT at the tool-dispatch boundary (CONTRACT-ENFORCE).

CONTRACT-3 compiled a contract into per-phase hard allowlists; this is the piece that
DENIES an out-of-scope tool call before it executes. The executor (the universal tool
chokepoint) holds an optional ``ContractScopeGuard``; when a build run is governed by a
contract, the guard rejects a call whose tool is not permitted in the current phase —
so e.g. an ``appkit.leadgen`` run cannot ``file_write`` during the EDIT phase (it must
use the semantic app_* tools); raw rewrite is reachable only in REPAIR.

Governed surface: a tool is enforced if the contract scopes it to SOME phase (a build
tool the contract knows) OR it is a known escape-hatch mutator (file_write/shell/…).
Everything else — think, preview_*, read-only utilities, the finalizer — is ungoverned
and always passes, so enforcement constrains the BUILD surface without breaking the
universal tools. Pure decision logic + a thin guard; no runtime imports.
"""

from __future__ import annotations

from collections.abc import Callable

from pydantic import BaseModel, ConfigDict

from .models import BuildContract
from .scopes import ContractToolScopes, Phase, compile_tool_scopes

# Escape-hatch mutators: powerful enough that they must be phase-gated even if a
# contract never names them (so a contract can't be bypassed by reaching for a raw
# writer/exec the pack didn't mention).
DANGEROUS_TOOLS: frozenset[str] = frozenset(
    {"file_write", "file_edit", "file_replace_lines", "file_delete", "shell", "bash", "exec"}
)


class ScopeDecision(BaseModel):
    """The allow/deny outcome for one tool call under a contract + phase."""

    model_config = ConfigDict(frozen=True)

    allowed: bool
    reason: str = ""


def _governed(tool: str, scopes: ContractToolScopes) -> bool:
    """Is this tool subject to contract enforcement at all?

    Governed = a dangerous escape-hatch mutator, OR a build tool the contract scopes to
    bootstrap/edit/repair/export. The verify finalizer is deliberately EXCLUDED: it is a
    control signal ('I think this is ready') that requests the phase transition, so it
    must remain callable from any phase — blocking it would strand the run."""
    if tool in DANGEROUS_TOOLS:
        return True
    return tool in (scopes.bootstrap | scopes.edit | scopes.repair | scopes.export)


def decide_tool_in_scope(scopes: ContractToolScopes, phase: Phase, tool: str) -> ScopeDecision:
    """Allow/deny ``tool`` in ``phase`` under compiled ``scopes`` (HARD allowlist).

    - permitted in this phase → allow
    - governed (scoped elsewhere, or a dangerous mutator) but NOT in this phase → DENY
    - ungoverned utility (think / preview / read-only / finalizer) → allow
    """
    if scopes.allowed(phase, tool):
        return ScopeDecision(allowed=True)
    if _governed(tool, scopes):
        permitted = ", ".join(sorted(scopes.for_phase(phase))) or "(none)"
        return ScopeDecision(
            allowed=False,
            reason=(
                f"out of contract scope: tool {tool!r} is not permitted in the "
                f"{phase.value} phase of this contract; permitted here: {permitted}. "
                + (
                    "Use the contract's semantic edit tools — raw file rewrite is "
                    "reachable only in the repair phase."
                    if tool in DANGEROUS_TOOLS
                    else "This tool belongs to a different build phase."
                )
            ),
        )
    return ScopeDecision(allowed=True)


class ContractScopeGuard:
    """The executor-side guard: holds the compiled scopes + a live phase provider, and
    checks a tool name against the current phase. Constructed by whoever runs a build
    under a contract; when absent, the executor enforces nothing (a plain agent run)."""

    def __init__(self, scopes: ContractToolScopes, phase_provider: Callable[[], Phase]) -> None:
        self._scopes = scopes
        self._phase = phase_provider

    @classmethod
    def for_contract(
        cls, contract: BuildContract, phase_provider: Callable[[], Phase]
    ) -> ContractScopeGuard:
        return cls(compile_tool_scopes(contract), phase_provider)

    def check(self, tool_name: str) -> ScopeDecision:
        return decide_tool_in_scope(self._scopes, self._phase(), tool_name)

