    50	def merge_tweak_defaults(spec: TweakSpec, values: Mapping[str, Any]) -> dict[str, Any]:
    51	    """Reconcile ``values`` against ``spec`` → a new dict with deterministic (sorted) key order:
    52	
    53	    * every present value for a DEFINED tweak is validated + coerced to its canonical form;
    54	    * a defined tweak ABSENT from ``values`` with a non-None default is filled from that default;
    55	    * a value keyed to an UNDEFINED tweak raises ``TweaksError`` (never keep ungoverned state).
    56	
    57	    A present ``None`` counts as PRESENT (validated, not default-filled). Defaults never
    58	    overwrite a present value.
    59	    """
    60	    defined = {f.key for f in spec.fields}
    61	    unknown = sorted(set(values) - defined)
    62	    if unknown:
    63	        raise TweaksError(f"value(s) for undefined tweak(s): {unknown}")
    64	
    65	    merged: dict[str, Any] = {}
    66	    for field in spec.fields:
    67	        if field.key in values:
    68	            try:
    69	                merged[field.key] = spec.validate_value(field.key, values[field.key])
    70	            except ValueError as e:
    71	                raise TweaksError(f"invalid value for tweak {field.key!r}: {e}") from e
    72	        elif field.default is not None:
    73	            try:
    74	                merged[field.key] = spec.validate_value(field.key, field.default)
    75	            except ValueError as e:  # a default that doesn't validate is a spec authoring bug
    76	                raise TweaksError(f"invalid default for tweak {field.key!r}: {e}") from e
    77	    return dict(sorted(merged.items()))

