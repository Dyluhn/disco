   258	def intermittent_classification(
   259	    original: dict[str, Any],
   260	    *,
   261	    replay_status: str,
   262	    replay_code: str | None = None,
   263	    replay_run_id: str | None = None,
   264	) -> dict[str, Any]:
   265	    """Apply the no-fluke replay policy (§17) to an originally-FAILED run.
   266	
   267	    A failed run that PASSES on exact replay is NOT a pass — it is an intermittent
   268	    failure: status stays FAIL, code becomes INTERMITTENT_<original_code> with the
   269	    SAME severity. A replay that fails the same way is a deterministic failure
   270	    (unchanged). The word "fluke" never yields PASS.
   271	
   272	    Returns a NEW classification dict; the input is not mutated."""
   273	    if original.get("status") != fc.FAIL:
   274	        raise ValueError("no-fluke policy only applies to an originally-FAILED run")
   275	    original_code = str(original.get("code"))
   276	    updated = dict(original)
   277	
   278	    if replay_status == fc.PASS:
   279	        intermittent_code = fc.INTERMITTENT_PREFIX + original_code
   280	        updated["status"] = fc.FAIL
