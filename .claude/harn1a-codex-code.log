     1	"""HARN-1a — the provider-call ledger evidence.
     2	
     3	A provider-call-ledger is the per-run record of every LLM provider request the build
     4	made: the destination host, the model, and whether the call fired after the
     5	conversation went terminal. It is the evidence the ProviderLedgerOracle judges to
     6	enforce the soak constraint (MiniMax-only / no-OpenRouter / zero-calls-after-terminal).
     7	
     8	The source of truth for a HEADLESS run is the MiniMax relay log (the relay sits between
     9	disco and the provider and logs each upstream request). This module normalizes relay-log
    10	lines into ledger records. Records may also be supplied directly as JSONL.
    11	
    12	A ledger record (dict):
    13	    {"ts": str|None, "host": str, "model": str, "after_terminal": bool}
    14	Only ``host`` is strictly required for enforcement; ``model``/``ts``/``after_terminal``
    15	default to "" / "" / False when the source line does not carry them.
    16	"""
    17	
    18	from __future__ import annotations
    19	
    20	import json
    21	import re
    22	from typing import Any
    23	
    24	# A URL host: grab the authority of the first http(s):// URL on the line.
    25	_URL_HOST_RE = re.compile(r"https?://([^/\s\"']+)", re.IGNORECASE)
    26	# A model id: "model":"X" (JSON), model=X, or model: X.
    27	_MODEL_RE = re.compile(r"""["']?model["']?\s*[:=]\s*["']?([A-Za-z0-9._\-]+)""", re.IGNORECASE)
    28	
    29	
    30	def _record(host: str, *, model: str = "", ts: str | None = None, after_terminal: bool = False) -> dict[str, Any]:
    31	    return {"ts": ts, "host": host, "model": model, "after_terminal": bool(after_terminal)}
    32	
    33	
    34	def parse_relay_log_lines(lines: list[str]) -> list[dict[str, Any]]:
    35	    """Normalize relay-log lines into ledger records (best-effort, tolerant).
    36	
    37	    Each line that is valid JSON carrying a ``host``/``url`` (and optional ``model``)
    38	    is used directly; otherwise a host is regex-extracted from the first URL on the
    39	    line and a model from a ``model``-like token. Lines with no recoverable host are
    40	    skipped (not every relay line is a provider request)."""
    41	    out: list[dict[str, Any]] = []
    42	    for raw in lines:
    43	        line = raw.strip()
    44	        if not line:
    45	            continue
    46	        # 1) structured JSONL relay record
    47	        try:
    48	            obj = json.loads(line)
    49	        except (json.JSONDecodeError, ValueError):
    50	            obj = None
    51	        if isinstance(obj, dict):
    52	            host = str(obj.get("host") or "")
    53	            if not host:
    54	                url = str(obj.get("url") or "")
    55	                m = _URL_HOST_RE.search(url)
    56	                host = m.group(1) if m else ""
    57	            if host:
    58	                out.append(
    59	                    _record(
    60	                        host,
    61	                        model=str(obj.get("model") or ""),
    62	                        ts=obj.get("ts") or obj.get("timestamp"),
    63	                        after_terminal=bool(obj.get("after_terminal", False)),
    64	                    )
    65	                )
    66	            continue
    67	        # 2) loose log line — extract host + model by regex
    68	        mh = _URL_HOST_RE.search(line)
    69	        if not mh:
    70	            continue
    71	        mm = _MODEL_RE.search(line)
    72	        out.append(_record(mh.group(1), model=mm.group(1) if mm else ""))
    73	    return out
    74	
    75	
    76	def parse_relay_log(text: str) -> list[dict[str, Any]]:
    77	    """Convenience: parse a whole relay-log blob into ledger records."""
    78	    return parse_relay_log_lines(text.splitlines())
