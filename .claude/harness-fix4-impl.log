+
+    def churn(step):
+        (ws / "index.html").write_text(f"<h1>v{step}</h1>", encoding="utf-8")
+
+    clock = _FakeClock(on_poll=churn)
+    _install_clock(monkeypatch, clock)
+    client = DiscoApiClient(
