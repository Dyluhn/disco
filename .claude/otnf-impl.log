+class _FakeAliasSandbox:
+    id = "fake-run-script"
+    owner_id = "local"
+    conversation_id = "c"
+    spec = SandboxSpec()
+
+    def __init__(self) -> None:
+        self._workspace = Path(tempfile.mkdtemp(prefix="disco-run-script-test-"))
+        self._fs: dict[str, bytes] = {}
+
+    async def resolve_relpath(self, path: str) -> str:
+        lexical = posixpath.normpath(path)
+        candidate = self._workspace / lexical
+        if candidate.exists() or candidate.is_symlink():
+            resolved = candidate.resolve()
+            try:
+                return resolved.relative_to(self._workspace).as_posix()
+            except ValueError as exc:
+                from disco.tools.sandbox.base import SandboxPermissionError
+
+                raise SandboxPermissionError(f"path escapes workspace: {path}") from exc
+        return lexical
+
+    async def read_file(self, path: str) -> bytes:
+        key = await self.resolve_relpath(path)
+        if key not in self._fs:
+            raise FileNotFoundError(path)
+        return self._fs[key]
+
+    async def write_file(self, path: str, data: bytes) -> None:
+        key = posixpath.normpath(path)
+        self._fs[key] = data
+        target = self._workspace / key
+        target.parent.mkdir(parents=True, exist_ok=True)
+        target.write_bytes(data)
+
+    async def atomic_write(self, path: str, data: bytes) -> None:
+        await self.write_file(path, data)
+
+    async def file_exists(self, path: str) -> bool:
+        return (await self.resolve_relpath(path)) in self._fs
+
+    async def list_dir(self, path: str) -> list[str]:
+        base = "" if path in ("", ".") else posixpath.normpath(path).rstrip("/") + "/"
+        out = set()
+        for key in self._fs:
+            if not key.startswith(base):
+                continue
+            rest = key[len(base):]
+            if rest:
+                out.add(rest.split("/", 1)[0])
+        return sorted(out)
+
+    async def destroy(self) -> None:
+        shutil.rmtree(self._workspace, ignore_errors=True)
+
+
 def _run(ops):
     return RunProjectScriptTool().run(RunProjectScriptTool.definition.args_model(operations=ops), None)  # type: ignore
 

