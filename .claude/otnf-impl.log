+                "— do NOT re-send it; this file is too large to include without a match "
+                "anchor, so read the exact region you want to change and copy it precisely."
+            )
+    return ToolOutcome(
+        success=False,
+        error=error,
+        content=content,
+        structured=structured,
+    )
