+def _old_text_not_found_refusal(
+    conv_id: str,
+    path: str,
+    *,
+    current_bytes: bytes,
+    base_content: str,
+    error: str,
+) -> ToolOutcome:
+    """REL-6: anchored old-text misses are self-recovering refusal reads."""
+    import hashlib
+
+    count = _increment_old_text_not_found_count(conv_id, path)
+    content = base_content
