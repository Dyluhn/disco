+    content = base_content
+    structured: dict[str, Any] = {
+        "kind": "old_text_not_found",
+        "path": path,
+        "old_text_not_found_count": count,
+    }
+    delivered_content = len(current_bytes) <= _REFUSAL_READ_FULL_MAX_BYTES
+    if delivered_content:
