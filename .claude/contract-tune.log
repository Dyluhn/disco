def _ask_user_tool_singleton():
    global _ASK_USER_TOOL_SPEC
    if _ASK_USER_TOOL_SPEC is None:
        _ASK_USER_TOOL_SPEC = _ask_user_tool_spec()
    return _ASK_USER_TOOL_SPEC


