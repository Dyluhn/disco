    make_health_router,
    make_mcp_router,
    make_models_router,
    make_pi_inference_router,
    make_preview_edit_router,
    make_preview_router,
    make_probes_router,
    make_projects_router,
    make_report_router,
    make_schedules_router,
    make_sessions_router,
    make_share_router,
