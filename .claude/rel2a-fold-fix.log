def _declare_sheet(store, cid, filename):
    asyncio.run(store.append(cid, ObservationEvent(action_id='a1', tool_result=ToolResult(call_id='c1', tool_name='sheet_generate', success=True, content='ok', structured={'filename': filename, 'title': 'T', 'sheet_names': ['S']}))))

