    # -- action gate ----------------------------------------------------------
    async def confirm(self, conversation_id: str) -> None:
        """Approve the pending (blast-radius-gated) action and resume."""
        ...

    async def reject(self, conversation_id: str, reason: str = "rejected by user") -> None:
