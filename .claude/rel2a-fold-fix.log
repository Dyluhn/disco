+    rt._maybe_rehydrate = AsyncMock()
+    rt._rematerialize_uploads = AsyncMock()
+    rt._maybe_snapshot = AsyncMock()
+    await rt._run_with_persistence(cid, _FinishLoop(store, cid, detail=detail))
+
