        analyzer or FakeAnalyzer(),
        policy or NeverConfirm(),
        condenser or NoOpCondenser(),
        summarizer or FakeSummarizer(),
        mode=mode,
        max_iterations=max_iterations,
        stop_hooks=stop_hooks,

