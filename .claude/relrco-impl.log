+        return "index.html" if app_root else None
+    if norm.startswith("/") or norm == ".." or norm.startswith("../"):
+        return None
+    if app_root:
+        base = norm.rstrip("/")
+        if posixpath.basename(base) == "index.html":
+            return base
+        return posixpath.normpath(posixpath.join(base, "index.html"))
+    return norm
