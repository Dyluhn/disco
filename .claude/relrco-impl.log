+        try:
+            root = Path(workspace).resolve()
+            candidate = (root / path).resolve()
+            root_s = str(root)
+            cand_s = str(candidate)
+            if not (cand_s == root_s or cand_s.startswith(root_s.rstrip("/") + "/")):
