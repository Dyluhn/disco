+def _safe_deliverable_file_path(path: str, *, app_root: bool = False) -> str | None:
+    raw = (path or "").strip()
+    if not raw:
+        return None
+    norm = posixpath.normpath(raw)
+    if norm in ("", "."):
+        return "index.html" if app_root else None
