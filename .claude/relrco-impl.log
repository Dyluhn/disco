+        except OSError as exc:
+            _LOG.warning(
+                "dictated-content read failed for %s:%s from workspace: %s",
+                self._loop.conversation_id,
+                path,
+                exc,
+            )
+            return b""
+
+    async def _first_dictated_content_miss(
+        self,
