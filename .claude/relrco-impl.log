+        for step in ev.steps:
+            dc = getattr(step, "done_condition", None)
+            if isinstance(dc, FileExistsPredicate):
+                p = _safe_deliverable_file_path(dc.path)
+                if p is not None:
+                    out.append(p)
+    return out
+
