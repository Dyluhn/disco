+    out: list[str] = []
+    seen: set[str] = set()
+    for mt in _QUOTED_LITERAL_RE.finditer(text or ""):
+        literal = mt.group(1) if mt.group(1) is not None else mt.group(2)
+        if literal is None or _skip_dictated_literal(literal):
+            continue
