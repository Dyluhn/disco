+_FILE_LIKE_LITERAL_RE = re.compile(
+    r"^(?:[\w.-]+\.(?:html?|css|mjs|cjs|jsx?|tsx?|py|md|json|ya?ml|txt|csv|"
+    r"png|jpe?g|gif|webp|svg|pdf|docx?|xlsx?|pptx?)|\.env(?:\.[\w.-]+)?)$",
+    re.IGNORECASE,
+)
+_SHELL_COMMAND_WORDS = frozenset(
+    {
+        "ag",
+        "bun",
+        "cat",
+        "cd",
+        "chmod",
+        "chown",
+        "cp",
+        "curl",
+        "deno",
+        "docker",
+        "echo",
+        "git",
+        "grep",
+        "head",
+        "ls",
+        "make",
