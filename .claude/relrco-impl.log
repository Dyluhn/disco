+    r"png|jpe?g|gif|webp|svg|pdf|docx?|xlsx?|pptx?)|\.env(?:\.[\w.-]+)?)$",
+    re.IGNORECASE,
+)
+_SHELL_COMMAND_WORDS = frozenset(
