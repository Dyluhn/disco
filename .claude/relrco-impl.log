+                    self._loop.conversation_id,
+                    path,
+                    exc,
+                )
+                return b""
+            if isinstance(data, bytes):
+                return data
+            return str(data).encode("utf-8", "surrogatepass")
+
+        workspace = getattr(sbx, "workspace_path", None) if sbx is not None else None
+        if not workspace:
+            return None
