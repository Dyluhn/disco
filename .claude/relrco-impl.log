+                key = (plan.revision, literal)
+                if key in seen:
+                    continue
+                seen.add(key)
+                out.append(
+                    DictatedContentCondition(
+                        revision=plan.revision,
+                        literal=literal,
+                        source_event_id=user.id,
+                        source_seq=user.seq,
+                    )
+                )
+        prev_plan_idx = plan_idx
+    return out
+
+
