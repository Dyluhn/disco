+            if isinstance(dc, FileExistsPredicate):
+                p = _safe_deliverable_file_path(dc.path)
+                if p is not None:
+                    out.append(p)
+    return out
+
+
+def _deliverable_event_paths(events: list[Event]) -> list[str]:
