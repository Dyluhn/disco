+        for idx, e in indexed:
+            if idx <= prev_plan_idx or idx > plan_idx:
+                continue
+            if isinstance(e, StatusEvent) and e.detail == "planning":
+                planning_idx = idx
+        upper_idx = planning_idx if planning_idx is not None else plan_idx
+        users = [
