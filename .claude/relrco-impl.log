+                        "path": "artifact.txt",
+                    },
+                }
+            ],
+        },
+    )
+
+
+def _write(content: str) -> object:
+    return action_step("file_write", {"path": "artifact.txt", "content": content})
+
+
+def _finish() -> object:
+    return action_step("finish", {"summary": "done"})
+
+
+def _env_messages(events) -> list[str]:
+    return [
