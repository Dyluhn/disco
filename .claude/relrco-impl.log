+def _skip_dictated_literal(text: str) -> bool:
+    s = text.strip()
+    if len(s) != len(text) or not (2 <= len(s) <= 80):
+        return True
+    if _has_unspaced_slash(s):
+        return True
+    if _FILE_LIKE_LITERAL_RE.match(s):
+        return True
+    return _looks_like_shell_command(s)
