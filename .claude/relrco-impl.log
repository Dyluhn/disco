+        paths.extend(self._contract_required_deliverable_paths())
+        if _is_web_deliverable(events):
+            paths.append("index.html")
+
+        out: list[str] = []
+        seen: set[str] = set()
+        for path in paths:
+            norm = posixpath.normpath(path)
+            if norm in seen:
+                continue
+            seen.add(norm)
+            out.append(norm)
+        return out
