+def _latest_plan_revision(events: list[Event]) -> int | None:
+    rev: int | None = None
+    for ev in events:
+        if isinstance(ev, PlanEvent):
+            rev = ev.revision if rev is None else max(rev, ev.revision)
+    return rev
