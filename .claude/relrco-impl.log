+                        f"revision {cond.revision} and is carried forward into the "
+                        "current revision. The match is case-sensitive and exact. "
+                        "Update the deliverable so it contains that exact text, then "
+                        "finish again.\n"
+                        "</system-reminder>"
+                    ),
+                ),
+            )
+        )
+        return False
+
