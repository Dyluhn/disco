app = FastAPI()

@app.get("/v1/models")
async def models():
    async with httpx.AsyncClient(timeout=30) as c:
        r = await c.get(f"{UPSTREAM}/models", headers={"Authorization": f"Bearer {KEY}"})
    return JSONResponse(status_code=r.status_code, content=r.json())

@app.post("/v1/{path:path}")
async def proxy(path: str, request: Request):
    body = await request.json()
    if isinstance(body, dict):
        _tools = body.get("tools") or []
        print(f"RELAY-REQ path={path} model={body.get('model')} stream={body.get('stream')} "
              f"n_tools={len(_tools)} n_msgs={len(body.get('messages') or [])} "
              f"tool_choice={body.get('tool_choice')}", flush=True)
    if isinstance(body, dict) and "model" in body:
        body["model"] = MODEL_MAP.get(body["model"], DEFAULT_MODEL)
    # MiniMax-M3 rejects max_tokens > 524288 (400 bad_request). The Pi sidecar/gateway
    # sends an oversized default → clamp so the build's model turns actually succeed.
    # MiniMax-M3 400s on max_tokens > 524288, and the Pi sidecar/gateway emits a ~4M
    # default (pi-ai derives it from a default context window; the disco gateway model's
    # contextWindow/maxTokens fields are NOT the source — see S13-RUNBOOK durability TODO).
    # Clamp here so every build turn succeeds. PROVEN keystone fix for §13.
    if isinstance(body, dict):
        mt = body.get("max_tokens")
        if not isinstance(mt, int) or mt > 131072:
            body["max_tokens"] = 131072
    # identity encoding so the streamed SSE is not gzip-compressed on the wire
    # (aiter_raw would forward compressed bytes → the sidecar parses no tool_calls).
    headers = {"Authorization": f"Bearer {KEY}", "Content-Type": "application/json",
               "Accept-Encoding": "identity"}
    url = f"{UPSTREAM}/{path}"
    if isinstance(body, dict) and body.get("stream"):
        async def gen():
            buf = bytearray()
            async with httpx.AsyncClient(timeout=600) as c:
                async with c.stream("POST", url, json=body, headers=headers) as r:
                    async for chunk in r.aiter_bytes():
                        buf += chunk
                        yield chunk
            text = bytes(buf).decode("utf-8", "replace")
            import re
            frs = ",".join(sorted(set(re.findall(r'"finish_reason":"([a-z_]+)"', text))))
            has_tc = "tool_calls" in text
            content_len = sum(len(m) for m in re.findall(r'"content":"((?:[^"\\]|\\.)*)"', text))
            print(f"RELAY-RESP has_tool_calls={has_tc} finish_reason={frs or 'none'} "
                  f"content_chars~{content_len} bytes={len(buf)}", flush=True)
            if len(buf) < 1500:
                print(f"RELAY-RESP-BODY {text!r}", flush=True)
            print(f"RELAY-REQ-BODY {str(body)[:60000]!r}", flush=True)
        return StreamingResponse(gen(), media_type="text/event-stream")
    async with httpx.AsyncClient(timeout=600) as c:
        r = await c.post(url, json=body, headers=headers)
    return JSONResponse(status_code=r.status_code, content=r.json())

