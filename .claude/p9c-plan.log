    27	class TweakEditor(str, Enum):
    28	    TEXT = "text"
    29	    COLOR = "color"  # a free canonical hex
    30	    INT = "int"
    31	    FLOAT = "float"
    32	    BOOLEAN = "boolean"
    33	    ENUM = "enum"  # one of curated string options
    34	    PALETTE = "palette"  # one of 2-5 curated color swatches
    35	
    36	
    37	_NUMERIC = frozenset({TweakEditor.INT, TweakEditor.FLOAT})
    38	_KEY_RE = re.compile(r"^[a-z][a-z0-9_]*(\.[a-z][a-z0-9_]*)*$")  # e.g. lead_form.include_phone
    39	_HEX3 = re.compile(r"^#[0-9a-fA-F]{3}$")
    40	_HEX6 = re.compile(r"^#[0-9a-fA-F]{6}$")
    41	
