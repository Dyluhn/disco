    84	class StarterKit:
    85	    """A named host-owned scaffold: ``scaffold(title)`` → {rel_path: text} (path-safe)."""
    86	
    87	    def __init__(self, kit_id: str, builder: Callable[[str], dict[str, str]]) -> None:
