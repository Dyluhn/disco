   225	class TweakSpec(BaseModel):
   226	    """A registry of an app's owner-facing tweak definitions (unique keys)."""
   227	
   228	    model_config = ConfigDict(frozen=True, extra="forbid")
   229	
   230	    fields: tuple[TweakField, ...] = ()
   231	
   232	    @model_validator(mode="after")
   233	    def _unique_keys(self) -> TweakSpec:
   234	        keys = [f.key for f in self.fields]
   235	        if len(set(keys)) != len(keys):
   236	            raise ValueError("tweak keys must be unique")
   237	        return self
   238	
   239	    def get(self, key: str) -> TweakField | None:
   240	        return next((f for f in self.fields if f.key == key), None)
   241	
   242	    def validate_value(self, key: str, value: Any) -> Any:
   243	        """Coerce+validate ``value`` for the tweak ``key`` → canonical value, or ValueError
   244	        (unknown key included — never silently accept an undefined tweak)."""
   245	        field = self.get(key)
   246	        if field is None:
   247	            raise ValueError(f"unknown tweak {key!r}")
   248	        return coerce_tweak_value(field, value)

