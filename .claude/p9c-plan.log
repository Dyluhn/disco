    43	def canonical_hex(value: Any) -> str:
    44	    """``#RGB`` / ``#RRGGBB`` → lowercase ``#rrggbb``. Rejects names, rgb(), alpha, malformed."""
    45	    if not isinstance(value, str):
    46	        raise ValueError(f"color must be a hex string, got {type(value).__name__}")
    47	    v = value.strip()
    48	    if _HEX3.match(v):
    49	        return f"#{v[1]*2}{v[2]*2}{v[3]*2}".lower()
    50	    if _HEX6.match(v):
    51	        return v.lower()
    52	    raise ValueError(f"color must be #RGB or #RRGGBB hex, got {value!r}")
    53	
    54	
    55	def _is_real(x: Any) -> bool:
    56	    return isinstance(x, (int, float)) and not isinstance(x, bool) and math.isfinite(x)
    57	
    58	
    59	def _is_int(x: Any) -> bool:
    60	    return isinstance(x, int) and not isinstance(x, bool)
