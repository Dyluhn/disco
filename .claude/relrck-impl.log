    69	    i = 0
    70	    while i < len(messages):
    71	        msg = messages[i]
    72	        if msg.role == "assistant" and msg.tool_calls:
    73	            ids: list[str] = []
    74	            for tc in msg.tool_calls:
    75	                cid = tc.get("id") if isinstance(tc, dict) else None
    76	                if isinstance(cid, str) and cid:
    77	                    ids.append(cid)
    78	            if len(ids) == len(msg.tool_calls):
    79	                following = messages[i + 1 : i + 1 + len(ids)]
    80	                if len(following) == len(ids) and all(
    81	                    f.role == "tool" and f.tool_call_id == cid
    82	                    for f, cid in zip(following, ids, strict=True)
    83	                ):
    84	                    out.append(msg)
    85	                    out.extend(following)
    86	                    i += 1 + len(ids)
    87	                    continue
    88	            # Broken assistant tool call: drop it. Any separated tool result
    89	            # becomes an orphan and is dropped by the role=="tool" arm below.
    90	            i += 1
    91	            continue
    92	        if msg.role == "tool":
