+    o = _obs_for(a, "file body")
+    events = with_seqs(
+        [
+            user_msg("inspect"),
+            a,  # seq 2: paired action
+            o,  # seq 3: forgotten result
+            agent_msg("later"),
+            tombstone(3, 4, "[tool turn condensed]"),
+        ]
+    )
+
