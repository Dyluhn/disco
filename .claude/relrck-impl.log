+                       temperature=None, assist=False, attempt=1, provider_prefs=None):
+            self.calls += 1
+            raise LLMError(
+                "invalid params, tool call result does not follow tool call (2013)",
+                provider="minimax",
+            )
+
+    agent = _AlwaysProtocolErrorAgent()
+    loop, store = build_loop(agent)
