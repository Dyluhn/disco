+def _obs_for(action_event: ActionEvent, content: str = "ok") -> ObservationEvent:
+    return ObservationEvent(
+        tool_result=ToolResult(
+            call_id=action_event.tool_call.call_id,
+            tool_name=action_event.tool_call.tool_name,
+            success=True,
+            content=content,
