+
+        async def step(self, view, tools, *, mode, overflow_signal, on_stream=None,
+                       temperature=None, assist=False, attempt=1, provider_prefs=None):
+            self.calls += 1
+            self.seen_messages.append(list(view.messages))
+            if self.calls == 1:
+                raise LLMError(
