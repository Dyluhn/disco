+            ids = [tc["id"] for tc in msg.tool_calls]
+            following = messages[i + 1 : i + 1 + len(ids)]
+            assert [(m.role, m.tool_call_id) for m in following] == [
+                ("tool", cid) for cid in ids
+            ]
