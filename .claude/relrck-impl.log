    59	def repair_tool_call_adjacency(messages: list[LLMMessage]) -> list[LLMMessage]:
    60	    """Return a provider-safe message list with dangling tool-call pairs dropped.
    61	
    62	    OpenAI-compatible providers require an assistant message with ``tool_calls``
    63	    to be followed immediately by one tool message per call id. A broken history
    64	    cannot be repaired by a model rephrase because the provider rejects the
    65	    request before the model sees it, so the only safe retry payload is one that
    66	    removes incomplete assistant/tool fragments.
    67	    """
