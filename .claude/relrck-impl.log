+    view = View.of(events)
+    pair_idx = next(i for i, m in enumerate(view.messages) if m.role == "assistant" and m.tool_calls)
+    assert view.messages[pair_idx + 1].role == "tool"
+    assert view.messages[pair_idx + 1].tool_call_id == a.tool_call.call_id
