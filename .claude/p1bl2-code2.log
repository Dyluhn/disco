    46	
    47	def _wants_plan_gate(scenario: dict[str, Any] | None) -> bool:
    48	    if not scenario:
    49	        return False
    50	    ec = (scenario.get("assertions") or {}).get("event_chain") or {}
    51	    return bool(ec.get("require_plan_before_execution"))
    52	
    53	
    54	def _wants_observation_pairs(scenario: dict[str, Any] | None) -> bool:
    55	    # Default ON: a Build run should always pair actions with observations. A
    56	    # scenario may opt out explicitly with require_action_observation_pairs: false.
    57	    if not scenario:
    58	        return True
    59	    ec = (scenario.get("assertions") or {}).get("event_chain") or {}
    60	    return ec.get("require_action_observation_pairs", True) is not False
