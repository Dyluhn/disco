    47	        }
    48	
    49	
    50	# The §6.8 minimal scenario: a static site build that exercises the real UI/WS/preview/finish/
    51	# cleanup path. No export step (requires_export=False); a disco-kernel run has no sidecar — those
    52	# oracles SKIP legitimately, so they are NOT in required_slices.
    53	STATIC_SITE_SMOKE = ProductScenario(
