   110	def compute_evidence_hashes(folder: str | Path, files: dict[str, str]) -> dict[str, str]:
   111	    """Hash each named evidence file (relative to `folder`). `files` maps a label
   112	    (e.g. "events.jsonl") to a folder-relative path. A missing file hashes to the
   113	    sentinel "MISSING" so the manifest still records its absence (which the tamper
   114	    check and harness-validity oracle both treat as evidence-incomplete)."""
   115	    base = Path(folder)
   116	    out: dict[str, str] = {}
   117	    for label, rel in files.items():
   118	        p = base / rel
   119	        out[label] = sha256_file(p) if p.is_file() else "MISSING"
   120	    return out
   121	
   122	
   123	def write_manifest(folder: str | Path, manifest: EvidenceManifest) -> Path:
   124	    base = Path(folder)
   125	    base.mkdir(parents=True, exist_ok=True)
   126	    path = base / MANIFEST_NAME
   127	    path.write_text(json.dumps(manifest.to_dict(), indent=2, sort_keys=True), encoding="utf-8")
   128	    return path
   129	
   130	
   131	def load_manifest(folder: str | Path) -> EvidenceManifest:
   132	    base = Path(folder)
   133	    raw = json.loads((base / MANIFEST_NAME).read_text(encoding="utf-8"))
   134	    return EvidenceManifest.from_dict(raw)
   135	
   136	
   137	@dataclass(frozen=True)
   138	class IntegrityResult:
   139	    intact: bool
   140	    mismatches: dict[str, dict[str, str]] = field(default_factory=dict)
   141	
   142	    def __bool__(self) -> bool:  # truthy == intact
   143	        return self.intact
   144	
   145	
   146	def verify_evidence_unchanged(
   147	    folder: str | Path, manifest: EvidenceManifest
   148	) -> IntegrityResult:
   149	    """Re-hash the manifest's evidence files and compare to the frozen hashes.
   150	
   151	    Returns intact=False (with the per-file expected/actual) when ANY hashed file
   152	    changed, went missing, or newly appeared — that is the §6 INVALID_RUN trigger.
   153	    A manifest that recorded a hash for a label whose `evidence_files` path is now
   154	    absent is a mismatch; a label hashed "MISSING" that is still missing is intact
   155	    (the absence itself was frozen)."""
   156	    base = Path(folder)
   157	    mismatches: dict[str, dict[str, str]] = {}
   158	    for label, expected in manifest.evidence_hashes.items():
   159	        rel = manifest.evidence_files.get(label, label)
   160	        p = base / rel
   161	        actual = sha256_file(p) if p.is_file() else "MISSING"
   162	        if actual != expected:
   163	            mismatches[label] = {"expected": expected, "actual": actual}
   164	    return IntegrityResult(intact=not mismatches, mismatches=mismatches)

