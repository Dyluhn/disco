    27	    KIND_ACTION,
    28	    KIND_AGENT_ERROR,
    29	    KIND_OBSERVATION,
    30	    KIND_PLAN,
    31	    awaiting_approval_seqs,
    32	    has_action,
    33	    has_plan,
    34	    has_user_message,
    35	    is_autonomous,
    36	    kind_of,
    37	    plan_approved_seqs,
    38	    seq_of,
    39	    terminal_status,
    40	    tool_name_of,
    41	)
