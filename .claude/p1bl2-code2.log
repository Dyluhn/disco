     1	"""HARN-2 — the browser product-harness oracles.
     2	
     3	These eight zero-opinion oracles judge the REAL product path (not just that the
     4	engine wrote files) over the browser evidence HARN-1b captures into a single
     5	``product_evidence`` dict. Each oracle reads its own slice; when the slice is absent
     6	(a headless run, or HARN-1b not yet wired) it SKIPS — so these never affect headless
     7	classification until a product-harness run supplies the evidence.
     8	
     9	product_evidence (the HARN-1b dossier, all keys optional):
    10	    {
    11	      "browser_ws":   {"connections": int, "closes": [{"code": int, "reason": str}]},
    12	      "lifecycle":    {"statuses": ["RUNNING", ...], "terminal": "FINISHED"|...},
    13	      "sidecar":      {"stopped_at_terminal": bool, "provider_calls_after_terminal": int},
    14	      "preview":      {"owner": "platform"|"model", "manual_port": bool,
    15	                       "shown_to_user": bool, "url": str},
    16	      "shown":        {"artifact_shown": bool, "preview_shown": bool},
    17	      "verification": {"ready_for_verification_called": bool, "passed": bool},
    18	      "export":       {"requested": bool, "download_present": bool, "download_bytes": int},
    19	      "cleanup":      {"orphans": int, "workspace_released": bool},
    20	    }
    21	"""
    22	
    23	from __future__ import annotations
    24	
    25	from typing import Any
    26	
    27	from .. import failure_codes as fc
    28	from .schema import OracleResult, failing, passing, skipping
    29	
    30	_TERMINAL_OK = frozenset({"FINISHED", "VERIFIED"})
    31	
    32	
    33	def _slice(product_evidence: dict[str, Any] | None, key: str) -> dict[str, Any] | None:
    34	    if not product_evidence:
    35	        return None
    36	    val = product_evidence.get(key)
    37	    return val if isinstance(val, dict) else None
    38	
    39	
    40	def _int(v: Any) -> int | None:
    41	    """Safe int coercion: returns None for a missing/non-numeric/bool value so a
    42	    malformed count can be handled fail-closed instead of crashing classification."""
    43	    if isinstance(v, bool) or v is None:
    44	        return None
    45	    try:
    46	        return int(v)
    47	    except (TypeError, ValueError):
    48	        return None
    49	
    50	
    51	class BrowserWSOracle:
    52	    """The real browser opened (and kept) a build WebSocket — the 'silently dropped'
    53	    bug class where the UI never connects yet the engine runs blind."""
    54	
    55	    _NAME = "browser_ws"
    56	
    57	    def check(self, *, product_evidence: dict[str, Any] | None = None) -> list[OracleResult]:
    58	        ws = _slice(product_evidence, "browser_ws")
    59	        if ws is None:
    60	            return [skipping(self._NAME, reason="no browser_ws evidence (headless run)")]
    61	        conns = _int(ws.get("connections"))
    62	        if conns is None or conns <= 0:  # missing/malformed/zero → fail-closed
    63	            return [
    64	                failing(
    65	                    self._NAME,
    66	                    fc.BROWSER_WS_NOT_CONNECTED,
    67	                    first_broken_link="build -> browser_ws_connected",
    68	                    facts={"connections": ws.get("connections")},
    69	                )
    70	            ]
    71	        return [passing(self._NAME, facts={"connections": conns})]
