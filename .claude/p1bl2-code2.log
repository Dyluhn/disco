     1	"""Assemble a classifiable run-folder dossier from CAPTURED product-harness data (P1B-LIVE-2).
     2	
     3	`write_dossier` serializes ONLY what the live run captured — the assembled product_evidence
     4	dict, the provider-call ledger, the build event log, and any raw artifacts — into a run
     5	folder, locked with an EvidenceManifest (hashes) so the classifier loads it via the existing
     6	evidence lock. It PREFLIGHTS the product_evidence against the schema BEFORE writing anything,
     7	so a malformed capture never produces a partial/untrusted dossier, and it rejects unsafe
     8	artifact paths. No fabricated defaults — an un-captured slice is simply absent (its oracle SKIPs).
     9	"""
    10	
    11	from __future__ import annotations
    12	
    13	import json
    14	from pathlib import Path
    15	from typing import Any
    16	
    17	from harness.build_soak.evidence import EvidenceManifest, compute_evidence_hashes, write_manifest
    18	from harness.build_soak.product_evidence import (
    19	    PRODUCT_EVIDENCE_NAME,
    20	    PROVIDER_LEDGER_NAME,
    21	    validate_product_evidence,
    22	    write_product_evidence,
    23	    write_provider_ledger,
    24	)
    25	
    26	_EVENTS_NAME = "events.jsonl"
    27	
    28	
    29	def _safe_rel(rel: str) -> str:
    30	    """Reject an absolute path or one that escapes the run folder (no clobber outside)."""
    31	    p = Path(rel)
    32	    if p.is_absolute() or ".." in p.parts:
    33	        raise ValueError(f"unsafe artifact path: {rel!r}")
    34	    return rel
    35	
    36	
    37	def write_dossier(
    38	    run_dir: str | Path,
    39	    *,
    40	    product_evidence: dict[str, Any],
    41	    provider_records: list[dict[str, Any]],
    42	    events: list[dict[str, Any]],
    43	    artifacts: dict[str, str] | None = None,
    44	    run_id: str = "",
    45	    scenario_id: str = "",
    46	) -> Path:
    47	    """Write the dossier into ``run_dir`` and return it. Raises ValueError on malformed
    48	    product_evidence (preflight, before any write) or an unsafe artifact path."""
    49	    # PREFLIGHT — validate before touching the filesystem (no partial untrusted dossier).
    50	    problems = validate_product_evidence(product_evidence)
    51	    if problems:
    52	        raise ValueError(f"product_evidence failed schema validation: {problems}")
    53	    artifacts = artifacts or {}
    54	    for rel in artifacts:
    55	        _safe_rel(rel)
    56	
    57	    base = Path(run_dir)
    58	    base.mkdir(parents=True, exist_ok=True)
    59	    (base / _EVENTS_NAME).write_text(
    60	        "".join(json.dumps(e, sort_keys=True) + "\n" for e in events), encoding="utf-8"
    61	    )
    62	    write_product_evidence(base, product_evidence, strict=True)
    63	    write_provider_ledger(base, provider_records)
    64	    for rel, content in artifacts.items():
    65	        out = base / rel
    66	        out.parent.mkdir(parents=True, exist_ok=True)
    67	        out.write_text(content, encoding="utf-8")
    68	
    69	    # Lock the dossier: a manifest over every evidence file + its hash.
    70	    evidence_files: dict[str, str] = {
    71	        "events": _EVENTS_NAME,
    72	        "product_evidence": PRODUCT_EVIDENCE_NAME,
    73	        "provider_ledger": PROVIDER_LEDGER_NAME,
    74	        **{rel: rel for rel in artifacts},
    75	    }
    76	    manifest = EvidenceManifest(
    77	        run_id=run_id,
    78	        scenario_id=scenario_id,
    79	        mode="ui",
    80	        kernel="disco",
    81	        evidence_files=evidence_files,
    82	        evidence_hashes=compute_evidence_hashes(base, evidence_files),
    83	    )
    84	    write_manifest(base, manifest)
    85	    return base

