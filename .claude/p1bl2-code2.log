   214	
   215	def classify_run_folder(
   216	    folder: str | Path, *, scenario: dict[str, Any] | None = None
   217	) -> dict[str, Any]:
   218	    """Classify a frozen run folder: load the manifest, verify evidence integrity
   219	    (a mismatch -> INVALID_RUN), read the event log, classify, and write
   220	    classification.json into the folder. Returns the classification dict."""
   221	    base = Path(folder)
   222	    manifest: EvidenceManifest | None = None
   223	    evidence_intact = True
   224	    try:
   225	        manifest = load_manifest(base)
   226	        integrity = verify_evidence_unchanged(base, manifest)
   227	        evidence_intact = integrity.intact
   228	    except (FileNotFoundError, ValueError, json.JSONDecodeError):
   229	        manifest = None
   230	
   231	    events_raw: list[Any] = []
   232	    events_rel = (manifest.evidence_files.get("events") if manifest else None) or "events.jsonl"
   233	    events_path = base / events_rel
   234	    if not events_path.is_file():
   235	        # try the conventional conversation-scoped path
   236	        for candidate in base.rglob("events.jsonl"):
   237	            events_path = candidate
   238	            break
   239	    if events_path.is_file():
   240	        events_raw = _read_jsonl(events_path)
   241	
   242	    # HARN-1a: the provider-call ledger (MiniMax-only / no-OpenRouter enforcement).
   243	    # Read it if present anywhere in the run folder; absent → the oracle SKIPs (or
   244	    # fails closed if the scenario requires it). A malformed line is NOT silently
   245	    # dropped (that would under-report a forbidden call) nor crashes classification —
   246	    # it becomes a hostless record the ProviderLedgerOracle fails on as an evidence gap.
   247	    provider_ledger: list[dict[str, Any]] | None = None
   248	    ledger_path = base / "provider-call-ledger.jsonl"
   249	    if not ledger_path.is_file():
   250	        ledger_path = next(iter(base.rglob("provider-call-ledger.jsonl")), ledger_path)
   251	    if ledger_path.is_file():
   252	        provider_ledger = _read_ledger(ledger_path)
   253	
   254	    # HARN-2: the browser product-harness evidence dossier (a single JSON object).
   255	    # Absent → the browser oracles SKIP (headless run unaffected).
   256	    product_evidence: dict[str, Any] | None = None
   257	    pe_path = base / "product-evidence.json"
   258	    if not pe_path.is_file():
   259	        pe_path = next(iter(base.rglob("product-evidence.json")), pe_path)
   260	    if pe_path.is_file():
   261	        try:
   262	            loaded = json.loads(pe_path.read_text(encoding="utf-8"))
   263	            product_evidence = loaded if isinstance(loaded, dict) else None
   264	        except (json.JSONDecodeError, ValueError):
   265	            product_evidence = None
   266	
   267	    classification = classify(
   268	        events_raw,
   269	        scenario=scenario,
   270	        run_id=manifest.run_id if manifest else base.name,
   271	        commit=manifest.repo_commit if manifest else "",
   272	        seed=manifest.seed if manifest else None,
   273	        evidence_intact=evidence_intact,
   274	        autonomous=manifest.autonomous if manifest else None,
   275	        provider_ledger=provider_ledger,
   276	        product_evidence=product_evidence,
   277	    )
   278	    (base / CLASSIFICATION_NAME).write_text(
   279	        json.dumps(classification, indent=2, sort_keys=True), encoding="utf-8"
   280	    )
   281	    return classification
   282	
   283	
   284	def _read_jsonl(path: str | Path) -> list[Any]:
   285	    out: list[Any] = []
   286	    for line in Path(path).read_text(encoding="utf-8").splitlines():
   287	        line = line.strip()
   288	        if line:
   289	            out.append(json.loads(line))
   290	    return out
   291	
   292	
   293	def _read_ledger(path: str | Path) -> list[dict[str, Any]]:
   294	    """Tolerant provider-call-ledger reader: never crashes on a malformed line and
   295	    never silently drops one. A non-JSON / non-dict line becomes a hostless
   296	    ``{"__malformed__": ...}`` record so the ProviderLedgerOracle surfaces it as an
   297	    evidence gap (rather than under-reporting a possibly-forbidden call)."""
   298	    out: list[dict[str, Any]] = []
   299	    for line in Path(path).read_text(encoding="utf-8").splitlines():
   300	        line = line.strip()
   301	        if not line:
   302	            continue
   303	        try:
   304	            obj = json.loads(line)
   305	        except (json.JSONDecodeError, ValueError):
   306	            out.append({"__malformed__": line[:160]})
   307	            continue
   308	        out.append(obj if isinstance(obj, dict) else {"__malformed__": str(obj)[:160]})
   309	    return out
   310	
   311	
   312	# ---- §17 no-fluke replay policy (pure function) -----------------------------
   313	
   314	
   315	def intermittent_classification(
   316	    original: dict[str, Any],
   317	    *,
   318	    replay_status: str,
   319	    replay_code: str | None = None,
   320	    replay_run_id: str | None = None,
   321	) -> dict[str, Any]:
   322	    """Apply the no-fluke replay policy (§17) to an originally-FAILED run.
   323	
   324	    A failed run that PASSES on exact replay is NOT a pass — it is an intermittent
   325	    failure: status stays FAIL, code becomes INTERMITTENT_<original_code> with the
   326	    SAME severity. A replay that fails the same way is a deterministic failure
   327	    (unchanged). The word "fluke" never yields PASS.
   328	
   329	    Returns a NEW classification dict; the input is not mutated."""
   330	    if original.get("status") != fc.FAIL:
   331	        raise ValueError("no-fluke policy only applies to an originally-FAILED run")
   332	    original_code = str(original.get("code"))
   333	    updated = dict(original)
   334	
   335	    if replay_status == fc.PASS:
   336	        intermittent_code = fc.INTERMITTENT_PREFIX + original_code
   337	        updated["status"] = fc.FAIL
   338	        updated["code"] = intermittent_code
   339	        updated["severity"] = fc.severity_for(intermittent_code)
   340	        updated["replay"] = {
   341	            "attempted": True,
   342	            "result": "passed",
   343	            "run_id": replay_run_id,
   344	        }
   345	        return updated
   346	
   347	    if replay_status == fc.FAIL and replay_code == original_code:
   348	        updated["replay"] = {"attempted": True, "result": "same_failure", "run_id": replay_run_id}
   349	        return updated
   350	
   351	    if replay_status == fc.FAIL:
   352	        updated["replay"] = {
   353	            "attempted": True,
   354	            "result": "different_failure",
   355	            "run_id": replay_run_id,
   356	        }
   357	        return updated
   358	
   359	    # INVALID_RUN / INFRA_FAILURE on replay: cannot prove a pass; keep the failure
   360	    # and record the inconclusive replay.
   361	    updated["replay"] = {"attempted": True, "result": "not_attempted", "run_id": replay_run_id}
   362	    return updated

