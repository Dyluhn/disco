    62	def _missing(reason: str, facts: dict[str, Any]) -> dict[str, Any]:
    63	    return {
    64	        "status": fc.INVALID_RUN,
    65	        "severity": fc.NONE,
    66	        "code": fc.MISSING_REQUIRED_EVIDENCE,
    67	        "first_broken_link": "product_harness -> required_evidence",
    68	        "facts": {"reason": reason, **facts},
    69	    }
    70	
    71	
    72	def classify_dossier(run_dir: str | Path, scenario: ProductScenario) -> dict[str, Any]:
    73	    """Enforce product-harness completeness, then classify. A required slice (or, when
    74	    requires_export, export.requested) absent from product-evidence.json → INVALID_RUN, never
    75	    a PASS via oracle SKIP."""
