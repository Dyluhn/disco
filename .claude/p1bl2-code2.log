    72	                    fc.NO_USER_EVENT_AFTER_SUBMIT,
    73	                    first_broken_link="submit -> user_event",
    74	                    facts={"user_event_present": False},
    75	                )
    76	            ]
    77	
    78	        # 2. user event -> plan event (only when the scenario requires the gate)
    79	        if _wants_plan_gate(scenario) and not has_plan(events):
