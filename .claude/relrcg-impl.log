    assert not res.success and res.error == "SAFE_WRITE_SHRINK_REJECTED"
    assert (await inst.read_file("big.txt")) == body  # untouched
    await inst.destroy()


async def test_shrink_with_allow_shrink_applies():
    ctx, inst = await _ctx()
