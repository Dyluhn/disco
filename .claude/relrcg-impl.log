+        capabilities={Capability.FILESYSTEM},
+        owner_id="local",
+        conversation_id=conv_id,
+        assist=False,
+    )
+
+
+@pytest.fixture(autouse=True)
+def _clear_tracker():
+    reset_read_tracker()
+    yield
+    reset_read_tracker()
+
+
+_FILLER = "\n".join(
+    f"<p>row {i}: lorem ipsum dolor sit amet consectetur adipiscing</p>" for i in range(1, 41)
+)
+BIG = (
+    "<html><body>\n"
