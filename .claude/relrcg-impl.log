+        return outcome
+    fresh_content, delivered = _line_refusal_read(
+        conv_id, path, current_bytes=current_bytes, sha=sha, attempted_lines=attempted_lines
+    )
+    structured = dict(outcome.structured or {})
+    structured["delivered_read"] = delivered
