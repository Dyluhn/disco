+        "sha256": sha,
+        "full": full,
+        "ranges": [(start, end)],
+        "total_lines": total,
+    }
+    return header + numbered, delivered
+
+
+def _with_line_refusal_read(
+    outcome: ToolOutcome,
+    conv_id: str,
+    path: str,
+    *,
+    current_bytes: bytes,
+    sha: str,
+    attempted_lines: tuple[int, int] | None,
+    line_refusal_read: bool,
+) -> ToolOutcome:
