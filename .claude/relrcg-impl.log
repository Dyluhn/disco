                    success=False,
                    error="EXACT_REPLACE_DUPLICATE_MATCH",
                    content=(
                        f"exact_replace: old_string occurs {len(occ)}× in {args.path} — make it unique or "
                        f"set multi=true to replace all: {e.old_string[:60]!r}."
                    ),
                )
            targets = occ if args.multi else occ[:1]
