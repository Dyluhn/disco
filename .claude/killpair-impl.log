+    action = await store.append(CID, _action())
+    rt = _runtime(store)
+    rt._run_generation[CID] = 1
+
+    await rt.kill(CID)
+    await rt.kill(CID)
+
+    events = await store.get_events(CID)
+    assert len(_cancelled_errors(events, action.id)) == 1
+
+
