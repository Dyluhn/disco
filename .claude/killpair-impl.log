# The `core` package — "the brain": no server, no UI, importable library
# (basis-of-design.md §5). Phase 0 implements only the Event & State spine
# defined by event-state-contract.md; later subsystems (loop, memory condenser,
# LLM router, security) land here in subsequent phases.
[project]
name = "disco-core"
version = "0.1.0"
description = "Event & State spine + agent core for the disco platform."
requires-python = ">=3.12"
dependencies = [
    "pydantic>=2.7",
    "httpx>=0.27",
    "cryptography>=42",  # Fernet for encrypting stored secrets at rest (OpenRouter key)
]

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

# src-layout PEP 420 namespace package: `disco` is a shared namespace
# (no __init__.py) so sibling packages — disco.tools, .agent_server,
# .app_server — can join it later without a rename. Point the wheel at the
# namespace dir and hatch packages everything beneath it.
[tool.hatch.build.targets.wheel]
packages = ["src/disco"]
# WPP-1: ship the bundled workflow prompt packs (markdown) in the wheel so the
# PromptPackRegistry can load them from an installed package, not just from src.
artifacts = ["src/disco/core/workflows/prompt_packs/*.md"]

