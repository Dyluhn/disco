def host_verify_canary_enabled() -> bool:
    """True iff DISCO_HOST_VERIFY_CANARY is truthy (default OFF)."""
    return str(disco_env(_HOST_VERIFY_CANARY_FLAG) or "").strip().lower() in _TRUTHY


