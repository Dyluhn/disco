 succeeded in 0ms:
# The `agent-server` package — per-conversation runtime (BoD §5). In Phase 0 it
# exposes the §7 wire layer (WebSocket event/state streaming + reconnect/replay)
# and the §7.5 REST surface over the core EventStore. No agent loop yet.
[project]
name = "disco-agent-server"
version = "0.1.0"
description = "Per-conversation runtime: WebSocket + REST over the core event log."
requires-python = ">=3.12"
dependencies = [
    "disco-core",
    "disco-retrieval",
    "disco-tools",  # the Build surface composes the agent toolset + sandbox here
    "fastapi>=0.110",
    "python-multipart>=0.0.12",
    "uvicorn[standard]>=0.30",  # [standard] pulls the websockets impl the WS routes need
    "websockets>=12.0",
    "cronsim>=2.6",
    "weasyprint>=63.0",  # RP-07: PDF export (md → HTML → WeasyPrint)
    "markdown>=3.5",  # RP-07: faithful md → HTML for the PDF path (tables/lists/etc.)
    # RP-09 in-process Kokoro TTS — BUNDLED tier, a default product surface, so it ships
    # in CORE deps and a bare standard `uv sync` always installs it (no `--extra tts`
    # needed). Rides the onnxruntime already pulled by fastembed (deliberately NOT torch).
    # Weights download on first use. BYO/self-host/paid TTS tiers stay opt-in elsewhere.
    "kokoro-onnx>=0.4",
    "lameenc>=1.7",
    "numpy>=1.26",
]

[project.scripts]
# `disco verify` — verify a self-hoster's configured model actually drives the loop.
# Installed into the venv, so it runs in the compose image as `disco-verify` (or
# `python -m disco.agent_server.verify`).
disco-verify = "disco.agent_server.verify:main"
pmx-verify = "disco.agent_server.verify:main"  # deprecated alias — use disco-verify

