+    action = await store.append(CID, _action())
+    await store.append(
+        CID,
+        ObservationEvent(
+            tool_result=ToolResult(
+                call_id=action.tool_call.call_id,
+                tool_name=action.tool_call.tool_name,
+                success=True,
+                content="done",
+            ),
+            action_id=action.id,
+        ),
+    )
+    rt = _runtime(store)
