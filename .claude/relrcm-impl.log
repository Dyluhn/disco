+def _no_op_write_refusal(
+    conv_id: str,
+    path: str,
+    *,
+    tool_name: str,
+    current_bytes: bytes,
+) -> ToolOutcome:
+    """REL-RC-M: byte-identical whole-file writes are refused, not "successful" no-ops."""
+    import hashlib
+
+    count = _increment_no_op_edit_count(conv_id, path)
