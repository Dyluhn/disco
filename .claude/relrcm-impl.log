        # (4) syntax pre-check IN MEMORY — never introduce a new syntax error (no write-then-revert).
        pre = _syntax_errors(args.path, old_text or "")
        introduced = [e for e in _syntax_errors(args.path, args.content) if e not in pre]
        if introduced:
