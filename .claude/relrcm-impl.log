/bin/bash -lc ".venv/bin/python3 - <<'PY'
import asyncio
from disco.tools.anatomy import Capability, ToolContext
from disco.tools.builtin import FileReadTool
from disco.tools.sandbox.base import SandboxSpec
from disco.tools.sandbox.process import ProcessSandboxService

async def step(name, coro, timeout=5):
    print('start', name, flush=True)
    result = await asyncio.wait_for(coro, timeout=timeout)
    print('done', name, flush=True)
    return result

async def main():
    svc = ProcessSandboxService()
    inst = await step('create', svc.create(SandboxSpec(), owner_id='local', conversation_id='c'))
    ctx = ToolContext(sandbox=inst, workspace_path='.', timeout_s=30, capabilities={Capability.FILESYSTEM}, owner_id='local', conversation_id='c')
    body = '\\n'.join(f'line{i}' for i in range(1, 21))
    await step('write', inst.write_file('big.txt', body.encode()))
    out = await step('read', FileReadTool().run(FileReadTool().definition.args_model(path='big.txt', offset=5, limit=3), ctx))
    print(out.success, out.content[:80], flush=True)
    await step('destroy', inst.destroy())

asyncio.run(main())
