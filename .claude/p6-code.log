    14	from pydantic import BaseModel, ConfigDict, field_validator, model_validator
    15	
    16	# Host finalizers are the ready_for_*_verification family (§3.2). Pinning the shape
    17	# keeps minimal()/manual contracts from naming a finalizer the platform can't route.
    18	_FINALIZER_RE = re.compile(r"^ready_for_[a-z0-9_]+_verification$")
    19	
    20	# P5: the host-owned delivery SHAPE. A DeliverableEvent is either an "app" (a runnable
    21	# result the user opens in the live preview) or "files" (workspace artifacts to download/
    22	# inspect). A contract's kind fixes which shape its handoff must take — so a deck/document
    23	# can't be handed off as a runnable app, and an appkit/site/prototype isn't dumped as raw
    24	# files. Kinds NOT in the app set deliver as files (custom defaults to the safer "files").
    25	DeliveryMode = Literal["app", "files"]
