   189	
   190	# ---- Bug 6: actionless honest-unverifiable-static finish helpers ------------
   191	# The existing honest-unverifiable finish (`_maybe_honest_unverifiable_static_finish`)
   192	# only fires at the FINISH GATE. When the plan's verify step is unsatisfiable on a
   193	# browserless backend the model never reaches that gate — it churns and the actionless
   194	# valve PAUSES it. These pure helpers feed the SAME honest-finish concept at the
   195	# actionless valve (RCA option 3a), under conservative guards so a missing/broken
   196	# deliverable or a genuine web failure never converts to a success (W-45 preserved).
   197	
   198	# Tools that mutate the static deliverable on disk (mirror of `_is_web_deliverable`).
   199	_FILE_WRITE_TOOLS = frozenset(
   200	    {"file_write", "file_edit", "file_append", "file_replace_lines", "file_insert_lines"}
   201	)
   202	# Shell tools that can run a non-browser (HTMLParser/static-parse) validation.
   203	_SHELL_TOOLS = frozenset({"shell", "shell_exec"})
   204	# Verify-only step classification — STRUCTURAL, not a word list. The recurring
   205	# false-positive class is a verification WORD appearing as a CONTENT noun: test→
   206	# testimonials, render→product renders, validation→input validation, lint→lint config,
   207	# check→checkout. Whack-a-moling individual words never converges, so a step is
   208	# "verify-only" iff BOTH hold:
   209	#   (A) it has a verification-ACTION framing (a verify verb acting on the deliverable,
   210	#       or a clear verification-outcome phrase) — `_VERIFY_ACTION_RE`; AND
   211	#   (B) it has NO creation/content verb at all — `_CONTENT_VERB_RE` is a hard NEGATIVE
   212	#       OVERRIDE: a step that adds/creates/builds/sets-up/etc. is content work, never
   213	#       verification, even when it also contains a verify-ish word ("Add input
   214	#       validation", "Set up linting").
   215	# Bare nouns alone (`validation`, `lint`, `render`, `test`, `check`) never match — only
   216	# the action framing in (A) does. When in doubt → NON-verify (stay paused, the safe
   217	# choice that can never false-finish real work).
   218	_CONTENT_VERB_RE = re.compile(
   219	    r"\b(?:add(?:s|ed|ing)?|create(?:s|d)?|creating|build(?:s|ing)?|built"
   220	    r"|implement(?:s|ed|ing)?|writ(?:e|es|ing)|wrote|design(?:s|ed|ing)?"
   221	    r"|styl(?:e|es|ed|ing)|mak(?:e|es|ing)|made|configure(?:s|d)?|configuring|config"
   222	    r"|install(?:s|ed|ing)?|includ(?:e|es|ed|ing)|insert(?:s|ed|ing)?"
   223	    r"|append(?:s|ed|ing)?|generat(?:e|es|ed|ing)|develop(?:s|ed|ing)?"
   224	    r"|scaffold(?:s|ed|ing)?|integrat(?:e|es|ed|ing)|updat(?:e|es|ed|ing)"
   225	    r"|fix(?:es|ed|ing)?|refactor(?:s|ed|ing)?|polish(?:es|ed|ing)?"
   226	    r"|setup|set[\s-]?up|wire[\s-]?up)\b",
   227	    re.IGNORECASE,
   228	)
   229	_VERIFY_ACTION_RE = re.compile(
   230	    # (A1) a verification VERB (precise stems — `check(?:s|ed|ing)?` won't match
   231	    # "checkout"/"checkbox"; `test(?:s|ed|ing)?` won't match "testimonials") followed
   232	    # by a verification TARGET ("that/the/it/…") — "Verify the page", "Check that
   233	    # links work", "Validate the HTML", "Ensure it renders".
   234	    r"\b(?:verif(?:y|ies|ied|ying)|validat(?:e|es|ed|ing)|check(?:s|ed|ing)?"
   235	    r"|confirm(?:s|ed|ing)?|ensure(?:s|d)?|ensuring|test(?:s|ed|ing)?"
   236	    r"|review(?:s|ed|ing)?|inspect(?:s|ed|ing)?)\s+"
   237	    r"(?:that|the|it|its|all|each|every|whether|if|for|no|cross)\b"
   238	    # (A2) recognized standalone verification tokens/actions.
   239	    r"|\bqa\b"
   240	    r"|\bsmoke[\s-]?tests?\b"
   241	    r"|\brun(?:s|ning)? (?:the |a )?(?:linter|lint|tests?|test suite|checks?)\b"
   242	    # (A3) verification-OUTCOME phrases (a state asserted, not content created).
   243	    r"|\b(?:renders?|displays?) (?:correctly|properly|as expected|fine|cleanly|well)\b"
   244	    r"|\b(?:the )?(?:page|site|app|layout|content|everything|it) (?:renders?|displays?)\b"
   245	    r"|\btests? pass(?:es|ed)?\b"
   246	    r"|\blint(?:er)? pass(?:es|ed)?\b"
   247	    r"|\bno console errors?\b",
   248	    re.IGNORECASE,
   249	)
   250	# A shell command counts as a REAL non-browser CONTENT/STRUCTURE validation only when
   251	# it STRUCTURALLY invokes a markup parser/validator (the parser is the EXECUTABLE/module
   252	# actually run) or a content grep that reads index.html — NOT merely because a word like
   253	# "validate"/"markup" appears in the text (`echo validate index.html` must NOT count —
   254	# the codex catch), and never a bare existence/dump (`ls`/`test -f`/`stat`/`cat`/`wc`).
   255	# Commands whose first token is a no-op/echo are excluded outright; see
   256	# `_is_real_validation_command`.
   257	# First token = a dedicated markup validator/linter invoked directly.
   258	_VALIDATOR_EXECUTABLES = frozenset(
   259	    {"xmllint", "tidy", "html5validator", "html5check", "vnu", "htmlhint", "htmllint"}
   260	)
   260	)
   261	# First token = a content-search tool (a grep/assertion that actually reads the file).
   262	_GREP_EXECUTABLES = frozenset({"grep", "egrep", "fgrep", "rg", "ripgrep", "ag"})
   263	# First token = a python interpreter (only a real parser-module invocation counts).
   264	_PYTHON_EXECUTABLES = frozenset({"python", "python3", "py", "python2"})
   265	# First token = an explicit no-op / text-echo / existence-or-dump → NEVER a validation.
   266	_NONVALIDATION_EXECUTABLES = frozenset(
   267	    {"echo", "printf", ":", "true", "false", "cat", "ls", "stat", "test", "[", "[[",
   268	     "wc", "file", "head", "tail", "touch", "cp", "mv", "rm", "dd", "tee"}
   269	)
   270	# A python -c/-m body that actually IMPORTS/USES an HTML/XML parser or markup validator.
   271	_PYTHON_PARSER_RE = re.compile(
   272	    r"htmlparser|html\.parser|html5lib|html5validator|\blxml\b|beautifulsoup|\bbs4\b"
   273	    r"|xml\.etree|elementtree|\betree\b|xmllint|markupsafe",
   274	    re.IGNORECASE,
   275	)
   276	
   277	
   278	def _is_real_validation_command(cmd: str) -> bool:
   279	    """True iff `cmd` STRUCTURALLY runs a content/structure validation against
   280	    index.html — the invoked tool is a markup parser/validator (or a grep that reads
   281	    the file), not a word echoed in text. Rejects `echo validate index.html`,
   282	    `printf "markup" index.html`, no-ops, and bare existence/dump commands."""
   283	    cmd = cmd.strip()
   284	    if "index.html" not in cmd:
   285	        return False
   286	    tokens = cmd.split()
   287	    if not tokens:
   288	        return False
   289	    first = tokens[0].rsplit("/", 1)[-1]  # strip any leading path
   290	    if first.startswith("#") or first in _NONVALIDATION_EXECUTABLES:
   291	        return False
   292	    if first in _VALIDATOR_EXECUTABLES or first in _GREP_EXECUTABLES:
   293	        return True
   294	    if first in _PYTHON_EXECUTABLES:
   295	        # Must be a -c/-m invocation (actually executing code) AND name a real parser
   296	        # module — `python -c "print('validate')"` must NOT pass.
   297	        ran_code = bool(re.search(r"(?:^|\s)-[cm]\b", cmd))
   298	        return ran_code and bool(_PYTHON_PARSER_RE.search(cmd))
   299	    return False
   300	
   301	
   302	def _shell_command_text(action: ActionEvent) -> str:
   303	    """The command string a shell action ran — preferring the canonical command arg
   304	    (so the first-token executable analysis is reliable), else the joined values."""
   305	    args = action.tool_call.arguments or {}
   306	    for key in ("command", "cmd", "script", "code"):
   307	        v = args.get(key)
   308	        if isinstance(v, str) and v.strip():
   309	            return v
   310	    return " ".join(str(v) for v in args.values())
   311	# Distinctive substring of `browser.BROWSER_UNAVAILABLE_MSG` (kept inline rather than
   312	# imported — core must not depend on the tools package). Matched against the error/
   313	# content text a failed `browser` action leaves in the log.
   314	_BROWSER_UNAVAILABLE_TEXT = "browser verification is unavailable"
   315	
   316	
   317	def _missing_steps_all_verify(events: list[Event]) -> bool:
   318	    """Bug 6 — True iff a plan exists, is INCOMPLETE, and EVERY not-done
   319	    (missing/active) step is a verification-only step. A step qualifies iff it has a
   320	    verification-ACTION framing (`_VERIFY_ACTION_RE`) AND has NO creation/content verb
   321	    (`_CONTENT_VERB_RE`, a hard negative override). So "Verify the page renders
   322	    correctly" qualifies, while "Add input validation", "Set up linting", "Create
   323	    product renders", "Add a testimonials section" do NOT (content verb present) and a
   324	    bare noun like "validation"/"lint" does NOT (no action framing). Conservative: any
   325	    not-done step that isn't UNAMBIGUOUS verification → False (real work remains, so the
   326	    actionless valve must PAUSE, never honest-finish). Returns False when the plan is
   327	    complete (no missing steps — the `completed_via_notify` branch owns that)."""
   328	    plan, states = effective_plan_progress(events)
   329	    if plan is None or not plan.steps:
   330	        return False
   331	    missing = [i for i in range(len(plan.steps)) if states.get(i + 1) != "done"]
   332	    if not missing:
   333	        return False  # complete → not this path
   334	    for i in missing:
   335	        step = plan.steps[i]
   336	        text = f"{step.title} {step.detail or ''}"
   337	        if _CONTENT_VERB_RE.search(text):
   338	            return False  # creation/content work → never verify-only (negative override)
   339	        if not _VERIFY_ACTION_RE.search(text):
   340	            return False  # no verification-action framing → not verify-only
   341	    return True
   342	
   343	
   344	def _last_edit_seq(events: list[Event]) -> int:
   345	    """Seq of the last FILE write/edit action (a deliverable mutation), else 0.
   346	    The non-browser validation must have RUN AFTER this for its pass to count."""
   347	    for ev in reversed(events):
   348	        if isinstance(ev, ActionEvent) and ev.tool_call.tool_name in _FILE_WRITE_TOOLS:
   349	            return ev.seq or 0
   350	    return 0
   351	
   352	
   353	def _nonbrowser_static_validation_passed(events: list[Event]) -> bool:
   354	    """Bug 6 — True iff, AFTER the last file write/edit, a NON-browser shell
   355	    validation that GENUINELY inspects the static deliverable's CONTENT/STRUCTURE
   356	    (an HTML/XML parser, a markup/structure check, or a content grep on
   357	    `index.html`) RAN and SUCCEEDED, with no later FAILED such validation. This is
   358	    the positive evidence the delivered file is well-formed when the browser is
   359	    unavailable. A bare existence/dump (`ls`/`test -f`/`stat`/`cat`/`wc`) or a mere
   360	    echo of the word "validate"/"markup" does NOT count — only a STRUCTURAL parser/
   361	    validator invocation does (`_is_real_validation_command`, the codex catch). A
   362	    FAILED validation yields False so a broken parse BLOCKS the honest finish; no
   363	    qualifying validation at all → False (we require a passing one)."""
   364	    edit_seq = _last_edit_seq(events)
   365	    # action_id -> the shell action is a REAL content validation against index.html.
   366	    validation_actions: set[str] = set()
   367	    verdict: bool | None = None
   368	    for ev in events:
   369	        if isinstance(ev, ActionEvent) and ev.tool_call.tool_name in _SHELL_TOOLS:
   370	            if _is_real_validation_command(_shell_command_text(ev)):
   371	                validation_actions.add(ev.id)
   372	        elif isinstance(ev, ObservationEvent):
   373	            if (ev.seq or 0) > edit_seq and ev.action_id in validation_actions:
   374	                verdict = bool(ev.tool_result.success)
   375	        elif isinstance(ev, AgentErrorEvent):
   376	            if (ev.seq or 0) > edit_seq and ev.action_id in validation_actions:
   377	                verdict = False
   378	    return verdict is True
   379	
   380	
   381	def _browser_unavailable_observed(events: list[Event]) -> bool:
   382	    """Bug 6 — True iff a `browser` action left an 'unavailable on this backend'
   383	    signal in the log: an ObservationEvent carrying `structured.browser_unavailable`,
   384	    or an Observation/AgentError whose text matches `BROWSER_UNAVAILABLE_MSG`. This
   385	    is the second of the two "browser genuinely unavailable" signals (the first is
   386	    `_browser_verification_unavailable` — no browser tool at all)."""
   387	    for ev in reversed(events):
   388	        if isinstance(ev, ObservationEvent) and ev.tool_result.tool_name == "browser":
   389	            res = ev.tool_result
   390	            if (res.structured or {}).get("browser_unavailable"):
   391	                return True
   392	            if _BROWSER_UNAVAILABLE_TEXT in (res.content or "") or _BROWSER_UNAVAILABLE_TEXT in (
   393	                res.error or ""
   394	            ):
   395	                return True
   396	        elif isinstance(ev, AgentErrorEvent):
   397	            if _BROWSER_UNAVAILABLE_TEXT in (ev.error or ""):
   398	                return True
   399	    return False
   400	
   401	
   402	def _real_web_failure_evidence(events: list[Event]) -> bool:
   403	    """Bug 6 (W-45 guard) — True iff there is genuine 'the app is BROKEN' evidence
   404	    (not mere infra-unavailability): a `verify_web_app` verdict or a SUCCESSFUL
   405	    `browser` observation showing console errors, NETWORK failures, or a
   406	    served-but-blank render. ANY such evidence BLOCKS the honest actionless finish —
   407	    only an unverifiable (never a broken) build may finish honestly. A FAILED browser
   408	    call is infra-unavailability (an AgentErrorEvent, not an ObservationEvent) and is
   409	    NOT treated as app-broken here."""
   410	    for ev in events:
   411	        if not isinstance(ev, ObservationEvent):
   412	            continue
   413	        res = ev.tool_result
   414	        st = res.structured or {}
   415	        if res.tool_name == "verify_web_app":
   416	            if st.get("console_errors") or st.get("network_failures"):
   417	                return True
   418	            http_ok = 200 <= int(st.get("http_status") or 0) < 400
   419	            if http_ok and st.get("meaningful_content") is False:
   420	                return True  # served HTTP 200 but rendered nothing → broken, not unverifiable
   421	        elif res.tool_name == "browser":
   422	            if not res.success:
   423	                continue  # a failed/unavailable browser call is infra, not app-broken
   424	            # console errors — the app threw at runtime.
   425	            if any(c.get("level") == "error" for c in (st.get("console") or [])):
   426	                return True
   427	            # NETWORK failures — the daemon's `network` ring holds failed/4xx-5xx
   428	            # requests (B7). A page that loaded with broken requests is NOT a clean
   429	            # unverifiable delivery.
   430	            if st.get("network") or st.get("network_failures"):
   431	                return True
   432	            # BLANK render — the page served but nothing a user would see mounted
   433	            # (empty/trivial DOM: no meaningful text, no elements/links/forms).
   434	            if not _browser_content_meaningful(st):
   435	                return True
   436	    return False
   437	
   438	
   439	def _url_targets_preview(url: str, target_key: tuple[str, int] | None) -> bool:
   440	    """Does a browser observation `url` address the CURRENT preview target?
   441	
   442	    The preview platform assigns a RANDOM port — there is NO fixed :8000 inside the
   443	    sandbox. When the live preview port has been resolved (`target_key`, derived from
   444	    `_detect_preview_url` via `_preview_key` — backend-aware: never the agent-server's
   445	    :8000 on the shared-host/process backend) an observation counts ONLY if its url
   446	    resolves to the SAME (host, port) preview key — a foreign / wrong-port observation
   447	    does NOT satisfy the browser gate.
   448	
   449	    When the preview is undetectable (`target_key is None` — sandbox-less / legacy
   450	    backend / the pure-reader unit tests) the historical :8000 acceptance is kept as a
   451	    safe fallback rather than asserting a wrong port (on an ISOLATED backend :8000 IS
   452	    the app; the resolver returns it as the target_key there, so this also matches)."""
   453	    if target_key is None:
   454	        return url.startswith("http://127.0.0.1:8000") or url.startswith(
   455	            "http://localhost:8000"
   456	        )
   457	    return _preview_key(url) == target_key
   458	
   459	
   460	def _browser_verified(
   461	    events: list[Event], since_seq: int, target_key: tuple[str, int] | None = None
   462	) -> tuple[bool, str | None]:
   463	    """Scan the AGENT's browser observations since since_seq. Returns (ok,
   464	    first_error_line). An observation is valid if it's from the browser tool,
   465	    against the resolved preview target (`target_key`; :8000 when undetectable —
   466	    see `_url_targets_preview`), and has zero console errors. If not ok, returns
   467	    the first error from the LATEST qualifying observation.
   468	
   469	    The finish gate's OWN driven probe (the verify-overclaim active check —
   470	    ActionEvent tagged `verify_probe`) is EXCLUDED here: this helper answers "did
   471	    the AGENT verify cleanly", and the gate judges its own probe separately (with
   472	    the blank-render guard). Without the exclusion a clean-console-but-blank probe
   473	    from a prior refusal cycle would read back as an agent pass and bypass the
   474	    blank guard."""
   475	    probe_action_ids = {
   476	        ev.id for ev in events if isinstance(ev, ActionEvent) and ev.meta.get("verify_probe")
   477	    }
   478	    valid_obs = []
   479	    for ev in events:
   480	        if ev.seq is None or ev.seq <= since_seq:
   481	            continue
   482	        if isinstance(ev, ObservationEvent) and ev.tool_result.tool_name == "browser":
   483	            if ev.action_id in probe_action_ids:
   484	                continue  # the gate's own probe — judged actively, not as agent work
   485	            res = ev.tool_result
   486	            if res.success and res.structured:
   487	                url = str(res.structured.get("url", ""))
   488	                if _url_targets_preview(url, target_key):
   489	                    valid_obs.append(res.structured)
   490	
   491	    if not valid_obs:
   492	        return False, None
   493	
   494	    # ok = at least one observation with zero console errors
   495	    ok = any(
   496	        not any(c.get("level") == "error" for c in obs.get("console", [])) for obs in valid_obs
   497	    )
   498	
   499	    # first_error_line = from the LATEST qualifying-URL observation that has error-level entries
   500	    first_error_line = None
   501	    for obs in reversed(valid_obs):
   502	        errors = [
