   132	def _reject_if_imported(store: SqliteEventStore, conversation_id: str) -> None:
   133	    """Imported share-bundle conversations are READ-ONLY — they hold untrusted
   134	    third-party events, so reviving them would feed an attacker's content to the
   135	    agent with this instance's tools/credentials. Every loop-kicking / mutating
   136	    endpoint rejects them at the server EDGE (409); the UI hiding the affordance
   137	    is defense-in-depth, never the boundary."""
   138	    if store.conversation_origin(conversation_id) == "imported":
   139	        raise HTTPException(status_code=409, detail={"reason": "imported_read_only"})
