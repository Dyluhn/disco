    70	def _sanitize_name(raw: str) -> str | None:
    71	    """Return a safe filename for uploads/, or None if the result is empty."""
    72	    name = Path(raw).name            # kills traversal (../../etc/passwd → passwd)
    73	    name = unicodedata.normalize("NFC", name)
    74	    name = name.lstrip(".")          # strip leading dots (dotfiles)
    75	    name = re.sub(r"\s+", "-", name.strip())  # strip surrounding whitespace, runs → hyphen
    76	    return name or None
