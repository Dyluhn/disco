    93	# E4 — static-site verify. A static deliverable shouldn't have to curl a running
    94	# server to prove it's good; the honest post-condition is "the file exists and is
    95	# parseable HTML." The agent signals this with verify="static" (default index.html)
    96	# or verify="static:<path>". We translate it to a server-free python3 check that
    97	# runs through the SAME safe gate as any verify command (it assesses LOW — no
    98	# confirm). exit 0 ⇔ the page exists, is non-trivial, and parses.
    99	_STATIC_VERIFY_PREFIX = "static"
   100	
   101	
   102	def _static_verify_command(path: str) -> str:
   103	    p = (path or "index.html").strip().strip("'\"") or "index.html"
   104	    # single-quote the path safely for the shell, then hand to python3 -c
   105	    safe = p.replace("'", "'\\''")
   106	    script = (
   107	        "import sys,os.path,html.parser as H;"
   108	        f"p='{safe}';"
   109	        "(os.path.isfile(p) or sys.exit('missing '+p));"
   110	        "d=open(p,encoding='utf-8',errors='replace').read();"
   111	        "(len(d.strip())>=20 or sys.exit('empty '+p));"
   112	        "t=[];pr=H.HTMLParser();pr.handle_starttag=lambda n,a:t.append(n);pr.feed(d);"
   113	        "print('OK '+p+' tags='+str(len(t)));"
   114	        "sys.exit(0 if t else 'no html tags in '+p)"
   115	    )
   116	    return f'python3 -c "{script}"'
   117	
   118	
   119	# verify="app" / "app:<url>" — SERVER-AWARE self-verification (the verify_app
   120	# gap). Where `static` only proves a file exists + parses, `app` proves the
   121	# RUNNING deliverable actually serves: it GETs the URL inside the sandbox and
   122	# requires HTTP 200 + a non-trivial body. Portable (python3/urllib — no curl/
   123	# chromium dependency) so it runs on every backend; routes through the same safe
   124	# verify gate. A full pixel screenshot needs a browser in the sandbox image (not
   125	# present on the process backend) — this is the honest server-up post-condition.
   126	_APP_VERIFY_PREFIX = "app"
   127	
   128	
   129	def _app_verify_command(url: str) -> str:
   130	    # NO hardcoded :8000 default. The platform assigns the preview port (it is NOT a fixed
   131	    # port — see PreviewManager), so the ACTUAL served URL must be supplied by the caller
   132	    # (`resolve_verify_command` resolves it from the live preview, and degrades to the
   133	    # server-free static check when no preview can be located). A bare `verify="app"` with
   134	    # no resolvable preview never reaches here with an empty url — guarding against an empty
   135	    # url keeps this from fabricating a wrong port.
   136	    u = (url or "").strip().strip("'\"")
   137	    safe = u.replace("'", "'\\''")
   138	    # No try/except (a `-c` one-liner can't carry the block): a connection failure
   139	    # raises URLError → nonzero exit + a traceback the agent reads as "not serving".
   140	    script = (
   141	        "import sys,urllib.request as U;"
   142	        f"u='{safe}';"
   143	        "r=U.urlopen(u,timeout=10);"
   144	        "code=getattr(r,'status',None) or r.getcode();"
   145	        "(code==200 or sys.exit('HTTP '+str(code)+' from '+u));"
   146	        "b=r.read().decode('utf-8','replace');"
   147	        "(len(b.strip())>=20 or sys.exit('empty body from '+u));"
   148	        "print('OK '+u+' '+str(code)+' bytes='+str(len(b)))"
   149	    )
   150	    return f'python3 -c "{script}"'
   151	
   152	
   153	def _last_productive_seq(events: list[Event]) -> int:
   154	    """Seq of the last state-changing action (not in _NON_PRODUCTIVE_TOOLS).
   155	    If no productive action found, returns 0."""
   156	    for ev in reversed(events):
   157	        if isinstance(ev, ActionEvent):
   158	            if ev.tool_call.tool_name not in _NON_PRODUCTIVE_TOOLS:
   159	                return ev.seq or 0
   160	    return 0
   161	
   162	
   163	def _is_web_deliverable(events: list[Event]) -> bool:
   164	    """Web deliverable if index.html was written/edited OR port 8000 owned by non-preview.
   165	    Derived from events to keep the check pure (event-list in, verdict out)."""
   166	    for ev in reversed(events):
   167	        if isinstance(ev, ActionEvent):
   168	            if ev.tool_call.tool_name in (
   169	                "file_write",
   170	                "file_edit",
   171	                "file_append",
   172	                "file_replace_lines",
   173	                "file_insert_lines",
   174	            ):
   175	                path = ev.tool_call.arguments.get("path")
   176	                # Canonical workspace-root paths
   177	                if path in ("index.html", "./index.html"):
   178	                    return True
   179	        elif isinstance(ev, ObservationEvent) and ev.tool_result.tool_name == "server_status":
   180	            content = ev.tool_result.content
   181	            # "  - 8000: OWNED by pid 123 (python) [session: dev]"
   182	            for line in content.splitlines():
   183	                if "8000: OWNED" in line and "[session: " in line:
   184	                    session = line.split("[session: ")[1].split("]")[0]
   185	                    if session != "preview":
   186	                        return True
   187	    return False
