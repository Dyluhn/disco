    45	def delivery_mode_for_kind(kind: ContractKind) -> DeliveryMode:
    46	    """The host-owned delivery shape for an artifact kind: "app" (open in preview) for
    47	    appkit.leadgen / static.site / interactive.prototype; "files" (download) otherwise."""
    48	    return "app" if kind in _APP_DELIVERY_KINDS else "files"
    49	
