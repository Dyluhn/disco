+    # parse markdown; this is a recovery heuristic, not a renderer.
+    for _ in range(3):
+        new = _MD_EMPH_RE.sub(r"\2", text)
+        if new == text:
+            break
+        text = new
+    return text.strip(" \t`*_")
+
+
