+    assert state.execution_status == ConversationStatus.AWAITING_PLAN_APPROVAL
+    assert harvested.revision == 2
+    assert [s.title for s in harvested.steps][:1] == [
+        "Replace footer copy with Copyright Acme Cloud 2026"
+    ]

