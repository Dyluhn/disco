+    plan_lines = [line for line in lines if line.lower().startswith("plan")]
+    raw = plan_lines[-1] if plan_lines else (lines[0] if lines else "")
+    summary = _strip_prose_step_markdown(raw)
+    return summary[:200] if summary else None
+
