+        return False
+    for e in reversed(events):
+        if (e.seq or 0) <= start_seq:
+            return False
+        if isinstance(e, PlanEvent):
+            return False
+        if isinstance(e, ActionEvent):
+            tool = e.tool_call.tool_name if e.tool_call is not None else None
