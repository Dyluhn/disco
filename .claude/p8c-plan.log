    emit({
      v: 1,
      channel: 'disco-select',
      nonce: _nonce,
      type: 'disco:selection',
      selection_ref: resolveRef(el),
      human_label: humanLabel(el),
      rect: { x: r.left, y: r.top, width: r.width, height: r.height },
