import asyncio, os, tempfile, threading, sys, traceback
from unittest.mock import patch
from disco.agent_server import runtime as runtime_mod
from disco.agent_server.runtime import ConversationRuntime
from disco.core import SqliteEventStore, LLMMessage
from disco.core import MessageEvent as CoreMessageEvent
from disco.core.llm import CompletionResponse, DefaultLLMRouter, ModelEntry, RouterConfig, StreamChunk, TokenUsage
from disco.tools import ProcessSandboxService

class _FinishProvider:
    name = 'fake'
    async def complete(self, req, *, model):
        return CompletionResponse(text='done', tool_calls=[], usage=TokenUsage(input_tokens=1, output_tokens=1), finish_reason='stop', model_used=model, request_id=req.request_id, routing=None)
    async def stream_complete(self, req, *, model):
        yield StreamChunk(done=True, final=await self.complete(req, model=model))
    def supports(self, _req, *, model):
        return True

def fake_probe(*args):
    print('PROBE CALLED', args, flush=True)
    return {'model_id': 'm', 'n_ctx': 8192}

async def main():
    tmp = tempfile.TemporaryDirectory()
    base_url='https://api.anthropic.com/v1'
    cfg = RouterConfig(models={'m': ModelEntry(model_id='m', provider='fake', base_url=base_url, context_window=8192)}, default_model='m')
    cid = 'standard-cid'
    with patch.object(runtime_mod, '_do_live_model_probe', fake_probe):
      with patch.dict(os.environ, {'PMX_DB': tmp.name + '/disco.db'}):
        store = SqliteEventStore(':memory:')
        router = DefaultLLMRouter(cfg, {'fake': _FinishProvider()})
        rt = ConversationRuntime(store, router=router, sandbox_service=ProcessSandboxService())
        rt.set_assist(cid, False)
        store.create_conversation(cid, owner_id='local')
        rt.set_surface(cid, 'build')
        await store.append(cid, CoreMessageEvent(id='msg-1', source='user', message=LLMMessage(role='user', content='build something')))
        rt.kick(cid)
        for _ in range(20):
            if cid in rt._executors:
                break
            await asyncio.sleep(0.05)
        task = rt._tasks.get(cid)
        if task:
            task.cancel()
            try:
                await asyncio.wait_for(task, timeout=2)
            except BaseException:
                pass
        await asyncio.sleep(0)
        print('threads', [(t.name, t.ident, t.daemon) for t in threading.enumerate()], flush=True)

asyncio.run(main())
print('done', flush=True)
