     1	"""ModelExecutionPolicy — the SINGLE source of truth for model-tier execution.
     2	
     3	Background (2026-06-20 assist-pipeline refactor): the weak-model "assist" gate used
     4	to be a bare boolean smeared across runtime, the LLM request, every loop collaborator,
     5	and the tool context — AND the tool surface was gated by a SECOND, independent
     6	classifier (the ANCHORED_EDIT capability). The two never reconciled, so a capable
     7	local model could get the small-model prompt + every compensation but the full capable
     8	toolset, and a cached loop's frozen boolean could go stale against the live UI badge.
     9	
    10	This object replaces that. It is resolved ONCE per conversation (`resolve_policy`),
    11	frozen, and threaded immutably into the loop, executor, tool scope, prompt selection,
    12	and the LLM request — so all consumers read the SAME decision. The `standard` tier is a
    13	NO-OP: every weak-model gate is `if policy.assist`, so a standard-tier run is identical
    14	to the pre-assist code path. The tier and the anchored-edit capability now live on ONE
    15	object, so the tool surface and the compensations can no longer disagree.
    16	"""
    17	
    18	from __future__ import annotations
    19	
    20	from dataclasses import dataclass
    21	from typing import Literal
    22	
    23	Tier = Literal["standard", "weak"]
    24	
    25	
    26	@dataclass(frozen=True)
    27	class ModelExecutionPolicy:
    28	    """How a conversation's driver model should be executed. Immutable; resolve once."""
    29	
    30	    # "weak" enables the assist compensations (F1/F3/F4/F5/F6/F7/F8/F9/HS-01/HS-03 and
    31	    # the small-model prompt). "standard" is the no-op default — provably identical to
    32	    # the pre-assist path.
    33	    tier: Tier = "standard"
    34	    # Whether the model reliably performs anchored (search/replace) edits. A CAPABILITY,
    35	    # distinct from tier: it governs only whether the line-anchored edit tool is
    36	    # advertised. Carried here so the tool surface is decided by the SAME object as the
    37	    # compensations (the former two-classifiers bug).
    38	    anchored_edit: bool = True
    39	
    40	    @property
    41	    def assist(self) -> bool:
    42	        """The legacy weak-model gate. Every `if self._assist:` compensation reads this,
    43	        so the standard tier (assist=False) is byte-identical to pre-assist."""
    44	        return self.tier == "weak"
    45	
    46	    @property
    47	    def withheld_tools(self) -> frozenset[str]:
    48	        """The single place the advertised tool surface is narrowed for this policy —
    49	        reconciling what used to be two independent gates:
    50	          • no anchored-edit capability → withhold `file_str_replace` (line-anchored edit);
    51	          • ALL tiers → withhold `plan_step` (see below);
    52	          • weak tier → ALSO withhold `update_plan_progress` (weak models get the honest
    53	            NL plan + done-at-finish, never a per-step bookkeeping burden they drop).
    54	
    55	        `plan_step` is RETIRED from the advertised surface for EVERY tier (runthru-v2 #3):
    56	        incremental per-step `plan_step` updates caused plan-state drift and failed across
    57	        ALL models (capable and small alike). The declarative `update_plan_progress`
    58	        replaced it. We never advertise `plan_step` to anyone — previously the capable
    59	        (standard) surface still offered BOTH, so a capable model like MiniMax-M3 was given
    60	        `plan_step` and `update_plan_progress` and picked between them inconsistently. The
    61	        engine still HANDLES stray `plan_step` calls defensively (backward-compat for any
    62	        out-of-band call), but it is no longer offered. `plan_step` stays in the security
    63	        allowlist (callable) — only its *advertisement* is withdrawn here.
    64	        """
    65	        out: set[str] = set()
    66	        if not self.anchored_edit:
    67	            out.add("file_str_replace")
    68	            out.add("exact_replace")  # CD-TOOLS-2 — anchored exact-match batch edit (capable tier)
    69	        # Retired for ALL tiers (state-drift); kept callable for defensive back-compat.
    70	        out.add("plan_step")
    71	        if self.tier == "weak":
    72	            out.add("update_plan_progress")
    73	        return frozenset(out)
    74	
    75	    @classmethod
    76	    def standard(cls) -> ModelExecutionPolicy:
    77	        """The no-compensation default — a capable model with anchored edits and no weak-model compensations (it still withholds the universally-retired `plan_step`)."""
    78	        return cls(tier="standard", anchored_edit=True)
    79	
    80	
    81	def resolve_policy(
    82	    *,
    83	    assist_override: bool | None,
    84	    entry_tier: Tier | None,
    85	    hosting_weak_default: bool,
    86	    anchored_edit: bool,
    87	) -> ModelExecutionPolicy:
    88	    """Resolve the ONE policy for a conversation. Precedence for the tier:
    89	
    90	      1. an explicit per-conversation assist toggle (the user flipped it) wins;
    91	      2. else the model's explicit `tier` metadata (config.py ModelEntry.tier);
    92	      3. else the hosting heuristic (local && !openrouter → weak) — pure back-compat.
    93	
    94	    `anchored_edit` is the model's capability and is independent of the tier.
    95	    """
    96	    if assist_override is not None:
    97	        tier: Tier = "weak" if assist_override else "standard"
    98	    elif entry_tier is not None:
    99	        tier = entry_tier
   100	    else:
   101	        tier = "weak" if hosting_weak_default else "standard"
   102	    return ModelExecutionPolicy(tier=tier, anchored_edit=anchored_edit)

