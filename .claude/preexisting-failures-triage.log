     1	"""Test-support for the Pi tool-bridge suites.
     2	
     3	Defensive per-test wall-clock guard (scoped — see ``_GUARDED_MODULES``). The bridge
     4	gates park a held request on an ``asyncio.Future`` and ``await`` it until a SEPARATE
     5	control op resolves it (pi_kernel ``_park`` / ``_park_confirm``). A test that drives
     6	such a gate but forgets to RESOLVE it would otherwise block ``await fut`` forever and
     7	hang the whole suite. This wraps each async test in those two modules in
     8	``asyncio.wait_for`` so a future gate hang FAILS FAST (TimeoutError) instead of
     9	wedging the run. It is event-loop-native (no signals), touches no shared venv, and
    10	is scoped by module name so the other ~90 agent-server suites are unaffected.
    11	"""
    12	
    13	from __future__ import annotations
    14	
    15	import asyncio
    16	import functools
    17	import inspect
    18	from collections.abc import Iterable
    19	
    20	import pytest
    21	
    22	# Only these modules are guarded — every other suite in this directory is untouched.
    23	_GUARDED_MODULES = {"test_pi_tool_bridge", "test_pi_tool_bridge_unit"}
    24	
    25	# Generous vs. the suites' own 5s gate-status waits, tight enough to fail fast.
    26	_PER_TEST_TIMEOUT_S = 20.0
    27	
    28	
    29	def pytest_collection_modifyitems(items: Iterable[pytest.Item]) -> None:
    30	    for item in items:
    31	        module = getattr(item, "module", None)
    32	        short = module.__name__.rsplit(".", 1)[-1] if module is not None else ""
    33	        if short not in _GUARDED_MODULES:
    34	            continue
    35	        func = getattr(item, "obj", None)
    36	        if func is None or not inspect.iscoroutinefunction(func):
    37	            continue  # sync tests can't await-hang
    38	
    39	        @functools.wraps(func)
    40	        async def _guarded(*args: object, __func=func, **kwargs: object) -> object:
    41	            return await asyncio.wait_for(__func(*args, **kwargs), timeout=_PER_TEST_TIMEOUT_S)
    42	
    43	        item.obj = _guarded  # type: ignore[attr-defined]

