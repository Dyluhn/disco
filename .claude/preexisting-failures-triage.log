from types import SimpleNamespace
import asyncio
from disco.agent_server import verify
import disco.agent_server.verify._setup_checks as setup

def _cfg(*, assignments=None, default_model=None, models=None):
    return SimpleNamespace(assignments=assignments or {}, default_model=default_model, models=models or {})

def _rt(*, cfg=None, router=None):
    return SimpleNamespace(_config_store=SimpleNamespace(load=lambda: cfg), _router_now=lambda *a, **k: router)

async def fake_completion(rt):
    return setup.Check('completion', 'SKIP', 'short-circuited for triage')
async def fake_tool(rt):
    return setup.Check('tool-calling', 'SKIP', 'short-circuited for triage')

# Same patch target as the test. This does not affect run_checks.__globals__.
verify._build_runtime = lambda: _rt(cfg=_cfg())
# Avoid waiting on the real localhost model after the missed runtime patch.
setup.check_completion = fake_completion
setup.check_tool_calling = fake_tool
results = asyncio.run(verify.run_checks(quick=True, network=False))
print([(c.name, c.status, c.detail) for c in results])
