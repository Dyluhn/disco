   156	export function scrubProviderCredentialEnv(env: NodeJS.ProcessEnv = process.env): string[] {
   157	  const deny = new Set(PROVIDER_CREDENTIAL_ENV_VARS);
   158	  const removed: string[] = [];
   159	  for (const name of Object.keys(env)) {
   160	    if (env[name] === undefined) continue;
   161	    if (deny.has(name) || PROVIDER_CREDENTIAL_ENV_PATTERNS.some((re) => re.test(name))) {
   162	      delete env[name];
