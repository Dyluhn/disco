   213	   * agent_event chains off this so frames stay in arrival order AND each awaits
   214	   * writer capacity before it is emitted — see {@link forwardAgentEvent}.
   215	   */
   216	  private emitChain: Promise<void> = Promise.resolve();
   217	  /** agent_events enqueued on {@link emitChain} but not yet emitted (P1 #2). */
