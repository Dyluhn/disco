    58	
    59	# A trivial, unambiguous tool the model should call when asked about the weather.
    60	# Structured-tool-call support is the single capability the whole agent loop rests
    61	# on, so we test it directly rather than inferring it from a prose answer.
    62	_WEATHER_TOOL = ToolSpec(
    63	    name="get_weather",
    64	    description="Get the current weather for a city. Call this to answer weather questions.",
    65	    parameters_schema={
    66	        "type": "object",
    67	        "properties": {"city": {"type": "string", "description": "City name"}},
    68	        "required": ["city"],
    69	    },
    70	)
    71	
    72	
    73	def _profile() -> CapabilityProfile:
    74	    return CapabilityProfile(
    75	        role=ModelRole.AGENT_DRIVER,
    76	        requirements=frozenset({Requirement.TOOL_CALLING}),
    77	    )
    78	
    79	
    80	def _build_runtime():
    81	    """A throwaway runtime bound to the persisted config + secrets (the same stores
    82	    the servers use). We only borrow its router builder — no event store writes.
    83	
    84	    ConfigStore()/SecretStore() with no args resolve PMX_CONFIG / PMX_SECRETS (set by
    85	    compose) and otherwise fall back to their own defaults — the repo
    86	    `disco-config.json` for config, the XDG path for secrets — so verify reads
    87	    exactly what the running servers read."""
    88	    from disco.agent_server import ConversationRuntime
    89	    from disco.core import SqliteEventStore
    90	    from disco.core.llm import ConfigStore, SecretStore
    91	
    92	    return ConversationRuntime(
    93	        SqliteEventStore(":memory:"),
    94	        config_store=ConfigStore(),
    95	        secret_store=SecretStore(),
    96	    )
    97	
    98	
    99	def check_config(rt) -> Check:
   100	    """A driver model must RESOLVE — by explicit AGENT_DRIVER assignment OR the
   101	    `default_model` fallback (the same order the router uses, routing.py:216). This
   102	    catches the most common first-run mistake: a config with no usable driver at all."""
   103	    try:
   104	        cfg = rt._config_store.load()
   105	        driver_key = (
   106	            cfg.assignments.get(ModelRole.AGENT_DRIVER.value)
   107	            or cfg.assignments.get(ModelRole.AGENT_DRIVER)
   108	            or cfg.default_model
   109	        )
   110	        if not driver_key:
   111	            return Check("config", "FAIL", "no driver: set a default_model or assign AGENT_DRIVER")
   112	        model = cfg.models.get(driver_key)
   113	        if model is None:
   114	            return Check("config", "FAIL", f"driver '{driver_key}' is not in the model catalogue")
   115	        where = model.base_url or "(provider default)"
   116	        return Check("config", "PASS", f"driver '{model.model_id}' → {where}")
   117	    except Exception as exc:  # noqa: BLE001 — report the real error to the operator
   118	        return Check("config", "FAIL", f"{type(exc).__name__}: {exc}")
   119	
   120	
   121	async def check_completion(rt) -> Check:
   122	    """The driver endpoint is reachable and returns text. Distinguishes 'endpoint down /
   123	    wrong base_url / model not served' (FAIL with the verbatim error) from a working model."""
   124	    try:
   125	        router = rt._router_now()
   126	        req = CompletionRequest(
   127	            profile=_profile(),
   128	            messages=[LLMMessage(role="user", content="Reply with exactly the word: ok")],
   129	            max_tokens=16,
   130	        )
   131	        t0 = time.monotonic()
   132	        resp = await router.complete(req)
   133	        ms = int((time.monotonic() - t0) * 1000)
   134	        if not (resp.text or "").strip() and not resp.tool_calls:
   135	            return Check("completion", "FAIL", f"empty response from '{resp.model_used}'", ms)
   136	        return Check("completion", "PASS", f"'{resp.model_used}' replied in {ms} ms", ms)
   137	    except Exception as exc:  # noqa: BLE001
   138	        return Check("completion", "FAIL", f"{type(exc).__name__}: {exc}")
   139	
   140	
   141	async def check_tool_calling(rt) -> Check:
   142	    """THE gate. A model that won't emit a structured tool call cannot drive the loop —
   143	    no matter how fluent its prose. We force the simplest possible call and check for it."""
   144	    try:
   145	        router = rt._router_now()
   146	        req = CompletionRequest(
   147	            profile=_profile(),
   148	            messages=[
   149	                LLMMessage(role="system", content="You are an assistant with tools. Use them."),
   150	                LLMMessage(
   151	                    role="user",
   152	                    content="What is the weather in Paris right now? Use the get_weather tool.",
   153	                ),
   154	            ],
   155	            tools=[_WEATHER_TOOL],
   156	        )
   157	        resp = await router.complete(req)
   158	        names = [tc.tool_name for tc in resp.tool_calls]
   159	        if "get_weather" in names:
   160	            return Check("tool-calling", "PASS", f"'{resp.model_used}' called get_weather")
   161	        if names:
   162	            return Check("tool-calling", "FAIL", f"called {names}, expected get_weather")
   163	        preview = (resp.text or "").strip().replace("\n", " ")[:80]
   164	        return Check(
   165	            "tool-calling",
   166	            "FAIL",
   167	            f"'{resp.model_used}' answered in prose, no tool call — “{preview}”",
   168	        )
   169	    except Exception as exc:  # noqa: BLE001
   170	        return Check("tool-calling", "FAIL", f"{type(exc).__name__}: {exc}")
   171	
   172	
   173	async def check_grounding(rt) -> Check:
   174	    """The full research pipeline (live search + extraction + the user's driver + NLI
   175	    verification) returns a CITED answer. This is a capability smoke test, not a quality
   176	    gate — the faithfulness SCORE is the eval harness's job (`make eval`). Needs outbound
   177	    internet + a one-time encoder download, so it SKIPs (not FAILs) when those aren't
   178	    available — the point is to verify a *configured* model, not to penalize an offline box.
   179	
   180	    Semantics: no sources retrieved → SKIP (search blocked / rate-limited — environmental);
   181	    sources retrieved + ≥1 grounded claim → PASS; sources but zero grounded claims → FAIL
   182	    (a real "your model retrieves but doesn't ground" gap worth surfacing)."""
   183	    try:
   184	        from disco.retrieval.bundled_providers import (
   185	            DdgsSearchProvider,
   186	            LocalExtractionProvider,
   187	        )
   188	        from disco.retrieval.engine import DefaultRetrievalEngine
   189	        from disco.retrieval.grounding import GroundingPipeline
   190	        from disco.retrieval.live import build_live_retrieval
   191	        from disco.retrieval.ranking import RouterQueryRewriter
   192	        from disco.retrieval.wiring import research_answer
   193	    except Exception as exc:  # noqa: BLE001
   194	        return Check("grounding", "SKIP", f"retrieval extras unavailable: {exc}")
   195	
   196	    try:
   197	        enc = build_live_retrieval()  # encoders (downloads on first run)
   198	        router = rt._router_now()
   199	        engine = DefaultRetrievalEngine(
   200	            search=DdgsSearchProvider(),
   201	            extraction=LocalExtractionProvider(),
   202	            reranker=enc["reranker"],
   203	            embedder=enc.get("embedder"),
   204	            rewriter=RouterQueryRewriter(router),
   205	        )
   206	        grounding = GroundingPipeline(router, enc["nli"])
   207	        answer = await research_answer(
   208	            "Who wrote the novel Pride and Prejudice?", engine, grounding, depth="standard"
   209	        )
   210	        cited = {p.source_url for p in answer.passages}
   211	        n_claims = len(answer.claims)
   212	        if not cited:
   213	            return Check(
   214	                "grounding", "SKIP", "no sources retrieved (search blocked / rate-limited)"
   215	            )
   216	        if n_claims > 0:
   217	            return Check(
   218	                "grounding", "PASS", f"cited answer: {len(cited)} source(s), {n_claims} claim(s)"
   219	            )
   220	        return Check(
   221	            "grounding", "FAIL", f"retrieved {len(cited)} source(s) but produced 0 grounded claims"
   222	        )
   223	    except Exception as exc:  # noqa: BLE001
   224	        # Network / encoder-download / search failures are environmental, not a model
   225	        # verdict — SKIP with the reason so the operator knows what to fix.
   226	        return Check("grounding", "SKIP", f"could not run live ({type(exc).__name__}: {exc})")
   227	
   228	
   229	async def run_checks(*, quick: bool, network: bool) -> list[Check]:
   230	    rt = _build_runtime()
   231	    results: list[Check] = [check_config(rt)]
   232	    # If config failed, the live checks can't resolve a model — SKIP them honestly.
   233	    if results[0].status == "FAIL":
   234	        for name in ("completion", "tool-calling", "grounding"):
   235	            results.append(Check(name, "SKIP", "skipped — config check failed"))
   236	        return results
   237	
   238	    results.append(await check_completion(rt))
   239	    results.append(await check_tool_calling(rt))
   240	    if quick or not network:
   241	        results.append(Check("grounding", "SKIP", "skipped (--quick / --no-network)"))
   242	    else:
   243	        results.append(await check_grounding(rt))
   244	    return results
   245	
   246	
   247	def _render(results: list[Check]) -> int:
   248	    icons = {"PASS": "✓", "FAIL": "✗", "SKIP": "–"}
   249	    width = max(len(c.name) for c in results)
   250	    print("\ndisco — setup verification\n")
   251	    for c in results:
   252	        print(f"  {icons[c.status]} {c.status:<4} {c.name.ljust(width)}   {c.detail}")
   253	    failed = [c for c in results if c.status == "FAIL"]
   254	    passed = sum(1 for c in results if c.status == "PASS")
   255	    skipped = sum(1 for c in results if c.status == "SKIP")
   256	    print(f"\n  {passed} passed · {len(failed)} failed · {skipped} skipped")
   257	    if failed:
   258	        print("\n  Setup is NOT ready. Fix the failing checks above, then re-run.")
   259	        return 1
   260	    print("\n  Your model is ready to drive the loop.")
   261	    return 0
   262	
   263	
   264	def main() -> None:
   265	    ap = argparse.ArgumentParser(
   266	        prog="disco verify",
   267	        description="Verify your configured model/provider actually drives the agent loop.",
   268	    )
   269	    ap.add_argument(
   270	        "--quick", action="store_true", help="skip the live grounding check (config + LLM only)"
   271	    )
   272	    ap.add_argument(
   273	        "--no-network",
   274	        action="store_true",
   275	        help="skip checks that need outbound internet (same as --quick today)",
   276	    )
   277	    args = ap.parse_args()
   278	    results = asyncio.run(run_checks(quick=args.quick, network=not args.no_network))
   279	    raise SystemExit(_render(results))
   280	
   281	
   282	if __name__ == "__main__":
   283	    main()

