   380	
   381	export interface SerialQueue {
   382	  /** Run `task` after all previously enqueued tasks settle; preserves order. */
   383	  run: (task: () => Promise<void>) => Promise<void>;
   384	}
   385	
   386	/**
   387	 * A single-lane async queue for the DATA plane. Each task starts only after the
   388	 * previous one fully settles (resolve OR reject), so command handling is strictly
   389	 * sequential and in arrival order — `init` completes before a back-to-back
   390	 * `prompt` begins. NOTE: teardown/`cancel` deliberately do NOT ride this queue
   391	 * (see {@link createControlPlane}); they must preempt a possibly-hung in-flight
   392	 * data task rather than serialize behind it.
   393	 */
   394	export function createSerialQueue(): SerialQueue {
   395	  let tail: Promise<void> = Promise.resolve();
   396	  return {
   397	    run(task) {
   398	      const next = tail.then(task, task);
   399	      // Don't let one task's rejection poison the lane for the next task.
   400	      tail = next.then(
   401	        () => undefined,
   402	        () => undefined,
   403	      );
   404	      return next;
   405	    },
   406	  };
   407	}
