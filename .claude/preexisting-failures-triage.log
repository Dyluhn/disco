    33	import argparse
    34	import asyncio
    35	import time
    36	from dataclasses import dataclass
    37	from typing import Literal
    38	
    39	from disco.core.events import LLMMessage
    40	from disco.core.llm.types import (
    41	    CapabilityProfile,
    42	    CompletionRequest,
    43	    ModelRole,
    44	    Requirement,
    45	    ToolSpec,
    46	)
    47	
    48	Status = Literal["PASS", "FAIL", "SKIP"]
    49	
    50	
    51	@dataclass
    52	class Check:
    53	    name: str
    54	    status: Status
    55	    detail: str
    56	    ms: int | None = None
