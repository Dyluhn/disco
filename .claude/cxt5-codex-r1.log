            line = f"{i + 1:>{width}}\t{lines[i]}"
            raw_nl = 1 if (i < total - 1 or ends_nl) else 0
            charge = (len(lines[i]) + raw_nl) if budget_raw else (len(line) + 1)
            if out and used + charge > read_budget:
