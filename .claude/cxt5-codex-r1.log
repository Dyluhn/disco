        await self.execute(setup_cell, timeout_s=10)

    async def execute(self, code: str, *, timeout_s: int) -> KernelResult:
        if not self._kc:
            await self.start()
        assert self._kc is not None  # start() always populates both _km and _kc
        kc = self._kc

