+        {"kind": "message", "timestamp": datetime.fromtimestamp(start, UTC).isoformat()},
+        {
+            "kind": "status",
+            "status": "FINISHED",
+            "timestamp": datetime.fromtimestamp(terminal, UTC).isoformat(),
+        },
+    ]
+
+    async def collect(records: list[dict]) -> dict:
+        relay = tmp_path / "relay.jsonl"
