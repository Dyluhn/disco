@runtime_checkable
class RoutingSink(Protocol):
    """[CONTRACT boundary] Receives one RoutingDecision per call for the
    metrics/audit layer (BoD §18/§20)."""

    def record(self, decision: RoutingDecision) -> None: ...


class NullRoutingSink:
