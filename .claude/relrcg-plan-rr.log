   157	
   158	# CD-TOOLS-1 — the internal elision-marker family, re-expressed locally so the tools
   159	# package does not import from disco.core (layering). Mirrors core.events
   160	# _ELISION_MARKER_RE / _ELISION_PARAPHRASE_RE: an "<N chars … elided|full content …>"
   161	# render marker the model must never echo back into source.
   162	_EDIT_ELISION_RE = re.compile(
   163	    r"<\s*\d[\d,]*\s*chars\b[^>]*?\b(?:elided|full\s+content|placeholder)\b[^>]*>",
   164	    re.IGNORECASE,
   165	)
   166	
   167	# CD-TOOLS-1: the fresh-read REQUIREMENT applies only to files large enough that their content
   168	# is elided from the model's context view — i.e. over the arg-snip threshold (core.events
   169	# _ARG_SNIP_CHARS = 1500). Below it, a file_write's body / a read stays in context un-elided, so
   170	# the model reliably has the bytes and reproducing `old` is safe — requiring a read there would
   171	# only break legitimate small-file edits (Mode B is a LARGE-file phenomenon). The elision-MARKER
   172	# rejection is unconditional (a marker is never valid source, at any size).
   173	_GUARD_FRESH_READ_MIN_BYTES = 1_500
   174	
   175	
   176	def _has_elision_marker(*texts: str | None) -> bool:
   177	    return any(t is not None and _EDIT_ELISION_RE.search(t) is not None for t in texts)
   178	
   179	
   180	def record_read(
   181	    conv_id: str, path: str, *, sha: str, start_line: int, end_line: int, full: bool
   182	) -> None:
   183	    """CD-TOOLS-1: record that the model SAW lines [start_line, end_line] of `path`'s
   184	    CURRENT bytes (sha) un-elided. A new sha (the file changed) resets the ranges."""
   185	    if not isinstance(path, str) or not path:
   186	        return
   187	    reads = _conv_state(conv_id)["reads"]
   188	    key = _canonical(path)
   189	    rec = reads.get(key)
   190	    if rec is None or rec.get("sha") != sha:
   191	        rec = {"sha": sha, "ranges": [], "full": False}
   192	        reads[key] = rec
   193	    rec["ranges"].append((int(start_line), int(end_line)))
   194	    if full:
   195	        rec["full"] = True
   196	
   197	
   198	def _covers(ranges: list[tuple[int, int]], lo: int, hi: int) -> bool:
   199	    """True if the line span [lo,hi] is fully inside the union of shown ranges."""
   200	    need = set(range(lo, hi + 1))
   201	    for a, b in ranges:
   202	        need -= set(range(a, b + 1))
   203	        if not need:
   204	            return True
   205	    return not need
   206	
   207	
   208	def _fresh_read_required(path: str, why: str) -> ToolOutcome:
   209	    return ToolOutcome(
   210	        success=False,
   211	        error="FRESH_READ_REQUIRED",
   212	        content=(
   213	            f"Edit refused — {why}. Read {path} first (file_read), then edit using the exact "
   214	            "text you see. (This is a corrective nudge, not a failure — nothing was changed.)"
   215	        ),
   216	        structured={
   217	            "kind": "fresh_read_required",
   218	            "path": path,
   219	            "reason": why,
   220	            "next_required_action": "file_read",
   221	            "suggested_args": {"path": path},
   222	        },
   223	    )
   224	
   225	
   226	def guard_fresh_edit(
   227	    conv_id: str,
   228	    path: str,
   229	    *,
   230	    current_bytes: bytes,
   231	    old: str | None = None,
   232	    new: str | None = None,
   233	    edit_lines: tuple[int, int] | None = None,
   234	    anchored: bool = True,
   235	) -> ToolOutcome | None:
   236	    """CD-TOOLS-1 fresh-edit guard. Returns a BLOCKING ToolOutcome (the caller must NOT mutate
   237	    the file) when the model lacks fresh, complete grounding of the edit region — else None.
   238	
   239	    Checks, in order: (1) an internal elision marker in old/new → ELISION_MARKER_REJECTED;
   240	    (2) the file changed under the model since its last read → STALE_FILE_CONTEXT;
   241	    (3) the model has no current grounding since the last write (editing blind) → FRESH_READ_
   242	    REQUIRED; (4) the only grounding is a PARTIAL read not covering the edit region → FRESH_READ_
   243	    REQUIRED. `read_since_write` (set by file_read AND the workspace-snapshot pin / F9 dedup, and
   244	    CLEARED on every mutation) is the current-grounding signal — so a small file pinned in full,
   245	    or a freshly-read file, passes; the Mode-B case (wrote-then-edited a large elided file with
   246	    no fresh read) is blocked."""
   247	    import hashlib
   248	
   249	    if _has_elision_marker(old, new):
   250	        return ToolOutcome(
   251	            success=False,
   252	            error="ELISION_MARKER_REJECTED",
   253	            content=(
   254	                f"Edit refused — the edit text for {path} contains an internal elision "
   255	                "placeholder (e.g. '<… chars elided …>'); that marker is render-only and must "
   256	                "never be written into a file. Read the file, then edit with the real text."
   257	            ),
   258	            structured={
   259	                "kind": "elision_marker_rejected",
   260	                "path": path,
   261	                "next_required_action": "file_read",
   262	                "suggested_args": {"path": path},
   263	            },
   264	        )
   265	    # Small files stay fully in the model's context (never elided) → the model has the bytes;
   266	    # requiring a fresh read there would only break legitimate small-file edits.
   267	    if len(current_bytes) <= _GUARD_FRESH_READ_MIN_BYTES:
   268	        return None
   269	    sha = hashlib.sha256(current_bytes).hexdigest()
   270	    st = _read_state.get(conv_id) or {}
   271	    canon = _canonical(path)
   272	    rec = (st.get("reads") or {}).get(canon)
   273	    # [REL-RC-D] grounding for an EDIT comes from a genuine read OR — for ANCHORED callers only —
   274	    # from a prior host-validated anchored edit (edit_grounded) whose exact post-edit bytes the
   275	    # engine advanced the sha to, so back-to-back same-file anchored edits don't false-STALE.
   276	    # edit_grounded does NOT count for LINE-BASED callers (file_replace_lines / file_insert_lines,
   277	    # anchored=False): an anchored edit shifts line numbers, so their numeric targets could be stale
   278	    # even though the file's bytes are known — they must re-read. (file_write checks read_since_write
   279	    # only, so a blind rewrite-from-memory still requires a real read regardless.)
   280	    grounded = canon in (st.get("read_since_write") or set()) or (
   281	        anchored and canon in (st.get("edit_grounded") or set())
   282	    )
   283	    if rec is not None and rec.get("sha") != sha:
   284	        return ToolOutcome(
   285	            success=False,
   286	            error="STALE_FILE_CONTEXT",
   287	            content=(
   288	                f"Edit refused — {path} has changed since you last read it, so your edit text "
   289	                "may target stale content. Read it again (file_read), then edit."
   290	            ),
   291	            structured={
   292	                "kind": "stale_file_context",
   293	                "path": path,
   294	                "next_required_action": "file_read",
   295	                "suggested_args": {"path": path},
   296	            },
   297	        )
   298	    if not grounded:
   299	        return _fresh_read_required(
   300	            path, "you have not read this file's current content since it last changed"
   301	        )
   302	    # grounded, current sha: if the only sha-aware grounding is a PARTIAL read (not the whole
   303	    # file), the edited region must fall inside what was actually read. A FULL read (rec.full)
   304	    # covers everything, so it is exempt. When the region is UNDETERMINED (edit_lines is None —
   305	    # e.g. file_edit/file_str_replace matched `old` via the forgiving/whitespace-tolerant path
   306	    # after an exact find missed), we cannot prove the mutated lines were seen → fail closed so a
   307	    # partial read can't mutate unread lines (Codex round-1).
   308	    if rec is not None and not rec.get("full"):
   309	        if edit_lines is None:
   310	            return _fresh_read_required(
   311	                path,
   312	                "could not confirm the exact lines you are editing were in the part of the file "
   313	                "you read",
   314	            )
   315	        if not _covers(rec.get("ranges", []), edit_lines[0], edit_lines[1]):
   316	            return _fresh_read_required(
   317	                path, "the lines you are editing were not in the part of the file you read"
   318	            )
   319	    return None
   320	
   321	
   322	def reground_after_anchored_edit(conv_id: str, path: str, new_bytes: bytes) -> None:
   323	    """[REL-RC-D] After a HOST-VALIDATED ANCHORED edit (file_edit / file_str_replace / exact_replace
   324	    — the model's `old` text is matched against LIVE disk content and the engine computes the exact
   325	    result), ADVANCE the file's grounding to the just-written bytes instead of discarding it.
   326	
   327	    Root cause this fixes: the successful-mutation paths discarded only the coarse read_since_write
   328	    bit and left `reads[path].sha` at the PRE-edit value. So the model's OWN next same-file edit saw
   329	    rec.sha(v1) != disk_sha(v2) and was refused as STALE_FILE_CONTEXT — the guard misreporting a
   330	    tracked, deterministic, host-validated edit as EXTERNAL drift. Back-to-back same-file edits then
   331	    wedged the loop into STUCK (the REL-RC-D revise_thrice failure).
   332	
   333	    Preserves the PRIOR grounding SHAPE (Codex plan gate): keep whole-file grounding ONLY if the
   334	    read was already full; NEVER promote a partial read to whole-file. A partial/absent prior
   335	    grounding is DROPPED (not advanced) — advancing it would either lie about whole-file knowledge
   336	    or carry line ranges that this edit may have shifted; the next edit then honestly requires a
   337	    fresh read (auto-groundable) rather than inheriting a stale-but-fresh-sha partial window.
   338	
   339	    Grounding is granted on the SEPARATE `edit_grounded` signal, NOT `read_since_write`: an anchored
   340	    edit lets the model make its NEXT anchored edit (guard_fresh_edit honors edit_grounded), but the
   341	    coarse read bit stays cleared so a blind full file_write is STILL refused until a genuine read
   342	    (the Mode-B rewrite-from-memory protection is untouched).
   343	
   344	    Deliberately NOT called for line-based edits (file_replace_lines / file_insert_lines) or
   345	    full/blind writes (file_write / file_append / safe_write_file) or external mutations (run_script):
   346	    a later numeric line target or a from-memory rewrite can be stale even under a correct fresh sha,
   347	    so those keep clearing grounding and force a real re-read."""
   348	    import hashlib
   349	
   350	    canon = _canonical(path)
   351	    st = _conv_state(conv_id)
   352	    prior = (st.get("reads") or {}).get(canon)
   353	    # The read bit is always cleared on mutation (a blind full rewrite still needs a fresh read).
   354	    st["read_since_write"].discard(canon)
   355	    if prior is not None and prior.get("full"):
   356	        # Whole-file grounding stays whole-file, advanced to the post-edit bytes the engine wrote,
   357	        # and re-grants EDIT grounding so the model's own next anchored edit isn't false-STALE.
   358	        new_line_count = new_bytes.count(b"\n") + 1
   359	        st["reads"][canon] = {
   360	            "sha": hashlib.sha256(new_bytes).hexdigest(),
   361	            "full": True,
   362	            "ranges": [(1, new_line_count)],
   363	        }
   364	        st["edit_grounded"].add(canon)
   365	    else:
   366	        # Partial/absent grounding: drop the stale sha record so it can't produce a FALSE
   367	        # STALE_FILE_CONTEXT, and clear edit grounding → the next edit gets an honest
   368	        # FRESH_READ_REQUIRED (never promote partial context to whole-file).
   369	        (st.get("reads") or {}).pop(canon, None)
   370	        st["edit_grounded"].discard(canon)
   371	
   372	
   373	def _canonical(path: str) -> str:
   374	    """Canonical tracker key so the read-before-rewrite guard can't be bypassed by
   375	    spelling the same file differently. Strips the redundant workspace prefix
   376	    ('workspace/foo' == '/workspace/foo' == 'foo') AND normalizes './', '//' and
   377	    '../' segments ('./x.py' == 'x.py') via posixpath.normpath, so a read of one
   378	    spelling and a mutate of another resolve to ONE key."""
   379	    import posixpath
   380	
   381	    return posixpath.normpath(strip_redundant_workspace_prefix(path))
   382	
   383	
   384	def _number_lines(text: str, start: int = 1) -> str:
   385	    """Render text with right-aligned 1-based line numbers + a tab, so the model
   386	    can target precise ranges with file_replace_lines / file_insert_lines — the
   387	    robust way to edit a large file without reproducing its exact bytes."""
   388	    lines = text.splitlines()
   389	    if not lines:
   390	        return ""

