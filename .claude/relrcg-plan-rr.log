    69	# Per-conversation read-before-rewrite tracker (F1).
    70	# Structure: {conv_id: {"read_since_write": set[str]}}
    71	#   read_since_write: canonical paths (workspace-prefix-stripped) for which a
    72	#     successful FileReadTool.run has occurred since the path's last successful
    73	#     mutation (file_write / file_append / file_edit / file_replace_lines /
    74	#     file_insert_lines / file_str_replace) in this conversation.
    75	#     A write to a path that (a) EXISTS on disk AND (b) is NOT in this set is
    76	#     REFUSED — the model must file_read the file first.
    77	#     A NEW file (does not exist yet) is always allowed.
    78	# Module-level so it's per-process; the per-conversation key keeps state
    79	# isolated between agents/sessions. Applies to ALL model tiers (not gated on
    80	# ctx.assist) — the thrash root-cause hits capable models too.
    81	_read_state: dict[str, dict[str, Any]] = {}
    82	
    83	
    84	def reset_read_tracker() -> None:
    85	    """Clear all per-conversation read-since-write state. Tests only; not part
    86	    of the tool API."""
    87	    _read_state.clear()
    88	
