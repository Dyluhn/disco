    38	@dataclass
    39	class FileSnap:
    40	    """Per-path snapshot record: the SHA and seq of the last full-body render."""
    41	
    42	    last_seen_seq: int  # event seq at which the snapshot last showed this file
    43	    sha: str  # hex sha256 of the content bytes (content-addressed, not mtime)
    44	    mtime: float | None = None  # optional, for future diagnostics only
