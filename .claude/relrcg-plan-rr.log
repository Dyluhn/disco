   844	            "Matching is forgiving (tolerates indentation / trailing-space drift and "
   845	            "pasted-in line numbers). This is the SAFEST targeted edit — it anchors on "
   846	            "the text you give, so it can't hit the wrong place. For a large file, read "
   847	            "the relevant section first (file_read with offset/limit) and pass that exact "
   848	            "snippet as `old`."
   849	        ),
   850	        args_model=FileEditArgs,
   851	        needs=_FS,
   852	        runs_in="sandbox",
   853	    )
   854	
   855	    async def run(self, args: FileEditArgs, ctx: ToolContext) -> ToolOutcome:
   856	        assert ctx.sandbox is not None
   857	        if (g := await _governed_guard(ctx.sandbox, args.path)) is not None:
   858	            return g
   859	        # Intent no-op: old and new are LITERALLY identical (after stripping any
   860	        # line-number prefixes the model copied). This is distinct from a
   861	        # whitespace-only edit (old≠new, which must apply) — here the model asked
   862	        # for no change at all, so refuse before touching the file regardless of how
   863	        # the file's own whitespace happens to differ. The ground-truth guard below
   864	        # still catches the "applied result is unchanged" case.
   865	        if _strip_line_numbers(args.old) == _strip_line_numbers(args.new):
   866	            return ToolOutcome(
   867	                success=False,
   868	                content=(
   869	                    f"file_edit refused: `old` and `new` are identical — this asks for "
   870	                    f"no change to {args.path}. If you already applied this edit, move "
   871	                    "on; otherwise give the NEW content you want."
   872	                ),
   873	                error="no_op_edit",
   874	            )
   875	        _raw = await ctx.sandbox.read_file(args.path)
   876	        text = _raw.decode("utf-8", errors="replace")
   877	        # CD-TOOLS-1 fresh-edit guard: refuse (no mutation) when the model lacks fresh/complete/
   878	        # un-elided grounding of the edit region. Compute the region from `old`'s exact location.
   879	        _idx = text.find(args.old)
   880	        _elines = (
   881	            (text.count("\n", 0, _idx) + 1, text.count("\n", 0, _idx) + 1 + args.old.count("\n"))
   882	            if _idx >= 0
   883	            else None
   884	        )
   885	        _blocked = guard_fresh_edit(
   886	            ctx.conversation_id,
   887	            args.path,
   888	            current_bytes=_raw,
   889	            old=args.old,
   890	            new=args.new,
   891	            edit_lines=_elines,
   892	        )
   893	        if _blocked is not None:
   894	            return _blocked
   895	        updated, how = _forgiving_replace(text, args.old, _strip_line_numbers(args.new))
   896	        if updated is None:
   897	            return ToolOutcome(
   898	                success=False,
   899	                content=(
   900	                    f"`old` not found in {args.path} (tried exact + whitespace-tolerant)."
   901	                    + _nearest_anchor(text, args.old)
   902	                    + " Tip: read the file for line numbers, then use file_replace_lines."
   903	                ),
   904	                error="old_text_not_found",
   905	            )
   906	        # No-op guard, on GROUND TRUTH: refuse only when the replacement leaves the
   907	        # file byte-identical. Checking the *applied* result (not an abstract
   908	        # old-vs-new compare) lets a legitimate whitespace-only edit through — a
   909	        # re-indent or trailing-space cleanup matches ws-tolerantly but writes
   910	        # `new` verbatim, so `updated != text` and it applies — while still catching
   911	        # the real no-op: an already-applied edit (or old≈new) that changes nothing.
