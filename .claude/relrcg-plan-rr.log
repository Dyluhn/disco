    44	# Static so a unit test can assert on it; worded so the weak-model tier picks
    45	# the cheap, deterministic path (grep → targeted read) over a full dump.
    46	_PRESSURE_DIRECTIVE = (
    47	    "file is large; the full page is suppressed. Do NOT re-read this file "
    48	    "whole — pick the symbol/class/section you need, then either:\n"
    49	    "  (a) run a grep/ripgrep tool to locate it (e.g. `rg -n 'Symbol' <path>`), "
    50	    "then file_read a targeted line range (`offset=<n>, limit=<m>`); or\n"
    51	    "  (b) file_read a small line range directly to scan structure.\n"
    52	    "Reading this file whole again will just be truncated the same way."
