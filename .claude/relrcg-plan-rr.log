    37	        ),
    38	        args_model=ShellExecArgs,
    39	        needs=frozenset({Capability.SHELL}),
    40	        runs_in="sandbox",
    41	        read_only=False,
    42	        base_risk=SecurityRisk.MEDIUM,
    43	    )
    44	
    45	    async def run(self, args: ShellExecArgs, ctx: ToolContext) -> ToolOutcome:
    46	        if not ctx.sessions:
    47	            return _fail("Session manager not available.")
    48	        try:
