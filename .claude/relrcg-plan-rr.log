    46	
    47	class FileStateTracker:
    48	    """Mutable per-ViewBuilder tracker: records which files have been shown
    49	    in full and with what content SHA. Used by ``workspace_snapshot_message``
    50	    to decide full-body vs. one-line pointer rendering each turn.
    51	
    52	    Content-SHA comparison (not mtime, not a filesystem watcher) is sandbox-
    53	    robust: it works in gVisor / fake-FS sandboxes, and a no-op ``touch``
    54	    (mtime changes, content does not) never triggers a false positive.
    55	
    56	    Thread/async safety: the tracker is accessed only from the
    57	    ``ViewBuilder.build`` critical section (which runs under the conversation
    58	    lock in the loop). No internal locking is needed.
    59	    """
    60	
    61	    def __init__(self) -> None:
    62	        self._snaps: dict[str, FileSnap] = {}
    63	
    64	    # ------------------------------------------------------------------
    65	    # Mutation API
    66	    # ------------------------------------------------------------------
    67	
    68	    def record_agent_io(
    69	        self,
    70	        path: str,
    71	        content: str | bytes,
    72	        seq: int,
    73	        mtime: float | None = None,
    74	    ) -> None:
    75	        """Record that the agent (or snapshot) last saw ``path`` with
    76	        ``content``. Updates the per-path SHA so a subsequent
    77	        ``stale_paths`` call can determine whether the disk content has
    78	        changed since.
    79	
    80	        Call after:
    81	          * A successful file_read (agent pulled the file).
    82	          * A successful file_write / file_edit / file_append (pre-register
    83	            the new SHA so the self-write is NOT flagged as external
    84	            staleness on the NEXT snapshot build).
    85	          * ``workspace_snapshot_message`` showing a file in full (the
    86	            snapshot function calls this itself; callers need not duplicate
    87	            it after a snapshot build).
    88	        """
    89	        if not isinstance(path, str) or not path:
    90	            return
    91	        byt = (
    92	            content.encode("utf-8", "replace")
    93	            if isinstance(content, str)
    94	            else content
    95	        )
    96	        sha = hashlib.sha256(byt).hexdigest()
    97	        self._snaps[path] = FileSnap(last_seen_seq=seq, sha=sha, mtime=mtime)
    98	
    99	    # ------------------------------------------------------------------
   100	    # Query API
   101	    # ------------------------------------------------------------------
   102	
   103	    def is_known(self, path: str) -> bool:
   104	        """True iff this path has been shown in full at least once in this
   105	        session (i.e., an entry exists in the tracker)."""
   106	        return path in self._snaps
   107	
   108	    def get_sha(self, path: str) -> str | None:
   109	        """The hex-sha256 of the last-shown content, or None if never shown."""
   110	        snap = self._snaps.get(path)
   111	        return snap.sha if snap is not None else None
   112	
   113	    # ------------------------------------------------------------------
   114	    # Async staleness scan
   115	    # ------------------------------------------------------------------
   116	
   117	    async def stale_paths(
   118	        self,
   119	        sbx: object,
   120	        working_set: list[str],
   121	    ) -> list[str]:
   122	        """Return the subset of ``working_set`` paths whose current disk SHA
   123	        diverges from the last-seen SHA recorded in this tracker.
   124	
   125	        Paths that have never been shown (not in the tracker) are SKIPPED —
   126	        they are "never-shown" and handled separately by the snapshot's
   127	        full-body branch. Sandboxed reads are timeout-guarded and swallow
   128	        common filesystem exceptions (the path may have been deleted,
   129	        permissions changed, etc.) — a file we cannot read is conservatively
   130	        treated as "not stale" (the snapshot will handle the missing case).
   131	
   132	        This is a pure DETECTION scan; it does NOT update the tracker.
   133	        """
   134	        stale: list[str] = []
   135	        for path in working_set:
   136	            snap = self._snaps.get(path)
   137	            if snap is None:
   138	                continue  # never shown → "never-shown", not "stale"
   139	            try:
   140	                raw = await asyncio.wait_for(
   141	                    sbx.read_file(path),  # type: ignore[attr-defined]
   142	                    timeout=_STALE_READ_TIMEOUT_S,
   143	                )
   144	            except (FileNotFoundError, TimeoutError, PermissionError, OSError):
   145	                continue  # cannot read → treat conservatively as not stale
   146	            disk_sha = hashlib.sha256(raw).hexdigest()
   147	            if disk_sha != snap.sha:
   148	                stale.append(path)
   149	        return stale
   150	
   151	
   152	# ---------------------------------------------------------------------------
   153	# Pure helper: stale notice message
   154	# ---------------------------------------------------------------------------
   155	
   156	
   157	def file_state_notice(stale: list[str]) -> LLMMessage | None:
   158	    """Pure function: return None when ``stale`` is empty (SILENT — the
   159	    common no-change fast-path); otherwise return a concise user-role
   160	    message listing ONLY the stale paths.
   161	
   162	    The notice uses a NAMED heading (``_STALE_NOTICE_SENTINEL``) so tests
   163	    and the snapshot function can detect it reliably. The body is minimal —
   164	    it names the paths and says what to do (file_read before editing); it
   165	    does NOT reproduce file content (that is the snapshot's job).
   166	
   167	    Callers: ``ViewBuilder.build`` passes the list from
   168	    ``FileStateTracker.stale_paths``, which already filters to known paths
   169	    with changed disk SHA.
   170	    """
   171	    if not stale:
   172	        return None
   173	    lines = [
   174	        f"{_STALE_NOTICE_SENTINEL} since you last read them",
   175	        "The following files were modified externally (not by your tool calls).",
   176	        "Use `file_read` on each before editing to avoid overwriting the newer version:",
   177	    ]
   178	    lines.extend(f"  - {p}" for p in stale)
   179	    return LLMMessage(role="user", content="\n".join(lines))

