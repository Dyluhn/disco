    90	def mark_read(conv_id: str, path: str) -> None:
    91	    """Set the read-since-write bit for `path` in `conv_id` WITHOUT executing a
    92	    real file_read.
    93	
    94	    The bit is normally set only inside ``FileReadTool.run`` (an explicit
    95	    model-issued read of disk bytes). But the agent loop can put a file's CURRENT
    96	    content in front of the model by OTHER grounded means that never reach the
    97	    tool:
    98	
    99	      * the CURRENT WORKSPACE snapshot pins the file's full, disk-fresh bytes in
   100	        the prompt this turn (view_render ``out_pinned_full``); and
   101	      * the F9 read-dedup short-circuits an identical re-read into a pointer at
   102	        the current bytes (the prior read's result), never calling the executor.
   103	
   104	    In BOTH cases the model HAS the file's current content — a subsequent
   105	    file_write is genuinely grounded, NOT a blind rewrite-from-memory. Yet the
   106	    read-before-write gate (keyed on this set) would refuse it because no
   107	    ``FileReadTool.run`` fired, leaving the model unable to read (it only gets a
   108	    pointer/snapshot) AND unable to write (gated) → the unrecoverable
   109	    file_write loop that drove the live shell-exec fallback. The loop calls this
   110	    to record those snapshot-/dedup-backed grounded reads so the gate clears.
   111	
   112	    Canonicalizes the path the same way the gate does, so a snapshot path and a
   113	    later write spelling resolve to one key."""
   114	    if not isinstance(path, str) or not path:
   115	        return
   116	    _conv_state(conv_id)["read_since_write"].add(_canonical(path))
   117	
   118	
   119	def clear_conversation_read_state(conv_id: str) -> None:
   120	    """Remove the F1 tracker entry for a single conversation.
   121	
   122	    Called by DefaultToolExecutor.kill() so the module-level dict does not
   123	    grow unbounded in long-running processes (each killed executor cleans up
   124	    its own per-conversation bucket).  The per-conversation-id key design
   125	    already prevents cross-conversation leaks; this call prevents the dict
   126	    from accumulating dead entries indefinitely.
   127	
   128	    Tests should use reset_read_tracker() for a full clear between runs."""
   129	    _read_state.pop(conv_id, None)
   130	
   131	
   132	def _conv_state(conv_id: str) -> dict[str, Any]:
   133	    s = _read_state.get(conv_id)
   134	    if s is None:
   135	        # read_since_write: the coarse F1 bit (path grounded since last write).
   136	        # reads: CD-TOOLS-1 sha-aware per-path read records for the fresh-edit guard —
   137	        #   {canonical_path: {"sha": <full-file sha at read>, "ranges": [(start,end)],
   138	        #    "full": bool}}. `ranges` are 1-based inclusive line spans the model SAW
   139	        #   un-elided (a real file_read page); `full` is True for a whole-file read.
   140	        s = {"read_since_write": set(), "edit_grounded": set(), "reads": {}}
   141	        _read_state[conv_id] = s
   142	    s.setdefault("reads", {})  # back-compat for buckets created before CD-TOOLS-1
   143	    s.setdefault("edit_grounded", set())  # back-compat for buckets created before REL-RC-D
   144	    return s
   145	
   146	
   147	def _clear_grounding(conv_id: str, path: str) -> None:
   148	    """[REL-RC-D] Fully un-ground `path`: drop BOTH the read-since-write bit AND the edit-grounded
   149	    bit. Called by every NON-anchored mutation (full/blind file_write & file_append & safe_write,
   150	    line-based file_replace_lines & file_insert_lines, and external run_script edits) — after any of
   151	    those the model must do a genuine fresh read before it can edit or rewrite again."""
   152	    canon = _canonical(path)
   153	    st = _conv_state(conv_id)
   154	    st["read_since_write"].discard(canon)
   155	    st["edit_grounded"].discard(canon)
