  1210	def _all_occurrences(text: str, sub: str) -> list[int]:
  1211	    """Non-overlapping start offsets of `sub` in `text` (advances by len(sub))."""
  1212	    out: list[int] = []
  1213	    if not sub:
  1214	        return out
  1215	    i = text.find(sub)
  1216	    while i != -1:
  1217	        out.append(i)
  1218	        i = text.find(sub, i + len(sub))
  1219	    return out
