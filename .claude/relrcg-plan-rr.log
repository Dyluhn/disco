   916	                    f"file_edit refused: this edit leaves {args.path} unchanged — the "
   917	                    "new content already matches what's on disk (it may have been "
   918	                    "applied on an earlier turn). No further action is needed; move on."
   919	                ),
   920	                error="no_op_edit",
   921	            )
