    21	# A read result longer than the observation snip cap (events._OBS_SNIP_CHARS=8000)
    22	# gets destructively snipped (head+tail) at context ingestion, leaving the model a
    23	# corrupted middle — so it re-reads forever and never commits an edit (observed
    24	# live). So file_read PAGES by a CHARACTER budget kept safely under that cap: each
    25	# read returns intact, line-numbered lines + an explicit "read more with offset=…".
    26	_READ_CHAR_BUDGET = 7_000
    27	
    28	# F7 — pressure-aware head-only.
    29	#
    30	# LIMITATION: ToolContext exposes `assist` but not the condenser's token_count
    31	# pressure signal (that lives in engine.py / view.py and isn't threaded into the
    32	# tool call). So we gate on `assist=True` + a LARGE-FILE SIZE HEURISTIC: files
    33	# whose total content exceeds twice the read char budget are the ones that
    34	# today's paging has to split across multiple pages anyway — exactly the
    35	# payload size that gets most-corrupted by the snip pass and most-likely to
    36	# push the model into the next condenser tick. For those, we return only a
    37	# small HEAD slice and a prescriptive directive (grep, then file_read a
    38	# targeted line range) so the model stops dumping whole files into context
    39	# when it's already close to the limit. Assist-OFF behavior is unchanged.
    40	_PRESSURE_HEAD_BUDGET = 2_000  # head-only slice when the gate fires (well under the snip cap)
    41	# 14_000 — files that would otherwise span multiple pages
    42	_PRESSURE_FILE_THRESHOLD = _READ_CHAR_BUDGET * 2
