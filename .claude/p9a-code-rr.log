   152	
   153	    def _validate_numeric(self) -> None:
   154	        lo, hi, step = self.min, self.max, self.step
   155	        if lo is None or hi is None or step is None:
   156	            raise ValueError("int/float require min/max/step")
   157	        if not (_is_real(lo) and _is_real(hi) and _is_real(step)):
   158	            raise ValueError("min/max/step must be finite numbers (no bool/NaN/inf)")
