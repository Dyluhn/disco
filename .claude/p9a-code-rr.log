   121	        if self.options is not None and ed is not TweakEditor.ENUM:
   122	            raise ValueError("options only valid for enum")
   123	        if self.colors is not None and ed is not TweakEditor.PALETTE:
   124	            raise ValueError("colors only valid for palette")
   125	        if (self.min, self.max, self.step) != (None, None, None) and ed not in _NUMERIC:
   126	            raise ValueError("min/max/step only valid for int/float")
   127	        # GROUNDED invariant
   128	        if not self.controls_behavior and not self.affects:
   129	            raise ValueError(f"tweak {self.key!r} is ungrounded: needs controls_behavior or affects")
   130	        if ed in (TweakEditor.TEXT, TweakEditor.COLOR) and not self.controls_behavior and len(self.affects) < 2:
   131	            raise ValueError(
   132	                f"{ed.value} tweak {self.key!r} must control behavior or >=2 fields (else use a direct edit)"
   133	            )
   134	        # per-editor constraints
   135	        if ed is TweakEditor.ENUM:
   136	            if not self.options:
   137	                raise ValueError("enum requires non-empty options")
   138	            if len(set(self.options)) != len(self.options):
   139	                raise ValueError("enum options must be unique")
   140	        if ed is TweakEditor.PALETTE:
   141	            cols = self.colors or ()
   142	            if not 2 <= len(cols) <= 5:
   143	                raise ValueError("palette requires 2..5 colors")
   144	            if len(set(cols)) != len(cols):
   145	                raise ValueError("palette colors must be unique")
