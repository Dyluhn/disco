    69	class TweakField(BaseModel):
    70	    """One owner control: its editor + constraints + what it grounds onto (``affects``)."""
    71	
    72	    model_config = ConfigDict(frozen=True, extra="forbid")
    73	
    74	    key: str
    75	    label: str
    76	    editor: TweakEditor
    77	    affects: tuple[str, ...] = ()  # LEXICAL AppSpec paths it controls (validated vs spec in P9B/C)
    78	    controls_behavior: bool = False
    79	    default: Any = None
    80	    options: tuple[str, ...] | None = None  # ENUM
    81	    colors: tuple[str, ...] | None = None  # PALETTE swatches
    82	    min: float | None = None  # INT/FLOAT
    83	    max: float | None = None
    84	    step: float | None = None
