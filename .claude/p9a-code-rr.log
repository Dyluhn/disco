    94	                    raise ValueError(f"{k} must be a number, not a bool")
    95	            # canonicalize palette swatches up front (frozen model can't mutate post-construction).
    96	            # Require an ORDERED list/tuple — reject set/frozenset (pydantic would coerce those to
    97	            # a tuple AFTER this hook, bypassing canonicalization + losing swatch order).
