   104	        return data
   105	
   106	    @model_validator(mode="after")
   107	    def _validate(self) -> TweakField:
   108	        if not _KEY_RE.match(self.key):
   109	            raise ValueError(f"key must match dotted-path pattern, got {self.key!r}")
   110	        if not self.label.strip():
