    62	
    63	def _step_aligned(value: float, lo: float, step: float) -> bool:
    64	    """(value - lo) is an exact integer multiple of step — integer-scaled, no float modulo."""
    65	    q = (Decimal(str(value)) - Decimal(str(lo))) / Decimal(str(step))
    66	    return q == q.to_integral_value()
