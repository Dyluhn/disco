    86	    @model_validator(mode="before")
    87	    @classmethod
    88	    def _normalize(cls, data: Any) -> Any:
    89	        if isinstance(data, dict):
    90	            # reject bool numeric bounds BEFORE pydantic coerces False->0.0 (default may be a
    91	            # bool — that's valid for the boolean editor — so only guard min/max/step here).
    92	            for k in ("min", "max", "step"):
