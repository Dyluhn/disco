   113	        # TEXT/COLOR tweak can't satisfy ">=2 fields" with a repeated path).
   114	        for path in self.affects:
   115	            if not _KEY_RE.match(path):
   116	                raise ValueError(f"affects path {path!r} must be a dotted lexical path")
   117	        if len(set(self.affects)) != len(self.affects):
   118	            raise ValueError("affects paths must be unique")
