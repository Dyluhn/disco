     1	"""OutputTruthOracle (guidelines §11.5, §16).
     2	
     3	If the run says it FINISHED, the claimed output must actually exist (§7 truth
     4	hierarchy: a model/agent saying "the build worked" never overrides workspace /
     5	preview truth).
     6	
     7	Checks (only when the run reached a finished/verified terminal state AND the
     8	scenario asserts output):
     9	  * required workspace files exist             -> FALSE_FINISH_NO_OUTPUT
    10	  * required file contents present (must_contain) -> ARTIFACT_TRUTH_MISMATCH
    11	  * preview health passes (when required)      -> FALSE_FINISH_PREVIEW_BROKEN
    12	  * preview content present (must_contain)     -> PREVIEW_TRUTH_MISMATCH
    13	
    14	Evidence shapes (captured by the runner; supplied as plain dicts):
    15	  workspace_manifest: {"<relpath>": "<file content>", ...}
    16	                  or  {"<relpath>": {"content": "..."}, ...}
    17	                  or  {"files": {"<relpath>": "...", ...}}
    18	  preview: {"health": {"status": 200|404|...}, "content": "<served html>"}
    19	"""
    20	
    21	from __future__ import annotations
    22	
    23	from typing import Any
    24	
    25	from disco.core.observations import scan_for_destructive_elision
    26	
    27	from .. import failure_codes as fc
    28	from ..events import terminal_status
    29	from .schema import OracleResult, failing, passing, skipping
    30	
    31	_ORACLE = "OutputTruthOracle"
    32	
    33	_FINISHED_STATES = frozenset({"FINISHED", "VERIFIED"})
    34	
    35	# A content mismatch on a file captured on one of these NON-AUTHORITATIVE bases (the snapshot
    36	# readiness gate accepted it via extended content-stability, with NO file_write raw-sha and no
    37	# qualifying full readback) is UNRELIABLE — the capture may be a stale pre-flush copy. Any
    38	# OTHER proof level (raw_sha / rendered_readback / absent) OR an UNANNOTATED entry (a legacy /
    39	# proxy capture with no `proof` key — treated as authoritative so we never silently downgrade)
    40	# is PROVEN and a mismatch on it stays a hard ARTIFACT_TRUTH_MISMATCH.
    41	_NON_AUTHORITATIVE_PROOF = frozenset({"unproven_extended_stability", "unknown"})
    42	
    43	
    44	def _nested_files(manifest: dict[str, Any] | None) -> dict[str, Any]:
    45	    if not manifest:
    46	        return {}
    47	    nested = manifest.get("files")
    48	    return nested if isinstance(nested, dict) else manifest
    49	
    50	
    51	def _normalize_workspace(manifest: dict[str, Any] | None) -> dict[str, str]:
    52	    out: dict[str, str] = {}
    53	    for path, val in _nested_files(manifest).items():
    54	        if isinstance(val, dict):
    55	            out[str(path)] = str(val.get("content", ""))
    56	        else:
    57	            out[str(path)] = str(val)
    58	    return out
    59	
    60	
    61	def _proof_for(manifest: dict[str, Any] | None, path: str) -> str | None:
    62	    """The recorded acceptance proof level for a declared path, or None when the entry is a
    63	    plain string / carries no `proof` (legacy / proxy capture → treated as authoritative)."""
    64	    files = _nested_files(manifest)
    65	    entry = files.get(path)
    66	    if entry is None:
    67	        entry = files.get(path.lstrip("/"))
    68	    if isinstance(entry, dict):
    69	        proof = entry.get("proof")
    70	        return str(proof) if proof is not None else None
    71	    return None
    72	
    73	
    74	def _fold_content_mismatches(mismatches: list[dict[str, Any]]):
    75	    """DETERMINISTIC PRECEDENCE fold over ALL workspace-content mismatches in the run
    76	    (Part A). A mismatch is AUTHORITATIVE unless its file's proof is non-authoritative
    77	    (`unproven_extended_stability` / `unknown`). If ANY mismatch is authoritative → a hard
    78	    ``ARTIFACT_TRUTH_MISMATCH`` (the proven regression WINS; never masked). ONLY if EVERY
    79	    mismatch is non-authoritative → INVALID_RUN ``WORKSPACE_SNAPSHOT_UNVERIFIED`` (the capture
    80	    is too uncertain to call a product failure). The full per-file evidence (proof + path +
    81	    check class) rides in `facts["mismatches"]` either way."""
    82	    proven = [m for m in mismatches if m.get("proof") not in _NON_AUTHORITATIVE_PROOF]
    83	    first = mismatches[0]
    84	    facts: dict[str, Any] = {
    85	        "mismatches": mismatches,
    86	        "proven_mismatch_count": len(proven),
    87	        "unverified_mismatch_count": len(mismatches) - len(proven),
    88	        # Back-compat top-level keys (the first mismatch) for existing triage/tests.
    89	        "path": first.get("path"),
    90	    }
    91	    if "missing_substring" in first:
    92	        facts["missing_substring"] = first["missing_substring"]
    93	    if proven:
    94	        return failing(
    95	            _ORACLE,
    96	            fc.ARTIFACT_TRUTH_MISMATCH,
    97	            first_broken_link="finish -> required_content_present",
    98	            facts=facts,
    99	        )
   100	    return failing(
   101	        _ORACLE,
   102	        fc.WORKSPACE_SNAPSHOT_UNVERIFIED,
   103	        first_broken_link="finish -> snapshot_content_verifiable",
   104	        facts=facts,
   105	    )
   106	
   107	
   108	class OutputTruthOracle:
   109	    def check(
   110	        self,
   111	        events: list[dict[str, Any]],
   112	        *,
   113	        scenario: dict[str, Any] | None = None,
   114	        workspace_manifest: dict[str, Any] | None = None,
   115	        preview: dict[str, Any] | None = None,
   116	    ) -> list[OracleResult]:
   117	        assertions = (scenario or {}).get("assertions") or {}
   118	        workspace_assert = assertions.get("workspace") or {}
   119	        preview_assert = assertions.get("preview") or {}
   120	        wants_output = bool(workspace_assert.get("files")) or bool(preview_assert.get("required"))
   121	
   122	        if not wants_output:
   123	            return [skipping(_ORACLE, reason="scenario asserts no output truth")]
   124	
   125	        term = terminal_status(events)
   126	        terminal_expected = (scenario or {}).get("assertions", {}).get("terminal_status_in")
   127	        finished = term in _FINISHED_STATES or (
   128	            bool(terminal_expected) and term in set(terminal_expected)
   129	        )
   130	        if not finished:
   131	            # FAIL-CLOSED (migration 2026_06_24_paused_incomplete_not_pass): we only reach
   132	            # here when the scenario REQUIRES output (wants_output) and/or a finished
   133	            # terminal, but the run never reached one — e.g. the no-progress / actionless
   134	            # valve PAUSED it, it timed out, or it ended at an unhandled gate. This is NOT a
   135	            # "false finish" (nothing claimed finished) and it is NOT a PASS: a build that
   136	            # does not complete is a failure even if some files happen to exist on disk.
   137	            # Previously this SKIPPED, which let a paused-incomplete run score PASS — the
   138	            # live-surfaced adjudicator gap (surfaced-bugs Bug 8 / conv_c0ff8684...).
   139	            return [
   140	                failing(
   141	                    _ORACLE,
   142	                    fc.BUILD_DID_NOT_FINISH,
   143	                    first_broken_link="required_finish -> terminal_status",
   144	                    facts={
   145	                        "terminal_status": term,
   146	                        "terminal_status_in": terminal_expected,
   147	                        "reason": "run required to finish + deliver output but never reached "
   148	                        "a finished/required terminal",
   149	                    },
   150	                )
   151	            ]
   152	
   153	        files = _normalize_workspace(workspace_manifest)
   154	
   155	        # --- workspace file existence + content truth ---
   156	        # Existence is judged FIRST and hard (a missing required deliverable is FALSE_FINISH,
   157	        # never softened). Content checks (must_contain / must_not_contain / exact) across ALL
   158	        # asserted files are COLLECTED with each file's capture proof level, then folded by
   159	        # deterministic precedence (Part A): one PROVEN mismatch makes the whole run a hard
   160	        # ARTIFACT_TRUTH_MISMATCH; all-non-authoritative → INVALID_RUN snapshot-unverified.
   161	        content_mismatches: list[dict[str, Any]] = []
   162	        for spec in workspace_assert.get("files") or []:
   163	            path = spec.get("path")
   164	            if path is None:
   165	                continue
   166	            if path not in files:
   167	                return [
   168	                    failing(
   169	                        _ORACLE,
   170	                        fc.FALSE_FINISH_NO_OUTPUT,
   171	                        first_broken_link="finish -> required_file_exists",
   172	                        facts={"required_path": path, "present_paths": sorted(files)},
   173	                    )
   174	                ]
   175	            content = files[path]
   176	            proof = _proof_for(workspace_manifest, path)
   177	            for needle in spec.get("must_contain") or []:
   178	                if needle not in content:
   179	                    content_mismatches.append({
   180	                        "path": path, "check": "must_contain",
   181	                        "missing_substring": needle, "proof": proof,
   182	                    })
   183	            for needle in spec.get("must_not_contain") or []:
   184	                if needle in content:
   185	                    content_mismatches.append({
   186	                        "path": path, "check": "must_not_contain",
   187	                        "forbidden_substring": needle, "proof": proof,
   188	                    })
   189	            exact = spec.get("equals")
   190	            if exact is not None and content != str(exact):
   191	                content_mismatches.append({
