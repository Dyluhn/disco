     1	/**
     2	 * TweakPanel — P9D (owner controls UI).
     3	 *
     4	 * Renders ONE semantic control per tweak editor (boolean→checkbox, enum→select, int/float→
     5	 * range slider, palette→curated swatch buttons, color→native picker, text→one bounded
     6	 * input) — never a generic freeform text-box soup. A known editor whose constraints are
     7	 * malformed (enum without options, palette without colors, numeric without min/max/step) and
     8	 * any unknown editor fail closed to a disabled "unsupported" note with NO input.
     9	 *
    10	 * Decoupled: changes flow up via `onTweak(key, value)`; the parent adapts to the real
    11	 * app_set_tweak wire call (the live mount is P1B-LIVE). TweakFieldView is a props mirror of
    12	 * the Python core TweakField (TS can't import core/tweaks.py).
    13	 */
    14	
    15	import { cn } from "@/lib/cn";
    16	
    17	export type TweakEditor = "boolean" | "enum" | "int" | "float" | "color" | "palette" | "text";
    18	export type TweakValue = string | number | boolean;
    19	
    20	export interface TweakFieldView {
    21	  key: string;
    22	  label: string;
    23	  /** A documented editor; an unrecognized value renders the unsupported note (API boundary). */
    24	  editor: TweakEditor;
    25	  options?: string[]; // enum
    26	  colors?: string[]; // palette swatches
    27	  min?: number; // int/float
    28	  max?: number;
    29	  step?: number;
    30	  maxLength?: number; // text bound (default 120)
    31	}
    32	
    33	interface Props {
    34	  fields: TweakFieldView[];
    35	  values: Record<string, TweakValue>;
    36	  onTweak: (key: string, value: TweakValue) => void;
    37	}
    38	
    39	/** A known editor whose required constraints are missing → render disabled, not a fallback box. */
    40	function isMalformed(f: TweakFieldView): boolean {
    41	  if (f.editor === "enum") return !f.options || f.options.length === 0;
    42	  if (f.editor === "palette") return !f.colors || f.colors.length === 0;
    43	  if (f.editor === "int" || f.editor === "float")
    44	    return f.min === undefined || f.max === undefined || f.step === undefined;
    45	  return false;
    46	}
    47	
    48	const INPUT_CLS = "rounded border border-hairline bg-surface-1 px-inline py-hair font-ui text-[0.74rem] text-text";
    49	
    50	function Unsupported() {
    51	  return <span className="font-ui text-[0.72rem] text-text-faint">unsupported control</span>;
    52	}
    53	
    54	function Control({
    55	  field,
    56	  value,
    57	  onTweak,
    58	}: {
    59	  field: TweakFieldView;
    60	  value: TweakValue | undefined;
    61	  onTweak: Props["onTweak"];
    62	}) {
    63	  if (isMalformed(field)) return <Unsupported />;
    64	  const { key, label } = field;
    65	  switch (field.editor) {
    66	    case "boolean":
    67	      return (
    68	        <input
    69	          type="checkbox"
    70	          aria-label={label}
    71	          checked={value === true}
    72	          onChange={(e) => onTweak(key, e.target.checked)}
    73	        />
    74	      );
    75	    case "enum":
    76	      return (
    77	        <select
    78	          aria-label={label}
    79	          className={INPUT_CLS}
    80	          value={typeof value === "string" ? value : ""}
    81	          onChange={(e) => onTweak(key, e.target.value)}
    82	        >
    83	          {field.options!.map((o) => (
    84	            <option key={o} value={o}>
    85	              {o}
    86	            </option>
    87	          ))}
    88	        </select>
    89	      );
    90	    case "int":
    91	    case "float":
    92	      return (
    93	        <input
    94	          type="range"
    95	          aria-label={label}
    96	          min={field.min}
    97	          max={field.max}
    98	          step={field.step}
    99	          value={typeof value === "number" ? value : field.min}
   100	          onChange={(e) => onTweak(key, Number(e.target.value))}
   101	        />
   102	      );
   103	    case "color":
   104	      return (
   105	        <input
   106	          type="color"
   107	          aria-label={label}
   108	          value={typeof value === "string" ? value : "#000000"}
   109	          onChange={(e) => onTweak(key, e.target.value)}
   110	        />
   111	      );
   112	    case "palette":
   113	      return (
   114	        <div role="group" aria-label={label} className="flex gap-hair">
   115	          {field.colors!.map((c) => (
   116	            <button
   117	              key={c}
   118	              type="button"
   119	              aria-label={c}
   120	              aria-pressed={value === c}
   121	              onClick={() => onTweak(key, c)}
   122	              style={{ backgroundColor: c }}
   123	              className={cn(
   124	                "h-5 w-5 rounded-control border",
   125	                value === c ? "ring-2 ring-accent" : "border-hairline",
   126	              )}
   127	            />
   128	          ))}
   129	        </div>
   130	      );
   131	    case "text":
   132	      return (
   133	        <input
   134	          type="text"
   135	          aria-label={label}
   136	          maxLength={field.maxLength ?? 120}
   137	          className={INPUT_CLS}
   138	          value={typeof value === "string" ? value : ""}
   139	          onChange={(e) => onTweak(key, e.target.value)}
   140	        />
   141	      );
   142	    default:
   143	      return <Unsupported />;
   144	  }
   145	}
   146	
   147	export function TweakPanel({ fields, values, onTweak }: Props) {
   148	  return (
   149	    <div className="flex flex-col gap-inline">
   150	      {fields.map((field) => (
   151	        <div
   152	          key={field.key}
   153	          data-disco-control={`build.tweak.${field.key}`}
   154	          data-tweak-key={field.key}
   155	          className="flex items-center justify-between gap-inline"
   156	        >
   157	          <span className="font-ui text-[0.74rem] text-text-muted">{field.label}</span>
   158	          <Control field={field} value={values[field.key]} onTweak={onTweak} />
   159	        </div>
   160	      ))}
   161	    </div>
   162	  );
   163	}

