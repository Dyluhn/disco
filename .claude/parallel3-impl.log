    73	  browser_ws: ["connections"],
    74	  lifecycle: ["terminal", "statuses"],
    75	  sidecar: ["stopped_at_terminal", "provider_calls_after_terminal"],
    76	  preview: ["owner", "manual_port"],
    77	  shown: ["artifact_shown", "preview_shown"],
    78	  verification: ["ready_for_verification_called", "passed"],
    79	  export: ["requested", "download_present", "download_bytes"],
    80	  cleanup: ["orphans", "workspace_released", "scope"],
    81	};
