     1	"""HARN-1b (evidence side) — the validated producer of the product-harness dossier.
     2	
     3	The HARN-2 oracles READ a ``product_evidence`` dict + a provider-call ledger. This
     4	module is the verified WRITER: it validates a captured dossier against the schema the
     5	oracles expect BEFORE writing it, so a harness bug can't emit malformed evidence that
     6	an oracle would silently mis-adjudicate. The live Playwright harness captures the raw
     7	browser data and calls these to serialize ``product-evidence.json`` and
     8	``provider-call-ledger.jsonl`` into the run folder.
     9	
    10	This is pure + unit-tested; it does not drive a browser (that is HARN-1b's live spec).
    11	"""
    12	
    13	from __future__ import annotations
    14	
    15	import json
    16	from pathlib import Path
    17	from typing import Any
    18	
    19	# The expected slices and their field types. Each slice is optional (a run that did
    20	# not export has no "export" slice → the ExportDownload oracle SKIPs), but when a slice
    21	# IS present its fields must be well-typed so the oracle reads it fail-closed-correctly.
    22	_SLICE_FIELDS: dict[str, dict[str, type]] = {
    23	    "browser_ws": {"connections": int},
    24	    "lifecycle": {"terminal": str, "statuses": list},
    25	    "sidecar": {"stopped_at_terminal": bool, "provider_calls_after_terminal": int},
    26	    "preview": {"owner": str, "manual_port": bool},
    27	    "shown": {"artifact_shown": bool, "preview_shown": bool},
    28	    "verification": {"ready_for_verification_called": bool, "passed": bool},
    29	    # download_present/download_bytes ARE adjudicated by ExportDownloadOracle — they must be
    30	    # type-validated here too, else e.g. a bool download_bytes capture bug evades validation.
    31	    "export": {"requested": bool, "download_present": bool, "download_bytes": int},
    32	    "cleanup": {"orphans": int, "workspace_released": bool, "scope": str},
    33	}
    34	
    35	PRODUCT_EVIDENCE_NAME = "product-evidence.json"
    36	PROVIDER_LEDGER_NAME = "provider-call-ledger.jsonl"
    37	
    38	
    39	def validate_product_evidence(ev: dict[str, Any]) -> list[str]:
    40	    """Return a list of schema problems (empty = valid). Unknown top-level keys are
    41	    allowed (forward-compat); a known slice must be a dict whose declared fields, when
    42	    present, carry the right type. ``bool`` is rejected where ``int`` is required (a
    43	    bool count is a capture bug)."""
    44	    problems: list[str] = []
    45	    if not isinstance(ev, dict):
    46	        return ["product_evidence is not a dict"]
    47	    for slice_name, fields in _SLICE_FIELDS.items():
    48	        if slice_name not in ev:
    49	            continue
    50	        slice_val = ev[slice_name]
    51	        if not isinstance(slice_val, dict):
    52	            problems.append(f"{slice_name}: not a dict")
    53	            continue
    54	        for field, typ in fields.items():
    55	            if field not in slice_val:
    56	                continue
    57	            val = slice_val[field]
    58	            if typ is int and isinstance(val, bool):
    59	                problems.append(f"{slice_name}.{field}: bool where int expected")
    60	            elif not isinstance(val, typ):
    61	                problems.append(f"{slice_name}.{field}: {type(val).__name__} where {typ.__name__} expected")
    62	    return problems
    63	
    64	
    65	def write_product_evidence(folder: str | Path, ev: dict[str, Any], *, strict: bool = True) -> Path:
    66	    """Validate then write ``product-evidence.json`` into ``folder``. With
    67	    ``strict=True`` (default) a schema problem raises ValueError BEFORE writing, so the
    68	    harness never persists evidence the oracles can't trust."""
    69	    problems = validate_product_evidence(ev)
    70	    if problems and strict:
    71	        raise ValueError(f"product_evidence failed schema validation: {problems}")
    72	    out = Path(folder) / PRODUCT_EVIDENCE_NAME
    73	    out.write_text(json.dumps(ev, indent=2, sort_keys=True), encoding="utf-8")
    74	    return out
    75	
    76	
    77	def write_provider_ledger(folder: str | Path, records: list[dict[str, Any]]) -> Path:
    78	    """Write ``provider-call-ledger.jsonl`` (one JSON record per line). Each record
