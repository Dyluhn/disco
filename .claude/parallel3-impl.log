+        baseline_containers=0,
+        relay_log=None,
+        timeline=[],
+        grace_s=0.0,
+    )
+
+    assert ev["cleanup"] == {
+        "orphans": 0,
+        "workspace_released": True,
+        "scope": "conversation",
+    }
+
+
+@pytest.mark.asyncio
+async def test_cleanup_orphan_count_falls_back_to_global_delta_without_sandbox_ids(monkeypatch):
