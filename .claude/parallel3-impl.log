    89	 * defaults) — an omitted slice SKIPs its oracle.
    90	 */
    91	export function buildProductEvidence(obs: ProductObservations): ProductEvidence {
    92	  const ev: Record<string, unknown> = {};
    93	  for (const key of Object.keys(SLICE_FIELDS) as SliceKey[]) {
    94	    const slice = obs[key];
    95	    if (slice !== undefined) ev[key] = slice;
    96	  }
    97	  return ev as ProductEvidence;
    98	}

