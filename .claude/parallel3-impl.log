diff --git a/harness/build_soak/adapters/disco_api.py b/harness/build_soak/adapters/disco_api.py
index 7ddbdd51731d44ef82f3eb1764400df8fe6ea177..aebd9d7e802170e86c9307e24c6320dfee4bbf05
--- a/harness/build_soak/adapters/disco_api.py
+++ b/harness/build_soak/adapters/disco_api.py
@@ -1221,7 +1221,14 @@
         if served_index is None:
             return live
         # (2) Serve the snapshot static content ourselves + PROBE it for GENUINE evidence.
-        probe = await asyncio.to_thread(self._serve_probe_snapshot, served_index.parent)
+        # Use a short-lived executor instead of the event loop's default executor: on the
+        # Python 3.13 pytest runtime, default-executor shutdown can hang the whole gate after
+        # a completed to_thread/run_in_executor(None, ...) call.
+        from concurrent.futures import ThreadPoolExecutor
+
+        loop = asyncio.get_running_loop()
+        with ThreadPoolExecutor(max_workers=1, thread_name_prefix="build-soak-preview-probe") as pool:
+            probe = await loop.run_in_executor(pool, self._serve_probe_snapshot, served_index.parent)
         if probe is None:
             return live  # couldn't serve/probe → no positive evidence → honest 404
         probe_status, probe_body = probe
