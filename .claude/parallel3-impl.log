import asyncio, sys
from pathlib import Path
sys.path.insert(0, 'harness/build_soak/tests')
from test_api_runner import _CID, _plant_snapshot, _seed_db, _verify_obs, _DeadPreviewTransport
from harness.build_soak.adapters.disco_api import DiscoApiClient
import tempfile

async def main():
    with tempfile.TemporaryDirectory() as d:
        tmp=Path(d)
        db=tmp/'disco.db'; proj=tmp/'projects'
        _plant_snapshot(proj, _CID, {'index.html':'<h1>Build Smoke OK</h1>'})
        _seed_db(db, _CID, [_verify_obs(1, True)])
        transport=_DeadPreviewTransport(db, states=['FINISHED'])
        client=DiscoApiClient(transport, db_path=str(db), poll_interval_s=0.0, projects_root=str(proj))
        orig_fail=client._in_run_verify_failed
        def fail(cid):
            print('before _in_run_verify_failed', flush=True)
            r=orig_fail(cid)
            print('after _in_run_verify_failed', r, flush=True)
            return r
        client._in_run_verify_failed=fail
        orig_idx=client._snapshot_served_index
        def idx(cid):
            print('before _snapshot_served_index', flush=True)
            r=orig_idx(cid)
            print('after _snapshot_served_index', r, flush=True)
            return r
        client._snapshot_served_index=idx
        orig_probe=client._serve_probe_snapshot
        def probe(path):
            print('before _serve_probe_snapshot', path, flush=True)
            r=orig_probe(path)
            print('after _serve_probe_snapshot', r, flush=True)
            return r
        client._serve_probe_snapshot=probe
        print('before collect', flush=True)
        try:
            print(await asyncio.wait_for(client.collect_preview(_CID), timeout=5), flush=True)
        except Exception as e:
            print('EXC', type(e), repr(e), flush=True)
        print('after collect', flush=True)

asyncio.run(main())
