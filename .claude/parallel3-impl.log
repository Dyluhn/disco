+        run,
+        baseline_containers=2,
+        relay_log=None,
+        timeline=[],
+        grace_s=0.0,
+    )
+
+    assert ev["cleanup"] == {
+        "orphans": 2,
+        "workspace_released": False,
+        "scope": "global",
+    }
+
