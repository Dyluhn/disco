    47	}
    48	
    49	/** Captured observations — a slice is present iff that part of the run was observed. */
    50	export interface ProductObservations {
    51	  browser_ws?: BrowserWsObs;
    52	  lifecycle?: LifecycleObs;
    53	  sidecar?: SidecarObs;
    54	  preview?: PreviewObs;
    55	  shown?: ShownObs;
    56	  verification?: VerificationObs;
