import asyncio, os
import httpx

from harness.product_build.minimax_relay import create_app

closed = {'response': False, 'client': False}

class FakeResponse:
    status_code = 401
    headers = {'content-type': 'text/event-stream'}
    async def aiter_bytes(self):
        yield b'data: denied\\n\\n'
    async def aclose(self):
        closed['response'] = True

class FakeAsyncClient:
    def __init__(self, *args, **kwargs):
        pass
    def build_request(self, method, url, json=None, headers=None):
        return {'method': method, 'url': url, 'json': json, 'headers': headers}
    async def send(self, req, stream=False):
        assert stream is True
        return FakeResponse()
    async def aclose(self):
        closed['client'] = True
    async def __aenter__(self):
        return self
    async def __aexit__(self, exc_type, exc, tb):
        await self.aclose()

class FakeRequest:
    async def json(self):
        return {'stream': True, 'model': 'minimax-m3'}

async def main():
    orig = httpx.AsyncClient
    httpx.AsyncClient = FakeAsyncClient
    try:
        os.environ['MINIMAX_API_KEY'] = 'test-key'
        app = create_app()
        endpoint = next(r.endpoint for r in app.routes if getattr(r, 'path', None) == '/v1/{path:path}')
        resp = await endpoint('chat/completions', FakeRequest())
        chunks = []
        async for chunk in resp.body_iterator:
            chunks.append(chunk)
        print(resp.status_code)
        print(b''.join(chunks).decode().strip())
        print(closed)
    finally:
        httpx.AsyncClient = orig
        os.environ.pop('MINIMAX_API_KEY', None)

asyncio.run(main())
