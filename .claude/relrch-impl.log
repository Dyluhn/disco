   802	        default=None,
   803	    )
   804	    if last_user is None:
   805	        return False
   806	    # Progress = the agent did REAL WORK after the message: a tool call
   807	    # (ActionEvent), an observation (ObservationEvent), a plan change (PlanEvent),
   808	    # or an assistant message (AGENT MessageEvent). A pure terminal/status marker
   809	    # (RUNNING/FINISHED/STUCK/ERROR StatusEvent) does NOT count as processing the
   810	    # turn. The engine appends the terminal marker at run end, so a follow-up that
   811	    # lands during finalization — just before that marker — was previously MASKED
   812	    # as "already processed" and stranded forever (no re-kick, no re-entry). With
   813	    # status markers excluded, such a turn is correctly UNPROCESSED so the runtime
   814	    # re-kicks and run() re-enters to handle it.
   815	    #
   816	    # The basis is deliberately STRICT to avoid false negatives on synthetic no-op
   817	    # turns: system-reminder / F9-dedup injections carry EventSource.ENVIRONMENT or
   818	    # SYSTEM (only AGENT messages count here), and status events no longer count at
   819	    # all — neither can spuriously consume a real user turn. `latest_unprocessed_
   820	    # user_text` reads through this same predicate, so it stays consistent.
   821	    last_progress = max(
   822	        (
   823	            e.seq or 0
   824	            for e in events
   825	            if isinstance(e, (ActionEvent, ObservationEvent, PlanEvent))
   826	            or (isinstance(e, MessageEvent) and e.source == EventSource.AGENT)
   827	        ),
   828	        default=0,
   829	    )
   830	    return last_user > last_progress
