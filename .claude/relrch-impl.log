   483	# WHEN in-flight agent activity has MASKED latest_unprocessed_user_text (the     #
   484	# predicate the old polling guards relied on). This is the exact live           #
   485	# steer_while_running failure (steer seq N, masked, write would land on seq N+k).#
   486	# --------------------------------------------------------------------------- #
   487	async def test_live_steer_marker_reenters_planning_when_unprocessed_text_masked():
   488	    from disco.core import ConversationStatus
   489	    from disco.core.loop import signals
   490	
   491	    cid = "noreplan-marker-race"
   492	    agent = ScriptedAgent([_submit_plan_step("first")])
   493	    loop, store = build_plan_loop(agent, conversation_id=cid)
   494	    await loop.send_message("Create a two-page static site with Home and About.")
   495	    await loop.run()
   496	    await loop.approve_plan()
   497	    assert loop.mode != OperatingMode.PLANNING
   498	
   499	    # LIVE kernel steer sequence: user(steer) msg → an in-flight AGENT message (masks
   500	    # has_unprocessed_user_message → latest_unprocessed_user_text becomes None) → the
   501	    # durable revision_steer_pending marker the DiscoKernel ingress appends.
   502	    await store.append(
   503	        cid,
   504	        MessageEvent(
   505	            source=EventSource.USER,
   506	            message=LLMMessage(role="user", content="Also add a Contact page and update nav."),
   507	            meta={"steer": True},
   508	        ),
   509	    )
   510	    await store.append(
   511	        cid,
   512	        MessageEvent(
   513	            source=EventSource.AGENT,
   514	            message=LLMMessage(role="assistant", content="Working on it."),
   515	        ),
   516	    )
   517	    await store.append(
   518	        cid, StatusEvent(status=ConversationStatus.RUNNING, detail="revision_steer_pending")
   519	    )
   520	
   521	    events = await store.get_events(cid)
   522	    # Precondition that PROVES we exercise the race: the text predicate is masked.
   523	    assert signals.latest_unprocessed_user_text(events) is None
   524	    assert signals.pending_revision_steer(events) is True
   525	
   526	    # The marker path must re-enter PLANNING despite the masked text predicate.
   527	    reentered = await loop._maybe_reenter_planning_for_followup(events)
   528	    assert reentered is True
   529	    assert loop.mode == OperatingMode.PLANNING
   530	
   531	    # …and consuming it is idempotent: pending is now False (a `planning` was emitted).
   532	    events2 = await store.get_events(cid)
   533	    assert signals.pending_revision_steer(events2) is False

