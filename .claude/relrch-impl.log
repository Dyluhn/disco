   876	
   877	def is_revision_intent(text: str) -> bool:
   878	    """Bug 12 (§11.4) — conservative predicate: does this follow-up ask for a
   879	    workspace CHANGE (→ must re-enter PLANNING for a revised plan), or is it a
   880	    pure non-mutating question (→ answerable without a forced re-plan)?
   881	
   882	    Rule (bias toward re-planning, the safe contract — an unauthorized mutation
   883	    on a stale plan is the failure mode):
   884	      * any change/revision verb present → True (re-plan).
   885	      * otherwise, a clear question (leads with a question word or ends with '?')
   886	        → False (answer it, no dead-end).
   887	      * anything else ambiguous → True (re-plan)."""
   888	    t = (text or "").strip()
   889	    if not t:
   890	        return False
   891	    if _CHANGE_VERB_RE.search(t):
   892	        return True
   893	    if t.endswith("?") or _QUESTION_LEAD_RE.match(t):
   894	        return False
   895	    return True

