    38	        self.seen_views = []
    39	        self.seen_tools = []
    40	        self.calls = 0
    41	
    42	    async def step(
    43	        self, view, tools, *, mode: OperatingMode, overflow_signal, on_stream=None,
    44	        temperature=None, assist=False, attempt: int = 1, provider_prefs=None,
    45	    ):
    46	        i = self.calls
    47	        if i in self._before:
    48	            await self._before[i]()
    49	        self.seen_views.append(view)
    50	        self.seen_tools.append([getattr(t, "name", None) for t in tools])
    51	        self.calls += 1
    52	        item = self._steps[min(i, len(self._steps) - 1)]
    53	        if isinstance(item, BaseException):
    54	            raise item
    55	        if callable(item):
    56	            return item(view)
    57	        return item
