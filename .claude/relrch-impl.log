    71	        known: tuple[str, ...] = ("file_write", "shell_exec", "file_read", "file_list"),
    72	    ) -> None:
    73	        self.scope = scope
    74	        self.calls: list[ToolCall] = []
    75	        self.grounded: list[str] = []
    76	        self._results = results or {}
    77	        self._known = set(known)
    78	        self.sandbox = None
    79	        self.raise_exc: Exception | None = None
    80	
    81	    async def execute(self, call: ToolCall) -> ToolResult:
    82	        self.calls.append(call)
    83	        if self.raise_exc is not None:
    84	            raise self.raise_exc
    85	        if call.tool_name not in self._known:
    86	            return ToolResult(
    87	                call_id=call.call_id,
    88	                tool_name=call.tool_name,
    89	                success=False,
    90	                error=f"unknown or out-of-scope tool {call.tool_name!r}",
    91	            )
    92	        scripted = self._results.get(call.tool_name)
    93	        if scripted is not None:
    94	            return scripted
    95	        return ToolResult(
    96	            call_id=call.call_id, tool_name=call.tool_name, success=True, content="ok"
    97	        )
    98	
    99	    def tool_scope(self, tool_name: str) -> str:
   100	        return self.scope
   101	
   102	    def note_grounding_read(self, path: str) -> None:
   103	        self.grounded.append(path)
   104	
   105	    def readonly_tool_names(self) -> frozenset[str]:
   106	        return frozenset({"file_read", "file_list"})
   107	
   108	
   109	class FakeHost:
   110	    """Minimal :class:`BridgeHost` over an in-memory event log."""
   111	
   112	    def __init__(
   113	        self,
   114	        executor: FakeExecutor,
   115	        analyzer: object,
   116	        policy: object,
   117	        *,
   118	        mode: OperatingMode = OperatingMode.LONG_HORIZON,
   119	        plan_tool: str = "submit_plan",
   120	        planning_allowed: frozenset[str] = frozenset({"file_read", "file_list"}),

