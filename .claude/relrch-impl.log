   850	# Bug 12 (§11.4) — change/revision verbs that mark a follow-up as MUTATING (it
   851	# asks for a workspace change), so a follow-up on an approved/finished build must
   852	# re-enter PLANNING and go through a revised plan rather than a free write on the
   853	# stale plan. Word-boundary matched (so "add" doesn't fire inside "additional",
   854	# "fix" not inside "prefix"). The list is deliberately broad: the failure mode is
   855	# an UNAUTHORIZED mutation, so ambiguity biases toward re-planning; only a clear
   856	# pure question (no change verb + reads like a question) is exempted.
   857	_CHANGE_VERB_RE = re.compile(
   858	    r"\b("
   859	    r"revise|revised|change|changed|add|adds|added|update|updated|remove|removed|"
   860	    r"delete|deleted|replace|replaced|fix|fixed|edit|edited|modify|modified|adjust|"
   861	    r"adjusted|tweak|tweaked|swap|swapped|rename|renamed|move|moved|set|insert|append|"
   862	    r"instead|also|different|differently|implement|build|create|rebuild|redo|rework|"
   863	    r"convert|increase|decrease|enlarge|shrink|recolor|restyle"
   864	    r")\b",
   865	    re.IGNORECASE,
   866	)
   867	
   868	# Leading words that mark a clear, non-mutating QUESTION (answerable without a
   869	# forced re-plan). Only consulted when NO change verb is present.
   870	_QUESTION_LEAD_RE = re.compile(
   871	    r"^\s*(what|which|why|how|when|where|who|whose|whom|is|are|was|were|do|does|did|"
   872	    r"can|could|will|would|should|has|have|had|may|might)\b",
   873	    re.IGNORECASE,
   874	)
