# ---- fake StopHook ----------------------------------------------------------


class ScriptedStopHook:
    """allow_stop returns scripted booleans (repeats last)."""

    def __init__(self, verdicts):
        self._verdicts = list(verdicts)
        self.calls = 0

    async def allow_stop(self, state, events):
        i = self.calls
