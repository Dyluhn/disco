    59	def _source_of(entry: dict[str, Any]) -> str:
    60	    """Render a console entry's location dict into a `url:line:col` string."""
    61	    loc = entry.get("location") or {}
    62	    url = loc.get("url")
    63	    if not url:
    64	        return ""
    65	    line = loc.get("lineNumber")
    66	    if line is None:
    67	        return str(url)
    68	    col = loc.get("columnNumber")
    69	    return f"{url}:{line}:{col}" if col is not None else f"{url}:{line}"
