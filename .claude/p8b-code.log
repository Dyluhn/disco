   104	    """Every emitted data-disco-comment-anchor must be in the declared namespace — the model
   105	    cannot invent an anchor that doesn't trace back to the spec."""
   106	    anchors = set(extract_metadata(html_text).get(DataDiscoAttr.COMMENT_ANCHOR, []))
   107	    invented = anchors - declared
   108	    if invented:
   109	        raise SemanticMetadataError(f"invented comment anchors not in the spec: {sorted(invented)}")

