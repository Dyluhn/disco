    97	def declared_anchors_from_spec(spec: AppSpec) -> frozenset[str]:
    98	    """The legitimate comment-anchor namespace for a spec — derived DETERMINISTICALLY from
    99	    the source of truth (its section ids). The single authority for "not invented"."""
