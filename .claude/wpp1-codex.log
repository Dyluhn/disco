# Workspace root for the Platform (codename: disco).
#
# This is a *virtual* uv project: it is never built or installed itself
# (`tool.uv.package = false`). It exists to (a) declare the workspace members
# and (b) hold the shared dev toolchain so a single `uv sync` provisions the
# whole monorepo. Each real package lives under packages/* and is its own
# separately-versioned distribution, mirroring the four-layer topology in
# basis-of-design.md §5 (core -> tools -> agent-server -> app-server).
[project]
name = "disco-workspace"
version = "0"
description = "Self-hosted Research & Agent platform — workspace root (not a distributable)."
requires-python = ">=3.12"
dependencies = []

[tool.uv]
package = false

[tool.uv.workspace]
members = ["packages/*"]
# packages/pi-kernel is the Node/TypeScript Pi SDK sidecar (Epic B), not a Python
# package — it has no pyproject.toml. Without this exclude, uv's `packages/*` glob
# treats it as a workspace member and every `uv run`/`uv sync` fails resolution.
exclude = ["packages/pi-kernel"]

[dependency-groups]
# Shared dev toolchain for every member package.
dev = [
    "pytest>=8.2",
    "pytest-asyncio>=0.24",
    "ruff>=0.6",
    # Architecture fitness functions (CI/pre-commit): import-linter enforces the
    # package layering in .importlinter; pair with scripts/check_arch_budget.py
    # (size caps) + scripts/gen_arch_diagram.py (the generated container diagram).
    "import-linter>=2.0",
    "basedpyright>=1.39",  # Python static type-checking (strict: zero errors tree-wide, no baseline)
    "httpx>=0.27",  # Starlette TestClient (WebSocket + REST testing, headless)
    "hypothesis>=6.155.2",
    # BP-08 process backend: ProcessKernel launches the host `python3` kernelspec
    # via jupyter_client.AsyncKernelManager — ipykernel provides that kernelspec.
    # Without it every host-side kernel test fails at launch (the container image
    # installs its own ipykernel in deploy/sandbox/Dockerfile).
    "ipykernel>=6.29",
    # BP-08 acceptance 2(e): the plots integration test renders a real matplotlib
    # figure on the PROCESS backend (the container image stays matplotlib-free —
    # the decided option in deploy/sandbox/Dockerfile).
    "matplotlib>=3.9",
    "numpy>=2.0",
    # BP-04 browser daemon: the host-side integration test runs the REAL
    # _browser_daemon.py as a subprocess, which imports playwright and drives
    # Chromium (one-time `playwright install chromium` fetches the browser).
    # The container image installs its own in deploy/sandbox/Dockerfile.
    "playwright>=1.45",
]

[tool.pytest.ini_options]
# Async tests (the EventStore is async) run without per-test decorators.
asyncio_mode = "auto"
testpaths = ["packages"]
markers = [
    "integration",
    # W7: fast input/output boundary CONTRACTS (W1 sandbox-error typing, W2 task supervision,
    # W3 slides/artifact, W10 guardrails). Selected into the fast PR tier: `-m boundary_contract`.
    "boundary_contract",
    # Build Soak (S3): the opt-in LIVE-API path that hits a running agent-server on
    # :8000 with a real model. Skipped by default (env-guarded); never runs in CI.
    "live",
    # EPIC H (P2): the LIVE sandbox-isolation escape suite — drives ONE bounded real
    # container and inspects ACTUAL isolation (HostConfig.PidMode, namespace inodes vs
    # host, host-loopback reachability, host-PID signal bypass forms). Skipped unless
    # explicitly selected (`-m sandbox_integration`); never in the default suite / CI
    # (jail safety + it needs a container runtime + the sandbox image).
    "sandbox_integration",
]
# EPIC H (P2): DESELECT the live sandbox-isolation escape suite by default (jail safety —
# it spins real containers). A CLI `-m sandbox_integration` overrides this ini expression
# (the last -m wins), so the suite is reachable only when explicitly selected.
addopts = "-q -m 'not sandbox_integration'"

[tool.ruff]
line-length = 100
target-version = "py312"

[tool.ruff.lint]
# Sensible defaults: pyflakes, pycodestyle, isort, bugbear, pyupgrade.
select = ["E", "F", "I", "B", "UP"]
# UP042 (prefer enum.StrEnum) is intentionally disabled: the event-state
# contract's normative code defines enums as `(str, Enum)`, and we mirror it
# verbatim so the source stays a faithful transcription of the spec.
ignore = ["UP042"]

[tool.pyright]
include = [
    "packages/core/src",
    "packages/retrieval/src",
    "packages/tools/src",
    "packages/agent-server/src",
    "packages/app-server/src",
]
exclude = ["**/__pycache__", "**/tests", "**/.venv", "archived God files"]
pythonVersion = "3.13"
typeCheckingMode = "standard"
reportMissingImports = true

