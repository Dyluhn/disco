    47	    v = value.strip()
    48	    if _HEX3.match(v):
    49	        return f"#{v[1]*2}{v[2]*2}{v[3]*2}".lower()
    50	    if _HEX6.match(v):
    51	        return v.lower()
    52	    raise ValueError(f"color must be #RGB or #RRGGBB hex, got {value!r}")
