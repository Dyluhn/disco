   128	                value === c ? "ring-2 ring-accent" : "border-hairline",
   129	              )}
   130	            />
   131	          ))}
   132	        </div>
   133	      );
   134	    case "text":
   135	      return (
   136	        <input
   137	          type="text"
   138	          aria-label={label}
   139	          maxLength={field.maxLength ?? 120}
   140	          className={INPUT_CLS}
   141	          value={typeof value === "string" ? value : ""}
   142	          onChange={(e) => onTweak(key, e.target.value)}
   143	        />
   144	      );
   145	    default:
   146	      return <Unsupported />;
   147	  }
   148	}
   149	
   150	export function TweakPanel({ fields, values, onTweak }: Props) {
   151	  return (
   152	    <div className="flex flex-col gap-inline">
   153	      {fields.map((field) => (
   154	        <div
   155	          key={field.key}
