     1	/**
     2	 * TweakPanel — P9D (owner controls UI).
     3	 *
     4	 * Renders ONE semantic control per tweak editor (boolean→checkbox, enum→select, int/float→
     5	 * range slider, palette→curated swatch buttons, color→native picker, text→one bounded
     6	 * input) — never a generic freeform text-box soup. A known editor whose constraints are
     7	 * malformed (enum without options, palette without colors, numeric without min/max/step) and
     8	 * any unknown editor fail closed to a disabled "unsupported" note with NO input.
     9	 *
    10	 * Decoupled: changes flow up via `onTweak(key, value)`; the parent adapts to the real
    11	 * app_set_tweak wire call (the live mount is P1B-LIVE). TweakFieldView is a props mirror of
    12	 * the Python core TweakField (TS can't import core/tweaks.py).
    13	 */
    14	
    15	import { cn } from "@/lib/cn";
    16	
    17	export type TweakEditor = "boolean" | "enum" | "int" | "float" | "color" | "palette" | "text";
    18	export type TweakValue = string | number | boolean;
    19	
    20	export interface TweakFieldView {
    21	  key: string;
    22	  label: string;
    23	  /** A documented editor; an unrecognized value renders the unsupported note (API boundary). */
    24	  editor: TweakEditor;
    25	  options?: string[]; // enum
    26	  colors?: string[]; // palette swatches
    27	  min?: number; // int/float
    28	  max?: number;
    29	  step?: number;
    30	  maxLength?: number; // text bound (default 120)
    31	}
    32	
    33	interface Props {
    34	  fields: TweakFieldView[];
    35	  values: Record<string, TweakValue>;
    36	  onTweak: (key: string, value: TweakValue) => void;
    37	}
    38	
    39	const notFiniteNum = (x: unknown): boolean => typeof x !== "number" || !Number.isFinite(x);
    40	
    41	/** A known editor whose required constraints are missing/ill-typed → render disabled, not a
    42	 * fallback box. Numeric bounds must be FINITE numbers (runtime JSON can carry null). */
    43	function isMalformed(f: TweakFieldView): boolean {
    44	  if (f.editor === "enum") return !f.options || f.options.length === 0;
    45	  if (f.editor === "palette") return !f.colors || f.colors.length === 0;
    46	  if (f.editor === "int" || f.editor === "float")
    47	    return notFiniteNum(f.min) || notFiniteNum(f.max) || notFiniteNum(f.step);
    48	  return false;
    49	}
    50	
    51	const INPUT_CLS = "rounded border border-hairline bg-surface-1 px-inline py-hair font-ui text-[0.74rem] text-text";
    52	
    53	function Unsupported() {
    54	  return <span className="font-ui text-[0.72rem] text-text-faint">unsupported control</span>;
    55	}
    56	
    57	function Control({
    58	  field,
    59	  value,
    60	  onTweak,
    61	}: {
    62	  field: TweakFieldView;
    63	  value: TweakValue | undefined;
    64	  onTweak: Props["onTweak"];
    65	}) {
    66	  if (isMalformed(field)) return <Unsupported />;
    67	  const { key, label } = field;
    68	  switch (field.editor) {
    69	    case "boolean":
    70	      return (
    71	        <input
    72	          type="checkbox"
    73	          aria-label={label}
    74	          checked={value === true}
    75	          onChange={(e) => onTweak(key, e.target.checked)}
    76	        />
    77	      );
    78	    case "enum":
    79	      return (
    80	        <select
    81	          aria-label={label}
    82	          className={INPUT_CLS}
    83	          value={typeof value === "string" ? value : ""}
    84	          onChange={(e) => onTweak(key, e.target.value)}
    85	        >
    86	          {field.options!.map((o) => (
    87	            <option key={o} value={o}>
    88	              {o}
    89	            </option>
    90	          ))}
    91	        </select>
    92	      );
    93	    case "int":
    94	    case "float":
    95	      return (
    96	        <input
    97	          type="range"
    98	          aria-label={label}
    99	          min={field.min}
   100	          max={field.max}
   101	          step={field.step}
   102	          value={typeof value === "number" ? value : field.min}
   103	          onChange={(e) => onTweak(key, Number(e.target.value))}
   104	        />
   105	      );
   106	    case "color":
   107	      return (
   108	        <input
   109	          type="color"
   110	          aria-label={label}
   111	          value={typeof value === "string" ? value : "#000000"}
   112	          onChange={(e) => onTweak(key, e.target.value)}
   113	        />
   114	      );
   115	    case "palette":
   116	      return (
   117	        <div role="group" aria-label={label} className="flex gap-hair">
   118	          {field.colors!.map((c) => (
