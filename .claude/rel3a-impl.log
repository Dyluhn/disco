+def toolscope_audit_enabled() -> bool:
+    """True iff DISCO_TOOLSCOPE_AUDIT is truthy (default OFF)."""
+    return str(disco_env(_TOOLSCOPE_AUDIT_FLAG) or "").strip().lower() in _TRUTHY
