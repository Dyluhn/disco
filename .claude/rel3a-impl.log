+            except Exception:  # noqa: BLE001
+                continue
+            if payload.get("source") != EventSource.USER.value:
+                continue
+            msg = payload.get("message") or {}
+            content = msg.get("content")
+            if isinstance(content, str):
+                chunks.append(content)
+        return "\n".join(chunks)
