diff --git a/packages/agent-server/tests/test_toolscope_audit.py b/packages/agent-server/tests/test_toolscope_audit.py
new file mode 100644
index 0000000000000000000000000000000000000000..1796a20a4b799adf73d0635ccc85adefb519fddd
--- /dev/null
