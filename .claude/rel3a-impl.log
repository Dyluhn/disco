  1471	        chunks: list[str] = []
  1472	        try:
  1473	            rows = conn.execute(
  1474	                "SELECT payload FROM events WHERE conversation_id = ? "
  1475	                "AND kind = 'message' ORDER BY seq ASC LIMIT 8",
  1476	                (conversation_id,),
  1477	            ).fetchall()
  1478	        except Exception:  # noqa: BLE001 — audit classification is best-effort
  1479	            return ""
  1480	        for row in rows:
  1481	            try:
  1482	                payload = json.loads(row["payload"])
  1483	            except Exception:  # noqa: BLE001
  1484	                continue
  1485	            if payload.get("source") != EventSource.USER.value:
  1486	                continue
  1487	            msg = payload.get("message") or {}
  1488	            content = msg.get("content")
  1489	            if isinstance(content, str):
  1490	                chunks.append(content)
  1491	        return "\n".join(chunks)
