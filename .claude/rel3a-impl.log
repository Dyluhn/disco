+            return ""
+        chunks: list[str] = []
+        try:
+            rows = conn.execute(
+                "SELECT payload FROM events WHERE conversation_id = ? "
+                "AND kind = 'message' ORDER BY seq ASC LIMIT 8",
+                (conversation_id,),
+            ).fetchall()
+        except Exception:  # noqa: BLE001 — audit classification is best-effort
+            return ""
+        for row in rows:
