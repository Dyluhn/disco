     3	Headless: Starlette's TestClient drives the ASGI app in-process (no network, no
     4	external services). Each test gets a fresh in-memory store via create_app.
     5	"""
     6	
     7	from __future__ import annotations
     8	
     9	import pytest
    10	import httpx
    11	from disco.agent_server import create_app
