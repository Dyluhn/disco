    13	from fastapi.testclient import TestClient
    14	
    15	
    16	@pytest.fixture
    17	def client() -> TestClient:
    18	    store = SqliteEventStore(":memory:")
    19	    return TestClient(create_app(store))
    20	
    21	
    22	def _create(client: TestClient, owner_id: str = "local") -> str:
    23	    resp = client.post("/conversations", json={"owner_id": owner_id})
    24	    assert resp.status_code == 200
    25	    return resp.json()["conversation_id"]
    26	
    27	
    28	# ---- §7.5 REST surface ------------------------------------------------------
    29	
    30	
    31	def test_create_returns_id_and_url(client):
    32	    body = client.post("/conversations", json={}).json()
    33	    assert body["conversation_id"].startswith("conv_")
    34	    assert body["conversation_url"].endswith(body["conversation_id"])
    35	
    36	
    37	def test_post_message_then_history_and_state(client):
    38	    cid = _create(client)
    39	    r = client.post(f"/conversations/{cid}/messages", json={"content": "hello"})
    40	    assert r.json()["seq"] == 1
    41	
    42	    events = client.get(f"/conversations/{cid}/events").json()
    43	    assert len(events["events"]) == 1
    44	    assert events["events"][0]["kind"] == "message"
    45	    assert events["events"][0]["message"]["content"] == "hello"
    46	
    47	    state = client.get(f"/conversations/{cid}/state").json()
    48	    assert state["conversation_id"] == cid
    49	    # A USER message resets iteration to 0 (event contract §3).
    50	    assert state["iteration"] == 0
    51	
    52	
    53	def test_events_pagination(client):
    54	    cid = _create(client)
    55	    for i in range(5):
    56	        client.post(f"/conversations/{cid}/messages", json={"content": f"m{i}"})
    57	    page1 = client.get(f"/conversations/{cid}/events?limit=2").json()
    58	    assert [e["seq"] for e in page1["events"]] == [1, 2]
    59	    assert page1["next_cursor"] == 2
    60	    page2 = client.get(f"/conversations/{cid}/events?after_seq=2&limit=2").json()
    61	    assert [e["seq"] for e in page2["events"]] == [3, 4]
    62	
    63	
    64	@pytest.mark.asyncio
    65	async def test_list_conversations_is_owner_scoped():
    66	    store = SqliteEventStore(":memory:")
    67	    transport = httpx.ASGITransport(app=create_app(store))
    68	    async with httpx.AsyncClient(transport=transport, base_url="http://testserver") as client:
    69	        resp = await client.post("/conversations", json={"owner_id": "alice"})
    70	        assert resp.status_code == 200
    71	        a = resp.json()["conversation_id"]
    72	        resp = await client.post("/conversations", json={"owner_id": "bob"})
    73	        assert resp.status_code == 200
    74	        alice = (await client.get("/conversations?owner_id=alice")).json()["conversation_ids"]
    75	    assert alice == [a]  # §6.1: no cross-owner data
    76	
