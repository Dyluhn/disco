+        logger.info(
+            "toolscope audit would-deny conversation=%s phase=%s tool=%s reason=%s",
+            self.conversation_id,
+            phase_value,
+            tool,
+            decision.reason,
+            extra={
+                "event": "toolscope_audit_would_deny",
+                "conversation": self.conversation_id,
+                "phase": phase_value,
+                "tool": tool,
+                "reason": decision.reason,
+            },
+        )
+
