+        self.would_denies_by_phase: dict[str, int] = {}
+        self._summary_emitted = False
+
+    def record(self, tool: str, phase: Phase, decision: ScopeDecision) -> None:
+        if self._summary_emitted:
+            self.total_tools = 0
+            self.would_denies_by_phase.clear()
+            self._summary_emitted = False
+        self.total_tools += 1
+        if decision.allowed:
