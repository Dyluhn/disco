+        for kind in ContractKind:
+            if kind.value in text:
+                return kind.value
+        compact = re.sub(r"[^a-z0-9.+-]+", " ", text)
+        for kind, terms in self._AUDIT_KIND_TERMS:
+            if any(term in compact for term in terms):
