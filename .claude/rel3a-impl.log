+                "event": "toolscope_audit_summary",
+                "conversation": self.conversation_id,
+                "status": status.value,
+                "total_tools": self.total_tools,
+                "would_denies_by_phase": by_phase,
+            },
+        )
+        self._summary_emitted = True
