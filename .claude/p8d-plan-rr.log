   212	# Every product failure code, for validation.
   213	PRODUCT_FAILURE_CODES = frozenset(SEVERITY_BY_CODE)
   214	
   215	# The "intermittent" prefix (§17): a run that failed once then passed on exact
   216	# replay is recorded as FAIL with code INTERMITTENT_<original_code>, same severity.
   217	INTERMITTENT_PREFIX = "INTERMITTENT_"
   218	
   219	
   220	def severity_for(code: str) -> str:
   221	    """Severity for a (possibly INTERMITTENT_-prefixed) failure code. Unknown
   222	    codes are treated as P0 (§13: an unclassified failure is a release blocker)."""
   223	    base = code[len(INTERMITTENT_PREFIX):] if code.startswith(INTERMITTENT_PREFIX) else code
   224	    return SEVERITY_BY_CODE.get(base, P0)
   225	
   226	
   227	def is_known_code(code: str) -> bool:
   228	    base = code[len(INTERMITTENT_PREFIX):] if code.startswith(INTERMITTENT_PREFIX) else code
   229	    return base in PRODUCT_FAILURE_CODES or base in HARNESS_VALIDITY_CODES

