   479	def value_is_only_elision_marker(value: object) -> bool:
   480	    """True when `value` is a string consisting of NOTHING BUT an elision
   481	    placeholder (plus surrounding whitespace) — i.e. the model copied the
   482	    `_snip_args` marker back verbatim with no real content of its own around it.
   483	
   484	    Used by the K1 recovery path: a PURE marker copy-back can be safely
   485	    re-expanded to the original content the marker stood in for (the engine still
   486	    holds it in the event log), because re-expansion can't clobber any real text
   487	    the model authored — there is none. A marker EMBEDDED in real text (the model
   488	    wrote a header, a marker, a footer) returns False so the recovery never
   489	    silently drops the model's surrounding edits; that case falls through to the
   490	    rejection-and-re-read path instead. Pure + deterministic."""
   491	    if not isinstance(value, str):
   492	        return False
   493	    stripped = _ELISION_PARAPHRASE_RE.sub("", _ELISION_MARKER_RE.sub("", value))
   494	    # Nothing matched ⇒ not a marker at all; or matched but real text remains.
   495	    return value != stripped and stripped.strip() == ""
