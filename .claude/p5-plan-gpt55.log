   147	
   148	class BuildContractRegistry:
   149	    """Maps a ContractKind → its BuildContract."""
   150	
   151	    def __init__(self) -> None:
   152	        self._by_kind: dict[ContractKind, BuildContract] = {}
   153	
   154	    def register(self, contract: BuildContract) -> None:
   155	        self._by_kind[contract.kind] = contract
   156	
   157	    def get(self, kind: ContractKind) -> BuildContract | None:
   158	        return self._by_kind.get(kind)
   159	
   160	    def kinds(self) -> frozenset[ContractKind]:
   161	        return frozenset(self._by_kind)
   162	
   163	    def _custom(self) -> BuildContract:
   164	        """The CUSTOM contract — registered one, else a deterministic minimal fallback
   165	        (so a partial registry never KeyErrors). A run always gets a contract."""
   166	        return self._by_kind.get(ContractKind.CUSTOM) or BuildContract.minimal(ContractKind.CUSTOM)
   167	
   168	    def get_for_brief(
   169	        self, brief: Mapping[str, Any] | None, *, strict_kind: bool = True
   170	    ) -> BuildContract:
   171	        """Resolve the contract for a BuildBrief from ``brief['kind']``.
   172	
   173	        A MISSING kind (no 'kind' key) → the CUSTOM contract (the legitimate default: a
   174	        brief that declares no kind is a custom build). A PRESENT-but-unknown/malformed
   175	        kind (a typo, wrong type) is a bad input: with ``strict_kind=True`` (default) it
   176	        raises ValueError rather than silently broadening to CUSTOM; ``strict_kind=False``
   177	        opts into the compatibility fallback. Never returns None / KeyErrors on a partial
   178	        registry."""
   179	        raw = (brief or {}).get("kind")
   180	        if raw is None:
   181	            return self._custom()
   182	        try:
   183	            kind = ContractKind(raw)
   184	        except (ValueError, TypeError) as exc:
   185	            if strict_kind:
   186	                raise ValueError(f"BuildBrief declares an unknown contract kind: {raw!r}") from exc
   187	            return self._custom()
   188	        return self._by_kind.get(kind) or self._custom()
   189	
   190	    @classmethod
   191	    def default(cls) -> BuildContractRegistry:
   192	        """A registry with every built-in contract registered."""
   193	        reg = cls()
   194	        for factory in _BUILTINS:
   195	            reg.register(factory())
   196	        return reg

