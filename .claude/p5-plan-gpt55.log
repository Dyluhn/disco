    48	            starter_kit="lead_form",
    49	        ),
    50	        # P4/TOOL-1: the AppKit semantic mutation tools are now registered, so the
    51	        # contract scopes the SEMANTIC tools (edit the AppSpec, not raw HTML). Raw
    52	        # file_write is the repair-only escape hatch.
    53	        bootstrap=ToolPack(name="appkit.leadgen.bootstrap", tools=("app_create",)),
    54	        edit=EditContract(
    55	            edit_tools=(
    56	                "app_update_content",
