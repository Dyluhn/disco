   125	def _custom() -> BuildContract:
   126	    # the escape hatch: broad tools + rewrite allowed; the generic artifact finalizer.
   127	    return BuildContract(
   128	        kind=ContractKind.CUSTOM,
   129	        artifact=ArtifactContract(kind=ContractKind.CUSTOM),
   130	        bootstrap=ToolPack(name="custom.bootstrap", tools=("file_write", "file_edit", "shell")),
   131	        edit=EditContract(edit_tools=("file_edit", "file_replace_lines"), repair_tools=("file_write",), rewrite_allowed=True),
   132	        verify=VerificationContract(finalizer="ready_for_artifact_verification"),
   133	        ui_card="ArtifactCard",
   134	    )
   135	
   136	
   137	_BUILTINS = (
   138	    _static_site,
   139	    _appkit_leadgen,
   140	    _deck,
   141	    _document,
   142	    _interactive_prototype,
   143	    _workflow_output,
   144	    _custom,
   145	)
