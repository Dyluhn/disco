    57	    def check(self, *, product_evidence: dict[str, Any] | None = None) -> list[OracleResult]:
    58	        ws = _slice(product_evidence, "browser_ws")
    59	        if ws is None:
    60	            return [skipping(self._NAME, reason="no browser_ws evidence (headless run)")]
    61	        conns = _int(ws.get("connections"))
    62	        if conns is None or conns <= 0:  # missing/malformed/zero → fail-closed
    63	            return [
    64	                failing(
