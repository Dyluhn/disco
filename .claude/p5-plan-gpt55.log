   460	def find_elided_arg_markers(arguments: dict[str, object]) -> list[str]:
   461	    """K1 execution guard: return the argument keys whose string value carries an
   462	    elision placeholder (the `_snip_args` marker copied back by a weak model).
   463	    Empty list ⇒ the arguments are clean and safe to execute. Pure + deterministic.
