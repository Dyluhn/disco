   216	    async def actionless_valve(self, events: list[Event], noops: int) -> bool:
   217	        """Shared circuit-breaker ladder for steps that consumed a model turn
   218	        without doing real work — the tool-less noop path AND the non-blocking
   219	        intercepts (notify_user / remember / serve). Returns True when the run
   220	        was landed (PAUSED/FINISHED) — the caller must
   221	        `return await self.get_state()`. Emits the warning nudge in place and
   222	        returns False otherwise.
   223	
   224	        The Phase-B re-run (2026-06-10) is why the intercepts must share this:
   225	        their bare `continue` skipped the noop bookkeeping entirely, so ~50
   226	        serve spams and ~20 prose messages sailed past every DC-05a cap until
   227	        the stuck detector fired ~95 events later."""
   228	        incomplete, _ = signals.plan_is_incomplete(events)
   229	        # BW-01 — while a plan REVISION is pending (the build re-entered PLANNING
   230	        # via request_plan and has NOT been re-approved), every terminal decision
   231	        # below would key off the STALE prior-revision plan (still marked complete)
   232	        # and force-FINISH a build the user is actively re-planning. Suppress the
   233	        # stale-plan FINISH decisions for this turn — both the completed_via_notify
   234	        # done-build finish (3 no-ops) AND the generic noop_limit→FINISHED (6) — so
   235	        # a pending re-plan can never read as a COMPLETED build. At the 3-no-op cap
   236	        # the run falls through to the plan-nudge; at the 6-no-op CEILING it does
   237	        # NOT fall through to an infinite nudge (which would HANG) — it emits a
   238	        # NON-FINISH PAUSED(actionless) halt instead (see below). Releases
   239	        # automatically once the revised plan is approved (then plan_approved.seq >
   240	        # planning.seq → this is False again and finish is allowed).
   241	        pending_revision = signals.in_planning_for_revision(events)
   242	        # BW-01 follow-up 2 — bounded halt for a pending re-plan that spins in
   243	        # PLANNING on tool-less turns. The ceiling branch below keys off the noop
   244	        # counter, but a BLANK tool-less planning turn moves NEITHER
   245	        # consecutive_noops NOR _invisible_steps (the planning-mode gate emits only
   246	        # the ENVIRONMENT plan-nudge and never bumps the invisible-step counter),
   247	        # so a model emitting prose/blank/nothing in planning racks up turns while
   248	        # `noops` stays 0 → the run hangs (codex P1). This stateless, noop-
   249	        # INDEPENDENT bound counts the planning turns since the latest `planning`
   250	        # marker (no later PlanEvent/plan_approved) and HALTS at the same ceiling
   251	        # the noop ladder uses — a NON-FINISH PAUSED(actionless), never a stale-plan
   252	        # FINISH. It is gated on `pending_revision` so a normal first build is
   253	        # untouched, and releases automatically once a revised plan is submitted/
   254	        # approved (then planning_turns_since_replan == 0 again).
   255	        if (
   256	            pending_revision
   257	            and signals.planning_turns_since_replan(events)
   258	            >= self._loop._max_consecutive_noops
   259	        ):
   260	            await self._loop._emit(
   261	                MessageEvent(
   262	                    source=EventSource.ENVIRONMENT,
   263	                    message=LLMMessage(
   264	                        role="user",
   265	                        content=(
   266	                            "The agent stayed in planning for several turns without"
   267	                            " submitting a revised plan while a re-plan is pending —"
   268	                            " pausing instead of burning tokens. Resume to continue,"
   269	                            " or send a new instruction."
   270	                        ),
   271	                    ),
   272	                )
   273	            )
   274	            await self._loop._emit(
   275	                StatusEvent(status=ConversationStatus.PAUSED, detail="actionless")
   276	            )
   277	            return True
   278	        if noops >= self._loop._ACTIONLESS_BREAK_CAP:
   279	            # B5 — completion BEFORE pause. A model that signals "done" via
   280	            # notify_user (×N) instead of finish() trips the actionless valve.
   281	            # If the build's definition-of-done is actually met (a plan exists
   282	            # and EVERY step is marked done), the run is finished — land a clean
   283	            # FINISHED rather than PAUSED so a completed build doesn't read as
   284	            # paused. Conservative: `plan_steps_complete` is False for the
   285	            # no-plan / partially-done cases, so a genuine stall still PAUSES
   286	            # below (the thrash guard is untouched). AND require real productive
   287	            # work since approval — marking every step done (plan_step OR the
   288	            # declarative update_plan_progress) + spamming notify_user must NOT
   289	            # FINISH an empty workspace; a "done" plan with zero state-changing
   290	            # actions is a hallucinated completion, not a build.
   291	            if (
   292	                not pending_revision
   293	                and signals.plan_steps_complete(events)
   294	                and signals.productive_actions_since_approval(events) > 0
   295	            ):
   296	                # W-32 — DO NOT force-finish directly. The old code emitted
   297	                # StatusEvent(FINISHED) here, BYPASSING every gate a real
   298	                # `finish()` must clear (execution-nudge, browser-verify, DoD).
   299	                # That let an UNVERIFIED "done" — signaled by notify_user-spam,
   300	                # with mid-action narration ("I need to press Enter to submit
   301	                # the Terminal command…") still in flight — land a FINISHED
   302	                # chip. Route through the SAME gate machinery a finish() call
   303	                # uses: only land FINISHED if they all pass; otherwise the gate
   304	                # injected its own "verify then finish" reminder and we CONTINUE
   305	                # (return False) — never PAUSE/STUCK — so the model verifies.
   306	                if await self._completed_via_notify_finish(events):
   307	                    return True
   308	                return False
   309	            # Bug 6 — HONEST unverifiable-static finish at the actionless valve. The
   310	            # finish-gate honest path (finish.py) only runs when the model REACHES the
   311	            # finish gate; here the model churns on an unsatisfiable browser-verify plan
   312	            # step on a browserless backend and would otherwise PAUSE actionless. When
   313	            # the build is substantively complete (a delivered index.html + a passing
   314	            # non-browser validation, only verify-only steps remaining) and browser
   315	            # verification is GENUINELY unavailable with NO real web-failure evidence,
   316	            # FINISH honestly instead of pausing. Every other case (missing/broken
   317	            # deliverable, real failure, non-verify work remaining, zero productive
   318	            # work) returns False and falls through to the pause/stuck ladder below —
   319	            # so W-45 and APPROVE_PLAN_NO_EXECUTION are preserved. Suppressed during a
   320	            # pending re-plan (BW-01) like the completion branch above.

