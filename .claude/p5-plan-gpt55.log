     3	Declares the concrete BuildContract for each artifact kind — its required files,
     4	starter kit, bootstrap/edit tool packs, verification finalizer, export pipeline,
     5	prompt pack, and UI card — and looks one up by kind or from a BuildBrief. Both kernels
     6	(DiscoKernel/PiKernel) resolve the same contract here, so a Build run has a declared,
     7	host-owned contract before execution. Pure data + lookup; no runtime imports.
     8	"""
     9	
    10	from __future__ import annotations
    11	
    12	from collections.abc import Mapping
    13	from typing import Any
    14	
    15	from .models import (
    16	    ArtifactContract,
    17	    BuildContract,
    18	    ContractKind,
    19	    EditContract,
    20	    ExportContract,
    21	    ToolPack,
    22	    VerificationContract,
    23	    VerificationLevel,
    24	)
    25	
    26	
    27	def _static_site() -> BuildContract:
    28	    return BuildContract(
    29	        kind=ContractKind.STATIC_SITE,
    30	        artifact=ArtifactContract(
    31	            kind=ContractKind.STATIC_SITE, required_files=("index.html",), starter_kit="app_shell"
    32	        ),
    33	        bootstrap=ToolPack(name="static.site.bootstrap", tools=("file_write", "preview_start")),
    34	        edit=EditContract(edit_tools=("file_edit", "file_replace_lines"), repair_tools=("file_write",)),
    35	        verify=VerificationContract(finalizer="ready_for_static_site_verification"),
    36	        export=ExportContract(name="static_standalone", pipeline=("preflight", "bundle", "validate", "deliver")),
    37	        prompt_pack="build_static_site",
    38	        ui_card="SiteCard",
    39	    )
