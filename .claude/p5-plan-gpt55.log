   163	def _ask_user_tool_spec():
   164	    """Lazy-imported ToolSpec for ask_user — avoids a circular import on
   165	    module load (ToolSpec lives in ..llm which doesn't yet exist when this
   166	    module imports)."""
   167	    from ..llm.types import ToolSpec
   168	
   169	    return ToolSpec(
   170	        name=_ASK_USER_TOOL_NAME,
   171	        description=_ASK_USER_DESCRIPTION,
   172	        parameters_schema=_ASK_USER_PARAMETERS_SCHEMA,
