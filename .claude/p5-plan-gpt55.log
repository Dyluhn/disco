   174	
   175	
   176	# The propose_plan_update tool — the model's auto-recovery affordance for
   177	# when its current plan is no longer right. Call this when a step fails in a
   178	# way that invalidates the path, OR when discoveries during execution suggest
   179	# a different decomposition is better, OR when the user steers toward a new
   180	# goal. The user accepts/refines/rejects via the existing plan-approval gate.
   181	_PROPOSE_PLAN_UPDATE_DESCRIPTION = (
   182	    "Propose a REVISED plan when the current plan is no longer the right path. "
   183	    "Use this when: a step has failed in a way that means the whole plan needs "
   184	    "rethinking; you've discovered something during execution that suggests a "
   185	    "different decomposition; or the user's steer message implies a new goal. "
