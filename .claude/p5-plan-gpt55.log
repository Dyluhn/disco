   169	def _canonical_deployment_url(raw: str) -> str:
   170	    """Return a served `deployment_url` ONLY when it is reachable from OUTSIDE the
   171	    sandbox; otherwise return "".
   172	
   173	    F3 (live build stress-test): when the agent serves a site it reports the
   174	    address it bound INSIDE the sandbox (observed: ``http://127.0.0.1:8000/``).
   175	    That loopback/private address is reachable only from inside the sandbox —
   176	    never from the host browser, the operator, or the verifier. Worse, :8000 also
   177	    happens to be the Disco agent-server's own port, so following the URL verbatim
   178	    hits the wrong server. Surfacing it as the deliverable's "Deployed" URL is a
   179	    false affordance.
   180	
   181	    The honest, host-reachable address is the preview-proxy route
   182	    (``/conversations/{cid}/preview-app/``), which every consumer already falls
   183	    back to when there is no canonical URL (frontend DeliverablePanel/PreviewPane,
   184	    operator `view`, the verify runner's URL-less app branch). So we keep the URL
   185	    only for an absolute http(s) URL whose host is publicly reachable (a real
   186	    deploy target / tunnel hostname or a global IP); a loopback / unspecified /
   187	    private / link-local / reserved host is dropped to "".
   188	    """
   189	    url = (raw or "").strip()
   190	    if not url:
   191	        return ""
   192	    parts = urlsplit(url)
   193	    if parts.scheme not in ("http", "https") or not parts.hostname:
   194	        return ""
   195	    host = parts.hostname
   196	    if host.lower() in {
   197	        "localhost",
   198	        "localhost.localdomain",
   199	        "ip6-localhost",
   200	        "ip6-loopback",
   201	    }:
   202	        return ""
   203	    try:
   204	        ip = ipaddress.ip_address(host)
   205	    except ValueError:
   206	        # A real DNS hostname (deploy target / tunnel) — keep it.
   207	        return url
   208	    # A bare IP literal: keep only a globally-routable (public) address.
   209	    return url if ip.is_global else ""
