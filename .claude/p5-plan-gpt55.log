     1	"""Meta-tool specifications — static ToolSpec builders for the virtual tools.
     2	
     3	Extracted from `engine.py` (god-file decomposition, Wave 1). These build the
     4	static ToolSpec objects for the loop-intercepted virtual tools that never reach
     5	the executor: `ask_user`, `clarify`, `propose_plan_update`, and `notify_user`.
     6	
     7	Each builder lazy-imports ToolSpec from ..llm.types inside the function to avoid
     8	a circular import at module-load time; the `_*_tool_singleton()` accessors build
     9	each spec once (cached in a module global) on first access. All pure — no loop
    10	or `self` state. The engine imports the four `_*_tool_singleton()` accessors to
    11	assemble its virtual-tool list.
    12	
    13	(The finish / remember / serve / delegate_explore specs follow the identical
    14	pattern but remain in engine.py — they are interleaved there with non-spec
    15	verify-command + fan-out machinery and are out of scope for this Wave-1 move.)
    16	"""
    17	
    18	from __future__ import annotations
    19	
    20	# The virtual ask_user tool — the model's escape hatch when it (in its own
    21	# reasoning, not at harness nudging) decides it needs the human's judgment.
    22	# This is the Claude Code pattern done honestly: the tool is described, it's
    23	# in the model's tool list, and the model chooses to call it. The harness
    24	# never says "you must use this now"; the model uses it when its reasoning
    25	# concludes that human input is the next-best step.
    26	#
    27	# When called, the loop INTERCEPTS it (the tool is never executed against the
    28	# sandbox). WITH options it becomes an AlternativesEvent + AWAITING_USER_DECISION
    29	# (the user picks a card); WITHOUT options it becomes a free-form question +
    30	# AWAITING_USER_QUESTION (the user types an answer). Either way the reply resumes
    31	# the run.
    32	_ASK_USER_TOOL_NAME = "ask_user"
    33	
    34	# The virtual clarify tool — the planner's typed multi-question escape hatch.
    35	# When the request is ambiguous (multiple interpretations, missing specifics),
    36	# the planner calls `clarify` with a set of TYPED questions instead of guessing.
    37	# The loop intercepts the call, emits a ClarifyEvent carrying the typed
    38	# questions, and halts at AWAITING_USER_QUESTION. The user answers each
    39	# question; the answers are re-injected as a user message and planning proceeds
    40	# with the clarified context.
    41	#
    42	# This GENERALIZES ask_user's single free-form question: clarify carries
    43	# MULTIPLE structured questions with types (short_text / long_text / choice)
    44	# so the planner can get precise answers to the exact unknowns, not one
    45	# sprawling free-form block. The planner CHOOSES which tool to call — single
    46	# question (ask_user) or structured batch (clarify) — based on how many
    47	# unknowns it faces.
    48	_CLARIFY_TOOL_NAME = "clarify"
    49	_CLARIFY_DESCRIPTION = (
    50	    "Pause BEFORE planning and ask the user MULTIPLE structured clarification "
    51	    "questions. Use this when the request is ambiguous and you need SEVERAL "
    52	    "specific answers before you can commit to a good plan — a brand color, "
    53	    "a tech preference, a target host, a file name, a layout choice. "
    54	    "Provide an overarching `question` summarizing what you're clarifying, "
    55	    "and a `questions` array of typed items. Each item has: an `id` (short "
    56	    "stable identifier like 'color' or 'stack'), the `question` text, a "
    57	    "`type` field ('short_text' for a one-word answer, 'long_text' for a "
    58	    "sentence, 'choice' for a pick from `options`), and optional `options` "
    59	    "array for choice-type questions. For a 'choice' question, `options` MUST "
    60	    "be a FLAT array of plain strings (the exact labels the user picks, e.g. "
    61	    "[\"Modern\", \"Classic\", \"Your call\"]) — never objects, never nested "
    62	    "arrays. Prefer 2-5 questions — enough to "
    63	    "disambiguate, not an interrogation. Call this BEFORE submit_plan when "
    64	    "the unknowns are genuine blockers to a good plan."
    65	)
    66	_CLARIFY_PARAMETERS_SCHEMA = {
    67	    "type": "object",
    68	    "properties": {
    69	        "question": {
    70	            "type": "string",
    71	            "description": "Overarching summary of what you're clarifying (one sentence).",
    72	        },
    73	        "questions": {
    74	            "type": "array",
    75	            "description": "The typed questions to ask (2-5 items).",
    76	            "items": {
    77	                "type": "object",
    78	                "properties": {
    79	                    "id": {
    80	                        "type": "string",
    81	                        "description": "Short stable id, e.g. 'color' or 'stack'.",
    82	                    },
    83	                    "question": {
    84	                        "type": "string",
    85	                        "description": "The question text the user sees.",
    86	                    },
    87	                    "type": {
    88	                        "type": "string",
    89	                        "enum": ["short_text", "long_text", "choice"],
    90	                        "description": (
    91	                            "Input kind: short_text (one word), long_text (sentence), "
    92	                            "choice (pick from options)."
    93	                        ),
    94	                    },
    95	                    "options": {
    96	                        "type": "array",
    97	                        "items": {"type": "string"},
    98	                        "description": (
    99	                            "Allowed choices for type=choice — a FLAT array of "
   100	                            "plain strings (the labels the user picks), e.g. "
   101	                            '["Modern", "Classic"]. Never objects or nested arrays.'
   102	                        ),
   103	                    },
   104	                },
   105	                "required": ["id", "question"],
   106	            },
   107	            "minItems": 1,
   108	            "maxItems": 5,
   109	        },
   110	    },
