   124	def _normalize_clarify_options(raw: object) -> list[str]:
   125	    """Flatten a raw `options` value into clean, de-duplicated label strings.
   126	    Empty / unrecoverable options are dropped — a `choice` left with too few
   127	    real options is downgraded to free text by the caller (no blank radios)."""
   128	    if not isinstance(raw, (list, tuple)):
   129	        return []
   130	    seen: set[str] = set()
   131	    out: list[str] = []
   132	    for opt in raw:
   133	        for label in _coerce_choice_label(opt):
   134	            if label not in seen:
   135	                seen.add(label)
   136	                out.append(label)
   137	    return out
