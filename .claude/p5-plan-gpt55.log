   103	        artifact=ArtifactContract(
   104	            kind=ContractKind.INTERACTIVE_PROTOTYPE, required_files=("index.html",), starter_kit="app_shell"
   105	        ),
   106	        bootstrap=ToolPack(name="interactive.prototype.bootstrap", tools=("file_write", "preview_start")),
   107	        edit=EditContract(edit_tools=("file_edit", "file_replace_lines")),
