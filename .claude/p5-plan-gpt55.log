     1	"""Preview tools — the model declares INTENT; the platform owns the port/serving/health.
     2	
     3	EPIC F. These four tools (`preview_start`, `preview_status`, `preview_logs`,
     4	`preview_stop`) are the model-facing surface of the `PreviewManager`. The defining
     5	property — the whole point of the epic — is what `preview_start` does NOT have: a
     6	port argument. The model says WHAT to serve (a build-output dir, a framework, or a
     7	bare start command) and the platform decides WHERE (the port), starts + supervises
     8	the process, polls health, and hands back the platform-assigned URL. A model can
     9	neither pick nor override a port through these tools.
    10	
    11	The `PreviewManager` lives in the agent-server layer (it's a runtime collaborator,
    12	bound to the conversation's sandbox). To respect the package layering (tools must not
    13	statically depend on agent_server), the tool reaches the manager off the live sandbox
    14	session — the runtime attaches it there — and lazily constructs one on first use via a
    15	function-local import (the same dodge `audio_overview` uses for its agent_server reach).
    16	"""
    17	
    18	from __future__ import annotations
    19	
    20	from typing import Any
    21	
    22	from disco.core import SecurityRisk
    23	from pydantic import BaseModel, ConfigDict, Field
    24	
    25	from ..anatomy import Capability, ToolContext, ToolDef, ToolOutcome
    26	
    27	
    28	def _manager(ctx: ToolContext) -> Any:
    29	    """The conversation's PreviewManager, bound to the live sandbox session.
    30	
    31	    Cached on the sandbox session (which is task-scoped and survives across tool
    32	    calls) so supervision + the preview registry persist between `preview_*` calls.
    33	    Lazily constructed on first use — a function-local import keeps the tools layer
    34	    free of a static agent_server dependency (mirrors `audio_overview`)."""
    35	    sandbox: Any = ctx.sandbox
    36	    mgr = getattr(sandbox, "_preview_manager", None)
    37	    if mgr is None:
    38	        from disco.agent_server.preview_manager import PreviewManager
    39	
    40	        mgr = PreviewManager(sandbox)
    41	        try:
    42	            sandbox._preview_manager = mgr  # noqa: SLF001 — caching on the session we own
    43	        except Exception:  # noqa: BLE001 — non-settable fake in a test → use the fresh one
    44	            pass
    45	    return mgr
    46	
    47	
    48	def _render(session: Any) -> str:
    49	    url = session.url or "(no URL — see status)"
    50	    running = getattr(session.status, "value", "") == "running"
    51	    # BAKE-OFF #7: `url` is the HOST-published browser URL — NOT reachable from inside the
    52	    # sandbox. A model that curls it from its shell gets connection-refused (000) and wrongly
    53	    # concludes the build is broken. The IN-SANDBOX url is on the PLATFORM-assigned port
    54	    # (NEVER a fixed :8000 — the platform chooses it; see PreviewManager), so ALWAYS surface
    55	    # it: it is the one URL the model can curl from its shell. Showing it unconditionally —
    56	    # even before the preview is health-verified — stops the model falling back to guessing
    57	    # :8000 (which serves nothing) while the server is still coming up.
    58	    insandbox = f"http://localhost:{session.port}/"
    59	    if running:
    60	        # `running` means the platform already health-probed it (HTTP 200, in-sandbox) — so
    61	        # say it's verified and hand over the in-sandbox URL for any further check.
    62	        verify = (
    63	            f"\n  status: ALREADY platform-health-verified (HTTP 200, probed in-sandbox) — it IS "
    64	            f"serving; you do NOT need to curl it.\n"
    65	            f"  in-sandbox url (curl THIS from your shell, NOT the browser url): {insandbox}"
    66	        )
    67	    else:
    68	        # Not yet health-verified — but still give the correct in-sandbox URL so the model
    69	        # checks the RIGHT port once it's up, never a guessed :8000.
    70	        verify = (
    71	            f"\n  in-sandbox url (once it's up, curl THIS from your shell, NOT the browser url): "
    72	            f"{insandbox}"
    73	        )
    74	    return (
    75	        f"preview '{session.name}': {session.status.value}\n"
    76	        f"  browser url: {url}  (for the USER's browser — NOT reachable from inside the sandbox)\n"
    77	        f"  port:   {session.port}  (platform-assigned)\n"
    78	        f"  detail: {session.detail or 'ok'}"
    79	        f"{verify}"
    80	    )
