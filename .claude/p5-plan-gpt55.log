   744	class DeliverableEvent(BaseEvent, LLMConvertible):
   745	    """The agent's explicit 'here is the finished thing' handoff (Build). It names
   746	    WHAT was produced and WHERE, so the UI can present a real handoff (open the
   747	    live app / download the files) instead of leaving the user to guess what the
   748	    run made. Distinct from the live preview (which shows work-in-progress): a
   749	    DeliverableEvent is the agent affirming a result is ready.
   750	
   751	    `kind`:
   752	      • "app"   — a runnable result the user opens in the live preview (a built
   753	                  site / running dev server rooted at `path`).
   754	      • "files" — one or more workspace artifacts to download/inspect (`path` is
   755	                  the file or directory).
   756	
   757	    LLMConvertible so the agent's own context reflects what it has already handed
   758	    off (it shouldn't re-deliver the same thing); the body stays terse."""
   759	
   760	    kind: Literal[EventKind.DELIVERABLE] = EventKind.DELIVERABLE
   761	    source: EventSource = EventSource.AGENT
   762	    title: str  # short human label, e.g. "Landing page" / "Sales report"
   763	    path: str  # workspace-relative path (dir for an app root, file/dir for files)
   764	    artifact_kind: Literal["app", "files"] = "app"
   765	    # Optional canonical URL the deliverable is reachable at (a deploy target, a
   766	    # tunnel, or the live preview). When the agent serves to a known address it
   767	    # passes it on `serve(url=…)`; the UI surfaces an "Open deployed app" link.
   768	    deployment_url: str = ""
   769	
   770	    def to_llm_message(self) -> LLMMessage:
   771	        return LLMMessage(
   772	            role="user",
   773	            content=(
   774	                f"<deliverable kind=\"{self.artifact_kind}\" path=\"{self.path}\">\n"
   775	                f"{self.title}\n</deliverable>"
   776	            ),
   777	        )
