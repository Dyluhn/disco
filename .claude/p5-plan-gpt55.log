    79	def _coerce_choice_label(opt: object, _depth: int = 0) -> list[str]:
    80	    """Normalize ONE raw `clarify` choice-option into zero or more clean label
    81	    strings. Defensive against the model's shape drift — exactly the discipline
    82	    `plans.py:alternatives_from_args` applies to `ask_user` options, which the
    83	    clarify handler historically lacked.
    84	
    85	    Observed live malformations (build `clarify`, real models) that the naive
    86	    `str(o)` mangled into garbage or empties:
    87	      * a `{"id": "...", "question"/"label": "..."}` object  → `str(dict)`
    88	        rendered the whole Python-repr as one radio label.
    89	      * a NESTED list `["A", ["B", "C"]]`                    → `str(list)`
    90	        rendered the whole repr as one radio label.
    91	      * empty placeholders `["", "", ""]`                     → blank radios
    92	        ("empty bubble cards" with nothing to pick).
    93	
    94	    This returns FLAT, human-readable, non-empty labels; dicts contribute their
    95	    best text field; nested lists are flattened; empties are dropped."""
    96	    if _depth > 4:
    97	        return []
    98	    if isinstance(opt, str):
    99	        s = opt.strip()
   100	        return [s] if s else []
   101	    if isinstance(opt, bool):
   102	        return [str(opt)]
   103	    if isinstance(opt, (int, float)):
   104	        return [str(opt)]
   105	    if isinstance(opt, dict):
   106	        # Prefer a human-readable field; the model reuses the multi-question
   107	        # item shape ({id, question}) and the ask_user option shape
   108	        # ({title, description}) interchangeably inside `options`.
   109	        for key in ("label", "title", "text", "value", "name", "question", "option"):
   110	            v = opt.get(key)
   111	            if isinstance(v, str) and v.strip():
   112	                return [v.strip()]
   113	        # No known text key — fall back to the single string value if unambiguous.
   114	        str_vals = [v.strip() for v in opt.values() if isinstance(v, str) and v.strip()]
   115	        return [str_vals[0]] if len(str_vals) == 1 else []
   116	    if isinstance(opt, (list, tuple)):
   117	        out: list[str] = []
   118	        for sub in opt:
   119	            out.extend(_coerce_choice_label(sub, _depth + 1))
   120	        return out
   121	    return []
   122	
