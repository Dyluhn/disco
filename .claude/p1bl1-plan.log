    16	- the product harness ran green: browser WS connected, preview visible, download
    17	  verified, cleanup ok, zero provider calls after terminal. Enforced only when
    18	  ``require_product_harness=True`` (default False until HARN-1b exists, so this gate
    19	  reports as not-yet-required rather than blocking on absent browser evidence).
    20	"""
    21	
    22	from __future__ import annotations
    23	
    24	from typing import Any
    25	
    26	from . import failure_codes as fc
    27	
    28	# Provider-ledger violation codes that must never appear in a promotable run.
    29	_PROVIDER_VIOLATIONS = frozenset(
    30	    {fc.PROVIDER_FORBIDDEN, fc.PROVIDER_WRONG_MODEL, fc.PROVIDER_CALL_AFTER_TERMINAL}
    31	)
    32	
    33	# The product-harness sub-gates HARN-1b must report all True.
    34	_PRODUCT_HARNESS_KEYS = (
    35	    "browser_ws_connected",
    36	    "preview_visible",
    37	    "download_verified",
    38	    "cleanup_ok",
    39	    "zero_provider_calls_after_terminal",
    40	)
    41	
    42	
    43	def evaluate_product_promotion(
    44	    classifications: list[dict[str, Any]],
    45	    *,
    46	    product_harness: dict[str, Any] | None = None,
    47	    require_product_harness: bool = False,
    48	) -> dict[str, Any]:
    49	    """Return ``{"eligible": bool, "checks": [{"check", "ok", "detail"}]}``.
    50	
    51	    A check with ``ok is None`` is informational (not blocking), matching the
    52	    bakeoff gate convention. ``eligible`` is True only when no check is False.
    53	    """
    54	    checks: list[dict[str, Any]] = []
    55	
    56	    def chk(name: str, ok: bool | None, detail: str) -> None:
    57	        checks.append({"check": name, "ok": ok, "detail": detail})
    58	
    59	    runs = list(classifications or [])
    60	    chk("runs present", len(runs) > 0, f"{len(runs)} run(s) classified")
    61	
    62	    if runs:
    63	        non_pass = [c for c in runs if c.get("status") != fc.PASS]
    64	        chk("all runs PASS", not non_pass, f"{len(non_pass)} non-PASS run(s)")
    65	
    66	        invalid = [c for c in runs if c.get("status") == fc.INVALID_RUN]
    67	        chk("no INVALID_RUN", not invalid, f"{len(invalid)} invalid run(s)")
    68	
    69	        unknown = [c for c in runs if c.get("code") == fc.UNKNOWN_FAILURE]
    70	        chk("no UNKNOWN_FAILURE", not unknown, f"{len(unknown)} unknown-failure run(s)")
    71	
    72	        provider_bad = [c for c in runs if c.get("code") in _PROVIDER_VIOLATIONS]
    73	        chk(
    74	            "provider constraint (MiniMax-only / no-OpenRouter / no calls after terminal)",
    75	            not provider_bad,
    76	            (
    77	                "clean"
    78	                if not provider_bad
    79	                else f"{len(provider_bad)} provider violation(s): "
    80	                + ", ".join(sorted({str(c.get('code')) for c in provider_bad}))
    81	            ),
    82	        )
    83	
    84	    # product harness gate
    85	    if require_product_harness:
    86	        if not product_harness:
    87	            chk("product harness green", False, "required but no product-harness result supplied")
    88	        else:
    89	            failed_keys = [k for k in _PRODUCT_HARNESS_KEYS if not product_harness.get(k)]
    90	            chk(
    91	                "product harness green",
    92	                not failed_keys,
    93	                "all sub-gates green" if not failed_keys else f"failed: {failed_keys}",
    94	            )
    95	    else:
    96	        chk(
    97	            "product harness green",
    98	            None,
    99	            "not required yet (HARN-1b browser harness pending)",
   100	        )
   101	
   102	    eligible = all(c["ok"] for c in checks if c["ok"] is not None) and not any(
   103	        c["ok"] is False for c in checks
   104	    )
   105	    return {"eligible": eligible, "checks": checks}

