     1	"""HARN-1b (evidence side) — the validated producer of the product-harness dossier.
     2	
     3	The HARN-2 oracles READ a ``product_evidence`` dict + a provider-call ledger. This
     4	module is the verified WRITER: it validates a captured dossier against the schema the
     5	oracles expect BEFORE writing it, so a harness bug can't emit malformed evidence that
     6	an oracle would silently mis-adjudicate. The live Playwright harness captures the raw
     7	browser data and calls these to serialize ``product-evidence.json`` and
     8	``provider-call-ledger.jsonl`` into the run folder.
     9	
    10	This is pure + unit-tested; it does not drive a browser (that is HARN-1b's live spec).
    11	"""
    12	
    13	from __future__ import annotations
    14	
    15	import json
    16	from pathlib import Path
    17	from typing import Any
    18	
    19	# The expected slices and their field types. Each slice is optional (a run that did
    20	# not export has no "export" slice → the ExportDownload oracle SKIPs), but when a slice
    21	# IS present its fields must be well-typed so the oracle reads it fail-closed-correctly.
    22	_SLICE_FIELDS: dict[str, dict[str, type]] = {
    23	    "browser_ws": {"connections": int},
    24	    "lifecycle": {"terminal": str},
    25	    "sidecar": {"stopped_at_terminal": bool, "provider_calls_after_terminal": int},
    26	    "preview": {"owner": str, "manual_port": bool},
    27	    "shown": {"artifact_shown": bool, "preview_shown": bool},
    28	    "verification": {"ready_for_verification_called": bool, "passed": bool},
    29	    "export": {"requested": bool},
    30	    "cleanup": {"orphans": int, "workspace_released": bool},
    31	}
    32	
    33	PRODUCT_EVIDENCE_NAME = "product-evidence.json"
    34	PROVIDER_LEDGER_NAME = "provider-call-ledger.jsonl"
    35	
    36	
    37	def validate_product_evidence(ev: dict[str, Any]) -> list[str]:
    38	    """Return a list of schema problems (empty = valid). Unknown top-level keys are
    39	    allowed (forward-compat); a known slice must be a dict whose declared fields, when
    40	    present, carry the right type. ``bool`` is rejected where ``int`` is required (a
    41	    bool count is a capture bug)."""
    42	    problems: list[str] = []
    43	    if not isinstance(ev, dict):
    44	        return ["product_evidence is not a dict"]
    45	    for slice_name, fields in _SLICE_FIELDS.items():
    46	        if slice_name not in ev:
    47	            continue
    48	        slice_val = ev[slice_name]
    49	        if not isinstance(slice_val, dict):
    50	            problems.append(f"{slice_name}: not a dict")
    51	            continue
    52	        for field, typ in fields.items():
    53	            if field not in slice_val:
    54	                continue
    55	            val = slice_val[field]
    56	            if typ is int and isinstance(val, bool):
    57	                problems.append(f"{slice_name}.{field}: bool where int expected")
    58	            elif not isinstance(val, typ):
    59	                problems.append(f"{slice_name}.{field}: {type(val).__name__} where {typ.__name__} expected")
    60	    return problems
    61	
    62	
    63	def write_product_evidence(folder: str | Path, ev: dict[str, Any], *, strict: bool = True) -> Path:
    64	    """Validate then write ``product-evidence.json`` into ``folder``. With
    65	    ``strict=True`` (default) a schema problem raises ValueError BEFORE writing, so the
    66	    harness never persists evidence the oracles can't trust."""
    67	    problems = validate_product_evidence(ev)
    68	    if problems and strict:
    69	        raise ValueError(f"product_evidence failed schema validation: {problems}")
    70	    out = Path(folder) / PRODUCT_EVIDENCE_NAME
    71	    out.write_text(json.dumps(ev, indent=2, sort_keys=True), encoding="utf-8")
    72	    return out
    73	
    74	
    75	def write_provider_ledger(folder: str | Path, records: list[dict[str, Any]]) -> Path:
    76	    """Write ``provider-call-ledger.jsonl`` (one JSON record per line). Each record
    77	    should carry at least a ``host``; the ProviderLedgerOracle fail-closes on a hostless
    78	    record, so a non-dict / hostless entry here would surface as an evidence gap."""
    79	    out = Path(folder) / PROVIDER_LEDGER_NAME
    80	    lines = [json.dumps(r, sort_keys=True) for r in records]
    81	    out.write_text("\n".join(lines) + ("\n" if lines else ""), encoding="utf-8")
    82	    return out

