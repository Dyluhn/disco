     1	"""Kernel-neutral prompt assembly (WPP-2).
     2	
     3	Both kernels (DiscoKernel / PiKernel) build the model prompt from the SAME ordered
     4	parts, so product behavior can't diverge between them:
     5	
     6	    stable system prefix
     7	    → WorkflowPromptPack (the mode-specific operating manual, WPP-1)
     8	    → ContextPack block (the compact run state, CXT-4 render_context_pack)
     9	    → recent turns (the live user/assistant messages)
    10	    → [allowed tool schema — supplied to the driver as its `tools`, not a message]
    11	
    12	Pure + deterministic: identical inputs → identical messages (the kernel-neutrality
    13	guarantee). Each structured part appears EXACTLY once and the stable prefix never
    14	reorders, so the prompt prefix stays cache-stable.
    15	"""
    16	
    17	from __future__ import annotations
    18	
    19	from collections.abc import Sequence
    20	
    21	from ..events import LLMMessage
    22	from .prompt_pack import PromptPack
    23	
    24	
    25	def assemble_workflow_prompt(
    26	    *,
    27	    system_prefix: str,
    28	    prompt_pack: PromptPack | None = None,
    29	    context_pack_block: str | None = None,
    30	    recent_turns: Sequence[LLMMessage] = (),
    31	) -> list[LLMMessage]:
    32	    """Assemble the ordered message list both kernels send to the driver.
    33	
    34	    - ``system_prefix``: the stable system prompt (cache-stable head).
    35	    - ``prompt_pack``: the workflow pack for the active contract (its rendered manual).
    36	    - ``context_pack_block``: the CXT-4 rendered ``<context-pack>`` block (run state).
    37	    - ``recent_turns``: the live conversation turns, appended verbatim.
    38	    The allowed tool schema is NOT a message — the driver receives it as `tools`.
    39	    """
    40	    msgs: list[LLMMessage] = [LLMMessage(role="system", content=system_prefix)]
    41	    if prompt_pack is not None:
    42	        msgs.append(LLMMessage(role="system", content=prompt_pack.render()))
    43	    if context_pack_block:
    44	        msgs.append(LLMMessage(role="user", content=context_pack_block))
    45	    msgs.extend(recent_turns)
    46	    return msgs

