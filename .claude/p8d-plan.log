    )
    (tmp_path / "product-evidence.json").write_text("{ not valid json", encoding="utf-8")
    c = classify_run_folder(tmp_path, scenario=_scn())  # corrupt → ignored (None) → oracles SKIP
    assert c["status"] == "PASS", c

