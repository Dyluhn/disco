+def _matched_old_lines(text: str, old: str) -> tuple[int, int] | None:
+    """Best-effort line span for the file_edit old text under the same forgiving match family."""
+    candidates: list[str] = []
+    for candidate in (old, _strip_line_numbers(old)):
