    # it onto every ToolContext, so file_read honors it without per-tool plumbing.
    sandbox = FakeSandboxInstance()
    await sandbox.write_file("big.py", _big_file_body(1_000))
    ex = DefaultToolExecutor(
        build_default_registry(),
