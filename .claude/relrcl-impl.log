                        "placeholder (e.g. '<… chars elided …>'); read the file and use the real text."
                    ),
                    structured={
                        "kind": "elision_marker_rejected",
                        "path": args.path,
                        "next_required_action": "file_read",
                        "suggested_args": {"path": args.path},
