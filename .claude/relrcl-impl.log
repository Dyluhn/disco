+    doc = text.splitlines(keepends=True)
+    norm = [x.strip() for x in doc]
+    tgt = target.split("\n")
+    for i in range(0, len(norm) - len(tgt) + 1):
+        if norm[i : i + len(tgt)] == tgt:
+            return (i + 1, i + len(tgt))
+    return None
+
