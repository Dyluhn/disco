"""Manual-edit-preservation oracles (P8D).

Zero-opinion checks that an edit preserved work it must not destroy: a user's direct/manual
override survives a later agent edit, comment anchors survive text edits and section
reorders (set membership, not position), and an UNEDITED section's screen label stays
stable. Pure functions over the ``product_evidence`` dossier; SKIP on an absent slice,
fail closed (EDIT_ORACLE_EVIDENCE_MALFORMED → INVALID_RUN) on a malformed one.
"""

from __future__ import annotations

from typing import Any

from .. import failure_codes as fc
from .schema import OracleResult, failing, passing, skipping


def _slice(product_evidence: dict[str, Any] | None, key: str) -> dict[str, Any] | None:
    if not product_evidence:
        return None
    val = product_evidence.get(key)
    return val if isinstance(val, dict) else None


def _malformed(oracle: str, why: str, facts: dict[str, Any]) -> OracleResult:
    return failing(
        oracle,
        fc.EDIT_ORACLE_EVIDENCE_MALFORMED,
        first_broken_link="edit_evidence -> oracle",
        facts={"why": why, **facts},
    )


class ManualEditPreservationOracle:
    """Every manual/direct override snippet must still be present (verbatim) in the post-edit
    file — an agent edit must not clobber the user's own change."""

    _NAME = "ManualEditPreservationOracle"

    def check(self, *, product_evidence: dict[str, Any] | None = None) -> list[OracleResult]:
        ev = _slice(product_evidence, "manual_edit")
        if ev is None:
            return [skipping(self._NAME, reason="no manual_edit evidence")]
        overrides, final = ev.get("overrides"), ev.get("final_files")
        if not isinstance(overrides, dict) or not isinstance(final, dict):
            return [_malformed(self._NAME, "overrides/final_files must be dicts", {})]
        clobbered: list[str] = []
        for path, snippet in overrides.items():
            content = final.get(path)
            if not isinstance(content, str) or str(snippet) not in content:
                clobbered.append(str(path))
        facts = {"override_paths": sorted(map(str, overrides)), "clobbered": sorted(clobbered)}
        if clobbered:
            return [failing(self._NAME, fc.MANUAL_EDIT_CLOBBERED,
                            first_broken_link="agent_edit -> manual_override", facts=facts)]
        return [passing(self._NAME, facts=facts)]


class CommentAnchorOracle:
    """Comment anchors present before the edit must all still be present after it — they
    survive a text edit and MOVE with a section reorder (set membership, not position)."""

    _NAME = "CommentAnchorOracle"

    def check(self, *, product_evidence: dict[str, Any] | None = None) -> list[OracleResult]:
        ev = _slice(product_evidence, "comment_anchors")
        if ev is None:
            return [skipping(self._NAME, reason="no comment_anchors evidence")]
        before, after = ev.get("before"), ev.get("after")
        if not isinstance(before, list) or not isinstance(after, list):
            return [_malformed(self._NAME, "before/after must be lists", {})]
        lost = sorted(set(map(str, before)) - set(map(str, after)))
        facts = {"before": sorted(map(str, before)), "after": sorted(map(str, after)), "lost": lost}
        if lost:
            return [failing(self._NAME, fc.COMMENT_ANCHOR_LOST,
                            first_broken_link="edit -> comment_anchor", facts=facts)]
        return [passing(self._NAME, facts=facts)]


class ScreenLabelOracle:
    """A section NOT in the edit's targets must keep the same screen label — an edit to one
    section must not perturb another section's stable identity."""

    _NAME = "ScreenLabelOracle"

    def check(self, *, product_evidence: dict[str, Any] | None = None) -> list[OracleResult]:
        ev = _slice(product_evidence, "screen_labels")
        if ev is None:
            return [skipping(self._NAME, reason="no screen_labels evidence")]
        edited, before, after = ev.get("edited_sections"), ev.get("before"), ev.get("after")
        if not isinstance(edited, list) or not isinstance(before, dict) or not isinstance(after, dict):
            return [_malformed(self._NAME, "edited_sections list + before/after dicts required", {})]
        edited_set = set(map(str, edited))
        unstable: list[str] = []
        for sec, label in before.items():
            if str(sec) in edited_set:
                continue  # the edited section may legitimately change
            if str(after.get(sec)) != str(label):
                unstable.append(str(sec))
        facts = {"edited_sections": sorted(edited_set), "unstable": sorted(unstable)}
        if unstable:
            return [failing(self._NAME, fc.SCREEN_LABEL_UNSTABLE,
                            first_broken_link="edit -> unedited_section_label", facts=facts)]
        return [passing(self._NAME, facts=facts)]

