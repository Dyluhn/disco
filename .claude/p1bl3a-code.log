    # a hostless / non-dict record is corrupt evidence → fail-closed, never under-report
    r = _run([{"host": "api.minimaxi.com", "model": "MiniMax-M3"}, {"__malformed__": "junk line"}])
    assert r[0].failed
    assert r[0].code == "MISSING_REQUIRED_EVIDENCE"
