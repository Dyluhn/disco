    r = _run(None, scenario=scenario)
    assert r[0].skipped


def test_empty_ledger_fails_closed_distinct_from_absent():
    r = _run([])
    assert r[0].failed
    assert r[0].code == "MISSING_REQUIRED_EVIDENCE"
    assert r[0].facts["captured"] is True and r[0].facts["records"] == 0


