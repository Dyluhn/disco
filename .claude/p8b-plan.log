    19	import type { SelectionEnvelope } from "@/lib/selectionBridge";
    20	
    21	/** A parsed `data-oid`: the workspace-relative source file + its 1-based line. */
    22	export interface AppRef {
    23	  /** Workspace-relative path of the source HTML file (e.g. "index.html"). */
    24	  file: string;
    25	  /** 1-based source line of the stamped element. */
    26	  line: number;
    27	}
