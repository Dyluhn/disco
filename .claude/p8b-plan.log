   144	    return parseSelectionEnvelope(frame, nonce);
   145	  }
   146	  if (type === "disco:hover") {
   147	    return parseHoverEnvelope(frame, nonce);
   148	  }
   149	  return null;
   150	}
   151	
   152	function parseSelectionEnvelope(
   153	  frame: Record<string, unknown>,
   154	  nonce: string,
   155	): SelectionEnvelope | null {
   156	  const ref = frame["selection_ref"];
   157	  const label = frame["human_label"];
   158	  const rect = frame["rect"];
   159	  if (!isSelectionRef(ref)) return null;
   160	  if (typeof label !== "string") return null;
   161	  if (!isRect(rect)) return null;
   162	  const env: SelectionEnvelope = {
   163	    v: 1,
   164	    channel: "disco-select",
   165	    nonce,
   166	    type: "disco:selection",
   167	    selection_ref: ref,
   168	    human_label: label,
   169	    rect,
   170	  };
   171	  // Optional screenshot_crop
   172	  if (typeof frame["screenshot_crop"] === "string") {
   173	    return { ...env, screenshot_crop: frame["screenshot_crop"] as string };
   174	  }
   175	  return env;
   176	}
   177	
   178	function parseHoverEnvelope(
   179	  frame: Record<string, unknown>,
   180	  nonce: string,
   181	): HoverEnvelope | null {
   182	  const rect = frame["rect"];
   183	  if (!isRect(rect)) return null;
   184	  return {
   185	    v: 1,
   186	    channel: "disco-select",
   187	    nonce,
   188	    type: "disco:hover",
   189	    rect,
   190	  };
   191	}
   192	
   193	function isRect(
   194	  r: unknown,
   195	): r is { x: number; y: number; width: number; height: number } {
   196	  if (!r || typeof r !== "object") return false;
   197	  const o = r as Record<string, unknown>;
   198	  return (
   199	    typeof o["x"] === "number" &&
   200	    typeof o["y"] === "number" &&
   201	    typeof o["width"] === "number" &&
   202	    typeof o["height"] === "number"
   203	  );
   204	}
   205	
   206	function isSelectionRef(r: unknown): r is SelectionRef {
   207	  if (!r || typeof r !== "object") return false;
   208	  const o = r as Record<string, unknown>;
   209	  if (o["kind"] === "deck") {
   210	    return typeof o["slide_id"] === "string" && typeof o["element_id"] === "string";
   211	  }
   212	  if (o["kind"] === "source") {
   213	    return (
   214	      typeof o["oid"] === "string" &&
   215	      typeof o["file"] === "string" &&
   216	      typeof o["line"] === "number"
   217	    );
   218	  }
   219	  return false;
   220	}

