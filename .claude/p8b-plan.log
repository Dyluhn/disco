   126	def _render_section(sec: AppSection) -> str:
   127	    f = sec.fields
   128	    if sec.kind == "hero":
   129	        return (
   130	            f'<section class="hero" data-disco-section="{_esc(sec.id)}">'
   131	            f'<h1 data-disco-field="headline">{_esc(f.get("headline", ""))}</h1>'
   132	            f'<p data-disco-field="subhead">{_esc(f.get("subhead", ""))}</p>'
   133	            f'<a class="cta" href="#lead" data-disco-field="cta_text">{_esc(f.get("cta_text", "Get started"))}</a>'
   134	            f"</section>"
   135	        )
   136	    if sec.kind == "lead_form":
   137	        return (
   138	            f'<section class="lead" id="lead" data-disco-section="{_esc(sec.id)}">'
   139	            f'<h2 data-disco-field="title">{_esc(f.get("title", "Contact us"))}</h2>'
   140	            f'<form method="post" action="/lead">'
   141	            f'<input name="name" placeholder="Name" required>'
   142	            f'<input name="email" type="email" placeholder="Email" required>'
   143	            f'<button type="submit">{_esc(f.get("submit_text", "Send"))}</button>'
   144	            f"</form></section>"
   145	        )
   146	    if sec.kind == "about":
   147	        return (
   148	            f'<section class="about" data-disco-section="{_esc(sec.id)}">'
   149	            f'<h2 data-disco-field="title">{_esc(f.get("title", "About"))}</h2>'
   150	            f'<p data-disco-field="body">{_esc(f.get("body", ""))}</p></section>'
   151	        )
   152	    # features / cta / footer + any future-but-known kind: a generic titled block.
   153	    return (
   154	        f'<section class="{_esc(sec.kind)}" data-disco-section="{_esc(sec.id)}">'
   155	        f'<h2 data-disco-field="title">{_esc(f.get("title", sec.kind.title()))}</h2>'
   156	        f'<p data-disco-field="body">{_esc(f.get("body", ""))}</p></section>'
   157	    )
   158	
   159	
   160	def render_html(spec: AppSpec) -> str:
   161	    """Deterministically render an AppSpec to a self-contained index.html (inline CSS
   162	    so it paints reliably — no separate stylesheet that streams late)."""
   163	    d = {k: _css_safe(v) for k, v in spec.resolved_design().items()}
   164	    css = (
   165	        f":root{{--primary:{d['primary']};--accent:{d['accent']};--bg:{d['bg']};--fg:{d['fg']}}}"
   166	        f"body{{margin:0;font-family:{d['font']};background:var(--bg);color:var(--fg)}}"
   167	        "section{padding:3rem 1.5rem;max-width:900px;margin:0 auto}"
   168	        ".hero{text-align:center}.hero h1{font-size:2.5rem;margin:0 0 .5rem}"
   169	        ".cta,button{display:inline-block;background:var(--primary);color:#fff;border:0;"
   170	        "padding:.75rem 1.25rem;border-radius:.5rem;text-decoration:none;cursor:pointer}"
   171	        ".lead form{display:flex;flex-direction:column;gap:.5rem;max-width:360px}"
   172	        ".lead input{padding:.6rem;border:1px solid #ccc;border-radius:.4rem}"
   173	    )
   174	    body = "\n".join(_render_section(s) for s in spec.sections)
   175	    return (
   176	        "<!doctype html>\n<html lang=\"en\">\n<head>\n"
   177	        '<meta charset="utf-8">\n<meta name="viewport" content="width=device-width,initial-scale=1">\n'
   178	        f"<title>{_esc(spec.title)}</title>\n<style>{css}</style>\n</head>\n"
   179	        f"<body>\n{body}\n</body>\n</html>\n"
   180	    )

