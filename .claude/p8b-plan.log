    84	 * selection kind and carries no instruction — it just hands the agent the context
    85	 * of WHAT the user clicked so a conversation can begin. It lands via the existing
    86	 * steer → send_message path (no backend change).
    87	 *
    88	 * - source: `{file}:{line}` plus the human label (de-duped if the label already
    89	 *   leads with the location, which `humanLabel` produces).
    90	 * - deck:   `slide {slide_id} · element {element_id}` plus the human label.
    91	 */
    92	export function formatSelectionContext(sel: SelectionEnvelope): string {
    93	  const ref = sel.selection_ref;
    94	  const label = sel.human_label?.trim() ?? "";
    95	  let target: string;
