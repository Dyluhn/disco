    43	  if (!oid) return null;
    44	  const sep = oid.lastIndexOf(":");
    45	  if (sep <= 0) return null; // no colon, or leading colon (empty file)
    46	  const file = oid.slice(0, sep);
    47	  const lineStr = oid.slice(sep + 1);
    48	  if (!file) return null;
    49	  if (!/^\d+$/.test(lineStr)) return null;
    50	  const line = parseInt(lineStr, 10);
    51	  if (line <= 0) return null;
    52	  return { file, line };
    53	}
