   179	    return ReferenceResolution(resolved=t, reason=ResolutionReason.RESOLVED)
   180	
   181	
   182	def _ambiguous(candidates: list[str]) -> ReferenceResolution:
   183	    return ReferenceResolution(
   184	        ambiguous=True, reason=ResolutionReason.AMBIGUOUS, candidates=tuple(sorted(set(candidates)))
   185	    )
