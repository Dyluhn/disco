     1	"""Starter kits (P7) — host-owned scaffolds the contracts/packs name.
     2	
     3	A contract declares ``artifact.starter_kit`` (app_shell / lead_form) and the prompt packs
     4	tell the model to "scaffold from the <name> starter" — but the names were bare strings
     5	with nothing behind them (a false affordance; the model hand-drew frames). A StarterKit
     6	resolves a name to a host-owned file scaffold (path → text), parameterized by the build's
     7	title, so the model EDITS a real frame instead of hand-drawing common chrome.
     8	
     9	Pure: AppSpec/render reuse from disco.core.appkit; no runtime/tool imports. The lead_form
    10	starter IS the AppKit default (single source — app_create scaffolds from it).
    11	"""
    12	
    13	from __future__ import annotations
    14	
    15	import html
    16	from collections.abc import Callable
    17	from pathlib import PurePosixPath
    18	
    19	from ..appkit import AppSection, AppSpec, render_html
    20	
    21	
    22	def _safe_rel(path: str) -> str:
    23	    """A starter writes only NORMALIZED, workspace-relative paths — never absolute and
    24	    never escaping the workspace (no ``..``). Rejects traversal at scaffold time."""
    25	    p = PurePosixPath(path)
    26	    if p.is_absolute() or ".." in p.parts or not p.parts:
    27	        raise ValueError(f"unsafe starter path: {path!r}")
    28	    return str(p)
    29	
    30	
    31	def lead_form_appspec(title: str) -> AppSpec:
    32	    """The default AppKit lead-gen app (a hero + a lead form). The SINGLE source for both
    33	    the lead_form starter AND app_create's default — so they can't drift."""
    34	    return AppSpec(
    35	        title=title,
    36	        sections=(
    37	            AppSection(id="hero", kind="hero", fields={"headline": title, "subhead": "", "cta_text": "Get started"}),
    38	            AppSection(id="lead", kind="lead_form", fields={"title": "Contact us", "submit_text": "Send"}),
    39	        ),
    40	    )
    41	
    42	
    43	def _appspec_files(spec: AppSpec) -> dict[str, str]:
    44	    # byte-identical to AppSpecStore.write (.disco/appspec.json + rendered index.html).
    45	    return {
    46	        ".disco/appspec.json": spec.model_dump_json(indent=2) + "\n",
    47	        "index.html": render_html(spec),
    48	    }
    49	
    50	
    51	_APP_SHELL_HTML = """<!doctype html>
    52	<html lang="en">
    53	<head>
    54	<meta charset="utf-8">
    55	<meta name="viewport" content="width=device-width,initial-scale=1">
    56	<title>{title}</title>
    57	<style>
    58	:root{{--fg:#1a1a1a;--bg:#fcfcfa;--accent:#4077a3}}
    59	*{{box-sizing:border-box}}
    60	body{{margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif;color:var(--fg);background:var(--bg)}}
    61	main{{max-width:720px;margin:0 auto;padding:4rem 1.5rem}}
    62	h1{{font-size:2.25rem;margin:0 0 .5rem}}
    63	p{{font-size:1.1rem;line-height:1.6;color:#444}}
    64	</style>
    65	</head>
    66	<body>
    67	<main>
    68	<h1>{title}</h1>
    69	<p>Start building. Replace this shell with your content.</p>
    70	</main>
    71	</body>
    72	</html>
    73	"""
    74	
    75	
    76	def _app_shell(title: str) -> dict[str, str]:
    77	    return {"index.html": _APP_SHELL_HTML.format(title=html.escape(title, quote=True))}
    78	
    79	
    80	def _lead_form(title: str) -> dict[str, str]:
    81	    return _appspec_files(lead_form_appspec(title))
    82	
    83	
    84	class StarterKit:
    85	    """A named host-owned scaffold: ``scaffold(title)`` → {rel_path: text} (path-safe)."""
    86	
    87	    def __init__(self, kit_id: str, builder: Callable[[str], dict[str, str]]) -> None:
    88	        self.id = kit_id
    89	        self._builder = builder
    90	
    91	    def scaffold(self, title: str) -> dict[str, str]:
    92	        return {_safe_rel(k): v for k, v in self._builder(title).items()}
    93	
    94	
    95	class StarterKitRegistry:
    96	    """Resolves a contract's ``starter_kit`` name to a host-owned StarterKit."""
    97	
    98	    _BUILTINS: dict[str, Callable[[str], dict[str, str]]] = {
    99	        "app_shell": _app_shell,  # static.site / interactive.prototype
   100	        "lead_form": _lead_form,  # appkit.leadgen — the AppKit default
   101	    }
   102	
   103	    def get(self, kit_id: str) -> StarterKit | None:
   104	        builder = self._BUILTINS.get(kit_id)
   105	        return StarterKit(kit_id, builder) if builder is not None else None
   106	
   107	    def ids(self) -> frozenset[str]:
   108	        return frozenset(self._BUILTINS)
   109	
   110	    @classmethod
   111	    def default(cls) -> StarterKitRegistry:
   112	        return cls()

