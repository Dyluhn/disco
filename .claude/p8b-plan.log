 succeeded in 0ms:
# The `core` package — "the brain": no server, no UI, importable library
# (basis-of-design.md §5). Phase 0 implements only the Event & State spine
# defined by event-state-contract.md; later subsystems (loop, memory condenser,
# LLM router, security) land here in subsequent phases.
[project]
name = "disco-core"
version = "0.1.0"
description = "Event & State spine + agent core for the disco platform."
requires-python = ">=3.12"
dependencies = [
    "pydantic>=2.7",
    "httpx>=0.27",
    "cryptography>=42",  # Fernet for encrypting stored secrets at rest (OpenRouter key)
]

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

# src-layout PEP 420 namespace package: `disco` is a shared namespace
# (no __init__.py) so sibling packages — disco.tools, .agent_server,
# .app_server — can join it later without a rename. Point the wheel at the
# namespace dir and hatch packages everything beneath it.
[tool.hatch.build.targets.wheel]
packages = ["src/disco"]
# WPP-1: ship the bundled workflow prompt packs (markdown) in the wheel so the
# PromptPackRegistry can load them from an installed package, not just from src.
artifacts = ["src/disco/core/workflows/prompt_packs/*.md"]
# The `tools` package — the action space (BoD §5).
[project]
name = "disco-tools"
version = "0.1.0"
description = "Tool/action space for the disco platform."
requires-python = ">=3.12"
dependencies = [
    "disco-core",
    # MCP client (RP-05) — Model Context Protocol v1 (stateless, per-conversation-pool).
    # Pin <2: v2 is unreleased + breaking; the 2026-07-28 RC moves to a stateless core.
    "mcp>=1.27.2,<2",
    # Docker SDK — the gVisor backend drives the daemon over the local socket OR
    # Docker-over-SSH (the [ssh] extra makes ssh:// importable; use_ssh_client=True
    # still authenticates via the system ssh, e.g. keyless Tailscale SSH).
    "docker[ssh]>=7",
    "podman>=5",  # Podman SDK — the Podman backend drives the rootless socket native-remote
    "jupyter_client",
    "websockets",
    "openpyxl>=3.1",
    # C3: native editable PPTX renderer (real text boxes, NOT image-per-slide).
    # BSD-3-Clause; no transitive non-permissive deps.
    "python-pptx>=1.0.2",
]

[project.optional-dependencies]
browser = ["playwright"]

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/disco"]

[tool.uv.sources]
disco-core = { workspace = true }

