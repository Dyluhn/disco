   162	
   163	    @model_validator(mode="after")
   164	    def _invariants(self) -> ReferenceResolution:
   165	        # Full biconditional, one branch per reason — no slack states.
   166	        if self.reason is ResolutionReason.RESOLVED:
   167	            if self.resolved is None or self.ambiguous or self.candidates:
   168	                raise ValueError("RESOLVED: exactly one target, not ambiguous, no candidates")
   169	        elif self.reason is ResolutionReason.AMBIGUOUS:
   170	            if self.resolved is not None or not self.ambiguous or not self.candidates:
