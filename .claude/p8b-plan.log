    56	 * Build a human-readable label for the edit affordance from an `AppRef` and the
    57	 * element's text content (passed in by the caller — the resolver does not read
    58	 * the DOM). Mirrors deckResolver.makeHumanLabel's shape.
    59	 */
    60	export function humanLabel(ref: AppRef, textContent: string): string {
    61	  const trimmed = textContent.trim().replace(/\s+/g, " ").slice(0, 60);
    62	  const loc = `${ref.file}:${ref.line}`;
    63	  return trimmed ? `${loc} — “${trimmed}”` : loc;
    64	}
