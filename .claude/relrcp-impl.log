+            path = self.root / str(call.arguments.get("path") or "")
+            path.parent.mkdir(parents=True, exist_ok=True)
+            path.write_text(str(call.arguments.get("content") or ""), encoding="utf-8")
+        return ToolResult(
+            call_id=call.call_id,
+            tool_name=call.tool_name,
+            success=True,
