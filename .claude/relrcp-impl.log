+"""REL-RC-P — repeated actionless pauses synthesize a gated finish attempt."""
+
+from __future__ import annotations
+
+from pathlib import Path
+from typing import Any
+
+import pytest
+from disco.core import (
+    ActionEvent,
+    ConversationStatus,
+    EventSource,
+    LLMMessage,
+    MessageEvent,
