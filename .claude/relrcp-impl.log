+@pytest.mark.asyncio
+async def test_dawdle_after_two_actionless_pauses_synthesizes_finish() -> None:
+    executor = FakeExecutor(tools=_tool_specs("submit_plan", "shell", "file_read", "browser"))
+    agent = ScriptedAgent(
+        [
+            _submit_plan(),
+            action_step("shell", {"command": "echo built"}),
