diff --git a/packages/core/src/disco/core/loop/finish.py b/packages/core/src/disco/core/loop/finish.py
index e6c8c548ec089c9a4f6b6602523901d95cfb5483..828901b1f5f6ed3f3d3faa60635eae5f43f3e1bb
--- a/packages/core/src/disco/core/loop/finish.py
