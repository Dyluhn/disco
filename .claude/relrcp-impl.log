+@pytest.mark.asyncio
+async def test_synthetic_finish_refusal_continues_with_dictated_content_blocker(
+    tmp_path: Path,
+) -> None:
+    agent = ScriptedAgent(
+        [
+            _submit_plan(),
+            action_step(
+                "file_write",
+                {"path": "artifact.txt", "content": "plain content"},
+            ),
+            _noop("Artifact is written."),
+            _noop("Ready to wrap up."),
+            _noop("All done."),
+        ]
+    )
+    loop, store = build_loop(
+        agent,
+        conversation_id=CID,
