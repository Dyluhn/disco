   160	# Workspace-snapshot manifest bounds (Bug 9 fix): cap per-file captured content and the
   161	# number of files walked so a pathological workspace can't blow up the dossier.
   162	_WS_MANIFEST_MAX_BYTES = 5 * 1024 * 1024  # capture content for files up to 5 MiB
   163	_WS_MANIFEST_MAX_FILES = 2000
   164	_SNAPSHOT_POLL_S = 0.5  # re-read cadence while a just-finished build's snapshot flushes
   165	# Consecutive identical reads required before a declared file with NO content-precise signal
   166	# (a partial mutator with no provable post-edit content — `present_unproven` — or no event
   167	# signal at all — `unknown`) is treated as SETTLED. These can't be content-verified, so we
   168	# demand SEVERAL consecutive-stable reads (the bytes stopped changing across multiple poll
   169	# intervals) before accepting + log a warning, rather than fail-fast — a legitimate
   170	# edit-without-readback build must NOT become INVALID_RUN.
   171	_SNAPSHOT_UNPROVEN_STABLE_POLLS = 4
   172	# The agent's FINAL on-disk state per declared file is reconstructed from the durable event
   173	# log. file_write persists its FULL content in the action payload (`_snip_args` elides only
   174	# at LLM-render time — verified in core.events: "The full content stays in the event
   175	# payload"), so a successful file_write gives a sha-PRECISE expected identity. The partial
   176	# mutators rewrite only part of the file, so their post-state can't be reconstructed from a
   177	# single action → they fall back to content-stability.
   178	# safe_write_file writes its FULL `content` arg verbatim (via _atomic_write tmp+rename), exactly
   179	# like file_write → sha-precise expected identity. Without it, a revision whose FINAL touch is a
   180	# safe_write_file was invisible and `expected` pinned to an EARLIER file_write's sha → false
   181	# WORKSPACE_SNAPSHOT_NOT_READY on a snapshot that actually holds the correct latest bytes.
   182	_FILE_WRITE_FULL_TOOLS = frozenset({"file_write", "safe_write_file"})
   183	# exact_replace is a TARGETED partial mutator (the promoted replacement for file_edit on revise
   184	# follow-ups) — its post-state can't be reconstructed from one action, so it degrades to
   185	# content-stability (present_unproven, accepted best-effort) instead of resurrecting a stale sha.
   186	_FILE_WRITE_PARTIAL_TOOLS = frozenset(
   187	    {
   188	        "file_append",
   189	        "file_edit",
   190	        "file_replace_lines",
   191	        "file_insert_lines",
   192	        "file_str_replace",
   193	        "exact_replace",
   194	    }
   195	)
   196	# A partial mutator can't be reconstructed from its action alone, but a later FULL
   197	# ``file_read`` readback carries the agent's TRUE post-edit bytes — in the file_read RENDERED
   198	# view (``<line-no>\t<line>``), NOT raw bytes (FileReadTool numbers every line). So a
   199	# readback-derived expected is compared in RENDERED space (see `_render_numbered`), not by
   200	# raw sha256. We only promote a read that is FULL and GENUINELY RENDERED:
   201	#   * FULL — the read header is ``[lines 1-N of N]`` with the two counts EQUAL (started at
   202	#     line 1, showed every line); a budget-truncated read appends ``; read more with
   203	#     offset=…`` and a pressure read appends ``— HEAD-ONLY under context pressure`` (counts
   204	#     unequal / extra text), so both fail this exact match. The read's args must also carry
   205	#     no offset/limit.
   206	#   * GENUINELY RENDERED — the content is the real file_read body, NOT a synthetic template.
   207	#     The F9 read-dedup pointer (``[F9 dedup: …]``, emitted for duplicate reads on assist
   208	#     runs) carries NO bytes and must NEVER be promoted; it is rejected by the header match.
   209	# A qualifying readback is used ONLY when its seq is AFTER the path's last mutation (a
   210	# readback before a later edit is stale → ignored).
   211	_FILE_READ_TOOLS = frozenset({"file_read"})
   212	# Matches ONLY a full read header: ``[lines 1-N of N]`` with N == N. The first capture must
   213	# equal the second (start==1 already pinned by the literal ``1-``).
   214	_FILE_READ_FULL_HEADER_RE = re.compile(r"^\[lines 1-(\d+) of (\d+)\]$")
   215	# An elision placeholder (e.g. "<1,234 chars elided …>") copied into a file_write content arg
   216	# is NOT real bytes — mirrors core.events._ELISION_MARKER_RE structurally. When matched we
   217	# decline the sha gate for that file and fall back to stability (defensive: a SUCCESSFUL
   218	# file_write already carries full bytes, so this is belt-and-suspenders).
   219	_ELISION_MARKER_RE = re.compile(r"<\s*\d[\d,]*\s*chars\b[^>]*?\b(?:elided|full content)\b[^>]*>")
   220	# Internal dirs the served-root index detection must skip — mirrors the product's
   221	# lifecycle._find_snapshot_index / SandboxSession._detect_serve_dir skip set exactly, so a
   222	# .pmx/.disco/node_modules index.html is NEVER mistaken for the build's served root.
   223	_SERVE_SKIP_DIRS = frozenset({".pmx", ".disco", "node_modules"})
   224	# Reserved control ports the durable serve+probe must NEVER bind (defense in depth — the
   225	# probe binds port 0 so the OS assigns a free EPHEMERAL high port, never these): the
   226	# agent-server (8000), the app-server (8800), and the conventional vite dev port (5173).
   227	_RESERVED_CONTROL_PORTS = frozenset({8000, 8800, 5173})
   228	
   229	# Tools that DON'T count as a "file write" for the mid-run steer trigger (the
   230	# planning-safe read/ask set; mirrors ToolScopeOracle.PLANNING_SAFE_TOOLS).
   231	_NON_MUTATING_TOOLS = frozenset(
   232	    {"submit_plan", "file_read", "file_list", "search", "extract", "ask_user", "clarify", "think"}
   233	)
