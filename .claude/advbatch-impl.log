   172	async def _wait_for_cancel_idle(
   173	    client: DiscoApiClient,
   174	    cid: str,
   175	    *,
   176	    previous_status: str,
   177	    timeout_s: float,
   178	) -> str:
   179	    """Wait until a kill settles into the product's resting state.
   180	
   181	    The kill route appends `IDLE` with detail `killed`. We require two consecutive IDLE
   182	    reads to avoid racing the state projection immediately after the POST.
   183	    """
   184	    deadline = time.monotonic() + timeout_s
   185	    last = previous_status
   186	    if previous_status and previous_status != "IDLE":
   187	        remaining = max(0.0, deadline - time.monotonic())
   188	        last = await client.wait_until_status_leaves(
   189	            cid, previous_status, timeout_s=remaining
   190	        )
   191	
   192	    stable_idle_reads = 1 if last == "IDLE" else 0
   193	    while time.monotonic() < deadline:
   194	        last = DiscoApiClient._status_of(await client.get_state(cid))
   195	        if last == "IDLE":
   196	            stable_idle_reads += 1
   197	            if stable_idle_reads >= 2:
   198	                return last
   199	        else:
   200	            stable_idle_reads = 0
   201	        await asyncio.sleep(getattr(client, "_poll", 0.1))
   202	    raise TimeoutError(f"cancel did not settle to stable IDLE (last status={last!r})")
   203	
