  2260	async def test_after_terminal_followups_are_serialized(tmp_path):
  2261	    # THE H1/V2 pin: revise_after_finish has TWO after_terminal follow-ups. With the FAITHFUL
  2262	    # dead-window fake (status stuck FINISHED; pickup + the new terminal only show as higher-seq
  2263	    # EVENTS), the runner must (1) detect pickup of follow-up 1 from the event seq, (2) drive it
  2264	    # to its OWN new terminal (seq > baseline), and only THEN (3) send follow-up 2 — else they
  2265	    # pile up and collapse into a single plan revision (false PLAN_REVISION_NOT_INCREMENTED).
  2266	    db = tmp_path / "disco.db"
  2267	    _seed_db(db, _CID, clean_smoke_log())
  2268	    transport = _DeadWindowTransport(db, stale_reads=2, work_reads=2)
  2269	    client = DiscoApiClient(transport, db_path=str(db), poll_interval_s=0.0)
  2270	    scenario = load_scenarios()["revise_after_finish"]
  2271	    assert sum(f.get("trigger") == "after_terminal" for f in scenario["followups"]) == 2
  2272	
  2273	    await drive_scenario(client, scenario, model="m", autonomous=False, timeout_s=5)
  2274	
  2275	    # Both follow-ups were sent, in order, exactly once each (no re-kick needed — pickup fired).
  2276	    sends = [f for f in transport.ws_frames if f.get("type") == "send_message"]
  2277	    assert len(sends) == 2
  2278	    assert len(transport.send_log) == 2
  2279	    assert len(transport.pickup_log) == 2
  2280	    assert len(transport.terminal_log) == 2
  2281	    send1_at = transport.send_log[0][1]
  2282	    pickup1_at = transport.pickup_log[0][1]
  2283	    terminal1_at = transport.terminal_log[0][1]
  2284	    send2_at = transport.send_log[1][1]
  2285	    # Serialization with the V2 min_seq guard: follow-up 1 was PICKED UP, then reached its OWN
  2286	    # new terminal, BOTH strictly BEFORE follow-up 2 was sent.
  2287	    assert send1_at < pickup1_at < terminal1_at < send2_at
  2288	    # And the runner genuinely WAITED through the stale-FINISHED reads (didn't return on the
  2289	    # first stale poll) — proof it never read the prior terminal as instant pickup/terminal.
  2290	    assert pickup1_at - send1_at > 1
  2291	    # The two re-plans were detected from distinct higher-seq plan events (revisions 2 then 3).
  2292	    assert client._latest_plan_revision(_CID) == 3
