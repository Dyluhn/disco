    76	class FakeTransport:
    77	    """Scripts the live surfaces. `states` is the status sequence GET /state yields
    78	    (clamped at the last). `workspace`/`preview_html` back the preview-proxy reads."""
    79	
    80	    def __init__(
    81	        self,
    82	        db_path,
    83	        *,
    84	        states,
    85	        workspace=None,
    86	        preview_html="",
    87	        health_status=200,
    88	        health_exc=None,
    89	        cid=_CID,
    90	    ):
    91	        self.db_path = db_path
    92	        self._states = list(states)
    93	        self._idx = 0
    94	        self.workspace = workspace or {}
    95	        self.preview_html = preview_html
    96	        self.health_status = health_status
    97	        self.health_exc = health_exc
    98	        self.cid = cid
    99	        self.ws_frames = []
   100	        self.posts = []
   101	
   102	    async def health(self):
   103	        if self.health_exc is not None:
   104	            raise self.health_exc
   105	        return self.health_status, {"ok": True}
   106	
   107	    async def post_json(self, path, body):
   108	        self.posts.append((path, body))
   109	        if path == "/conversations":
   110	            return 200, {"conversation_id": self.cid, "surface": "build"}
   111	        if path.endswith("/resume"):
   112	            # The REAL resume body carries a STATE string under "status" — a regression
   113	            # guard for the http-int/state-string key collision (Bug 11): merging this
   114	            # under "status" used to clobber the HTTP code and crash int(resp["status"]).
   115	            return 200, {"ok": True, "status": "RUNNING"}
   116	        return 200, {"event_id": "e", "seq": 1}
   117	
   118	    async def get_json(self, path):
   119	        if path.endswith("/state"):
   120	            st = self._states[min(self._idx, len(self._states) - 1)]
   121	            self._idx += 1
   122	            return 200, {"execution_status": st}
   123	        if path.endswith("/preview"):
   124	            return 200, {"available": True}
   125	        return 200, {}
   126	
   127	    async def get_text(self, path):
   128	        if path.endswith("/preview-app/"):
   129	            return 200, self.preview_html, {}
   130	        for rel, html in self.workspace.items():
   131	            if path.endswith(f"/preview-app/{rel}"):
   132	                return 200, html, {}
   133	        return 404, "", {}
   134	
   135	    async def ws_control(self, conversation_id, frame):
   136	        self.ws_frames.append(frame)
