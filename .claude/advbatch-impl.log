+def _has_shell_meta(tokens: list[str]) -> bool:
+    return any(
+        tok in _SHELL_META_TOKENS
+        or any(marker in tok for marker in _SHELL_META_SUBSTRINGS)
+        for tok in tokens
+    )
+
