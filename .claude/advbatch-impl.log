   227	async def test_pre_kick_idle_does_not_abort_the_drive(tmp_path):
   228	    # LIVE-SURFACED runner bug: POST /messages kicks the loop ASYNCHRONOUSLY, so a
   229	    # freshly-created conversation reads IDLE for a beat before RUNNING. IDLE is a
   230	    # terminal for adjudication but NOT a drive-stop until the run has gone active —
   231	    # otherwise the runner bails before the agent plans and mis-reports
   232	    # NO_PLAN_AFTER_USER_TURN against a product that actually planned. The drive must
   233	    # wait through the pre-kick IDLE, catch the approval gate, approve, and finish.
