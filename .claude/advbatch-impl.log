+class _CancelMissedWindowTransport(FakeTransport):
+    def __init__(self, db_path, **kw):
+        super().__init__(
+            db_path,
+            states=["RUNNING"],
+            workspace={"index.html": "<h1>finished too fast</h1>"},
+            preview_html="<h1>finished too fast</h1>",
+            **kw,
+        )
