+        if path.endswith("/state"):
+            self._state_reads += 1
+            if not self._terminal_inserted and self._state_reads >= 2:
+                write = action(
+                    self._next_seq(),
+                    "file_write",
+                    args={"path": "index.html", "content": "<h1>finished too fast</h1>"},
+                    action_id="act_fast_write",
