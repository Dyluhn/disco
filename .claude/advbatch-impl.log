    90	AWAITING_PLAN_APPROVAL = "AWAITING_PLAN_APPROVAL"
    91	# The mid-build CLARIFY / CONFIRM gates the runner answers as the user (Bug 17): a
    92	# capable model may ask a clarifying question (AWAITING_USER_QUESTION) or pause for a
    93	# go-ahead (WAITING_FOR_CONFIRMATION) BEFORE/while building. The runner answers them so
    94	# an interactive build proceeds instead of false-stalling into NO_PLAN.
    95	AWAITING_USER_QUESTION = "AWAITING_USER_QUESTION"
    96	WAITING_FOR_CONFIRMATION = "WAITING_FOR_CONFIRMATION"
    97	# The structured user-choice gate: after repeated tool failure the model proposes 2–3
    98	# concrete next-step alternatives (an AlternativesEvent) and the loop parks at
    99	# AWAITING_USER_DECISION until the user picks one (the WS `pick_alternative` frame →
