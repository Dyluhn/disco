  1425	def _last_terminal(rows: list[dict[str, Any]]) -> str | None:
  1426	    result: str | None = None
  1427	    for r in rows:
  1428	        if r.get("kind") != "status":
  1429	            continue
  1430	        st = str(_payload(r).get("status"))
  1431	        if st in TERMINAL_STATES:
  1432	            result = st
  1433	        elif st == "RUNNING":
  1434	            result = None
  1435	    return result
