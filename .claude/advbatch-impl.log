+        p = _payload(e)
+        tr = p.get("tool_result") or {}
+        if not isinstance(tr, dict) or not bool(tr.get("success", True)):
+            continue
+        call_id = tr.get("call_id")
+        if call_id is not None:
+            call_ids.add(str(call_id))
+        action_id = p.get("action_id") or e.get("action_id")
