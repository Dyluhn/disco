   143	def _smoke_log_with_file_write(path, content):
   144	    """clean_smoke_log's plan→approve→execute→finish shape, but the executed action is a
   145	    file_write of `content` to `path` with a MATCHING observation call_id — so the snapshot
   146	    readiness gate records a PROVEN raw_sha capture for that file (vs clean_smoke_log's generic
   147	    shell action, which leaves the declared file unproven)."""
   148	    return [
   149	        msg(1, "user", "build a page"),
   150	        status(2, "RUNNING"),
   151	        plan(3, revision=1),
   152	        status(4, "AWAITING_PLAN_APPROVAL", "evt_3"),
   153	        status(5, "RUNNING", "plan_approved"),
   154	        status(6, "RUNNING"),
   155	        {
   156	            "id": "act7", "seq": 7, "kind": "action", "source": "agent",
   157	            "tool_call": {"tool_name": "file_write",
   158	                          "arguments": {"path": path, "content": content}, "call_id": "cw7"},
   159	        },
   160	        {
   161	            "id": "evt_8", "seq": 8, "kind": "observation", "source": "environment",
   162	            "action_id": "act7",
   163	            "tool_result": {"call_id": "cw7", "tool_name": "file_write", "success": True,
   164	                            "content": "wrote"},
   165	        },
   166	        msg(9, "agent", "done", role="assistant"),
   167	        status(10, "FINISHED"),
   168	    ]
