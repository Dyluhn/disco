   101	AWAITING_USER_DECISION = "AWAITING_USER_DECISION"
   102	
   103	# ---- progress-aware terminal-wait sentinels (Bug 15) ------------------------
   104	# The terminal wait is PROGRESS-AWARE, not a blind wall-clock: while the conversation
   105	# is still emitting NEW events (max seq / event count advancing) or its status is
   106	# actively transitioning, we KEEP WAITING. A wall-clock cutoff only ends the wait when
   107	# the run is GENUINELY INACTIVE (no progress for the inactivity window) or a generous
   108	# HARD CAP bounds a truly-hung run. The two timeout outcomes are NOT the same finding:
   109	#   * PROGRESSING_TIMEOUT — the hard cap was hit while the build was STILL actively
   110	#     progressing (events advanced within the inactivity window). The runner could NOT
   111	#     obtain a terminal verdict; this is INCONCLUSIVE (model-speed / harness limitation),
   112	#     NOT a product BUILD_DID_NOT_FINISH → the caller records INVALID_RUN so §17 re-runs it.
   113	#   * INACTIVE_TIMEOUT — the build went genuinely SILENT (no new events) for the inactivity
   114	#     window: a real wedge. The caller falls through to normal classification (the
   115	#     collected non-terminal run is a genuine finding: BUILD_DID_NOT_FINISH / STUCK).
   116	PROGRESSING_TIMEOUT = "PROGRESSING_TIMEOUT"
   117	INACTIVE_TIMEOUT = "INACTIVE_TIMEOUT"
   118	
   119	# ---- after-terminal follow-up SERIALIZATION sentinels (H1) -------------------
   120	# The runner sends each `after_terminal` follow-up as its own re-plan→approve→terminal
   121	# cycle. The bug: the post-terminal poll returned IMMEDIATELY on the STALE prior FINISHED
   122	# status, so follow-up 2 was sent before the engine even started processing follow-up 1;
   123	# the engine then only processes the LATEST unprocessed user turn, COLLAPSING the piled-up
   124	# follow-ups into ONE plan revision (rev 2 vs an expected 3) → false PLAN_REVISION_NOT_INCREMENTED.
   125	# `wait_for_followup_pickup` blocks AFTER each send until the engine actually PICKS UP the
   126	# follow-up (relative to a baseline captured BEFORE the send) so the follow-ups are serialized.
   127	FOLLOWUP_PICKED_UP = "FOLLOWUP_PICKED_UP"  # the build left its prior terminal status (processing)
   128	FOLLOWUP_REPLANNED = "FOLLOWUP_REPLANNED"  # a re-plan signal (planning re-entry / revision bump)
   129	FOLLOWUP_PICKUP_TIMEOUT = "FOLLOWUP_PICKUP_TIMEOUT"  # no pickup within the bound → caller proceeds
   130	# enter_planning stamps this status DETAIL on a re-plan re-entry (RUNNING + detail="planning");
   131	# the very first build turn is a plain RUNNING with no detail — so this detail is a genuine
   132	# RE-PLAN signal, never the initial plan. Mirrors events.PLANNING_DETAIL / the product's loop.
   133	_PLANNING_DETAIL = "planning"
   134	# Bound for the after-terminal pickup wait — POLICY-DRIVEN (env-overridable), NOT a brittle
   135	# literal. The pickup signal (plan-rev bump / planning re-entry / first non-user progress past
   136	# the baseline seq) is detected correctly but arrives LATE on a slow driver: measured ~37s on
   137	# MiniMax-M3 (finalize + replan latency). The old 25s literal therefore ALWAYS timed out, which
   138	# (under the now-removed re-send branch) duplicated the user turn and could stall the next
   139	# follow-up. Default 75s covers the measured ~37s with margin; override via the env var with a
   140	# safe float parse. It MUST stay BELOW the build `--timeout` (the per-drive inactivity window)
   141	# so a genuinely stuck follow-up HARD-FAILS as a sequencing failure (INVALID_RUN) before the
   142	# drive's own wait would mask it. Resolved per-call so an override is honored live (testable).
   143	_FOLLOWUP_PICKUP_TIMEOUT_ENV = "DISCO_SOAK_PICKUP_TIMEOUT_S"
   144	_FOLLOWUP_PICKUP_TIMEOUT_DEFAULT_S = 75.0
   145	
   146	
   147	def _followup_pickup_timeout_s() -> float:
   148	    """The pickup-wait bound: ``$DISCO_SOAK_PICKUP_TIMEOUT_S`` (positive float seconds) else the
   149	    documented default. A missing/blank/non-numeric/non-positive value falls back safely so a
   150	    fat-fingered override never silently disables the bound."""
   151	    raw = os.environ.get(_FOLLOWUP_PICKUP_TIMEOUT_ENV)
   152	    if raw is None:
   153	        return _FOLLOWUP_PICKUP_TIMEOUT_DEFAULT_S
   154	    try:
   155	        val = float(raw)
   156	    except (TypeError, ValueError):
   157	        return _FOLLOWUP_PICKUP_TIMEOUT_DEFAULT_S
   158	    return val if val > 0 else _FOLLOWUP_PICKUP_TIMEOUT_DEFAULT_S
