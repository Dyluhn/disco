   236	class InconclusiveRunError(Exception):
   237	    """A POST-create terminal-wait that could NOT obtain a verdict because the build was
   238	    cut off by the HARD CAP while it was STILL ACTIVELY PROGRESSING (Bug 15). This is NOT
   239	    a product failure (the loop never failed to finish — it simply hadn't finished by the
   240	    safety ceiling) and NOT pre-create INFRA_FAILURE; the runner degrades it to INVALID_RUN
   241	    so the §17 no-fluke policy re-runs it instead of recording a false BUILD_DID_NOT_FINISH.
   242	    `facts` carries the progress evidence (last seq seen, elapsed) for the dossier."""
   243	
   244	    def __init__(self, reason: str, facts: dict[str, Any] | None = None) -> None:
   245	        super().__init__(reason)
   246	        self.reason = reason
   247	        self.facts = facts or {}
   248	
   249	
   250	class FollowupPickupError(Exception):
   251	    """An after-terminal follow-up was SENT (exactly ONCE) but the engine never PICKED IT UP
   252	    within the policy-driven bound — no progress event past the baseline seq, status stuck at the
   253	    prior terminal. This is a SEQUENCING failure, NOT a product verdict. The runner does NOT
   254	    re-send (a second send_followup would DUPLICATE the user turn — there is no legal
   255	    kick-without-append on a FINISHED run) and does NOT drive on the STALE terminal (which is
   256	    exactly what lets the NEXT follow-up collapse into this unprocessed one → V1's false single
   257	    plan revision); it records INVALID_RUN instead. `facts` carries the baseline evidence
   258	    (status, seq, revision) for the dossier."""
   259	
   260	    def __init__(self, reason: str, facts: dict[str, Any] | None = None) -> None:
  1320	        return None
