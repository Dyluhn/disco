+
+    def _next_seq(self) -> int:
+        self._seq += 1
+        return self._seq
+
+    async def get_json(self, path):
+        if path.endswith("/state"):
+            self._state_reads += 1
+            if not self._terminal_inserted and self._state_reads >= 2:
