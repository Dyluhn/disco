+                    self._recovery_progress_inserted = True
+                    self.pickup_log.append(self._state_reads)
+                elif self._recovery_reads == 4 and not self._recovery_terminal_inserted:
+                    seq = self._next_seq()
+                    self._append(
+                        action(
+                            seq,
+                            "file_write",
+                            args={
+                                "path": "index.html",
+                                "content": (
+                                    "<h1>Beacon Status</h1>"
+                                    "<table><td>All systems nominal</td></table>"
+                                ),
+                            },
+                            action_id=f"act{seq}",
