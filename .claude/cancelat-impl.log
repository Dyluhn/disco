+                    seq = self._next_seq()
+                    self._append(
+                        action(
+                            seq,
+                            "file_write",
+                            args={
+                                "path": "index.html",
+                                "content": (
+                                    "<h1>Beacon Status</h1>"
+                                    "<table><td>All systems nominal</td></table>"
