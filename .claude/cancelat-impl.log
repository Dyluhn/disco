+) -> None:
+    before_status = ""
+    with contextlib.suppress(Exception):
+        before_status = DiscoApiClient._status_of(await client.get_state(cid))
+    resp = await client.kill(cid)
+    seq_note = f" (seq={trigger_seq})" if trigger_seq is not None else ""
