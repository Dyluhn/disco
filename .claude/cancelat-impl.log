140-# safe float parse. It MUST stay BELOW the build `--timeout` (the per-drive inactivity window)
141-# so a genuinely stuck follow-up HARD-FAILS as a sequencing failure (INVALID_RUN) before the
142-# drive's own wait would mask it. Resolved per-call so an override is honored live (testable).
143-_FOLLOWUP_PICKUP_TIMEOUT_ENV = "DISCO_SOAK_PICKUP_TIMEOUT_S"
