# Frontend environment — copy to `.env.local` to wire the live backend.
#
# Unset (the default) → the data layer runs against in-repo fixtures (offline,
# what the tests use). Set VITE_API_BASE → it calls the live app-server endpoints
# (see ../docs/contracts/api-endpoints.md). Set VITE_AGENT_BASE → research-answer streaming runs
# live against the agent-server (otherwise it stays fixture-backed).

# The app-server base URL (settings + library). Start it with:
#   DISCO_PORT=8800 python -m disco.app_server
VITE_API_BASE=http://localhost:8800

# The agent-server base URL (live WebSocket: loops + grounded research). Start it:
#   DISCO_PORT=8000 python -m disco.agent_server
# Research streams from ws://…/ws/research; leave unset to keep fixtures.
VITE_AGENT_BASE=http://localhost:8000

# The owner whose conversations are listed/deleted (no auth in v1).
VITE_OWNER_ID=local
