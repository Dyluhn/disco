# Campaign §1.2: the Pi sidecar must never run install/lifecycle scripts and must
# never pull user-installable Pi packages or extensions. Enforce ignore-scripts
# for every install in this package (CI and local).
#
# This .npmrc is only honored when npm runs WITH THIS PACKAGE as cwd. The
# documented install path is therefore `npm run setup` (which forces
# `--ignore-scripts` regardless of cwd). As a backstop, the package.json
# `preinstall` guard fails LOUDLY if an install is ever attempted without
# ignore-scripts set (e.g. a repo-level install that bypasses this file), so a
# locked dependency's install script can never silently execute.
ignore-scripts=true
