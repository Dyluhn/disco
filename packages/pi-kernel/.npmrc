# Campaign §1.2: the Pi sidecar must never run install/lifecycle scripts and must
# never pull user-installable Pi packages or extensions.
#
# ENFORCEMENT POINT (the real backstop): install ONLY via the sanctioned path —
#   npm run setup     →  npm install --ignore-scripts
# or, in CI, run the install with --ignore-scripts explicitly. That flag, on the
# install command itself, is what actually prevents any dependency lifecycle
# script from executing.
#
# This .npmrc pins `ignore-scripts=true` as the package-local DEFAULT, honored
# only when npm runs WITH THIS PACKAGE as cwd (a repo-root install does NOT read
# it). It is a strong default, not a guarantee for every invocation — hence the
# sanctioned `npm run setup` / CI `--ignore-scripts` path above.
#
# The package.json `preinstall` script is a BEST-EFFORT advisory warning only: it
# can warn when ignore-scripts is unset, but it cannot guarantee a dependency
# script did not already run, so it is NOT the enforcement mechanism.
ignore-scripts=true
