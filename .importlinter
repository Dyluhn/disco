# Architecture layering contract (enforced by import-linter — `lint-imports`).
# Wire into CI/pre-commit alongside scripts/check_arch_budget.py.
#
# Real dependency direction (measured): core is the foundation; retrieval sits on
# core; tools on retrieval+core; agent_server and app_server are independent top
# siblings (neither imports the other) that build on the lower layers.

[importlinter]
root_package = disco

[importlinter:contract:layers]
name = Package layering — core ← retrieval ← tools ← {agent_server | app_server}
type = layers
layers =
    disco.app_server | disco.agent_server
    disco.tools
    disco.retrieval
    disco.core
exhaustive = false
# KNOWN VIOLATION (debt, not hidden): disco.tools.builtin.audio_overview reaches
# UP into agent_server for server-side TTS + the audio LLM constant, and
# disco.tools.builtin.preview reaches UP into agent_server for the PreviewManager
# (EPIC F — a runtime collaborator bound to the conversation's sandbox). All are
# lazy (function-local) imports today to dodge a load-time cycle; the proper fix
# is dependency inversion (a port in tools/core, implemented in agent_server) or
# relocating the collaborator down. Ignored here — the SAME sanctioned mechanism
# audio_overview uses — so the contract passes on the rest of the tree while these
# tracked edges are tracked. Remove these lines when fixed.
ignore_imports =
    disco.tools.builtin.audio_overview -> disco.agent_server.audio_config
    disco.tools.builtin.audio_overview -> disco.agent_server.tts_local
    disco.tools.builtin.preview -> disco.agent_server.preview_manager

[importlinter:contract:no-cycles]
name = No circular dependencies between packages
type = independence
modules =
    disco.app_server
    disco.agent_server
# (core/retrieval/tools intentionally NOT independent — they form the lower stack.)
