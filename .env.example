# Optional Disco self-host overrides.
#
# A fresh clone does not need this file:
#   podman compose up -d
#
# Copy to `.env` only when you want to override ports, bind addresses, provider
# keys, or the sandbox socket. Configure the driver model in the UI after boot.

# ---- network exposure -------------------------------------------------------
# Defaults bind every published port to loopback. Only use 0.0.0.0 behind your
# own TLS/auth boundary.
DISCO_BIND=127.0.0.1
DISCO_UI_PORT=8088
DISCO_APP_PORT=8800
DISCO_AGENT_PORT=8000

# Runtime URLs injected into the browser bundle. Leave blank for localhost/LAN
# auto-targeting from the browser hostname plus the ports above.
DISCO_PUBLIC_API_BASE=
DISCO_PUBLIC_AGENT_BASE=
DISCO_PUBLIC_UI_URL=
# Remote deployments should route an HTTPS wildcard on a separately registrable
# site to the same front door, for example https://preview.example.net when the
# UI is on app.example.com. HTTP and port 0 are rejected. Leave blank for localhost.
DISCO_PREVIEW_ORIGIN_BASE=

# ---- first-run/auth ---------------------------------------------------------
# Blank: compose generates DISCO_SECRET_KEY once into the data volume. Pin a
# value if encrypted Settings secrets must survive volume loss:
#   openssl rand -base64 32
DISCO_SECRET_KEY=
# Optional non-secret identity for the active key. During an intentional key
# rotation, DISCO_SECRET_READ_KEYS is a JSON object containing at most four old
# key IDs and their material. Never commit populated values.
DISCO_SECRET_KEY_ID=
DISCO_SECRET_READ_KEYS=

# Dev convenience only. Default 0 requires the loopback pairing token printed in
# app-server logs; 1 mints an admin session without that token.
AUTH_DEV_AUTO_PAIR=0

# ---- images ----------------------------------------------------------------
# Which published release to pull (ghcr.io/dyluhn/disco-{server,frontend,sandbox}).
# The default is the tag this checkout was cut from; `latest` follows releases.
DISCO_IMAGE_TAG=v0.2.2

# ---- sandbox ---------------------------------------------------------------
# Bare `podman compose up -d` pulls the sandbox image too and tags it
# `disco-sandbox:base` in your daemon, so the Build and Agent surfaces work out
# of the box. For a lean stack, comment out the `sandbox-image` service in
# compose.yaml.
#
# The default is the current user's rootless Podman socket. Enable it once:
#   systemctl --user enable --now podman.socket
# `/run/user/1000` is the conventional Linux/WSL2 first-user path; change the UID
# when your account differs. Docker also works: set DISCO_LOCAL_ENGINE=docker.
# Prefer rootless Docker's socket, DISCO_SANDBOX_SOCKET=$XDG_RUNTIME_DIR/docker.sock,
# which keeps the same non-root-owned boundary as the Podman default. Rootful
# Docker's socket, /var/run/docker.sock, is root-equivalent — a less-isolated,
# explicit opt-in.
DISCO_SANDBOX_SOCKET=/run/user/1000/podman/podman.sock
DISCO_LOCAL_ENGINE=podman
DISCO_PREVIEW_HOST=host.docker.internal

# Force a sandbox backend only for troubleshooting. Leave unset normally; the
# Settings UI owns the backend. `process` has no isolation and is refused unless
# DISCO_ALLOW_PROCESS_SANDBOX_FOR_DEV=1 is also set.
# DISCO_SANDBOX=process
# DISCO_ALLOW_PROCESS_SANDBOX_FOR_DEV=1

# ---- model/provider keys ----------------------------------------------------
# No driver endpoint is seeded from env. Add your OpenAI-compatible local/LAN or
# paid API endpoint in Settings -> Models & Providers, then run:
#   podman compose exec agent-server disco-verify --quick
#
# Optional env keys can be imported into encrypted Settings secrets after the
# corresponding origin is approved.
DISCO_OPENROUTER_API_KEY=
DISCO_GEMMA_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
TAVILY_API_KEY=
BRAVE_API_KEY=
BRAVE_SEARCH_API_KEY=
FIRECRAWL_API_KEY=
OPENAI_IMAGE_API_KEY=
OPENAI_TTS_API_KEY=

# ---- bundled encoders -------------------------------------------------------
# local (default): use baked in-process ONNX fastembed models.
# remote: use Settings/env encoder endpoints instead.
DISCO_ENCODERS=local

# full is the code default and the default image bake:
#   embed: intfloat/multilingual-e5-large (MIT)
#   rerank/NLI: BAAI/bge-reranker-base (MIT)
# lite is smaller:
#   embed: BAAI/bge-small-en-v1.5 (MIT)
#   rerank/NLI: Xenova/ms-marco-MiniLM-L-6-v2 (Apache-2.0)
DISCO_ENCODER_TIER=full

# Remote encoder endpoints, used only with DISCO_ENCODERS=remote or Settings
# remote mode.
DISCO_RERANKER_URL=
DISCO_EMBEDDER_URL=
DISCO_NLI_URL=

# ---- misc ------------------------------------------------------------------
DISCO_LOG_LEVEL=INFO
# DISCO_LOG_JSON=1
# Set to 1 only when the configured driver actually accepts image inputs.
DISCO_DRIVER_VISION=0
# filtered (default), public, sealed, open, or raw. See docs/self-host.md.
DISCO_BUILD_EGRESS=filtered
# Approved MCP origins connect directly (no egress sidecar ships with this
# stack). Set to 1 ONLY if you run your own outbound proxy reachable at
# DISCO_MCP_EGRESS_PROXY_HOST:8888 from inside the agent-server container.
# DISCO_MCP_EGRESS_PROXY_REQUIRED=1
# DISCO_MCP_EGRESS_PROXY_HOST=127.0.0.1
# DISCO_INSPECT=1
