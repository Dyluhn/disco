# disco self-host configuration.  Copy to `.env` and edit, then:
#   docker compose up -d --build   (podman compose also works)
# Read docs/self-host.md for the full story — especially #security before exposing.

# ---- network exposure -------------------------------------------------------
# THERE IS NO AUTH IN v1. The defaults bind everything to loopback. Only set
# PMX_BIND=0.0.0.0 if you put your own TLS + auth (a reverse proxy) in front.
PMX_BIND=127.0.0.1
PMX_UI_PORT=8088
PMX_APP_PORT=8800
PMX_AGENT_PORT=8000

# The URLs the BROWSER uses to reach the two servers. Leave BLANK for the zero-config
# default (the UI auto-targets its own hostname + the ports above — works for both
# localhost and LAN/tailnet access). Set them explicitly only behind a reverse proxy
# or TLS, e.g. PMX_PUBLIC_API_BASE=https://pmx.example.com/api
PMX_PUBLIC_API_BASE=
PMX_PUBLIC_AGENT_BASE=

# ---- secrets ----------------------------------------------------------------
# Encrypts stored API keys (e.g. OpenRouter, pasted later in Settings) at rest.
# Blank → auto-generated on first run and kept inside the data volume. PIN IT
# YOURSELF to survive volume loss:   openssl rand -base64 32
PMX_SECRET_KEY=

# ---- sandbox (READ docs/self-host.md#security BEFORE changing) --------------
# The host container socket mounted into the agent-server, which spawns sibling
# sandbox containers through it. This makes the agent-server ROOT-EQUIVALENT on your
# host. SAFER: a rootless Podman socket — an escape then lands as your unprivileged
# user, not root. To use it:
#   systemctl --user enable --now podman.socket
#   podman build -t pmx-sandbox:base deploy/sandbox      # build into YOUR daemon
#   PMX_SANDBOX_SOCKET=/run/user/$(id -u)/podman/podman.sock
PMX_SANDBOX_SOCKET=/var/run/docker.sock

# Where the agent-server reaches sandbox preview ports (the host gateway).
PMX_PREVIEW_HOST=host.docker.internal

# Force a sandbox backend (normally LEAVE UNSET — the Settings UI controls it).
# process = NO ISOLATION (dev only, e.g. a host with no container runtime).
# PMX_SANDBOX=local

# ---- model ------------------------------------------------------------------
# The strategic wedge is reliability on LOCAL models. `bundled-llm` ships a small
# llama.cpp model so it works keyless out of the box. Delete the profile to bring
# your own endpoint (the recommended path for real work — a 24-32B model).
COMPOSE_PROFILES=bundled-llm
PMX_LLM_HF=unsloth/Qwen3-4B-Instruct-2507-GGUF:Q4_K_M
PMX_LLM_CTX=32768

# First-run config seed ONLY (afterwards the Settings UI owns the model catalogue):
#   bundled:  http://llm:8080/v1   (the service above)
#   BYO host: http://host.docker.internal:11434/v1  (your ollama / llama-server)
#   OpenRouter-only: point at any, then assign the OpenRouter slots in Settings.
PMX_DRIVER_BASE_URL=http://llm:8080/v1
PMX_DRIVER_MODEL_ID=qwen3-4b-instruct
PMX_DRIVER_CTX=32768

# ---- misc -------------------------------------------------------------------
PMX_LOG_LEVEL=INFO
# PMX_LOG_JSON=1            # structured JSON log lines
# PMX_DRIVER_VISION=1       # only if your endpoint serves a vision model (mmproj)
# PMX_BUILD_EGRESS=filtered # deny-by-default sandbox egress (allowlist proxy)
