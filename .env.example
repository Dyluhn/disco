# disco self-host configuration. Copy to `.env` and edit, then:
#   docker compose up -d --build   (podman compose also works)
# Read SECURITY.md before exposing anything off localhost.

# ---- network exposure -------------------------------------------------------
# THERE IS NO AUTH IN v1. The defaults bind everything to loopback. Only set
# DISCO_BIND=0.0.0.0 if you put your own TLS + auth (a reverse proxy) in front.
DISCO_BIND=127.0.0.1
DISCO_UI_PORT=8088
DISCO_APP_PORT=8800
DISCO_AGENT_PORT=8000

# The URLs the BROWSER uses to reach the two servers. Leave BLANK for the zero-config
# default (the UI auto-targets its own hostname + the ports above, which works for
# localhost and ordinary LAN/VPN access). Set them explicitly only behind a reverse
# proxy or TLS, e.g. DISCO_PUBLIC_API_BASE=https://disco.example.com/api
DISCO_PUBLIC_API_BASE=
DISCO_PUBLIC_AGENT_BASE=

# ---- secrets ----------------------------------------------------------------
# Encrypts stored API keys at rest. Compose auto-generates one into the data volume
# when blank, but pin your own value to survive volume loss:
#   openssl rand -base64 32
DISCO_SECRET_KEY=

# ---- sandbox (read SECURITY.md before changing) ------------------------------
# The host container socket mounted into the agent-server, which spawns sibling
# sandbox containers through it. This makes the agent-server ROOT-EQUIVALENT on your
# host. SAFER: a rootless Podman socket — an escape then lands as your unprivileged
# user, not root. To use it:
#   systemctl --user enable --now podman.socket
#   podman build -t disco-sandbox:base -f deploy/sandbox/Dockerfile .
#   DISCO_SANDBOX_SOCKET=/run/user/$(id -u)/podman/podman.sock
DISCO_SANDBOX_SOCKET=/var/run/docker.sock

# Where the agent-server reaches sandbox preview ports (the host gateway).
DISCO_PREVIEW_HOST=host.docker.internal

# Force a sandbox backend (normally LEAVE UNSET; the Settings UI controls it).
# process = NO ISOLATION (dev only, e.g. a host with no container runtime).
# DISCO_SANDBOX=local

# ---- model (REQUIRED: wire in your own driver) ------------------------------
# There is NO bundled driver model. A keyless CPU 4B is a demo, not a real driver;
# the reliability wedge needs a 24-32B-class model. Point Disco at an
# OpenAI-compatible endpoint you control. Two tiers, both fully supported:
#   - SELF-HOSTED (recommended, keyless): Ollama / llama.cpp / vLLM / LM Studio,
#     local or on your LAN. e.g. http://host.docker.internal:11434/v1 (Ollama).
#   - PAID API: any OpenAI-compatible base URL + an API key. Set api_key_env for
#     the model in Settings, then provide the matching env var below or store the
#     key in Settings.
# The ONNX encoders, web search, extraction, and TTS still ship keyless/bundled.
#
# First-run config seed ONLY (afterwards the Settings UI owns the model catalogue):
DISCO_DRIVER_BASE_URL=http://host.docker.internal:11434/v1
DISCO_DRIVER_MODEL_ID=qwen2.5:32b-instruct
DISCO_DRIVER_CTX=32768

# ---- provider keys (optional; encrypted Settings secrets win when present) ----
# LLM/model providers.
# DISCO_OPENROUTER_API_KEY=
# DISCO_GEMMA_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# AZURE_OPENAI_API_KEY=

# Search/extraction/image/TTS providers. These are used when the corresponding
# Settings entry names this env var as api_key_env.
# TAVILY_API_KEY=
# BRAVE_API_KEY=
# FIRECRAWL_API_KEY=
# COMFYUI_API_KEY=
# OPENAI_IMAGE_API_KEY=
# OPENAI_TTS_API_KEY=

# ONNX encoder tier for grounded/research retrieval (embed + rerank).
#   lite (default here): BAAI/bge-small-en-v1.5 + Xenova/ms-marco-MiniLM-L-6-v2
#                        — ~0.15 GB total, ENGLISH-focused. Fits an 8 GB box.
#   full:                multilingual-e5-large + jina-reranker-v2-multilingual
#                        — ~4 GB, MULTILINGUAL/higher quality, needs ≥16 GB.
# (An explicit DISCO_EMBED_MODEL / DISCO_RERANK_MODEL still overrides the tier.)
DISCO_ENCODER_TIER=lite

# Self-hosted/remote provider endpoints. Leave blank for keyless bundled defaults.
# DISCO_SEARXNG_URL=http://localhost:8888
# DISCO_CRAWL4AI_URL=http://localhost:11235
# DISCO_EMBEDDER_URL=http://localhost:8090/v1
# DISCO_RERANKER_URL=http://localhost:8091
# DISCO_NLI_URL=http://localhost:8092

# ---- verifier / release flags ------------------------------------------------
# Default ON: host verifier verdicts gate app finishes. Set to off/0/false/no to
# restore the older shadow-only posture during troubleshooting.
# DISCO_HOST_VERIFY_AUTHORITATIVE=off

# Default ON: promoted artifact readers use the maintained artifact manifest.
# Set to off/0/false/no to fall back to legacy event-only artifact path readers.
# DISCO_ARTIFACT_MANIFEST_READER=off

# Optional shadow telemetry for manifest divergence; default OFF.
# DISCO_ARTIFACT_MANIFEST_SHADOW=1

# ---- owner-only Cloudflare deploy API ----------------------------------------
# The Cloudflare account token is connected through the owner API and encrypted in
# the SecretStore; do not put it in this file. These vars gate the owner HTTP API.
# DISCO_ADMIN_TOKEN=            # required to call /api/appkit/cloudflare/*
# DISCO_OWNER_ORIGIN=           # optional CORS allowlist for the owner deploy UI
# DISCO_WRANGLER_BIN=           # optional absolute path to a trusted wrangler binary

# ---- misc -------------------------------------------------------------------
DISCO_LOG_LEVEL=INFO
# DISCO_LOG_JSON=1            # structured JSON log lines
# DISCO_DRIVER_VISION=1       # only if your endpoint serves a vision model (mmproj)
# DISCO_BUILD_EGRESS=filtered # deny-by-default sandbox egress (allowlist proxy)
# DISCO_INSPECT=1             # capture per-conversation request traces/debug evidence
