                    "content": "\"\"\"Simple HTTP API that serves sensor_readings.csv as JSON.\"\"\"\n\nimport csv\nimport json\nfrom http.server import HTTPServer, BaseHTTPRequestHandler\nimport os\n\n# Resolve CSV path relative to this file's directory\nCSV_PATH = os.path.join(os.path.dirname(__file__), \"uploads\", \"sensor_readings.csv\")\n\n\ndef load_readings():\n    \"\"\"Read the CSV and return a list of dicts with typed values.\"\"\"\n    rows = []\n    with open(CSV_PATH, newline=\"\", encoding=\"utf-8\") as f:\n        reader = csv.DictReader(f)\n        for row in reader:\n            rows.append({\n                \"timestamp\": row[\"timestamp\"],\n                \"sensor\": row[\"sensor\"],\n                \"temperature_c\": float(row[\"temperature_c\"]),\n            })\n    return rows\n\n\nclass Handler(BaseHTTPRequestHandler):\n    def do_GET(self):\n        if self.path == \"/api/readings\":\n            readings = load_readings()\n            body = json.dumps(readings).encode()\n            self.send_response(200)\n            self.send_header(\"Content-Type\", \"application/json\")\n            self.send_header(\"Access-Control-Allow-Origin\", \"*\")\n            self.send_header(\"Content-Length\", str(len(body)))\n            self.end_headers()\n            self.wfile.write(body)\n        else:\n            self.send_response(404)\n            self.send_header(\"Content-Type\", \"text/plain\")\n            self.end_headers()\n            self.wfile.write(b\"Not Found\")\n\n    def log_message(self, fmt, *args):\n        print(f\"[API] {args[0]}\")\n\n\nif __name__ == \"__main__\":\n    port = 3000\n    server = HTTPServer((\"0.0.0.0\", port), Handler)\n    print(f\"Sensor API listening on port {port}\")\n    server.serve_forever()\n"
                },
