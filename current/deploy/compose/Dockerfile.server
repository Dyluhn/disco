# Production image for the disco Python servers (BoD §5: app-server +
# agent-server). ONE venv runs both:
#   python -m disco.app_server     (user-facing orchestrator, :8800)
#   python -m disco.agent_server    (per-conversation runtime,  :8000)
# compose overrides `command` per service; the default CMD is the app-server.
#
# uv-workspace monorepo: packages/{core,tools,retrieval,agent-server,app-server}.
# The agent-server's bundled Kokoro TTS (kokoro-onnx + lameenc) is a default
# product tier, so it lives in the agent-server's CORE deps and a bare
# `--all-packages` sync installs it — no `--extra` flag needed. The tools
# `browser` extra (Playwright/Chromium) is deliberately NOT installed: the
# browser belongs to the separate sandbox image (deploy/sandbox/Dockerfile).

# ---------------------------------------------------------------------------
# Stage 1 — builder: resolve + install BOTH servers (the agent-server's bundled
# Kokoro TTS is a core dep, so it lands automatically) into a single
# self-contained venv at /app/.venv (workspace members go in as editable
# installs whose .pth files point at /app/packages/*/src).
# ---------------------------------------------------------------------------
FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim AS builder

ARG DISCO_ENCODER_TIER=full

# copy (not hardlink) into the venv, and pre-compile .pyc for faster cold start.
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    DISCO_ENCODER_TIER=${DISCO_ENCODER_TIER} \
    FASTEMBED_CACHE_PATH=/opt/disco-cache/fastembed \
    DISCO_TTS_DIR=/opt/disco-cache/tts

WORKDIR /app

# Workspace metadata first: install third-party deps without the editable
# workspace members so dependency and model-asset layers stay cacheable across
# ordinary source edits. The final sync below still uses --all-packages.
COPY pyproject.toml uv.lock ./
COPY current/packages/core/pyproject.toml current/packages/core/pyproject.toml
COPY current/packages/retrieval/pyproject.toml current/packages/retrieval/pyproject.toml
COPY current/packages/tools/pyproject.toml current/packages/tools/pyproject.toml
COPY current/packages/agent-server/pyproject.toml current/packages/agent-server/pyproject.toml
COPY current/packages/app-server/pyproject.toml current/packages/app-server/pyproject.toml
RUN uv sync --frozen --no-dev --all-packages --no-install-workspace

# Baked runtime assets. Keep this after deps but before application source, or a
# code-only edit would re-download several GB of ONNX/Kokoro weights.
COPY development/scripts/prefetch_packaged_assets.py /tmp/prefetch_packaged_assets.py
RUN /app/.venv/bin/python /tmp/prefetch_packaged_assets.py

# Workspace source: uv builds members editable from src, so the full packages/
# tree must be present for the final sync. Keep --all-packages: dropping it
# prunes workspace members from the shared server venv.
COPY current/packages/ ./current/packages/

# Single incantation that lands all 5 members + the agent-server's bundled TTS
# (kokoro-onnx, lameenc, numpy — now core deps) + weasyprint, and NOT the
# browser extra:
#   --all-packages : install every workspace member (core,tools,retrieval,
#                    agent-server,app-server) into one venv
#   --frozen       : honour uv.lock exactly, never re-resolve
#   --no-dev       : drop the shared dev toolchain (pytest/ruff/playwright/etc.)
RUN uv sync --frozen --no-dev --all-packages

# ---------------------------------------------------------------------------
# Stage 2 — runtime: slim python with only the native libs the servers need.
# ---------------------------------------------------------------------------
FROM python:3.12-slim-bookworm

ARG DISCO_ENCODER_TIER=full

# WeasyPrint (RP-07 PDF export) needs pango/cairo/gdk-pixbuf + fontconfig + a
# base font; tmux backs the agent shell-session tool. libgomp1 is required by
# the onnxruntime that fastembed (retrieval encoders) and kokoro-onnx (TTS)
# load lazily at runtime — without it the encoders/TTS fail at first use.
# libjemalloc2: a DECAYING allocator the agent-server LD_PRELOADs (see compose).
# Deep Research's bursty concurrent gather + in-process ONNX encoders fragment the
# glibc heap, so freed transient pages get stranded mid-heap and malloc_trim can't
# return them (the RSS floor never recedes). jemalloc's background_thread purges
# dirty pages to the OS even under fragmentation — the real fix for that floor.
# libreoffice-impress (+ fonts-liberation): deck→PDF export. When the operator
# selects the `process` backend in Settings, the agent-server runs tools in THIS
# image instead of a sibling sandbox container, so `soffice` must be present here
# too (the sandbox image already ships it). Out-of-the-box deck→PDF, mirroring the
# bundled-TTS bake-in. Absent soffice → render_deck() returns a clear error.
RUN apt-get update && apt-get install -y --no-install-recommends \
        libpango-1.0-0 \
        libpangoft2-1.0-0 \
        libgdk-pixbuf-2.0-0 \
        libcairo2 \
        libgomp1 \
        libjemalloc2 \
        fontconfig \
        fonts-dejavu-core \
        libreoffice-impress \
        fonts-liberation \
        podman \
        tmux \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# The self-contained venv + the workspace source the editable installs resolve
# against. The .pth files baked by the builder reference /app/packages/*/src,
# so the source must land at exactly that path.
COPY --from=builder /app/.venv /app/.venv
COPY --from=builder /app/current/packages /app/current/packages
COPY --from=builder /opt/disco-cache /opt/disco-cache

# The compose entrypoint (prepares /data, seeds a first-run config, ensures a
# PMX_SECRET_KEY) and the seed script it calls. compose sets
# `entrypoint: ["/entrypoint.sh"]` and the entrypoint runs /app/scripts/seed_config.py.
COPY current/deploy/compose/entrypoint.sh /entrypoint.sh
COPY development/scripts/ /app/development/scripts/
RUN chmod +x /entrypoint.sh

# Put the venv first on PATH so `python` is the venv interpreter (the base
# python:3.12-slim interpreter the venv was built against lives at the same
# /usr/local path, so the venv symlinks resolve here).
ENV PATH=/app/.venv/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    DISCO_ENCODER_TIER=${DISCO_ENCODER_TIER} \
    FASTEMBED_CACHE_PATH=/opt/disco-cache/fastembed \
    DISCO_TTS_DIR=/opt/disco-cache/tts

# Both servers default to PMX_HOST/PMX_DB/… from the environment; compose
# supplies those plus the /data mount. The healthcheck hits the servers with
# python stdlib urllib (no curl needed), which the venv interpreter provides.
EXPOSE 8000 8800

# Default to the app-server; compose overrides `command` for the agent-server.
CMD ["python", "-m", "disco.app_server"]
