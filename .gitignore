# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Coverage artifacts
.coverage
.coverage.*
htmlcov/

# uv / virtualenv
.venv/
# Local worktree symlinks and verification environments are not source.
/.venv
/.venv-release-check

# SQLite event stores / scratch DBs
*.db
*.db-wal
*.db-shm

# App-server config + secrets (NEVER commit — contains encrypted key material)
disco-config.json
disco-secrets.json
*-secrets.json
# Operator origin-approval ledger (runtime state — HMAC + approved provider origins)
disco-approved-origins.json
# DISCO_INSPECT=1 writes this beside the server. A live run must not be able
# to dirty the candidate tree -- Epics 6/7 certify exact bytes.
inspect-trace.jsonl

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# orchestration runtime state (development/scripts/orchestrate.sh) + Claude review queue
.orchestrate/
review-queue/

# Agent runtime workspaces (dev PMX_PROJECTS_ROOT output) + model bake-off scratch +
# captured verification artifacts (event logs, screenshots, run records). All generated.
/agent-projects/
/bakeoff/
/test-record/

# Root-level manual-test scratch (these patterns are ROOT-scoped on purpose — real
# test_*.py live under packages/ and must stay tracked).
/run_manual*.py
/test_*.py
/validate.py
/validation_output.txt
/test_tmux_out.txt
/tmp_weather.csv
/pytest_shell_sessions.txt
/pytest_tools.txt
/f5-pids.txt
/selected.csv
/sensor_readings.csv
/wind_dataset.csv
.omo/
# generated runtime state (sqlite db + per-conversation sidecars)
disco.db
disco.db-*
disco.db.*.json
# local model-swap backup of the live config
*.gemma-bak
# numbered backups of the secret-bearing config (e.g. disco-config.json.bak-1781588447)
disco-config.json.*
*.bak-*
# orchestration scratch (review output, lane diffs, screenshot helper)
.review/
*.diff
frontend/_*.mjs

# harness strays — never commit
/node_modules/
/workorders/
frontend/_a2harness*
frontend/_a2-deck.json
frontend/_a4_toggle*

# --- close-out cull (2026-07-07) ---
test-record/
disco.db*
disco-config.json*
disco-approved-origins.json
tmux-client-*.log
.env
frontend/.env.development.local
.bashrc
.bash_profile
.zshrc
.zprofile
.profile
.gitconfig
.ripgreprc
.idea/
.vscode/
.claude/*.log
.claude/*.txt
.claude/*-prompt.md
.claude/*-review-prompt.md
.wire-dump/

# Our source lives in components/build/ — defend it from a global `build/` rule
!/frontend/src/components/build/

# Editor/tooling state and an empty submodule file are not source (PKG-40).
# These were tracked as 0-byte files; .serena/ is per-machine tool state.
.idea
.vscode
.serena/
.gitmodules

# Retired history lives on its own pushed branches, not on main (PKG-40).
# Retrieve with:
#   git restore --source=archive/pre-v52-20260910 -- archive
#   git restore --source=evidence/harness-runs-20260910 -- development/harness/runs
/archive/
/development/harness/runs/
